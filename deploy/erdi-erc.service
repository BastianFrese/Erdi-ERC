# Erdi-ERC.service
# /etc/systemd/system/erdi-erc.service
[Unit]
Description=Erdi-ERC Razor App
After=network.target

[Service]
WorkingDirectory=/var/www/app
ExecStart=/usr/bin/dotnet /var/www/app/Erdi-ERC.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=erdi-erc
User=erdi
Group=erdi
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5000
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
# Secrets: sudo mkdir -p /etc/erdi-erc && sudo cp deploy/secrets.env.example /etc/erdi-erc/secrets.env
# Dann die Werte in /etc/erdi-erc/secrets.env ausfüllen und: sudo chmod 600 /etc/erdi-erc/secrets.env
EnvironmentFile=/etc/erdi-erc/secrets.env

[Install]
WantedBy=multi-user.target
