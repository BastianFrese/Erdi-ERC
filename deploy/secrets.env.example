# /etc/erdi-erc/secrets.env
# Auf dem Server NICHT im Repo!
# Setup: sudo mkdir -p /etc/erdi-erc
#        sudo cp deploy/secrets.env.example /etc/erdi-erc/secrets.env
#        sudo chmod 600 /etc/erdi-erc/secrets.env
#        sudo nano /etc/erdi-erc/secrets.env   # Werte eintragen
#
# Danach: sudo systemctl daemon-reload && sudo systemctl restart erdi-erc
#
# ASP.NET Core liest Env-Vars mit __ als Trennzeichen für verschachtelte Config-Keys:
#   ConnectionStrings__Default  →  Configuration["ConnectionStrings:Default"]

ConnectionStrings__Default=Server=<PROD_HOST>;Port=3306;Database=erdierc;User=erdierc;Password=PASSWORT_HIER;TreatTinyAsBoolean=true
Discord__ClientId=DISCORD_CLIENT_ID_HIER
Discord__ClientSecret=DISCORD_CLIENT_SECRET_HIER
Discord__Webhook__Url=WEBHOOK_URL_HIER
