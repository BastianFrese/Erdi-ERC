@using System.Text.Json
@using Erdi_ERC.Models
@using Erdi_ERC.Helpers
@inject Microsoft.Extensions.Options.IOptions<Erdi_ERC.Options.ApplicationOptions> _adminAppOpts
@{
    ViewData["Title"] = "F1 Setups";

    var tracks = (ViewBag.SetupTracks as List<string>) ?? new List<string>();
    var selectedTrack = ViewBag.SelectedTrack as string;
    var newSetupGroups = (ViewBag.NewSetupGroups as List<SetupNewsGroup>) ?? new List<SetupNewsGroup>();
    var newSetupSinceUtc = ViewBag.NewSetupSinceUtc is DateTime nsu ? nsu : DateTime.UtcNow.AddDays(-SetupNewsGroup.WindowDays);
    var visibleSetups = (ViewBag.VisibleSetups as List<Erdi_ERC.Models.TrackSetup>) ?? new List<Erdi_ERC.Models.TrackSetup>();
    var hiddenSetups = (ViewBag.HiddenSetups as List<Erdi_ERC.Models.TrackSetup>) ?? new List<Erdi_ERC.Models.TrackSetup>();
    var setupTier = ViewBag.SetupTier is int t ? t : 0;
    var setupRole = ViewBag.SetupRole as string;
    var isOnCommunityGuild = ViewBag.IsOnCommunityGuild is bool icg && icg;
    var isTenurePending = ViewBag.IsTenurePending is bool itp && itp;
    var guildJoinedAt = ViewBag.GuildJoinedAt as DateTimeOffset?;
    var tenureRequiredDays = ViewBag.TenureRequiredDays is int trd ? trd : 0;
    var tenureUnlockAt = guildJoinedAt?.AddDays(tenureRequiredDays);
    var tenureRemaining = tenureUnlockAt.HasValue ? tenureUnlockAt.Value - DateTimeOffset.UtcNow : (TimeSpan?)null;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var editorConfig = ViewBag.SetupEditorConfig as SetupEditorConfig ?? SetupGameSpec.GetEditorConfig();
    var metricConfig = ViewBag.SetupMetricConfig as IReadOnlyList<SetupMetricConfig> ?? SetupGameSpec.GetMetricConfig();
    var setupComments = (ViewBag.SetupComments as Dictionary<int, List<SetupComment>>) ?? new Dictionary<int, List<SetupComment>>();
    var setupLikeCounts = (ViewBag.SetupLikeCounts as Dictionary<int, int>) ?? new Dictionary<int, int>();
    var likedSetupIds = (ViewBag.LikedSetupIds as HashSet<int>) ?? new HashSet<int>();

    static string TierLabel(int tier, string? role) => tier switch
    {
        0 => "Öffentlich",
        // Legacy: Setups die noch Tier 2 in der DB haben werden wie Tier 1 behandelt.
        1 or 2 => "Community",
        3 => string.IsNullOrWhiteSpace(role) ? "Pit Crew"        : role,
        4 => string.IsNullOrWhiteSpace(role) ? "Race Engineer"   : role,
        5 => string.IsNullOrWhiteSpace(role) ? "Team Principal"  : role,
        _ => "Unbekannt"
    };

    static string TierIcon(int tier) => tier switch
    {
        0 => "bi-globe2",
        1 or 2 => "bi-discord",
        3 or 4 or 5 => "bi-twitch",
        _ => "bi-shield"
    };

    static string TierBadgeClass(int tier) => tier switch
    {
        0 => "tier-badge tier-badge--public",
        1 or 2 => "tier-badge tier-badge--community",
        3 => "tier-badge tier-badge--t1",
        4 => "tier-badge tier-badge--t2",
        5 => "tier-badge tier-badge--t3",
        _ => "tier-badge"
    };

    static (string Cls, string Label, string Title) TireCompound(Erdi_ERC.Models.TrackSetup s)
    {
        var hay = ((s.Title ?? string.Empty) + " " + (s.SetupInfo ?? string.Empty)).ToLowerInvariant();
        if (hay.Contains("regen") || hay.Contains("wet") || hay.Contains("nass") || hay.Contains("rain"))
            return ("tire--wet", "Wet", "Regenreifen empfohlen");
        if (hay.Contains("inter") || hay.Contains("intermediate"))
            return ("tire--inter", "Inter", "Intermediates empfohlen");
        if (hay.Contains("quali") || hay.Contains("qualy") || hay.Contains("qualifying") || hay.Contains("hotlap") || hay.Contains("time attack"))
            return ("tire--soft", "Soft", "Quali / Soft Compound");
        if (hay.Contains("hard") || hay.Contains("long run") || hay.Contains("longrun") || hay.Contains("stint"))
            return ("tire--hard", "Hard", "Long Run / Hard Compound");
        return ("tire--medium", "Medium", "Race / Medium Compound");
    }

}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/home-index.css" asp-append-version="true" />
}

<div class="f1-home-backdrop" aria-hidden="true"></div>

<partial name="_F1PageHero" model="@(new F1PageHeroVm {
    Eyebrow   = "F1 26 · Setup Library",
    Title     = "F1 Setup",
    Highlight = "Library",
    Lead      = "Setups für jede Strecke – schnell finden, vergleichen und ins Spiel übernehmen.",

})" />

<div class="d-flex align-items-center gap-2 mb-4 reveal flex-wrap">
    <span class="status-pill">
        <i class="bi @TierIcon(setupTier)"></i>
        Dein Zugriff: <strong class="ms-1">@TierLabel(setupTier, setupRole)</strong>
    </span>
    @if (isAuthenticated && !isOnCommunityGuild)
    {
        <span class="small text-warning"><i class="bi bi-exclamation-triangle me-1"></i> Tritt dem Community-Discord bei, um Zugang zu Setups freizuschalten.</span>
    }
    else if (isAuthenticated && isTenurePending && tenureRemaining is { } remaining && remaining > TimeSpan.Zero)
    {
        var days = (int)Math.Ceiling(remaining.TotalDays);
        var hours = (int)Math.Ceiling(remaining.TotalHours);
        var waitText = days >= 2 ? $"noch ca. {days} Tage" : $"noch ca. {hours} Stunden";
        <span class="small text-warning">
            <i class="bi bi-hourglass-split me-1"></i>
            Du bist erst seit kurzem auf dem Community-Discord. Setup-Zugang wird @waitText freigeschaltet.
        </span>
    }
</div>

<!-- ═══════════════════════════════════════════════════ INTRO -->
<section class="f1-section reveal">
    <partial name="_F1Section" model="@(new F1SectionVm {
        Chip  = "Tutorial",
        Title = "Erste Schritte"
    })" />

    <div class="row g-3">
        <div class="col-lg-5">
            <div style="background:var(--surface-1);border:1px solid var(--stroke-1);border-radius:var(--r-3);overflow:hidden;box-shadow:var(--sh-2);max-width:480px;">
                <div style="padding:.85rem 1rem;border-bottom:1px solid var(--stroke-1);display:flex;align-items:center;gap:.65rem;">
                    <span class="icon-chip is-cyan"><i class="bi bi-play-fill"></i></span>
                    <span style="font:700 .9rem/1 var(--ff-body);color:var(--ink);">Erdis Setup Tutorial</span>
                </div>
                <div class="ratio ratio-16x9">
                    <iframe src="https://www.youtube.com/embed/H9g4J0G_rKQ"
                            title="Erdi Setup Tutorial"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                            allowfullscreen
                            loading="lazy"></iframe>
                </div>
            </div>
        </div>
        <div class="col-lg-7">
            <div style="background:var(--surface-1);border:1px solid var(--stroke-1);border-radius:var(--r-3);padding:1.1rem;height:100%;box-shadow:var(--sh-2);">
                <div style="display:flex;align-items:center;gap:.65rem;margin-bottom:.85rem;">
                    <span class="icon-chip is-cyan"><i class="bi bi-link-45deg"></i></span>
                    <span style="font:700 .9rem/1 var(--ff-body);color:var(--ink);">Twitch ↔ Discord verknüpfen</span>
                </div>
                <p class="small text-mute mb-3">Seid ihr Subscriber auf Erdis Twitch-Kanal, könnt ihr euch die Subscriber-Rollen abholen:</p>
                <ol class="small text-mute mb-0 ps-3" style="line-height:1.8;">
                    <li>Discord öffnen → Benutzereinstellungen über das Zahnrad.</li>
                    <li>Links auf <strong style="color:var(--ink);">Verknüpfungen</strong> klicken.</li>
                    <li>In der Liste <strong style="color:var(--ink);">Twitch</strong> wählen.</li>
                    <li>Im Pop-up mit Twitch anmelden bzw. <strong style="color:var(--ink);">Autorisieren</strong>.</li>
                    <li>Optional: in den Einstellungen Twitch-Account auf dem Profil anzeigen.</li>
                </ol>
            </div>
        </div>
    </div>
</section>

@if (newSetupGroups.Any())
{
    <!-- ═══════════════════════════════════════════════════ FRISCH EINGETROFFEN -->
    <section class="f1-section reveal">
        <partial name="_F1Section" model="@(new F1SectionVm {
            Chip    = "Neu",
            Title   = "Frisch eingetroffen",
            SubText = $"letzte {SetupNewsGroup.WindowDays} Tage"
        })" />
        <div class="d-flex flex-wrap gap-2">
            @foreach (var group in newSetupGroups)
            {
                <a class="setup-news-chip"
                   asp-action="TrackSetups"
                   asp-route-track="@group.Track"
                   asp-route-gameYear="@group.GameYear"
                   title="Setups für @group.Track anzeigen">
                    <span aria-hidden="true">@RaceFlagHelper.Resolve(group.Track)</span>
                    <strong>@group.Track</strong>
                    @if (!string.IsNullOrWhiteSpace(group.GameYear))
                    {
                        <span class="chip-year">F1 @group.GameYear</span>
                    }
                    @if (group.NewCount > 0)
                    {
                        <span class="setup-freshness setup-freshness--new">@group.NewCount NEU</span>
                    }
                    @if (group.UpdatedCount > 0)
                    {
                        <span class="setup-freshness setup-freshness--updated">@group.UpdatedCount UPDATE</span>
                    }
                </a>
            }
        </div>
    </section>
}

<!-- ═══════════════════════════════════════════════════ FILTER -->
<section class="f1-section reveal">
    <form method="get" asp-action="TrackSetups" class="d-flex gap-2 align-items-end flex-wrap">
        <div class="flex-grow-1" style="min-width:240px;">
            <label for="track" class="form-label mb-1">Strecke filtern</label>
            <select id="track" name="track" class="form-select" onchange="this.form.submit()">
                <option value="" selected="@(string.IsNullOrWhiteSpace(selectedTrack))">Alle Strecken</option>
                @foreach (var tr in tracks)
                {
                    <option value="@tr" selected="@(string.Equals(tr, selectedTrack, StringComparison.OrdinalIgnoreCase))">@tr</option>
                }
            </select>
        </div>
        <div style="min-width:160px;">
            <label for="gameYear" class="form-label mb-1">Spieljahr</label>
            <select id="gameYear" name="gameYear" class="form-select" onchange="this.form.submit()">
                <option value="" selected="@(ViewBag.SelectedGameYear == null)">Alle Jahre</option>
                @{
                    var years = ViewBag.AvailableGameYears as List<string> ?? SetupGameSpec.KnownGameYears.ToList();
                    foreach (var y in years)
                    {
                        <option value="@y" selected="@(string.Equals(ViewBag.SelectedGameYear as string, y, StringComparison.OrdinalIgnoreCase))">F1 @y</option>
                    }
                }
            </select>
        </div>
        <button class="f1-btn f1-btn--primary" type="submit">
            <i class="f1-icon" data-lucide="filter"></i> Filtern
        </button>
        @if (!string.IsNullOrWhiteSpace(selectedTrack) || !string.IsNullOrWhiteSpace(ViewBag.SelectedGameYear as string))
        {
            <a class="f1-btn f1-btn--ghost" asp-action="TrackSetups">
                <i class="f1-icon" data-lucide="x"></i> Reset
            </a>
        }
    </form>

    @if (!isAuthenticated)
    {
        <div class="alert alert-info mt-3">Für geschützte Setups bitte zuerst einloggen.</div>
    }
    else if (!isOnCommunityGuild)
    {
        <div class="alert alert-warning mt-3">
            <strong>Setups gesperrt:</strong> Du musst Mitglied auf dem Erdi Community Discord sein, damit dir die Setups angezeigt werden.
            <div class="mt-2">
                <a class="f1-btn f1-btn--ghost" href="@_adminAppOpts.Value.DiscordInviteCommunity" target="_blank" rel="noopener">
                    <i class="bi bi-discord"></i> Community Discord beitreten
                </a>
            </div>
        </div>
    }
</section>

@if (!visibleSetups.Any() && !hiddenSetups.Any())
{
    var hasActiveFilter = !string.IsNullOrWhiteSpace(selectedTrack) || !string.IsNullOrWhiteSpace(ViewBag.SelectedGameYear as string);
    if (hasActiveFilter)
    {
        <div class="empty-state reveal">
            <span class="icon-chip is-amber"><i class="bi bi-search"></i></span>
            <div class="empty-state__title">Keine Setups für diesen Filter</div>
            <p class="empty-state__lead">Für die gewählte Strecke/Spieljahr-Kombination gibt es aktuell keine Setups. Setz den Filter zurück, um alle zu sehen.</p>
            <a class="f1-btn f1-btn--primary mt-2" asp-action="TrackSetups">
                <i class="f1-icon" data-lucide="rotate-ccw"></i> Filter zurücksetzen
            </a>
        </div>
    }
    else
    {
        <div class="empty-state reveal">
            <span class="icon-chip is-amber"><i class="bi bi-tools"></i></span>
            <div class="empty-state__title">Keine Setups hinterlegt</div>
            <p class="empty-state__lead">Sobald Setups verfügbar sind, erscheinen sie hier.</p>
        </div>
    }
}
else
{
    <section class="f1-section reveal">
        <partial name="_F1Section" model="@(new F1SectionVm {
            Chip    = "Setups",
            Title   = "Verfügbare Setups",
            SubText = $"{visibleSetups.Count} freigegeben"
        })" />

        <div class="row g-3">
            @foreach (var setup in visibleSetups)
            {
                // Einmaliger Parse pro Karte (ersetzt 4 separate JsonDocument.Parse-Durchläufe).
                var cardData = SetupGameSpec.ReadCardData(setup.SetupText);
                var hasPayload = cardData.HasPayload;
                var payloadVersion = cardData.Version;
                var compound = TireCompound(setup);
                var strategy = string.IsNullOrWhiteSpace(cardData.StrategyKey)
                    ? null
                    : editorConfig.RaceStrategies.FirstOrDefault(x => string.Equals(x.Key, cardData.StrategyKey, StringComparison.OrdinalIgnoreCase));
                var userHasAccepted = ViewBag.UserHasAcceptedExclusiveSetupTerms is bool accAccepted && accAccepted;
                // Exklusive (Tier-3) Setups: Werte erst nach protokollierter Widerrufs-Zustimmung ins HTML geben.
                // Vorher NICHTS emittieren (auch kein data-setup-json), sonst wäre die Zustimmung per DevTools umgehbar.
                var needsConsent = setup.RequiredAccessTier >= 3 && isAuthenticated && !userHasAccepted;
                <div class="col-12 col-xl-6">
                    <article id="setup-@setup.Id" class="setup-card h-100" data-setup-json="@((hasPayload && !needsConsent) ? setup.SetupText : string.Empty)">
                        <div class="setup-card__head">
                            <span class="icon-chip is-accent"><i class="bi bi-tools"></i></span>
                            <div class="flex-fill min-w-0">
                                <div class="setup-card__sub"><i class="bi bi-geo-alt-fill"></i> @setup.Track</div>
                                <div class="setup-card__title">@setup.Title</div>
                                <div class="mt-2 d-flex flex-wrap gap-2 align-items-center">
                                    @if (setup.CreatedAt >= newSetupSinceUtc)
                                    {
                                        <span class="setup-freshness setup-freshness--new">NEU</span>
                                    }
                                    else if (setup.UpdatedAt >= newSetupSinceUtc)
                                    {
                                        <span class="setup-freshness setup-freshness--updated">UPDATE</span>
                                    }
                                    <span class="tire @compound.Cls" title="@compound.Title">@compound.Label</span>
                                    @if (strategy is not null)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle" title="@strategy.Description">
                                            @strategy.Icon @strategy.Label · @strategy.Distance
                                        </span>
                                    }
                                </div>
                            </div>
                            <div class="d-flex flex-column gap-1 align-items-end">
                                <span class="badge bg-secondary text-mono">v@(payloadVersion)</span>
                                <span class="@TierBadgeClass(setup.RequiredAccessTier)"><i class="bi @TierIcon(setup.RequiredAccessTier)"></i> @TierLabel(setup.RequiredAccessTier, setup.RequiredRoleLabel)</span>
                            </div>
                        </div>
                        <div class="setup-card__body">
                            @if (!string.IsNullOrWhiteSpace(setup.SetupInfo))
                            {
                                <p class="text-mute small mb-3">@setup.SetupInfo</p>
                            }
                            @{
                                var planTrack = F1RaceCatalog.FindTrack(cardData.TrackKey);
                                var planLength = F1RaceCatalog.FindLength(cardData.LengthKey);
                                var planInfo = (TrackName: planTrack?.Name, LengthLabel: planLength?.Label, Plan: cardData.StrategyPlan);
                            }
                            @if (!needsConsent && !string.IsNullOrWhiteSpace(planInfo.Plan))
                            {
                                <div class="setup-strategy-block mb-3 p-2 rounded border border-warning-subtle bg-dark-subtle">
                                    <div class="small text-warning fw-semibold mb-1">
                                        <i class="bi bi-flag-fill me-1"></i> Renn-Strategie@(string.IsNullOrWhiteSpace(planInfo.TrackName) ? "" : $" · {planInfo.TrackName}")@(string.IsNullOrWhiteSpace(planInfo.LengthLabel) ? "" : $" · {planInfo.LengthLabel}")
                                    </div>
                                    <pre class="small text-mono mb-0" style="white-space:pre-wrap;color:var(--ink-2);">@planInfo.Plan</pre>
                                </div>
                            }

                            @if (needsConsent)
                            {
                                <div class="setup-locked-teaser p-3 rounded border border-warning-subtle bg-dark-subtle text-center">
                                    <i class="bi bi-shield-lock-fill text-warning" style="font-size:1.6rem"></i>
                                    <p class="text-mute small mb-0 mt-2">Exklusives Setup — bitte zuerst die Widerrufsbelehrung unten bestätigen, um die Setup-Werte einzusehen.</p>
                                </div>
                            }
                            else if (hasPayload)
                            {
                                <div class="setup-card__tools" data-no-toggle>
                                    <button type="button" class="setup-toggle-btn" data-setup-toggle
                                            aria-expanded="false" aria-controls="setup-playground-@setup.Id">
                                        <i class="bi bi-sliders" aria-hidden="true"></i>
                                        <span data-toggle-label>Regler anzeigen</span>
                                    </button>
                                    <button type="button" class="setup-reset-btn" data-sandbox-reset
                                            title="Setup-Regler zurücksetzen">
                                        <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Reset
                                    </button>
                                </div>
                                <div class="setup-user-playground" id="setup-playground-@setup.Id" data-setup-root></div>
                                <div class="setup-user-metrics mt-3">
                                    <div class="setup-user-metric" data-metric="topSpeed"><span>Top Speed</span><div><i></i></div><strong>0</strong></div>
                                    <div class="setup-user-metric" data-metric="traction"><span>Traktion</span><div><i></i></div><strong>0</strong></div>
                                    <div class="setup-user-metric" data-metric="rotation"><span>Einlenken</span><div><i></i></div><strong>0</strong></div>
                                    <div class="setup-user-metric" data-metric="stability"><span>Stabilität</span><div><i></i></div><strong>0</strong></div>
                                    <div class="setup-user-metric" data-metric="tyreWear"><span>Reifenschonung</span><div><i></i></div><strong>0</strong></div>
                                </div>
                            }
                            else
                            {
                                <pre class="setup-user-data">@setup.SetupText</pre>
                            }

                            <div class="mt-3 pt-3 border-top border-secondary-subtle">
                                <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-2">
                                    <h6 class="mb-0"><i class="bi bi-chat-left-dots"></i> Community Meinung</h6>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="text-mute small"><i class="bi bi-heart-fill text-danger"></i> @(setupLikeCounts.TryGetValue(setup.Id, out var lc) ? lc : 0)</span>
                                        @if (isAuthenticated)
                                        {
                                            <form asp-action="ToggleSetupLike" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="setupId" value="@setup.Id" />
                                                <input type="hidden" name="track" value="@selectedTrack" />
                                            <input type="hidden" name="gameYear" value="@(ViewBag.SelectedGameYear as string)" />
                                                <button class="f1-btn @(likedSetupIds.Contains(setup.Id) ? "f1-btn--primary" : "f1-btn--ghost") btn-sm" type="submit">
                                                    <i class="bi bi-heart-fill"></i> @(likedSetupIds.Contains(setup.Id) ? "Geliked" : "Liken")
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>

                                @if (isAuthenticated)
                                {
                                    <form asp-action="AddSetupComment" method="post" class="d-flex flex-column gap-2 mb-3">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="setupId" value="@setup.Id" />
                                        <input type="hidden" name="track" value="@selectedTrack" />
                                        <input type="hidden" name="gameYear" value="@(ViewBag.SelectedGameYear as string)" />
                                        <textarea class="form-control form-control-sm" name="message" rows="2" maxlength="600" placeholder="z.B. für Regen top / gutes Race Trim / stabile Hinterachse" required></textarea>
                                        <div class="d-flex justify-content-end">
                                            <button class="f1-btn f1-btn--ghost" type="submit">Kommentar posten</button>
                                        </div>
                                    </form>
                                }

                                @if (needsConsent)
                                {
                                    <partial name="_ExclusiveSetupConsentPartial" model="setup.Id" />
                                }

                                @{
                                    setupComments.TryGetValue(setup.Id, out var commentsForSetup);
                                }
                                @if (commentsForSetup != null && commentsForSetup.Any())
                                {
                                    <div class="d-flex flex-column gap-2">
                                        @foreach (var comment in commentsForSetup.Take(5))
                                        {
                                            <div class="surface-glass p-2 rounded">
                                                <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-1">
                                                    <strong class="small">@comment.AuthorName</strong>
                                                    <span class="text-mute small">@comment.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                                                </div>
                                                <div class="small">@comment.Message</div>
                                            </div>
                                        }
                                    </div>
                                    @if (commentsForSetup.Count > 5)
                                    {
                                        <div class="text-mute small mt-2">
                                            <i class="bi bi-three-dots"></i> @(commentsForSetup.Count - 5) weitere Kommentar@(commentsForSetup.Count - 5 == 1 ? "" : "e")
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
    </section>

    @if (hiddenSetups.Any())
    {
        <section class="f1-section reveal">
            <partial name="_F1Section" model="@(new F1SectionVm {
                Chip    = "Gesperrt",
                Title   = "Gesperrte Setups",
                SubText = $"{hiddenSetups.Count} gesperrt"
            })" />

            <div style="background:var(--surface-1);border:1px solid var(--stroke-1);border-radius:var(--r-3);padding:1.1rem;box-shadow:var(--sh-2);">
                <div class="d-flex flex-column gap-2 mb-3">
                    @foreach (var setup in hiddenSetups)
                    {
                        <div class="d-flex justify-content-between align-items-center gap-2 p-2 surface-glass">
                            <div class="d-flex align-items-center gap-2 min-w-0">
                                <i class="bi bi-lock-fill text-mute"></i>
                                <span class="fw-semibold text-truncate">@setup.Track · @setup.Title</span>
                            </div>
                            <span class="@TierBadgeClass(setup.RequiredAccessTier)"><i class="bi @TierIcon(setup.RequiredAccessTier)"></i> @TierLabel(setup.RequiredAccessTier, setup.RequiredRoleLabel)</span>
                        </div>
                    }
                </div>
                @if (isAuthenticated)
                {
                    <p class="text-mute small mb-0">Wenn dein Zugang nicht passt, bitte mit dem passenden Account neu anmelden.</p>
                }
                else
                {
                    <a class="f1-btn f1-btn--primary" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString">
                        <i class="bi bi-discord"></i> Login mit Discord
                    </a>
                }
            </div>
        </section>
    }
}

@section BodyOverlays {
    @if (newSetupGroups.Any())
    {
        var introGroups = newSetupGroups.Take(6).ToList();
        var introMoreCount = newSetupGroups.Count - introGroups.Count;
        var introLatestIso = newSetupGroups.Max(g => g.LatestUtc).ToString("O");
        <div class="setup-intro" id="setupIntro" hidden
             data-latest="@introLatestIso"
             role="dialog" aria-modal="true" aria-labelledby="setupIntroTitle">
            <div class="setup-intro__panel" tabindex="-1">
                <div class="setup-intro__head">
                    <div class="setup-intro__eyebrow"><i class="bi bi-broadcast"></i> Race Engineer · Setup Library</div>
                    <div class="setup-intro__title" id="setupIntroTitle">Box, Box — neue Setups!</div>
                    <div class="setup-intro__sub">Frisch eingetroffen in den letzten @SetupNewsGroup.WindowDays Tagen:</div>
                </div>
                <div class="setup-intro__rows">
                    @for (var i = 0; i < introGroups.Count; i++)
                    {
                        var g = introGroups[i];
                        <a class="setup-intro__row" style="animation-delay:@(400 + i * 90)ms"
                           asp-action="TrackSetups"
                           asp-route-track="@g.Track"
                           asp-route-gameYear="@g.GameYear"
                           title="Setups für @g.Track anzeigen">
                            <span class="flag" aria-hidden="true">@RaceFlagHelper.Resolve(g.Track)</span>
                            <span class="track">
                                @g.Track
                                @if (!string.IsNullOrWhiteSpace(g.GameYear))
                                {
                                    <span class="year">F1 @g.GameYear</span>
                                }
                            </span>
                            @if (g.NewCount > 0)
                            {
                                <span class="setup-freshness setup-freshness--new">@g.NewCount NEU</span>
                            }
                            @if (g.UpdatedCount > 0)
                            {
                                <span class="setup-freshness setup-freshness--updated">@g.UpdatedCount UPDATE</span>
                            }
                        </a>
                    }
                    @if (introMoreCount > 0)
                    {
                        <div class="setup-intro__more" style="animation-delay:@(400 + introGroups.Count * 90)ms">
                            + @introMoreCount weitere Strecke@(introMoreCount == 1 ? "" : "n") mit Updates
                        </div>
                    }
                </div>
                <div class="setup-intro__foot">
                    <span class="setup-intro__hint">Strecke anklicken, um direkt zu filtern.</span>
                    <button type="button" class="f1-btn f1-btn--ghost" data-intro-close>Weiter zur Library</button>
                    <div class="setup-intro__progress" aria-hidden="true"><i></i></div>
                </div>
            </div>
        </div>
    }
}

@section Scripts {
    <script>
        window.erdiSetupEditorConfig = @Html.Raw(JsonSerializer.Serialize(editorConfig));
        window.erdiSetupMetricConfig = @Html.Raw(JsonSerializer.Serialize(metricConfig));
    </script>
    <script src="~/js/track-setups.js" asp-append-version="true"></script>
    @* F1-Intro für neue Setups: zeigt sich nur bei ungelesener Aktivität.
       Läuft VOR dem Badge-Script im Layout, das den Gelesen-Status setzt. *@
    <script>
        (function () {
            const intro = document.getElementById('setupIntro');
            if (!intro) return;
            const KEY = 'erc-setups-seen-at';
            const latest = intro.getAttribute('data-latest') || '';
            let show = false;
            try {
                const seen = localStorage.getItem(KEY);
                show = !!latest && (!seen || Date.parse(latest) > Date.parse(seen));
                // Gleich als gelesen markieren (max-Semantik), damit Reload das Intro nicht wiederholt.
                if (show) localStorage.setItem(KEY, latest);
            } catch { show = false; /* localStorage blockiert → Intro aus, sonst käme es bei jedem Besuch */ }
            if (show && window.matchMedia('(prefers-reduced-motion: reduce)').matches) show = false;
            if (!show) { intro.remove(); return; }

            const AUTO_CLOSE_MS = 8000;
            const panel = intro.querySelector('.setup-intro__panel');
            document.body.classList.add('setup-intro-lock');
            intro.hidden = false;
            panel?.focus({ preventScroll: true });

            let closed = false;
            let remaining = AUTO_CLOSE_MS;
            let startedAt = Date.now();
            let timer = setTimeout(close, remaining);

            function close() {
                if (closed) return;
                closed = true;
                clearTimeout(timer);
                document.body.classList.remove('setup-intro-lock');
                document.removeEventListener('keydown', onKey);
                intro.classList.add('is-closing');
                setTimeout(() => intro.remove(), 320);
            }
            function focusableInPanel() {
                if (!panel) return [];
                return Array.from(panel.querySelectorAll('a[href], button:not([disabled])'))
                    .filter(el => el.offsetParent !== null);
            }
            // Escape schließt; Tab wird im Panel gefangen (Focus-Trap für aria-modal="true").
            function onKey(e) {
                if (e.key === 'Escape') { close(); return; }
                if (e.key !== 'Tab') return;
                const items = focusableInPanel();
                if (items.length === 0) return;
                const first = items[0];
                const last = items[items.length - 1];
                const active = document.activeElement;
                if (e.shiftKey) {
                    if (active === first || active === panel || !panel.contains(active)) {
                        e.preventDefault();
                        last.focus();
                    }
                } else if (active === last || active === panel || !panel.contains(active)) {
                    e.preventDefault();
                    first.focus();
                }
            }

            document.addEventListener('keydown', onKey);
            // Hover pausiert den Auto-Close (Progress-Bar pausiert via CSS synchron).
            panel?.addEventListener('mouseenter', () => {
                clearTimeout(timer);
                remaining -= Date.now() - startedAt;
            });
            panel?.addEventListener('mouseleave', () => {
                if (closed) return;
                startedAt = Date.now();
                timer = setTimeout(close, Math.max(remaining, 1500));
            });
            intro.addEventListener('click', (e) => {
                if (e.target.closest('[data-intro-close]')) { close(); return; }
                if (e.target.closest('a')) { close(); return; }            // Track-Link: navigieren + aufräumen
                if (!e.target.closest('.setup-intro__panel')) close();      // Klick auf Backdrop
            });
        })();
    </script>
}
