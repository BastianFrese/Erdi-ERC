@model Erdi_ERC.Models.UiComponents.PictureVm
@*
  Rendert ein <picture>-Element mit <img> + optionalem 2x-Retina-srcset.
  Ohne serverseitige Bild-Konversion: das vom Uploader hochgeladene Format
  wird ausgeliefert (jpg/png/webp/avif). Der Browser wählt das beste Bild
  anhand seiner eigenen Capabilities + Accept-Header aus.

  Pfad-Konvention:
    Original:   /uploads/events/{guid}.jpg
    2x-Variante: /uploads/events/{guid}@2x.jpg  (nur wenn Model.Retina == true)

  Cache: HTTP-Header Cache-Control: public, max-age=31536000, immutable
  wird von der /uploads-Static-File-Middleware in Program.cs gesetzt;
  ETag/Last-Modified → Browser macht 304-Not-Modified bei Re-Visit.

  Vorteile ggü. Block 2:
   - Kein CPU-Job beim Upload (kein Fire-and-forget-Race-Conditions)
   - Kein 5x Speicherverbrauch pro Bild
   - Keine 404s für nicht-existierende Varianten
   - Browser-native AVIF/WebP-Auswahl bleibt erhalten (Format vom Uploader)
*@
@using System.Text
@using System.Web
@{
    var src = Model.Src;
    var isPriority = string.Equals(Model.Priority, "high", StringComparison.OrdinalIgnoreCase);
    var effectiveLoading = isPriority ? "eager" : Model.Loading;
    var fetchPriority = isPriority ? "high" : null;
    var sizes = string.IsNullOrWhiteSpace(Model.Sizes) ? "100vw" : Model.Sizes;

    // 2x-Retina-Pfad: <stem>@2x.<ext>
    string? retinaSrc = null;
    if (Model.Retina)
    {
        int dotIdx = src.LastIndexOf('.');
        int slashIdx = src.LastIndexOf('/');
        var stem = (dotIdx >= 0 && (slashIdx < 0 || dotIdx > slashIdx)) ? src[..dotIdx] : src;
        var ext = (dotIdx >= 0 && (slashIdx < 0 || dotIdx > slashIdx)) ? src[dotIdx..] : string.Empty;
        retinaSrc = $"{stem}@2x{ext}";
    }

    // WebP-Zweitvariante (Offline erzeugt vom Tool tools/MediaWebPConverter):
    // existiert {stem}.webp neben dem Original, bekommt der Browser eine
    // <source type="image/webp"> — deutlich kleinere Downloads, gleiche URLs
    // für DB/Cache. Ohne Variante greift der Original-Fallback.
    var env = (Microsoft.AspNetCore.Hosting.IWebHostEnvironment?)Context.RequestServices.GetService(typeof(Microsoft.AspNetCore.Hosting.IWebHostEnvironment));
    var webpSrc = env is null ? null : TryGetWebpVariant(src, env.WebRootPath ?? "wwwroot");

    var imgAttrs = new StringBuilder();
    imgAttrs.Append(" src=\"").Append(HttpUtility.HtmlAttributeEncode(src)).Append("\"");
    imgAttrs.Append(" alt=\"").Append(HttpUtility.HtmlAttributeEncode(Model.Alt ?? "")).Append("\"");
    if (!string.IsNullOrEmpty(Model.CssClass))
        imgAttrs.Append(" class=\"").Append(HttpUtility.HtmlAttributeEncode(Model.CssClass)).Append("\"");
    if (Model.Width.HasValue)
        imgAttrs.Append(" width=\"").Append(Model.Width.Value).Append("\"");
    if (Model.Height.HasValue)
        imgAttrs.Append(" height=\"").Append(Model.Height.Value).Append("\"");
    imgAttrs.Append(" loading=\"").Append(HttpUtility.HtmlAttributeEncode(effectiveLoading)).Append("\"");
    imgAttrs.Append(" decoding=\"").Append(HttpUtility.HtmlAttributeEncode(Model.Decoding)).Append("\"");
    if (retinaSrc != null)
        imgAttrs.Append(" srcset=\"").Append(HttpUtility.HtmlAttributeEncode(src))
                .Append(" 1x, ").Append(HttpUtility.HtmlAttributeEncode(retinaSrc)).Append(" 2x\"");
    if (fetchPriority != null)
        imgAttrs.Append(" fetchpriority=\"").Append(HttpUtility.HtmlAttributeEncode(fetchPriority)).Append("\"");
    if (!string.IsNullOrEmpty(Model.ExtraAttrs))
        imgAttrs.Append(" ").Append(Model.ExtraAttrs);
}
<picture>
    @if (!string.IsNullOrEmpty(webpSrc))
    {
        <source type="image/webp" srcset="@webpSrc">
    }
    <img @Html.Raw(imgAttrs.ToString())>
</picture>
@functions {
    // Prozessweiter Cache der Varianten-Existenz (pos. wie neg. Ergebnisse),
    // damit pro Bild max. einmal File.Exists läuft. Neue Varianten werden mit
    // dem nächsten App-Restart sichtbar (Publish startet die App eh neu).
    private static readonly System.Collections.Concurrent.ConcurrentDictionary<string, bool> WebpVariantExists = new();

    private static string? TryGetWebpVariant(string src, string webRootPath)
    {
        if (string.IsNullOrWhiteSpace(src)) return null;
        if (src.StartsWith("//") || src.Contains("://", StringComparison.Ordinal)) return null; // extern/absolut

        var path = src.StartsWith("~/", StringComparison.Ordinal) ? src[2..] : src;
        if (!path.StartsWith("/uploads/", StringComparison.OrdinalIgnoreCase)) return null; // Varianten nur für Uploads

        var dot = path.LastIndexOf('.');
        if (dot < 0) return null;
        var ext = path[dot..].ToLowerInvariant();
        if (ext is not (".jpg" or ".jpeg" or ".png")) return null; // nur vom Tool konvertierte Formate

        var webpPath = path[..dot] + ".webp";
        var exists = WebpVariantExists.GetOrAdd(webpPath, p =>
            File.Exists(System.IO.Path.Combine(webRootPath, p.TrimStart('/').Replace('/', System.IO.Path.DirectorySeparatorChar))));
        return exists ? webpPath : null;
    }
}
