@model Erdi_ERC.Models.DriverDetailViewModel
@using Erdi_ERC.Models
@using Erdi_ERC.Helpers
@{
    var profile = ViewBag.Profile as DriverProfile;

    var photo    = profile?.PhotoUrl;
    var hasPhoto = !string.IsNullOrWhiteSpace(photo);
    var age      = profile?.Age?.ToString();
    var number   = Model?.DriverNumber?.ToString();

    // Initialen aus dem Gamertag — Unterstriche & Co. wirken als Wortgrenzen, nicht als Zeichen.
    var initials = DriverInitialsHelper.FromGamertag(Model?.Driver);

    var favTeam  = F1TeamsHelper.GetTeamByName(profile?.FavoriteTeam);
    var team     = favTeam ?? F1TeamsHelper.GetTeamByName(Model?.Team);
    var teamLogo = team is not null ? $"/images/teams/{team.LogoKey}.svg" : null;
    var teamName = team?.Name ?? (string.IsNullOrWhiteSpace(Model?.Team) ? null : Model!.Team);
    var accent   = team?.PrimaryColor ?? "#e10600";

    var hardware     = SimHardwareHelper.Resolve(profile?.InputDevice);
    var hardwareLogo = hardware is not null ? $"/images/logos/{hardware.Key}.svg" : null;

    var favTrack     = RaceFlagHelper.ResolveTrack(profile?.FavoriteTrack);
    var trackOutline = favTrack is not null ? $"/images/tracks/{favTrack.Key}.svg" : null;
    var trackName    = favTrack is not null
        ? (favTrack.Key switch { "lasvegas" => "Las Vegas", "abudhabi" => "Abu Dhabi", _ => favTrack.Country })
        : (string.IsNullOrWhiteSpace(profile?.FavoriteTrack) ? null : profile!.FavoriteTrack!.Trim());

    // Nation: echte Flagge (wenn SVG vorhanden) + bulletproof 3-Buchstaben-Code als Fallback.
    var natCode = RaceFlagHelper.ResolveCountryCode(profile?.Nationality);
    var natIso2 = RaceFlagHelper.ResolveCountryIso2(profile?.Nationality);
    var natFlag = natIso2 is not null ? $"/images/flags/{natIso2}.svg" : null;

    // Fahrernummer-Farbe: vom Controller aufgelöst, sonst lokal nach derselben Regel.
    var numberColor = ViewBag.NumberColor as string
        ?? (profile?.DriverNumberColor is not null ? profile.DriverNumberColor.Trim() : null)
        ?? team?.PrimaryColor
        ?? "#e10600";

    // Stats für die FIFA-Karte (ohne Foto).
    var totalRaces    = Model?.Races?.Count ?? 0;
    var finishedRaces = Model?.Races?.Count(r => r.Position > 0) ?? 0;
    var winRate       = finishedRaces > 0 ? (int)Math.Round(100.0 * (Model?.Wins ?? 0) / finishedRaces) : 0;
    var bestFinish    = Model?.BestFinish is int bf && bf > 0 ? $"P{bf}" : "–";

    // Autofit-Skript nur einmal pro Request einbinden, egal wie viele Karten gerendert werden.
    var emitFitScript = !Context.Items.ContainsKey("__ercCardFitEmitted");
    if (emitFitScript) { Context.Items["__ercCardFitEmitted"] = true; }
}

@if (emitFitScript)
{
    <script src="~/js/driver-card-fit.min.js" asp-append-version="true" defer></script>
}

@if (hasPhoto)
{
    @* ── Layout A: Foto-Poster ─────────────────────────────────── *@
    <div class="erc-card erc-card--photo" style="--dc-accent:@accent;">
        <div class="erc-card__shell">
            <div class="erc-card__wash"></div>
            <div class="erc-photo">
                @{
                    var photoPic = new PictureVm {
                        Src = @photo,
                        Alt = @Model?.Driver,
                        Loading = "lazy",
                        Decoding = "async"
                    };
                }
                <partial name="_Picture" model="photoPic" />
            </div>
            @if (number is not null)
            {
                <div class="erc-bignum" style="color:@numberColor;">@number</div>
            }

            <div class="erc-card__brand">
                <div class="erc-brand__mark">
                    <span class="erc-brand__erc">ERC</span>
                    <span class="erc-brand__sub">League Racing</span>
                </div>
                <div class="erc-chips">
                    @if (natCode is not null)
                    {
                        <span class="erc-chip"><span class="erc-nation">
                            @if (natFlag is not null)
                            {
                                <img class="erc-nation__flag" src="@natFlag" alt="" onerror="this.style.display='none'" />
                            }
                            <span class="erc-nation__code">@natCode</span>
                        </span></span>
                    }
                    @if (age is not null)
                    {
                        <span class="erc-chip"><span class="erc-chip__val">@age</span><span class="erc-chip__lbl">Alter</span></span>
                    }
                </div>
            </div>

            <div class="erc-info">
                <div class="erc-info__name">
                    @if (natFlag is not null)
                    {
                        <img class="erc-name__flag" src="@natFlag" alt="" onerror="this.style.display='none'" />
                    }
                    @Model?.Driver
                </div>
                <div class="erc-info__accent"></div>
                <div class="erc-meta">
                    @if (teamName is not null)
                    {
                        <div class="erc-meta__cell">
                            <span class="erc-meta__lbl">Team</span>
                            <span class="erc-meta__val">
                                @if (teamLogo is not null)
                                {
                                    <img class="erc-meta__logo" src="@teamLogo" alt="@teamName" onerror="this.style.display='none'" />
                                }
                                <span>@teamName</span>
                            </span>
                        </div>
                    }
                    @if (trackName is not null)
                    {
                        <div class="erc-meta__cell">
                            <span class="erc-meta__lbl">Strecke</span>
                            <span class="erc-meta__val">
                                @if (trackOutline is not null)
                                {
                                    <img class="erc-meta__track-svg" src="@trackOutline" alt="" aria-hidden="true" onerror="this.style.display='none'" />
                                }
                                @trackName
                            </span>
                        </div>
                    }
                    @if (hardwareLogo is not null)
                    {
                        <div class="erc-meta__cell">
                            <span class="erc-meta__lbl">Hardware</span>
                            <span class="erc-meta__val">
                                <img class="erc-meta__logo" src="@hardwareLogo" alt="@hardware!.Name" onerror="this.style.display='none'" />
                                <span>@hardware!.Name</span>
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
else
{
    @* ── Layout B: FIFA-Stats-Karte (ohne Foto) ────────────────── *@
    <div class="erc-card erc-card--stats" style="--dc-accent:@accent;">
        <div class="erc-card__shell">
            <div class="erc-card__wash"></div>

            <div class="erc-card__brand">
                <div class="erc-brand__mark">
                    <span class="erc-brand__erc">ERC</span>
                    <span class="erc-brand__sub">League Racing</span>
                </div>
                <div class="erc-chips">
                    @if (age is not null)
                    {
                        <span class="erc-chip"><span class="erc-chip__val">@age</span><span class="erc-chip__lbl">Alter</span></span>
                    }
                </div>
            </div>

            <div class="erc-tower">
                @if (number is not null)
                {
                    <div class="erc-tower__num" style="color:@numberColor;">@number</div>
                }
                @if (natCode is not null)
                {
                    <div class="erc-nation">
                        @if (natFlag is not null)
                        {
                            <img class="erc-nation__flag" src="@natFlag" alt="" onerror="this.style.display='none'" />
                        }
                        <span class="erc-nation__code">@natCode</span>
                    </div>
                }
                @if (team is not null)
                {
                    <div class="erc-tower__rule"></div>
                    <div class="erc-tower__team">
                        <img src="@teamLogo" alt="@team.Name" onerror="this.style.display='none'" />
                        <span class="erc-tower__team-lbl">@team.Name</span>
                    </div>
                }
            </div>

            <div class="erc-monogram"><span class="erc-monogram__txt">@initials</span></div>

            <div class="erc-sname">
                <div class="erc-sname__name">
                    @if (natFlag is not null)
                    {
                        <img class="erc-name__flag" src="@natFlag" alt="" onerror="this.style.display='none'" />
                    }
                    @Model?.Driver
                </div>
                <div class="erc-sname__rule"></div>
            </div>

            <div class="erc-stats-eyebrow">Saison-Bilanz</div>
            <div class="erc-stats">
                <div class="erc-stat"><span class="erc-stat__val">@totalRaces</span><span class="erc-stat__lbl">Rennen</span></div>
                <div class="erc-stat"><span class="erc-stat__val">@Model?.Wins</span><span class="erc-stat__lbl">Siege</span></div>
                <div class="erc-stat"><span class="erc-stat__val">@Model?.Podiums</span><span class="erc-stat__lbl">Podien</span></div>
                <div class="erc-stat"><span class="erc-stat__val">@bestFinish</span><span class="erc-stat__lbl">Best&nbsp;Finish</span></div>
                <div class="erc-stat"><span class="erc-stat__val">@PointsFormatHelper.Format(Model?.TotalPoints)</span><span class="erc-stat__lbl">Punkte</span></div>
                <div class="erc-stat"><span class="erc-stat__val">@(winRate)%</span><span class="erc-stat__lbl">Win-Rate</span></div>
            </div>

            @if (hardwareLogo is not null)
            {
                <div class="erc-card__hw">
                    <span class="erc-hw__lbl">Hardware</span>
                    <img src="@hardwareLogo" alt="@hardware!.Name" onerror="this.style.display='none'" />
                    <span class="erc-hw__name">@hardware!.Name</span>
                </div>
            }
        </div>
    </div>
}
