@model Erdi_ERC.Models.UiComponents.F1PageHeroVm
@*
    Seiten-Kopfzeile. CSS: pages/home-index.css (.f1-hero*).

    Frueher trug sie zwei leere FX-Ebenen (Telemetry, Chequer) und die Rubrik
    als umrandetes Kaestchen mit Farbkante ueber der Ueberschrift. Das Kaestchen
    ist weg: eine Rubrikzeile ueber einer Ueberschrift ist genau das
    "ueberfluessige Label ueber Inhalt", das der Auftrag als Klischee nennt.
    Die Information bleibt — sie steht jetzt als Text da, nicht als Kasten.
*@
<section class="f1-hero">
    @if (!string.IsNullOrWhiteSpace(Model.Eyebrow))
    {
        <p class="f1-hero__eyebrow">
            @if (Model.LiveDot) { <span class="f1-pulse-dot" aria-hidden="true"></span> }
            @Model.Eyebrow
        </p>
    }

    <h1 class="f1-hero__title">
        @Model.Title
        @if (!string.IsNullOrWhiteSpace(Model.Highlight))
        {
            <em>@Model.Highlight</em>
        }
    </h1>

    @if (!string.IsNullOrWhiteSpace(Model.Lead))
    {
        <p class="f1-hero__lead">@Html.Raw(Model.Lead)</p>
    }

    @if (Model.Actions is { Count: > 0 })
    {
        <div class="f1-hero__actions">
            @foreach (var a in Model.Actions)
            {
                <a class="f1-btn f1-btn--@a.Variant" href="@a.Href"
                   @(string.IsNullOrEmpty(a.Target) ? "" : $"target=\"{a.Target}\" rel=\"noopener\"")>
                    @if (!string.IsNullOrWhiteSpace(a.IconLucide))
                    {
                        <i class="f1-icon" data-lucide="@a.IconLucide"></i>
                    }
                    @a.Label
                </a>
            }
        </div>
    }
</section>
