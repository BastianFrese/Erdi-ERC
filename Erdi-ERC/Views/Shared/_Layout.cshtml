    @* ---------- MUSIC PLAYER (gleiche IDs für JS) ---------- *@
    <div class="music-player" id="globalMusicPlayer" aria-label="Background Music Player">
        <button type="button" class="music-btn" id="musicToggle" aria-label="Play/Pause"><i class="bi bi-play-fill"></i></button>
        <button type="button" class="music-btn" id="musicPrev" aria-label="Vorheriger Song"><i class="bi bi-skip-start-fill"></i></button>
        <button type="button" class="music-btn" id="musicNext" aria-label="Nächster Song"><i class="bi bi-skip-end-fill"></i></button>
        <div class="music-meta">
