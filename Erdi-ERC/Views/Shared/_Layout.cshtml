@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@inject Erdi_ERC.Services.ILayoutDataService _layoutDataService
@inject Erdi_ERC.Services.ISiteSettingsService SiteSettings
@using Erdi_ERC.Helpers
@{
    // -------- Layout-Daten aus Memory-Cache (30s TTL) statt DB-Query pro Page-Load --------
    var _layoutData = await _layoutDataService.GetLayoutDataAsync(Context.RequestAborted);

    string? _winnerTeamKey = _layoutData.WinnerTeamKey;
    string _winnerCarPrimary = _layoutData.WinnerCarPrimary;
    string _winnerCarPrimaryLight = _layoutData.WinnerCarPrimaryLight;
    string _winnerCarPrimaryDark = _layoutData.WinnerCarPrimaryDark;
    string _winnerCarSecondary = _layoutData.WinnerCarSecondary;

    // View kann BodyClass explizit überschreiben (z. B. Pages mit Spezial-Theme).
    if (string.IsNullOrEmpty(ViewData["BodyClass"] as string) && _winnerTeamKey != null)
    {
        ViewData["BodyClass"] = $"team-{_winnerTeamKey}";
    }
    else if (!string.IsNullOrEmpty(ViewData["BodyClass"] as string))
    {
        var _bodyClass = ViewData["BodyClass"] as string ?? string.Empty;
        var _match = System.Text.RegularExpressions.Regex.Match(_bodyClass, @"team-([a-z0-9]+)");
        if (_match.Success)
        {
            var _overrideKey = _match.Groups[1].Value;
            if (!string.Equals(_overrideKey, _winnerTeamKey, StringComparison.OrdinalIgnoreCase))
            {
                // BodyClass-Override aktiv → Farben passend zur Override-Team-Klasse berechnen.
                var _teamInfo = F1TeamsHelper.Teams.FirstOrDefault(t =>
                    t.CssKey.Equals(_overrideKey, StringComparison.OrdinalIgnoreCase));
                if (_teamInfo != null)
                {
                    _winnerTeamKey = _overrideKey;
                    _winnerCarPrimary = $"";
                    _winnerCarSecondary = _teamInfo.SecondaryColor;
                    string Shade(string hex, double factor)
                    {
                        if (string.IsNullOrWhiteSpace(hex) || hex[0] != '#' || hex.Length != 7) return hex;
                        int r = Convert.ToInt32(hex.Substring(1, 2), 16);
                        int g = Convert.ToInt32(hex.Substring(3, 2), 16);
                        int b = Convert.ToInt32(hex.Substring(5, 2), 16);
                        int Adjust(int c) => Math.Max(0, Math.Min(255, (int)Math.Round(c + (factor >= 0 ? (255 - c) * factor : c * factor))));
                        return $"#{Adjust(r):X2}{Adjust(g):X2}{Adjust(b):X2}";
                    }
                    _winnerCarPrimaryLight = Shade(_teamInfo.PrimaryColor, 0.25);
                    _winnerCarPrimaryDark = Shade(_teamInfo.PrimaryColor, -0.55);
                }
            }
        }
    }

    var _activeStream = _layoutData.ActiveStream;
    ViewData["ActiveStream"] = _activeStream;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    string IsActive(string controller, params string[] actions)
    {
        if (!string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)) return "";
        if (actions.Length == 0) return "active";
        return actions.Any(a => string.Equals(currentAction, a, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
    }

    // "!"-Badge am Setups-Navlink: nur emittieren, wenn die letzte Setup-Aktivität
    // im News-Fenster liegt. Sichtbarkeit entscheidet der Client per localStorage
    // (Besuch der Setup-Seite = "gelesen", wie WhatsApp).
    var _latestSetupActivityIso = _layoutData.LatestSetupActivityUtc is DateTime _lsa
        && _lsa >= DateTime.UtcNow.AddDays(-Erdi_ERC.Models.SetupNewsGroup.WindowDays)
        ? _lsa.ToString("O")
        : null;
    var _isOnSetupsPage = IsActive("Setups", "TrackSetups") == "active";
}
<!DOCTYPE html>
<html lang="de" data-bs-theme="dark">
<head>
    @* ---------- Theme Pre-Paint (vor allen CSS-Links, kein FOUC) ----------
       Liest localStorage "erc.theme.v1" und setzt data-theme/data-bs-theme
       noch vor dem ersten Render. Failsafe: try/catch -> dunkel. *@
    <script>
        (function () {
            try {
                if (localStorage.getItem('erc.theme.v1') === 'light') {
                    document.documentElement.setAttribute('data-theme', 'light');
                    document.documentElement.setAttribute('data-bs-theme', 'light');
                }
                document.addEventListener('DOMContentLoaded', function () {
                    var m = document.querySelector('meta[name="theme-color"]');
                    if (m) m.setAttribute('content',
                        document.documentElement.getAttribute('data-theme') === 'light' ? 'var(--ink)' : 'var(--kerb)');
                });
            } catch (e) { /* Private Mode -> dunkel (Default) */ }
        })();
    </script>
    @{
        var _ogTitle = (ViewData["OgTitle"] as string) ?? ($"{ViewData["Title"]} · Erdi's Racing Community");
        var _ogDescription = (ViewData["OgDescription"] as string)
            ?? "Erdi's Racing Community – Drei Ligen, ein Ziel. Lights out and away we go.";
        var _ogImagePath = (ViewData["OgImage"] as string) ?? "/images/ERCLogoHighRes1.png";
        var _ogUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
        var _ogImageAbs = _ogImagePath.StartsWith("http") ? _ogImagePath : $"{Context.Request.Scheme}://{Context.Request.Host}{_ogImagePath}";
    }
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="var(--kerb)" />
    <title>@ViewData["Title"] · Erdi's Racing Community</title>
    <meta name="description" content="@_ogDescription" />

    @* ---------- Open Graph / Twitter ---------- *@
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Erdi's Racing Community" />
    <meta property="og:title" content="@_ogTitle" />
    <meta property="og:description" content="@_ogDescription" />
    <meta property="og:url" content="@_ogUrl" />
    <meta property="og:image" content="@_ogImageAbs" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@_ogTitle" />
    <meta name="twitter:description" content="@_ogDescription" />
    <meta name="twitter:image" content="@_ogImageAbs" />

    @* ---------- PWA ---------- *@
    <link rel="manifest" href="~/site.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Erdi's Racing Community" />

    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16x16.png" asp-append-version="true" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" asp-append-version="true" />

    @* Schriften kommen selbst gehostet aus 01-tokens.css (@font-face auf /fonts/).
       Kein Fremd-Origin mehr: kein preconnect, kein media="print"-Trick, kein noscript.
       Bootstrap Icons folgen in Task 12 ebenfalls selbst gehostet und beschnitten;
       bis dahin bleiben die bi-Glyphen leer. *@

    @* LCP-Preload: Hero-Logo ist nur auf Pages relevant, die es above-the-fold zeigen (via ViewData["PreloadHero"]="hero"). Sonst wuerde jede Page 247 KB vorladen. *@
    @if ((ViewData["PreloadHero"] as string) == "hero")
    {
        <link rel="preload" as="image" href="~/images/ERCLogo.webp" fetchpriority="high">
    }

    @* site.bundled.css ist die Konkatenation aller CSS-Partials aus /css/site/ — 1 Request statt 13 @import-Roundtrips. Wird via MSBuild-Target bei jedem Build neu erzeugt (inkl. Minify zu site.bundled.min.css). *@
    <link rel="stylesheet" href="~/css/site.bundled.min.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(ViewData["BodyClass"] as string ?? "") @(string.IsNullOrEmpty(_winnerTeamKey) ? "" : $"team-{_winnerTeamKey}")">

    @* ---------- RACE-START LIGHTS (initial loader, einmalig pro Session) ---------- *@
    <div class="race-lights" id="raceStartLights" role="status" aria-label="Race start lights">
        <div class="race-lights__rig" aria-hidden="true">
            <span class="race-lights__lamp" data-lamp="1"></span>
            <span class="race-lights__lamp" data-lamp="2"></span>
            <span class="race-lights__lamp" data-lamp="3"></span>
            <span class="race-lights__lamp" data-lamp="4"></span>
            <span class="race-lights__lamp" data-lamp="5"></span>
        </div>
        <div class="race-lights__label" id="raceStartLabel">Lights out…</div>
    </div>

    @* ---------- BROADCAST-STREIFEN ----------
       Duenn und hartkantig statt der frueheren Glas-Pille. Die Untermenues der alten
       Navbar (Liga, Partner, Mehr) sind in den Footer gewandert — ein Broadcast-Streifen
       hat keine Untermenues. *@
    <header class="strip" id="mainNav">
        <div class="app-shell-container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <span class="strip__kicker">Erdi&#x27;s Racing Community</span>
            </a>
            <nav class="strip__nav" aria-label="Hauptnavigation">
                <a class="@IsActive("Stats", "Erdi10")" asp-controller="Stats" asp-action="Erdi10">Racing Hub</a>
                <a class="@IsActive("Races", "Results", "LeagueResults")" asp-controller="Races" asp-action="Results">Ergebnisse</a>
                <a class="@IsActive("Races", "AllRaces", "RaceDetail")" asp-controller="Races" asp-action="AllRaces">Rennen</a>
                <a class="@IsActive("Setups", "TrackSetups")" asp-controller="Setups" asp-action="TrackSetups">
                    Setups
                    @if (_latestSetupActivityIso != null)
                    {
                        <span class="nav-alert-badge" id="setupNewsBadge"
                              data-latest="@_latestSetupActivityIso"
                              data-on-setups="@(_isOnSetupsPage ? "true" : "false")"
                              hidden role="status" aria-label="Neue Setups verf&uuml;gbar">!</span>
                    }
                </a>
                <a class="@IsActive("Community", "Events", "EventDetail")" asp-controller="Community" asp-action="Events">Events</a>
                <a class="@IsActive("Races", "RaceCalendar")" asp-controller="Races" asp-action="RaceCalendar">Kalender</a>
                <a class="@IsActive("Application", "Apply", "Submitted", "MyApplication")" asp-controller="Application" asp-action="Apply">Bewerbung</a>
            </nav>
            <div class="strip__status">
                @if (_activeStream != null)
                {
                    <a href="@(_activeStream.Url ?? "https://twitch.tv/erdi10")" target="_blank" rel="noopener"
                       title="@_activeStream.Title" class="d-flex align-items-center gap-2">
                        <span class="live-dot" aria-hidden="true"></span><span>Live</span>
                    </a>
                }
                <button type="button" id="ercThemeToggle" class="btn btn-sm btn-ghost"
                        aria-label="Design umschalten (hell/dunkel)" aria-pressed="false"
                        title="Design umschalten">
                    <i class="bi bi-sun" aria-hidden="true"></i>
                </button>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Profile" asp-action="Index"
                       title="@User.Identity!.Name &ndash; Profil &ouml;ffnen">@User.Identity!.Name</a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-ghost">Logout</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-sm btn-primary" asp-controller="Account" asp-action="Login">Login</a>
                }
            </div>
        </div>
    </header>

    @* ---------- MAIN ---------- *@
    <main role="main" id="appMain" class="page">
        <div class="app-shell-container">
            @RenderBody()
        </div>
    </main>

    @* ---------- BODY-LEVEL OVERLAYS (außerhalb von main, damit position:fixed korrekt am Viewport bleibt) ---------- *@
    @await RenderSectionAsync("BodyOverlays", required: false)

    @* ---------- FOOTER ----------
       Traegt seit dem Umbau auch die Navigation, die frueher in den Untermenues der
       Navbar hing (Liga, Partner, Mehr). Ein Broadcast-Streifen hat keine Untermenues,
       die Wege zu den Nebenseiten muessen aber erreichbar bleiben. *@
    <footer class="footer">
        <div class="app-shell-container">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <span>@DateTime.UtcNow.Year&ensp;Erdi&#x27;s Racing Community</span>
                <span class="d-none d-md-inline" style="letter-spacing:.22em;">F1 26&ensp;SIM RACING LEAGUE</span>
                <span class="d-flex align-items-center gap-3">
                    <a href="https://twitch.tv/erdi10" target="_blank" rel="noopener" title="Twitch">Twitch</a>
                    <a href="https://www.youtube.com/@@PzudemK" target="_blank" rel="noopener" title="YouTube">YouTube</a>
                    <a href="https://www.instagram.com/erdi10f1/" target="_blank" rel="noopener" title="Instagram">Instagram</a>
                    <a href="https://open.spotify.com/intl-de/artist/4VaOsXeYI0DNmfkPhP40L9" target="_blank" rel="noopener" title="Spotify">Spotify</a>
                </span>
            </div>

            <ul class="footer__links">
                <li><a asp-controller="Stats" asp-action="EwigeListe">Ewige Liste</a></li>
                <li><a asp-controller="Stats" asp-action="HallOfFame">Hall of Fame</a></li>
                <li><a asp-controller="Stats" asp-action="DriverLevels">Fahrerlevel&nbsp;/&nbsp;XP</a></li>
                <li><a asp-controller="Community" asp-action="Teams">Teams</a></li>
                <li><a asp-controller="Community" asp-action="ReserveExchange">Reservefahrer-B&ouml;rse</a></li>
                <li><a asp-controller="Community" asp-action="CommunityVotes">Community-Votings</a></li>
                <li><a asp-controller="Community" asp-action="Highlights">Highlights</a></li>
                <li><a asp-controller="Home" asp-action="Stewarding">Stewarding</a></li>
                <li><a asp-controller="Home" asp-action="Faq">FAQ</a></li>
                <li><a href="/about/erdi10">&Uuml;ber mich</a></li>
                <li><a asp-controller="Home" asp-action="Regelwerk">Regelwerk</a></li>
                <li><a href="https://mozaracing.com/?ref=erdi10" target="_blank" rel="noopener">MOZA Racing</a></li>
                <li><a href="https://www.instant-gaming.com/?igr=Erdi10Gamer" target="_blank" rel="noopener">Instant Gaming</a></li>
                <li><a href="https://teams.spized.com/erc-fanshop" target="_blank" rel="noopener">ERC Fanshop</a></li>
                <li><a href="https://erdi10.myspreadshop.de/" target="_blank" rel="noopener">Erdi10 Shop</a></li>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li><a asp-controller="Application" asp-action="MyApplication">Meine Bewerbungen</a></li>
                }
                @if (SiteSettings.IsAppDownloadEnabled())
                {
                    <li><a asp-controller="Home" asp-action="DownloadApp">App herunterladen</a></li>
                }
                @if (User.HasClaim("erdi:admin", "true"))
                {
                    <li><a asp-controller="Admin" asp-action="Index">Admin Dashboard</a></li>
                }
                <li><a asp-controller="Home" asp-action="Privacy">Datenschutz</a></li>
                <li><a asp-controller="Home" asp-action="Impressum">Impressum</a></li>
            </ul>
        </div>
    </footer>

    @* ---------- MUSIC PLAYER (gleiche IDs für JS) ---------- *@
    <div class="music-player" id="globalMusicPlayer" aria-label="Background Music Player">
        <button type="button" class="music-btn" id="musicToggle" aria-label="Play/Pause"><i class="bi bi-play-fill"></i></button>
        <button type="button" class="music-btn" id="musicPrev" aria-label="Vorheriger Song"><i class="bi bi-skip-start-fill"></i></button>
        <button type="button" class="music-btn" id="musicNext" aria-label="Nächster Song"><i class="bi bi-skip-end-fill"></i></button>
        <div class="music-meta">
            <div class="music-title" id="musicTitle">Background Music</div>
            <div class="music-sub" id="musicIndex">1 / 1</div>
        </div>
        <input type="range" class="music-volume" id="musicVolume" min="0" max="1" step="0.01" value="0.5" aria-label="Lautstärke" />
        <button type="button" class="music-btn music-btn--collapse" id="musicCollapse" aria-label="Player minimieren"><i class="bi bi-chevron-up"></i></button>
        <audio id="globalAudioPlayer" preload="metadata"></audio>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="~/lib/lucide/lucide.min.js" asp-append-version="true" defer></script>
    <script src="~/js/theme-toggle.min.js" asp-append-version="true" defer></script>
    <script src="~/js/site.min.js" asp-append-version="true" defer></script>
    <script src="~/js/exclusive-consent.min.js" asp-append-version="true" defer></script>
    <script>
        (function () {
            // ---------- Lucide-Icons aktivieren (data-lucide -> SVG) ----------
            const renderLucide = () => { if (window.lucide && typeof window.lucide.createIcons === 'function') window.lucide.createIcons(); };
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', renderLucide);
            } else {
                renderLucide();
            }
            window.addEventListener('load', renderLucide);
            window.ercRenderLucide = renderLucide;

            // ---------- Scroll progress + sticky nav state ----------
            const nav = document.getElementById('mainNav');
            // rAF-gedrosselt: höchstens ein Style-Write pro Frame statt bei jedem Scroll-Tick
            // (verhindert Layout-Thrash und hält das Scrollen flüssig).
            let scrollTicking = false;
            const applyScroll = () => {
                scrollTicking = false;
                const h = document.documentElement;
                const scrolled = (h.scrollTop || document.body.scrollTop);
                const max = (h.scrollHeight - h.clientHeight) || 1;
                if (nav) nav.classList.toggle('is-scrolled', scrolled > 12);
            };
            const onScroll = () => {
                if (scrollTicking) return;
                scrollTicking = true;
                requestAnimationFrame(applyScroll);
            };
            document.addEventListener('scroll', onScroll, { passive: true });
            applyScroll();

            // ---------- Live Race-Lights pills (data-race-state-target="<ISO>") ----------
            (function () {
                const pills = document.querySelectorAll('.race-lights-pill[data-race-state-target]');
                if (!pills.length) return;

                const computeState = (target) => {
                    const now = Date.now();
                    const t = new Date(target).getTime();
                    if (Number.isNaN(t)) return { state: 'green', label: 'Live' };
                    const diffMin = (t - now) / 60000;
                    if (diffMin > 60)   return { state: 'ready',     label: 'Ready' };
                    if (diffMin > 5)    return { state: 'formation', label: 'Formation' };
                    if (diffMin > -5)   return { state: 'red',       label: 'Lights out' };
                    if (diffMin > -180) return { state: 'green',     label: 'Race · Live' };
                    return { state: 'green', label: 'Race · Final' };
                };

                const apply = () => {
                    pills.forEach(pill => {
                        const target = pill.dataset.raceStateTarget;
                        if (!target) return;
                        const { state, label } = computeState(target);
                        pill.dataset.state = state;
                        const txt = pill.querySelector('.race-lights-pill__text');
                        if (txt) txt.textContent = label;
                    });
                };

                apply();
                setInterval(apply, 30_000);
            })();

            // ---------- Race-Start Lights (loader sequence + slow-navigation overlay) ----------
            (function () {
                const rig = document.getElementById('raceStartLights');
                if (!rig) return;
                const label = document.getElementById('raceStartLabel');
                const lamps = rig.querySelectorAll('.race-lights__lamp');
                const sessionKey = 'erc.raceLights.shown';
                const navKey = 'erc.raceLights.continue';
                const navLabelKey = 'erc.raceLights.label';
                const navGoKey = 'erc.raceLights.goLabel';
                const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

                let labelStartText = 'Lights out…';
                let labelGoText = 'GO GO GO';

                const resetRig = () => {
                    rig.classList.remove('is-done', 'is-go');
                    rig.style.removeProperty('display');
                    lamps.forEach(l => l.classList.remove('is-on'));
                    if (label) label.textContent = labelStartText;
                };

                const hideRig = (immediate) => {
                    rig.classList.add('is-done');
                    if (immediate) {
                        rig.style.display = 'none';
                    }
                };

                // Nach der Sequenz das Rig komplett aus dem DOM entfernen — nicht nur
                // verstecken. Verstecktes Markup (5 Lampen + 12 Icons + SVG + 3
                // Background-Layer) kostet bei jedem Repaint ein paar CPU-Cycles
                // (Style-Recalc, Compositor-Layer-Verwaltung). Einmal gezeigt + fertig
                // → weg. Erneute Anzeige (z. B. via Nav-Continue) rekonstruiert das
                // Rig per Klon aus dem data-Attribut. So bleibt die Markup-Größe
                // nach der ersten Anzeige dauerhaft klein.
                let rigTemplate = null;
                const destroyRig = () => {
                    if (rig && rig.parentNode) {
                        if (!rigTemplate) rigTemplate = rig.cloneNode(true);
                        rig.parentNode.removeChild(rig);
                    }
                };
                const restoreRig = () => {
                    if (!rigTemplate || !rigTemplate.parentNode) {
                        if (!rigTemplate) rigTemplate = document.getElementById('raceStartLights')?.cloneNode(true);
                        if (rigTemplate && document.body) document.body.appendChild(rigTemplate);
                    }
                };

                const finish = () => {
                    rig.classList.add('is-go');
                    if (label) label.textContent = labelGoText;
                    sessionStorage.setItem(sessionKey, '1');
                    setTimeout(() => { hideRig(false); destroyRig(); }, 520);
                };

                let running = false;
                const playSequence = () => {
                    if (running) return;
                    running = true;
                    resetRig();
                    let i = 0;
                    const tick = () => {
                        if (i < lamps.length) {
                            lamps[i].classList.add('is-on');
                            i++;
                            setTimeout(tick, 220);
                        } else {
                            const hold = 260;
                            setTimeout(() => {
                                lamps.forEach(l => l.classList.remove('is-on'));
                                finish();
                                running = false;
                            }, hold);
                        }
                    };
                    setTimeout(tick, 180);
                };

                const continueFromNav = sessionStorage.getItem(navKey) === '1';
                if (continueFromNav) {
                    sessionStorage.removeItem(navKey);
                    sessionStorage.removeItem(sessionKey);
                    const storedStart = sessionStorage.getItem(navLabelKey);
                    const storedGo = sessionStorage.getItem(navGoKey);
                    if (storedStart) labelStartText = storedStart;
                    if (storedGo) labelGoText = storedGo;
                    sessionStorage.removeItem(navLabelKey);
                    sessionStorage.removeItem(navGoKey);
                    if (label) label.textContent = labelStartText;
                }

                const alreadyShown = sessionStorage.getItem(sessionKey) === '1';

                if (reduce) {
                    hideRig(true);
                    destroyRig();
                } else if (continueFromNav || !alreadyShown) {
                    playSequence();
                } else {
                    hideRig(true);
                    destroyRig();
                }

            })();

            // ---------- Animated number counters ----------
            const animateCount = (el) => {
                const target = parseFloat(el.dataset.count || '0');
                const duration = 1100;
                const start = performance.now();
                const tick = (now) => {
                    const p = Math.min(1, (now - start) / duration);
                    const eased = 1 - Math.pow(1 - p, 3);
                    el.textContent = Math.round(target * eased).toLocaleString('de-DE');
                    if (p < 1) requestAnimationFrame(tick);
                };
                requestAnimationFrame(tick);
            };
            if ('IntersectionObserver' in window) {
                const co = new IntersectionObserver((entries) => {
                    entries.forEach(e => { if (e.isIntersecting) { animateCount(e.target); co.unobserve(e.target); } });
                }, { threshold: 0.4 });
                document.querySelectorAll('[data-count]').forEach(el => co.observe(el));
            }

            // ---------- Persistent global music player ----------
            (async function () {
                let tracks = [];
                try {
                    const response = await fetch('/Home/GetBackgroundMusicTracks');
                    if (response.ok) tracks = await response.json();
                } catch { tracks = []; }

                const player = document.getElementById('globalMusicPlayer');
                if (!tracks || tracks.length === 0) { if (player) player.style.display = 'none'; return; }

                const storageKey = 'erc.music.player.v2';
                const collapseKey = 'erc.music.player.collapsed.v1';
                const audio = document.getElementById('globalAudioPlayer');
                const toggle = document.getElementById('musicToggle');
                const prev = document.getElementById('musicPrev');
                const next = document.getElementById('musicNext');
                const title = document.getElementById('musicTitle');
                const indexLabel = document.getElementById('musicIndex');
                const volume = document.getElementById('musicVolume');
                const collapse = document.getElementById('musicCollapse');
                if (!audio || !toggle || !prev || !next || !title || !indexLabel || !volume || !collapse || !player) return;

                const readState = () => {
                    try {
                        const raw = localStorage.getItem(storageKey);
                        if (!raw) return { index: 0, currentTime: 0, volume: 0.5, isPlaying: false };
                        const p = JSON.parse(raw);
                        return {
                            index: Number.isInteger(p.index) ? p.index : 0,
                            currentTime: Number(p.currentTime) || 0,
                            volume: Math.min(1, Math.max(0, Number(p.volume) || 0.5)),
                            isPlaying: !!p.isPlaying
                        };
                    } catch { return { index: 0, currentTime: 0, volume: 0.5, isPlaying: false }; }
                };
                const persistState = () => {
                    localStorage.setItem(storageKey, JSON.stringify({
                        index: currentIndex,
                        currentTime: audio.currentTime || 0,
                        volume: audio.volume,
                        isPlaying: !audio.paused
                    }));
                };

                // localStorage ist synchrone I/O. `timeupdate` feuert je nach Browser
                // 4–66 mal/Sekunde → würde auf jedem Tick einen blockierenden Disk-Write
                // auslösen und das Scrollen sichtbar ruckeln lassen. Stattdessen:
                // mindestens 5s Abstand zwischen Writes (ausreichend für Resume-Qualität),
                // und zwingend bei pause/ended/beforeunload (sonst gehen die letzten
                // Sekunden beim Tab-Wechsel verloren).
                const PERSIST_MIN_INTERVAL_MS = 5000;
                let lastPersistAt = 0;
                let persistPending = false;
                const persistStateThrottled = () => {
                    const now = performance.now();
                    if (now - lastPersistAt >= PERSIST_MIN_INTERVAL_MS) {
                        lastPersistAt = now;
                        persistState();
                    } else if (!persistPending) {
                        persistPending = true;
                        const wait = PERSIST_MIN_INTERVAL_MS - (now - lastPersistAt);
                        setTimeout(() => {
                            persistPending = false;
                            lastPersistAt = performance.now();
                            persistState();
                        }, wait);
                    }
                };

                let state = readState();
                let currentIndex = Math.min(Math.max(state.index, 0), tracks.length - 1);

                const setIcon = () => { toggle.innerHTML = audio.paused ? '<i class="bi bi-play-fill"></i>' : '<i class="bi bi-pause-fill"></i>'; };
                const applyCollapsed = (collapsed) => {
                    player.classList.toggle('is-collapsed', collapsed);
                    collapse.innerHTML = collapsed ? '<i class="bi bi-chevron-down"></i>' : '<i class="bi bi-chevron-up"></i>';
                    collapse.setAttribute('aria-label', collapsed ? 'Player maximieren' : 'Player minimieren');
                };
                const setCollapsed = (collapsed) => {
                    applyCollapsed(collapsed);
                    localStorage.setItem(collapseKey, collapsed ? '1' : '0');
                };
                const updateMeta = () => {
                    title.textContent = tracks[currentIndex].title;
                    indexLabel.textContent = `${currentIndex + 1} / ${tracks.length}`;
                    setIcon();
                };
                const setTrack = (index, keepTime) => {
                    currentIndex = (index + tracks.length) % tracks.length;
                    audio.src = tracks[currentIndex].url;
                    audio.load();
                    updateMeta();
                    const seekTo = keepTime ? (state.currentTime || 0) : 0;
                    if (seekTo > 0) {
                        audio.addEventListener('loadedmetadata', () => {
                            audio.currentTime = Math.min(seekTo, Math.max(0, (audio.duration || seekTo)));
                        }, { once: true });
                    }
                };

                audio.volume = state.volume;
                volume.value = String(state.volume);
                setTrack(currentIndex, true);
                applyCollapsed(localStorage.getItem(collapseKey) === '1');
                if (state.isPlaying) audio.play().catch(() => updateMeta());

                toggle.addEventListener('click', () => { audio.paused ? audio.play().catch(()=>{}) : audio.pause(); updateMeta(); persistState(); });
                prev.addEventListener('click', () => { state.currentTime = 0; setTrack(currentIndex - 1, false); audio.play().catch(()=>{}); persistState(); });
                next.addEventListener('click', () => { state.currentTime = 0; setTrack(currentIndex + 1, false); audio.play().catch(()=>{}); persistState(); });
                volume.addEventListener('input', () => { audio.volume = Math.min(1, Math.max(0, Number(volume.value) || 0.5)); persistState(); });
                collapse.addEventListener('click', () => setCollapsed(!player.classList.contains('is-collapsed')));

                audio.addEventListener('play',  () => { setIcon(); persistState(); });
                audio.addEventListener('pause', () => { setIcon(); persistState(); });
                // timeupdate: throttled statt synchron — siehe persistStateThrottled.
                // play/pause/ended/beforeunload oben/unten bleiben synchron (seltene
                // Ereignisse, müssen aber zuverlässig landen, damit Resume klappt).
                audio.addEventListener('timeupdate', persistStateThrottled);
                audio.addEventListener('ended', () => { setTrack(currentIndex + 1, false); audio.play().catch(()=>{}); persistState(); });

                window.addEventListener('beforeunload', persistState);
            })();
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)

    @* ---------- KEYBOARD SHORTCUTS ---------- *@
    <div class="shortcut-overlay" id="shortcutOverlay" role="dialog" aria-modal="true" aria-labelledby="shortcutTitle">
        <div class="shortcut-overlay__card">
            <h3 id="shortcutTitle"><i class="bi bi-keyboard me-2"></i>Shortcuts</h3>
            <div class="shortcut-row"><span>Racing Hub</span><span class="shortcut-keys"><kbd>G</kbd><kbd>H</kbd></span></div>
            <div class="shortcut-row"><span>Results</span><span class="shortcut-keys"><kbd>G</kbd><kbd>R</kbd></span></div>
            <div class="shortcut-row"><span>Alle Rennen</span><span class="shortcut-keys"><kbd>G</kbd><kbd>A</kbd></span></div>
            <div class="shortcut-row"><span>Setups</span><span class="shortcut-keys"><kbd>G</kbd><kbd>S</kbd></span></div>
            <div class="shortcut-row"><span>Events</span><span class="shortcut-keys"><kbd>G</kbd><kbd>E</kbd></span></div>
            <div class="shortcut-row"><span>Bewerbung</span><span class="shortcut-keys"><kbd>G</kbd><kbd>B</kbd></span></div>
            <div class="shortcut-row"><span>Twitch</span><span class="shortcut-keys"><kbd>G</kbd><kbd>T</kbd></span></div>
            <div class="shortcut-row"><span>Diese Hilfe</span><span class="shortcut-keys"><kbd>?</kbd></span></div>
            <div class="shortcut-row"><span>Schließen</span><span class="shortcut-keys"><kbd>Esc</kbd></span></div>
        </div>
    </div>
    <script>
        (function () {
            const overlay = document.getElementById('shortcutOverlay');
            if (!overlay) return;
            const open = () => overlay.classList.add('is-open');
            const close = () => overlay.classList.remove('is-open');
            overlay.addEventListener('click', (e) => { if (e.target === overlay) close(); });

            const map = {
                h: '@Url.Action("Erdi10", "Stats")',
                r: '@Url.Action("Results", "Races")',
                a: '@Url.Action("AllRaces", "Races")',
                s: '@Url.Action("TrackSetups", "Setups")',
                e: '@Url.Action("Events", "Community")',
                b: '@Url.Action("Apply", "Application")',
                t: 'https://twitch.tv/erdi10'
            };
            let pendingG = false, gTimer = null;

            document.addEventListener('keydown', (e) => {
                const tag = (e.target && e.target.tagName) || '';
                if (/INPUT|TEXTAREA|SELECT/.test(tag) || e.target.isContentEditable) return;
                if (e.ctrlKey || e.metaKey || e.altKey) return;

                if (e.key === '?') { e.preventDefault(); overlay.classList.toggle('is-open'); return; }
                if (e.key === 'Escape') { close(); return; }

                if (pendingG) {
                    const k = e.key.toLowerCase();
                    if (map[k]) {
                        e.preventDefault();
                        if (k === 't') window.open(map[k], '_blank', 'noopener'); else window.location.href = map[k];
                    }
                    pendingG = false;
                    if (gTimer) clearTimeout(gTimer);
                    return;
                }
                if (e.key.toLowerCase() === 'g') {
                    pendingG = true;
                    gTimer = setTimeout(() => pendingG = false, 1200);
                }
            });
        })();
    </script>

    @* ---------- "!"-Badge am Setups-Navlink (localStorage = gelesen-Status) ---------- *@
    <script>
        (function () {
            const badge = document.getElementById('setupNewsBadge');
            if (!badge) return;
            const KEY = 'erc-setups-seen-at';
            const latest = badge.getAttribute('data-latest');
            if (!latest) return;
            try {
                const seen = localStorage.getItem(KEY);
                if (badge.getAttribute('data-on-setups') === 'true') {
                    // Besuch der Setup-Seite gilt als "gelesen" – Badge verschwindet überall.
                    // Max-Semantik: Das Setup-Intro (TrackSetups) schreibt ggf. einen frischeren
                    // Zeitstempel als der 30s-Layout-Cache liefert — nie zurückdrehen.
                    if (!seen || Date.parse(latest) > Date.parse(seen)) localStorage.setItem(KEY, latest);
                    return;
                }
                if (!seen || Date.parse(latest) > Date.parse(seen)) badge.hidden = false;
            } catch { /* localStorage blockiert (z. B. Private Mode) → Badge bleibt aus */ }
        })();
    </script>


