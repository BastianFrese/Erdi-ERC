    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="~/lib/lucide/lucide.min.js" asp-append-version="true" defer></script>
    <script src="~/js/site.min.js" asp-append-version="true" defer></script>
    <script src="~/js/exclusive-consent.min.js" asp-append-version="true" defer></script>
    <script>
        (function () {
            // ---------- Lucide-Icons aktivieren (data-lucide -> SVG) ----------
            const renderLucide = () => { if (window.lucide && typeof window.lucide.createIcons === 'function') window.lucide.createIcons(); };
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', renderLucide);
            } else {
                renderLucide();
            }
            window.addEventListener('load', renderLucide);
            window.ercRenderLucide = renderLucide;

            // ---------- Scroll progress + sticky nav state ----------
            const nav = document.getElementById('mainNav');
            const bar = document.getElementById('scrollProgress');
            // rAF-gedrosselt: höchstens ein Style-Write pro Frame statt bei jedem Scroll-Tick
            // (verhindert Layout-Thrash und hält das Scrollen flüssig).
            let scrollTicking = false;
            const applyScroll = () => {
                scrollTicking = false;
                const h = document.documentElement;
                const scrolled = (h.scrollTop || document.body.scrollTop);
                const max = (h.scrollHeight - h.clientHeight) || 1;
                if (bar) bar.style.width = ((scrolled / max) * 100) + '%';
                if (nav) nav.classList.toggle('is-scrolled', scrolled > 12);
            };
            const onScroll = () => {
                if (scrollTicking) return;
                scrollTicking = true;
                requestAnimationFrame(applyScroll);
            };
            document.addEventListener('scroll', onScroll, { passive: true });
            applyScroll();

            // ---------- Reveal on scroll ----------
            if ('IntersectionObserver' in window) {
                // threshold:0 + rootMargin statt threshold:0.12 — sonst blenden Sections, die
                // höher als ~8× Viewport sind (z.B. die volle Setup-Liste ohne Filter), NIE ein:
                // 12% der Section sind dann nie gleichzeitig sichtbar -> is-visible wird nie gesetzt
                // -> opacity:0 bleibt. So triggert das Einblenden, sobald die Section in den unteren
                // Viewport-Rand kommt, unabhängig von ihrer Höhe.
                const io = new IntersectionObserver((entries) => {
                    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } });
                }, { threshold: 0, rootMargin: '0px 0px -10% 0px' });
                document.querySelectorAll('.reveal, .f1-stagger').forEach(el => io.observe(el));
            } else {
                document.querySelectorAll('.reveal, .f1-stagger').forEach(el => el.classList.add('is-visible'));
            }

            // ---------- Live Race-Lights pills (data-race-state-target="<ISO>") ----------
            (function () {
                const pills = document.querySelectorAll('.race-lights-pill[data-race-state-target]');
                if (!pills.length) return;

                const computeState = (target) => {
                    const now = Date.now();
                    const t = new Date(target).getTime();
                    if (Number.isNaN(t)) return { state: 'green', label: 'Live' };
                    const diffMin = (t - now) / 60000;
                    if (diffMin > 60)   return { state: 'ready',     label: 'Ready' };
                    if (diffMin > 5)    return { state: 'formation', label: 'Formation' };
                    if (diffMin > -5)   return { state: 'red',       label: 'Lights out' };
                    if (diffMin > -180) return { state: 'green',     label: 'Race · Live' };
                    return { state: 'green', label: 'Race · Final' };
                };

                const apply = () => {
                    pills.forEach(pill => {
                        const target = pill.dataset.raceStateTarget;
                        if (!target) return;
                        const { state, label } = computeState(target);
                        pill.dataset.state = state;
                        const txt = pill.querySelector('.race-lights-pill__text');
                        if (txt) txt.textContent = label;
                    });
                };

                apply();
                setInterval(apply, 30_000);
            })();

            // ---------- Race-Start Lights (loader sequence + slow-navigation overlay) ----------
            (function () {
                const rig = document.getElementById('raceStartLights');
                if (!rig) return;
                const label = document.getElementById('raceStartLabel');
                const lamps = rig.querySelectorAll('.race-lights__lamp');
                const sessionKey = 'erc.raceLights.shown';
                const navKey = 'erc.raceLights.continue';
                const navLabelKey = 'erc.raceLights.label';
                const navGoKey = 'erc.raceLights.goLabel';
                const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

                let labelStartText = 'Lights out…';
                let labelGoText = 'GO GO GO';

                const resetRig = () => {
                    rig.classList.remove('is-done', 'is-go');
                    rig.style.removeProperty('display');
                    lamps.forEach(l => l.classList.remove('is-on'));
                    if (label) label.textContent = labelStartText;
                };

                const hideRig = (immediate) => {
                    rig.classList.add('is-done');
                    if (immediate) {
                        rig.style.display = 'none';
                    }
                };

                // Nach der Sequenz das Rig komplett aus dem DOM entfernen — nicht nur
                // verstecken. Verstecktes Markup (5 Lampen + 12 Icons + SVG + 3
                // Background-Layer) kostet bei jedem Repaint ein paar CPU-Cycles
                // (Style-Recalc, Compositor-Layer-Verwaltung). Einmal gezeigt + fertig
                // → weg. Erneute Anzeige (z. B. via Nav-Continue) rekonstruiert das
                // Rig per Klon aus dem data-Attribut. So bleibt die Markup-Größe
                // nach der ersten Anzeige dauerhaft klein.
                let rigTemplate = null;
                const destroyRig = () => {
                    if (rig && rig.parentNode) {
                        if (!rigTemplate) rigTemplate = rig.cloneNode(true);
                        rig.parentNode.removeChild(rig);
                    }
                };
                const restoreRig = () => {
                    if (!rigTemplate || !rigTemplate.parentNode) {
                        if (!rigTemplate) rigTemplate = document.getElementById('raceStartLights')?.cloneNode(true);
                        if (rigTemplate && document.body) document.body.appendChild(rigTemplate);
                    }
                };

                const finish = () => {
                    rig.classList.add('is-go');
                    if (label) label.textContent = labelGoText;
                    sessionStorage.setItem(sessionKey, '1');
                    setTimeout(() => { hideRig(false); destroyRig(); }, 520);
                };

                let running = false;
                const playSequence = () => {
                    if (running) return;
                    running = true;
                    resetRig();
                    let i = 0;
                    const tick = () => {
                        if (i < lamps.length) {
                            lamps[i].classList.add('is-on');
                            i++;
                            setTimeout(tick, 480);
                        } else {
                            const hold = 400 + Math.random() * 800;
                            setTimeout(() => {
                                lamps.forEach(l => l.classList.remove('is-on'));
                                finish();
                                running = false;
                            }, hold);
                        }
                    };
                    setTimeout(tick, 180);
                };

                const continueFromNav = sessionStorage.getItem(navKey) === '1';
                if (continueFromNav) {
                    sessionStorage.removeItem(navKey);
                    sessionStorage.removeItem(sessionKey);
                    const storedStart = sessionStorage.getItem(navLabelKey);
                    const storedGo = sessionStorage.getItem(navGoKey);
                    if (storedStart) labelStartText = storedStart;
                    if (storedGo) labelGoText = storedGo;
                    sessionStorage.removeItem(navLabelKey);
                    sessionStorage.removeItem(navGoKey);
                    if (label) label.textContent = labelStartText;
                }

                const alreadyShown = sessionStorage.getItem(sessionKey) === '1';

                if (reduce) {
                    hideRig(true);
                    destroyRig();
                } else if (continueFromNav || !alreadyShown) {
                    playSequence();
                } else {
                    hideRig(true);
                    destroyRig();
                }

                // ---- Slow-navigation overlay ----
                if (reduce) return;

                const SLOW_THRESHOLD_MS = 260;
                const isInternalNavLink = (a) => {
                    if (!a || !a.getAttribute('href')) return false;
                    const href = a.getAttribute('href');
                    if (!href || href.startsWith('#') || href.startsWith('javascript:') || href.startsWith('mailto:') || href.startsWith('tel:')) return false;
                    if (a.hasAttribute('download')) return false;
                    if (a.dataset.bsToggle) return false;
                    const target = a.getAttribute('target');
                    if (target && target !== '' && target !== '_self') return false;
                    try {
                        const u = new URL(a.href, location.href);
                        if (u.origin !== location.origin) return false;
                        if (u.pathname === location.pathname && u.search === location.search && u.hash) return false;
                        return true;
                    } catch { return false; }
                };

                let armedTimer = null;
                const cancelArmed = () => {
                    if (armedTimer) { clearTimeout(armedTimer); armedTimer = null; }
                };

                document.addEventListener('click', (e) => {
                    if (e.defaultPrevented) return;
                    if (e.button !== 0) return;
                    if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
                    const a = e.target.closest('a[href]');
                    if (!isInternalNavLink(a)) return;

                    cancelArmed();

                    const force = a.dataset.raceLights === 'force';
                    const customStart = a.dataset.raceLightsText;
                    const customGo = a.dataset.raceLightsGo;
                    const armDelay = force ? 0 : SLOW_THRESHOLD_MS;

                    const arm = () => {
                        sessionStorage.setItem(navKey, '1');
                        if (customStart) sessionStorage.setItem(navLabelKey, customStart);
                        if (customGo) sessionStorage.setItem(navGoKey, customGo);
                        if (customStart) labelStartText = customStart;
                        if (customGo) labelGoText = customGo;
                        playSequence();
                    };

                    if (armDelay === 0) arm();
                    else armedTimer = setTimeout(arm, armDelay);
                }, true);

                // Also handle form posts (e.g. filter form, save buttons)
                document.addEventListener('submit', (e) => {
                    const f = e.target;
                    if (!(f instanceof HTMLFormElement)) return;
                    try {
                        const action = f.getAttribute('action') || location.href;
                        const u = new URL(action, location.href);
                        if (u.origin !== location.origin) return;
                    } catch { return; }
                    cancelArmed();
                    armedTimer = setTimeout(() => {
                        sessionStorage.setItem(navKey, '1');
                        playSequence();
                    }, SLOW_THRESHOLD_MS);
                }, true);

                // If navigation is cancelled / page stays alive, hide overlay after a while
                window.addEventListener('pageshow', () => {
                    cancelArmed();
                });
                window.addEventListener('beforeunload', cancelArmed);
            })();

            // ---------- Page transition (enter on load, leave on internal nav) ----------
            (function () {
                const main = document.getElementById('appMain');
                if (!main) return;
                const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                const rig = document.getElementById('raceStartLights');

                // Hide content while race-lights overlay is visible, then play enter once it's done.
                const lightsActive = rig && !rig.classList.contains('is-done') && rig.style.display !== 'none';
                if (lightsActive) {
                    main.classList.remove('is-entering');
                    main.style.opacity = '0';
                    const onDone = () => {
                        if (rig.classList.contains('is-done') || rig.style.display === 'none') {
                            main.style.removeProperty('opacity');
                            // restart enter animation
                            main.classList.remove('is-entering');
                            // force reflow
                            void main.offsetWidth;
                            main.classList.add('is-entering');
                            obs.disconnect();
                        }
                    };
                    const obs = new MutationObserver(onDone);
                    obs.observe(rig, { attributes: true, attributeFilter: ['class', 'style'] });
                }

                // Clean up enter class after animation so reflows don't replay
                main.addEventListener('animationend', (e) => {
                    if (e.animationName === 'page-enter') {
                        main.classList.remove('is-entering');
                    }
                }, true);

                if (reduce) return;

                // Trigger leave on internal navigation (links + forms)
                const isInternal = (a) => {
                    if (!a) return false;
                    const href = a.getAttribute('href');
                    if (!href || href.startsWith('#') || href.startsWith('javascript:') || href.startsWith('mailto:') || href.startsWith('tel:')) return false;
                    if (a.hasAttribute('download')) return false;
                    if (a.dataset.bsToggle) return false;
                    const target = a.getAttribute('target');
                    if (target && target !== '' && target !== '_self') return false;
                    try {
                        const u = new URL(a.href, location.href);
                        if (u.origin !== location.origin) return false;
                        if (u.pathname === location.pathname && u.search === location.search && u.hash) return false;
                        return true;
                    } catch { return false; }
                };

                document.addEventListener('click', (e) => {
                    if (e.defaultPrevented) return;
                    if (e.button !== 0) return;
                    if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
                    const a = e.target.closest('a[href]');
                    if (!isInternal(a)) return;
                    main.classList.remove('is-entering');
                    main.classList.add('is-leaving');
                }, true);

                document.addEventListener('submit', (e) => {
                    const f = e.target;
                    if (!(f instanceof HTMLFormElement)) return;
                    try {
                        const action = f.getAttribute('action') || location.href;
                        const u = new URL(action, location.href);
                        if (u.origin !== location.origin) return;
                    } catch { return; }
                    main.classList.remove('is-entering');
                    main.classList.add('is-leaving');
                }, true);

                // If user comes back via bfcache, replay enter
                window.addEventListener('pageshow', (e) => {
                    if (e.persisted) {
                        main.classList.remove('is-leaving');
                        main.classList.remove('is-entering');
                        void main.offsetWidth;
                        main.classList.add('is-entering');
                    }
                });
            })();

            // ---------- Animated number counters ----------
            const animateCount = (el) => {
                const target = parseFloat(el.dataset.count || '0');
                const duration = 1100;
                const start = performance.now();
                const tick = (now) => {
                    const p = Math.min(1, (now - start) / duration);
                    const eased = 1 - Math.pow(1 - p, 3);
                    el.textContent = Math.round(target * eased).toLocaleString('de-DE');
                    if (p < 1) requestAnimationFrame(tick);
                };
                requestAnimationFrame(tick);
            };
            if ('IntersectionObserver' in window) {
                const co = new IntersectionObserver((entries) => {
                    entries.forEach(e => { if (e.isIntersecting) { animateCount(e.target); co.unobserve(e.target); } });
                }, { threshold: 0.4 });
                document.querySelectorAll('[data-count]').forEach(el => co.observe(el));
            }

            // ---------- Persistent global music player ----------
            (async function () {
                let tracks = [];
                try {
                    const response = await fetch('/Home/GetBackgroundMusicTracks');
                    if (response.ok) tracks = await response.json();
                } catch { tracks = []; }

                const player = document.getElementById('globalMusicPlayer');
                if (!tracks || tracks.length === 0) { if (player) player.style.display = 'none'; return; }

                const storageKey = 'erc.music.player.v2';
                const collapseKey = 'erc.music.player.collapsed.v1';
                const audio = document.getElementById('globalAudioPlayer');
                const toggle = document.getElementById('musicToggle');
                const prev = document.getElementById('musicPrev');
                const next = document.getElementById('musicNext');
                const title = document.getElementById('musicTitle');
                const indexLabel = document.getElementById('musicIndex');
                const volume = document.getElementById('musicVolume');
                const collapse = document.getElementById('musicCollapse');
                if (!audio || !toggle || !prev || !next || !title || !indexLabel || !volume || !collapse || !player) return;

                const readState = () => {
                    try {
                        const raw = localStorage.getItem(storageKey);
                        if (!raw) return { index: 0, currentTime: 0, volume: 0.5, isPlaying: false };
                        const p = JSON.parse(raw);
                        return {
                            index: Number.isInteger(p.index) ? p.index : 0,
                            currentTime: Number(p.currentTime) || 0,
                            volume: Math.min(1, Math.max(0, Number(p.volume) || 0.5)),
                            isPlaying: !!p.isPlaying
                        };
                    } catch { return { index: 0, currentTime: 0, volume: 0.5, isPlaying: false }; }
                };
                const persistState = () => {
                    localStorage.setItem(storageKey, JSON.stringify({
                        index: currentIndex,
                        currentTime: audio.currentTime || 0,
                        volume: audio.volume,
                        isPlaying: !audio.paused
                    }));
                };

                // localStorage ist synchrone I/O. `timeupdate` feuert je nach Browser
                // 4–66 mal/Sekunde → würde auf jedem Tick einen blockierenden Disk-Write
                // auslösen und das Scrollen sichtbar ruckeln lassen. Stattdessen:
                // mindestens 5s Abstand zwischen Writes (ausreichend für Resume-Qualität),
                // und zwingend bei pause/ended/beforeunload (sonst gehen die letzten
                // Sekunden beim Tab-Wechsel verloren).
                const PERSIST_MIN_INTERVAL_MS = 5000;
                let lastPersistAt = 0;
                let persistPending = false;
                const persistStateThrottled = () => {
                    const now = performance.now();
                    if (now - lastPersistAt >= PERSIST_MIN_INTERVAL_MS) {
                        lastPersistAt = now;
                        persistState();
                    } else if (!persistPending) {
                        persistPending = true;
                        const wait = PERSIST_MIN_INTERVAL_MS - (now - lastPersistAt);
                        setTimeout(() => {
                            persistPending = false;
                            lastPersistAt = performance.now();
                            persistState();
                        }, wait);
                    }
                };

                let state = readState();
                let currentIndex = Math.min(Math.max(state.index, 0), tracks.length - 1);

                const setIcon = () => { toggle.innerHTML = audio.paused ? '<i class="bi bi-play-fill"></i>' : '<i class="bi bi-pause-fill"></i>'; };
                const applyCollapsed = (collapsed) => {
                    player.classList.toggle('is-collapsed', collapsed);
                    collapse.innerHTML = collapsed ? '<i class="bi bi-chevron-down"></i>' : '<i class="bi bi-chevron-up"></i>';
                    collapse.setAttribute('aria-label', collapsed ? 'Player maximieren' : 'Player minimieren');
                };
                const setCollapsed = (collapsed) => {
                    applyCollapsed(collapsed);
                    localStorage.setItem(collapseKey, collapsed ? '1' : '0');
                };
                const updateMeta = () => {
                    title.textContent = tracks[currentIndex].title;
                    indexLabel.textContent = `${currentIndex + 1} / ${tracks.length}`;
                    setIcon();
                };
                const setTrack = (index, keepTime) => {
                    currentIndex = (index + tracks.length) % tracks.length;
                    audio.src = tracks[currentIndex].url;
                    audio.load();
                    updateMeta();
                    const seekTo = keepTime ? (state.currentTime || 0) : 0;
                    if (seekTo > 0) {
                        audio.addEventListener('loadedmetadata', () => {
                            audio.currentTime = Math.min(seekTo, Math.max(0, (audio.duration || seekTo)));
                        }, { once: true });
                    }
                };

                audio.volume = state.volume;
                volume.value = String(state.volume);
                setTrack(currentIndex, true);
                applyCollapsed(localStorage.getItem(collapseKey) === '1');
                if (state.isPlaying) audio.play().catch(() => updateMeta());

                toggle.addEventListener('click', () => { audio.paused ? audio.play().catch(()=>{}) : audio.pause(); updateMeta(); persistState(); });
                prev.addEventListener('click', () => { state.currentTime = 0; setTrack(currentIndex - 1, false); audio.play().catch(()=>{}); persistState(); });
                next.addEventListener('click', () => { state.currentTime = 0; setTrack(currentIndex + 1, false); audio.play().catch(()=>{}); persistState(); });
                volume.addEventListener('input', () => { audio.volume = Math.min(1, Math.max(0, Number(volume.value) || 0.5)); persistState(); });
                collapse.addEventListener('click', () => setCollapsed(!player.classList.contains('is-collapsed')));

                audio.addEventListener('play',  () => { setIcon(); persistState(); });
                audio.addEventListener('pause', () => { setIcon(); persistState(); });
                // timeupdate: throttled statt synchron — siehe persistStateThrottled.
                // play/pause/ended/beforeunload oben/unten bleiben synchron (seltene
                // Ereignisse, müssen aber zuverlässig landen, damit Resume klappt).
                audio.addEventListener('timeupdate', persistStateThrottled);
                audio.addEventListener('ended', () => { setTrack(currentIndex + 1, false); audio.play().catch(()=>{}); persistState(); });

                window.addEventListener('beforeunload', persistState);
            })();
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)

    @* ---------- KEYBOARD SHORTCUTS ---------- *@
    <div class="shortcut-overlay" id="shortcutOverlay" role="dialog" aria-modal="true" aria-labelledby="shortcutTitle">
        <div class="shortcut-overlay__card">
            <h3 id="shortcutTitle"><i class="bi bi-keyboard me-2"></i>Shortcuts</h3>
            <div class="shortcut-row"><span>Racing Hub</span><span class="shortcut-keys"><kbd>G</kbd><kbd>H</kbd></span></div>
            <div class="shortcut-row"><span>Results</span><span class="shortcut-keys"><kbd>G</kbd><kbd>R</kbd></span></div>
            <div class="shortcut-row"><span>Alle Rennen</span><span class="shortcut-keys"><kbd>G</kbd><kbd>A</kbd></span></div>
            <div class="shortcut-row"><span>Setups</span><span class="shortcut-keys"><kbd>G</kbd><kbd>S</kbd></span></div>
            <div class="shortcut-row"><span>Events</span><span class="shortcut-keys"><kbd>G</kbd><kbd>E</kbd></span></div>
            <div class="shortcut-row"><span>Bewerbung</span><span class="shortcut-keys"><kbd>G</kbd><kbd>B</kbd></span></div>
            <div class="shortcut-row"><span>Twitch</span><span class="shortcut-keys"><kbd>G</kbd><kbd>T</kbd></span></div>
            <div class="shortcut-row"><span>Diese Hilfe</span><span class="shortcut-keys"><kbd>?</kbd></span></div>
            <div class="shortcut-row"><span>Schließen</span><span class="shortcut-keys"><kbd>Esc</kbd></span></div>
        </div>
    </div>
    <script>
        (function () {
            const overlay = document.getElementById('shortcutOverlay');
            if (!overlay) return;
            const open = () => overlay.classList.add('is-open');
            const close = () => overlay.classList.remove('is-open');
            overlay.addEventListener('click', (e) => { if (e.target === overlay) close(); });

            const map = {
                h: '@Url.Action("Erdi10", "Stats")',
                r: '@Url.Action("Results", "Races")',
                a: '@Url.Action("AllRaces", "Races")',
                s: '@Url.Action("TrackSetups", "Setups")',
                e: '@Url.Action("Events", "Community")',
                b: '@Url.Action("Apply", "Application")',
                t: 'https://twitch.tv/erdi10'
            };
            let pendingG = false, gTimer = null;

            document.addEventListener('keydown', (e) => {
                const tag = (e.target && e.target.tagName) || '';
                if (/INPUT|TEXTAREA|SELECT/.test(tag) || e.target.isContentEditable) return;
                if (e.ctrlKey || e.metaKey || e.altKey) return;

                if (e.key === '?') { e.preventDefault(); overlay.classList.toggle('is-open'); return; }
                if (e.key === 'Escape') { close(); return; }

                if (pendingG) {
                    const k = e.key.toLowerCase();
                    if (map[k]) {
                        e.preventDefault();
                        if (k === 't') window.open(map[k], '_blank', 'noopener'); else window.location.href = map[k];
                    }
                    pendingG = false;
                    if (gTimer) clearTimeout(gTimer);
                    return;
                }
                if (e.key.toLowerCase() === 'g') {
                    pendingG = true;
                    gTimer = setTimeout(() => pendingG = false, 1200);
                }
            });
        })();
    </script>

    @* ---------- "!"-Badge am Setups-Navlink (localStorage = gelesen-Status) ---------- *@
    <script>
        (function () {
            const badge = document.getElementById('setupNewsBadge');
            if (!badge) return;
            const KEY = 'erc-setups-seen-at';
            const latest = badge.getAttribute('data-latest');
            if (!latest) return;
            try {
                const seen = localStorage.getItem(KEY);
                if (badge.getAttribute('data-on-setups') === 'true') {
                    // Besuch der Setup-Seite gilt als "gelesen" – Badge verschwindet überall.
                    // Max-Semantik: Das Setup-Intro (TrackSetups) schreibt ggf. einen frischeren
                    // Zeitstempel als der 30s-Layout-Cache liefert — nie zurückdrehen.
                    if (!seen || Date.parse(latest) > Date.parse(seen)) localStorage.setItem(KEY, latest);
                    return;
                }
                if (!seen || Date.parse(latest) > Date.parse(seen)) badge.hidden = false;
            } catch { /* localStorage blockiert (z. B. Private Mode) → Badge bleibt aus */ }
        })();
    </script>


    </body>
    </html>

















