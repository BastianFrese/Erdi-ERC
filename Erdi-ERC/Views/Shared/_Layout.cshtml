@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@inject Erdi_ERC.Services.ILayoutDataService _layoutDataService
@using Erdi_ERC.Helpers
@{
    // -------- Layout-Daten aus Memory-Cache (30s TTL) statt DB-Query pro Page-Load --------
    var _layoutData = await _layoutDataService.GetLayoutDataAsync(Context.RequestAborted);

    string? _winnerTeamKey = _layoutData.WinnerTeamKey;
    string _winnerCarPrimary = _layoutData.WinnerCarPrimary;
    string _winnerCarPrimaryLight = _layoutData.WinnerCarPrimaryLight;
    string _winnerCarPrimaryDark = _layoutData.WinnerCarPrimaryDark;
    string _winnerCarSecondary = _layoutData.WinnerCarSecondary;

    // View kann BodyClass explizit überschreiben (z. B. Pages mit Spezial-Theme).
    if (string.IsNullOrEmpty(ViewData["BodyClass"] as string) && _winnerTeamKey != null)
    {
        ViewData["BodyClass"] = $"team-{_winnerTeamKey}";
    }
    else if (!string.IsNullOrEmpty(ViewData["BodyClass"] as string))
    {
        var _bodyClass = ViewData["BodyClass"] as string ?? string.Empty;
        var _match = System.Text.RegularExpressions.Regex.Match(_bodyClass, @"team-([a-z0-9]+)");
        if (_match.Success)
        {
            var _overrideKey = _match.Groups[1].Value;
            if (!string.Equals(_overrideKey, _winnerTeamKey, StringComparison.OrdinalIgnoreCase))
            {
                // BodyClass-Override aktiv → Farben passend zur Override-Team-Klasse berechnen.
                var _teamInfo = F1TeamsHelper.Teams.FirstOrDefault(t =>
                    t.CssKey.Equals(_overrideKey, StringComparison.OrdinalIgnoreCase));
                if (_teamInfo != null)
                {
                    _winnerTeamKey = _overrideKey;
                    _winnerCarPrimary = $"";
                    _winnerCarSecondary = _teamInfo.SecondaryColor;
                    string Shade(string hex, double factor)
                    {
                        if (string.IsNullOrWhiteSpace(hex) || hex[0] != '#' || hex.Length != 7) return hex;
                        int r = Convert.ToInt32(hex.Substring(1, 2), 16);
                        int g = Convert.ToInt32(hex.Substring(3, 2), 16);
                        int b = Convert.ToInt32(hex.Substring(5, 2), 16);
                        int Adjust(int c) => Math.Max(0, Math.Min(255, (int)Math.Round(c + (factor >= 0 ? (255 - c) * factor : c * factor))));
                        return $"#{Adjust(r):X2}{Adjust(g):X2}{Adjust(b):X2}";
                    }
                    _winnerCarPrimaryLight = Shade(_teamInfo.PrimaryColor, 0.25);
                    _winnerCarPrimaryDark = Shade(_teamInfo.PrimaryColor, -0.55);
                }
            }
        }
    }

    var _activeStream = _layoutData.ActiveStream;
    ViewData["ActiveStream"] = _activeStream;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    string IsActive(string controller, params string[] actions)
    {
        if (!string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)) return "";
        if (actions.Length == 0) return "active";
        return actions.Any(a => string.Equals(currentAction, a, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
    }

    // "!"-Badge am Setups-Navlink: nur emittieren, wenn die letzte Setup-Aktivität
    // im News-Fenster liegt. Sichtbarkeit entscheidet der Client per localStorage
    // (Besuch der Setup-Seite = "gelesen", wie WhatsApp).
    var _latestSetupActivityIso = _layoutData.LatestSetupActivityUtc is DateTime _lsa
        && _lsa >= DateTime.UtcNow.AddDays(-Erdi_ERC.Models.SetupNewsGroup.WindowDays)
        ? _lsa.ToString("O")
        : null;
    var _isOnSetupsPage = IsActive("Setups", "TrackSetups") == "active";
}
<!DOCTYPE html>
<html lang="de" data-bs-theme="dark">
<head>
    @{
        var _ogTitle = (ViewData["OgTitle"] as string) ?? ($"{ViewData["Title"]} · Erdi's Racing Community");
        var _ogDescription = (ViewData["OgDescription"] as string)
            ?? "Erdi's Racing Community – Drei Ligen, ein Ziel. Lights out and away we go.";
        var _ogImagePath = (ViewData["OgImage"] as string) ?? "/images/ERCLogoHighRes1.png";
        var _ogUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
        var _ogImageAbs = _ogImagePath.StartsWith("http") ? _ogImagePath : $"{Context.Request.Scheme}://{Context.Request.Host}{_ogImagePath}";
    }
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#06070a" />
    <title>@ViewData["Title"] · Erdi's Racing Community</title>
    <meta name="description" content="@_ogDescription" />

    @* ---------- Open Graph / Twitter ---------- *@
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Erdi's Racing Community" />
    <meta property="og:title" content="@_ogTitle" />
    <meta property="og:description" content="@_ogDescription" />
    <meta property="og:url" content="@_ogUrl" />
    <meta property="og:image" content="@_ogImageAbs" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@_ogTitle" />
    <meta name="twitter:description" content="@_ogDescription" />
    <meta name="twitter:image" content="@_ogImageAbs" />

    @* ---------- PWA ---------- *@
    <link rel="manifest" href="~/site.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Erdi's Racing Community" />

    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16x16.png" asp-append-version="true" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" asp-append-version="true" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    @* Non-blocking: media="print" + onload Trick. Browser holt das CSS, parst es aber ohne Render-Block. Fallback <noscript> fuer User ohne JS. *@
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;600;700;800;900&family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;600;700;800;900&family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap"></noscript>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"></noscript>

    @* LCP-Preload: Hero-Logo wird auf Home als groesstes above-the-fold-Element angezeigt. *@
    <link rel="preload" as="image" href="~/images/ERCLogoHighRes1.png" fetchpriority="high">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @* site.bundled.css ist die Konkatenation aller CSS-Partials aus /css/site/ — 1 Request statt 13 @import-Roundtrips. Wird via MSBuild-Target bei jedem Build neu erzeugt. *@
    <link rel="stylesheet" href="~/css/site.bundled.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Erdi_ERC.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(ViewData["BodyClass"] as string ?? "") @(string.IsNullOrEmpty(_winnerTeamKey) ? "" : $"team-{_winnerTeamKey}")">

    @* ---------- RACE-START LIGHTS (initial loader, einmalig pro Session) ---------- *@
    <div class="race-lights" id="raceStartLights" role="status" aria-label="Race start lights">
        <div class="race-lights__bg" aria-hidden="true">
            <div class="race-lights__chequers"></div>
            <div class="race-lights__speedlines"></div>
            <div class="race-lights__scan"></div>
            <div class="race-lights__icons">
                <i class="bi bi-trophy-fill" style="--i:0"></i>
                <i class="bi bi-flag-fill" style="--i:1"></i>
                <i class="bi bi-lightning-charge-fill" style="--i:2"></i>
                <i class="bi bi-speedometer2" style="--i:3"></i>
                <i class="bi bi-stopwatch-fill" style="--i:4"></i>
                <i class="bi bi-fire" style="--i:5"></i>
                <i class="bi bi-tools" style="--i:6"></i>
                <i class="bi bi-gear-fill" style="--i:7"></i>
                <i class="bi bi-trophy-fill" style="--i:8"></i>
                <i class="bi bi-flag-fill" style="--i:9"></i>
                <i class="bi bi-lightning-charge-fill" style="--i:10"></i>
                <i class="bi bi-speedometer2" style="--i:11"></i>
            </div>
        </div>
        <div class="race-lights__rig" aria-hidden="true">
            <span class="race-lights__lamp" data-lamp="1"></span>
            <span class="race-lights__lamp" data-lamp="2"></span>
            <span class="race-lights__lamp" data-lamp="3"></span>
            <span class="race-lights__lamp" data-lamp="4"></span>
            <span class="race-lights__lamp" data-lamp="5"></span>
        </div>
        <div class="race-lights__car" aria-hidden="true">
            <svg viewBox="0 0 360 110" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
                <defs>
                    <linearGradient id="rlCarBody" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%"  stop-color="@_winnerCarPrimaryLight"/>
                        <stop offset="55%" stop-color="@_winnerCarPrimary"/>
                        <stop offset="100%" stop-color="@_winnerCarPrimaryDark"/>
                    </linearGradient>
                    <linearGradient id="rlCarShine" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%"  stop-color="rgba(255,255,255,.55)"/>
                        <stop offset="100%" stop-color="rgba(255,255,255,0)"/>
                    </linearGradient>
                    <radialGradient id="rlWheel" cx="50%" cy="50%" r="50%">
                        <stop offset="0%"  stop-color="#3a3a3a"/>
                        <stop offset="60%" stop-color="#111"/>
                        <stop offset="100%" stop-color="#000"/>
                    </radialGradient>
                    <linearGradient id="rlHalo" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%"  stop-color="#222"/>
                        <stop offset="100%" stop-color="#0a0a0a"/>
                    </linearGradient>
                </defs>

                <!-- ground shadow -->
                <ellipse cx="180" cy="98" rx="150" ry="6" fill="rgba(0,0,0,.55)"/>

                <!-- rear wing -->
                <rect x="20" y="38" width="14" height="34" rx="2" fill="#1a1a1a"/>
                <rect x="14" y="34" width="28" height="6"  rx="2" fill="#111"/>
                <rect x="14" y="68" width="28" height="4"  rx="1" fill="#111"/>

                <!-- floor / sidepod -->
                <path d="M30,78 L320,78 L330,72 L310,60 L70,60 L40,68 Z" fill="url(#rlCarBody)"/>
                <path d="M30,78 L320,78 L330,72 L310,60 L70,60 L40,68 Z" fill="url(#rlCarShine)" opacity=".35"/>

                <!-- engine cover / airbox -->
                <path d="M120,60 L210,60 L205,40 L150,38 L130,48 Z" fill="url(#rlCarBody)"/>
                <path d="M150,38 L205,40 L200,46 L155,44 Z" fill="rgba(255,255,255,.18)"/>
                <!-- airbox intake -->
                <path d="M170,38 L195,40 L190,30 L175,30 Z" fill="#0a0a0a"/>

                <!-- halo + cockpit -->
                <path d="M150,52 Q180,18 215,52" stroke="url(#rlHalo)" stroke-width="5" fill="none" stroke-linecap="round"/>
                <path d="M158,52 Q182,30 210,52" fill="#0d0d0d"/>
                <circle cx="184" cy="44" r="3.2" fill="#1a1a1a"/>

                <!-- nose -->
                <path d="M210,60 L320,72 L330,72 L320,60 Z" fill="url(#rlCarBody)"/>
                <path d="M210,60 L320,72 L320,66 L210,58 Z" fill="rgba(255,255,255,.22)"/>

                <!-- front wing -->
                <rect x="318" y="74" width="32" height="6"  rx="2" fill="#111"/>
                <rect x="322" y="68" width="24" height="4"  rx="1" fill="#1a1a1a"/>
                <rect x="328" y="62" width="14" height="4"  rx="1" fill="#1a1a1a"/>

                <!-- wheels -->
                <g class="race-lights__car-wheel race-lights__car-wheel--rear">
                    <circle cx="78" cy="80" r="18" fill="url(#rlWheel)"/>
                    <circle cx="78" cy="80" r="6"  fill="#333"/>
                    <line x1="78" y1="64" x2="78" y2="96" stroke="#444" stroke-width="1.5"/>
                    <line x1="62" y1="80" x2="94" y2="80" stroke="#444" stroke-width="1.5"/>
                </g>
                <g class="race-lights__car-wheel race-lights__car-wheel--front">
                    <circle cx="290" cy="80" r="18" fill="url(#rlWheel)"/>
                    <circle cx="290" cy="80" r="6"  fill="#333"/>
                    <line x1="290" y1="64" x2="290" y2="96" stroke="#444" stroke-width="1.5"/>
                    <line x1="274" y1="80" x2="306" y2="80" stroke="#444" stroke-width="1.5"/>
                </g>

                <!-- livery accent -->
                <path d="M70,72 L300,72 L300,76 L70,76 Z" fill="@_winnerCarSecondary" opacity=".55"/>
                <text x="80" y="74" font-family="Orbitron, sans-serif" font-size="7" font-weight="800" fill="#fff" opacity=".85">ERDI&#x27;S RACING COMMUNITY</text>
            </svg>
            <div class="race-lights__car-flame" aria-hidden="true"></div>
        </div>
        <div class="race-lights__label" id="raceStartLabel">Lights out…</div>
    </div>

    <div class="scroll-progress" id="scrollProgress" aria-hidden="true"></div>

    @* ---------- TOPBAR ---------- *@
