@model <OWNER_HANDLE>_ERC.Models.DriverDetailViewModel
@using <OWNER_HANDLE>_ERC.Helpers
@{
    ViewData["Title"] = $"Profil – {Model.Driver}";
    var profile = ViewBag.Profile as <OWNER_HANDLE>_ERC.Models.DriverProfile;
    var canEditEaName = ViewBag.CanEditEaName is bool ce && ce;
    var preferredPlatform = profile?.PreferredPlatform?.Trim() ?? "EA";
    var currentIngameTag = profile?.GamerTags?
        .FirstOrDefault(t => string.Equals(t.Platform, preferredPlatform, StringComparison.OrdinalIgnoreCase))?.GamerTag?.Trim()
        ?? profile?.GamerTags?.FirstOrDefault(t => t.IsPrimary)?.GamerTag?.Trim()
        ?? profile?.DisplayName?.Trim()
        ?? string.Empty;
    var wallMessages = (ViewBag.ProfileWall as List<<OWNER_HANDLE>_ERC.Models.ProfileWallMessage>) ?? new List<<OWNER_HANDLE>_ERC.Models.ProfileWallMessage>();

    var selectedTrackKey = RaceFlagHelper.ResolveTrack(profile?.FavoriteTrack)?.Key ?? string.Empty;
    var selectedTeamCssKey = profile?.FavoriteTeam ?? string.Empty;
    var profileFavTeam = F1TeamsHelper.GetTeamByName(profile?.FavoriteTeam);
    var profileHardware = SimHardwareHelper.Resolve(profile?.InputDevice);
    var currentInputDevice = profile?.InputDevice?.Trim() ?? string.Empty;
    var hwOptions = new[] { "Fanatec", "MOZA Racing", "Logitech G", "Thrustmaster", "Gamepad" };
    var currentNumberColor = ViewBag.NumberColor as string ?? "***REMOVED***e10600";

    var featured = DriverAchievementsHelper.GetFeatured(Model.Achievements);
    var totalRaces = Model.Races.Count;
    var finishedRaces = Model.Races.Count(r => r.Position > 0);
    var dnfRaces = Model.Races.Count(r => r.Position <= 0);
    var top10Races = Model.Races.Count(r => r.Position is >= 1 and <= 10);
    var winRate = finishedRaces > 0 ? (int)Math.Round(100.0 * Model.Wins / finishedRaces) : 0;
    var top10Rate = finishedRaces > 0 ? (int)Math.Round(100.0 * top10Races / finishedRaces) : 0;
    var reliability = totalRaces > 0 ? (int)Math.Round(100.0 * finishedRaces / totalRaces) : 0;
    var recentRaces = Model.Races.OrderByDescending(r => r.Date).Take(8).ToList();
    var unlocked = Model.Achievements.Where(a => a.IsUnlocked).ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/home-index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/results.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/driver-card.css" asp-append-version="true" />
    <style>
        .profile-card { background:var(--surface-1);border:1px solid var(--stroke-1);border-radius:var(--r-3);overflow:hidden;box-shadow:var(--sh-2); }
        .profile-card__head { padding:.85rem 1rem;border-bottom:1px solid var(--stroke-1);display:flex;align-items:center;gap:.5rem;font:700 .88rem/1 var(--ff-body);color:var(--ink);background:linear-gradient(180deg,rgba(255,255,255,.025),transparent); }
        .profile-card__body { padding:1.25rem; }
    </style>
}

<div class="f1-home-backdrop" aria-hidden="true"></div>

<partial name="_F1PageHero" model="@(new F1PageHeroVm {
    Eyebrow   = "Fahrer-Profil · ERC",
    Title     = Model.Driver,
})" />

@* Driver card visual (custom partial) *@
<div class="mb-2 reveal" id="driver-card-wrapper">
    <partial name="_DriverCard" model="Model" />
</div>
<div class="mb-4 d-flex gap-2">
    <button class="f1-btn f1-btn--ghost" id="btn-card-download" style="font-size:.82rem;padding:.35rem .9rem;" title="Karte als PNG-Datei herunterladen">
        <i class="f1-icon" data-lucide="download"></i> Karte speichern
    </button>
    <button class="f1-btn f1-btn--ghost" id="btn-card-copy" style="font-size:.82rem;padding:.35rem .9rem;" title="Karte als Bild in die Zwischenablage kopieren">
        <i class="f1-icon" data-lucide="copy"></i> Karte kopieren
    </button>
</div>

@* Bewerbungs-Status-Block entfernt - System wird greenfield-rebuilt. *@

@if (featured != null || profile is not null || totalRaces > 0)
{
    <div class="reveal mb-4 d-flex flex-wrap gap-3 align-items-center">
        @if (profile is not null)
        {
            <span class="text-mute" style="font-size:.88rem;">Discord: <strong style="color:var(--ink);">@profile.DiscordName</strong></span>
        }
        @if (featured != null)
        {
            <span class="featured-achievement achievement-chip--@featured.Tier" title="@featured.Title – @featured.Description">
                <i class="bi @featured.Icon"></i>
                <span class="featured-achievement__title">@featured.Title</span>
                <span class="achievement-chip__tier">@featured.Tier</span>
            </span>
        }
        @if (totalRaces > 0)
        {
            <span class="race-lights-pill" data-state="green">
                <span class="race-lights-pill__strip" aria-hidden="true">
                    <span class="race-lights-pill__lamp"></span><span class="race-lights-pill__lamp"></span><span class="race-lights-pill__lamp"></span><span class="race-lights-pill__lamp"></span><span class="race-lights-pill__lamp"></span>
                </span>
                Profile · Live Stats
            </span>
            <div class="lap-counter" title="Gefahrene Rennen"><span class="lap-counter__label">Races</span><span class="lap-counter__value">@totalRaces.ToString("00")</span></div>
            <div class="lap-counter" title="Top-10 Quote"><span class="lap-counter__label">Top 10</span><span class="lap-counter__value">@top10Rate%</span></div>
        }
    </div>
}

@if (TempData["ProfileMessage"] is string profileMessage && !string.IsNullOrWhiteSpace(profileMessage))
{
    <div class="alert alert-info reveal">@profileMessage</div>
}

<div class="f1-stat-grid reveal mb-4">
    <partial name="_F1StatTile" model="@(new F1StatTileVm { IconLucide = "trophy",     Label = "Siege",        Value = Model.Wins.ToString(),        Sub = $"{winRate}% Win-Rate" })" />
    <partial name="_F1StatTile" model="@(new F1StatTileVm { IconLucide = "medal",      Label = "Podien",       Value = Model.Podiums.ToString() })" />
    <partial name="_F1StatTile" model="@(new F1StatTileVm { IconLucide = "zap",        Label = "Fastest Laps", Value = Model.FastestLaps.ToString() })" />
    <partial name="_F1StatTile" model="@(new F1StatTileVm { IconLucide = "circle-dot", Label = "Punkte",       Value = Model.TotalPoints.ToString() })" />
</div>

<div class="row g-4 reveal">
    <div class="col-lg-4">

        <div class="profile-card">
            <div class="profile-card__head"><i class="bi bi-controller" style="color:var(--sig-cyan);"></i> Ingame-Name</div>
            <div class="profile-card__body d-flex flex-column gap-2">
                @{
                    var displayedName = profile?.DisplayName ?? profile?.GamerTags?.FirstOrDefault(t => t.IsPrimary)?.GamerTag;
                }
                @if (!string.IsNullOrWhiteSpace(displayedName))
                {
                    <div class="d-flex align-items-center justify-content-between surface-glass p-2">
                        <div>
                            <div class="text-mute small">@preferredPlatform</div>
                            <div class="fw-semibold">@displayedName</div>
                        </div>
                        <span class="status-pill is-green">Aktiv</span>
                    </div>
                }
                else
                {
                    <div class="text-mute">Noch kein Ingame-Name eingetragen.</div>
                }
            </div>
        </div>

        <div class="profile-card mt-4">
            <div class="profile-card__head"><i class="bi bi-stars" style="color:var(--text-amber,***REMOVED***f59e0b);"></i> Profil-Infos</div>
            <div class="profile-card__body d-flex flex-column gap-2">
                <div class="surface-glass p-2">
                    <div class="text-mute small">Lieblingsstrecke</div>
                    <div class="fw-semibold">@(string.IsNullOrWhiteSpace(profile?.FavoriteTrack) ? "-" : (F1RaceCatalog.FindTrack(profile!.FavoriteTrack)?.Name ?? profile!.FavoriteTrack))</div>
                </div>
                <div class="surface-glass p-2">
                    <div class="text-mute small">Lieblingsteam</div>
                    <div class="fw-semibold d-flex align-items-center gap-2">
                        @if (profileFavTeam is not null)
                        {
                            <img src="/images/teams/@(profileFavTeam.LogoKey).svg" @* alt="@profileFavTeam.Name" *@
                                 style="height:18px;width:auto;" onerror="this.style.display='none';" />
                            @* <span>@profileFavTeam.Name</span> *@
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </div>
                </div>
                <div class="surface-glass p-2">
                    <div class="text-mute small">Input / Hardware</div>
                    <div class="fw-semibold d-flex align-items-center gap-2">
                        @if (profileHardware is not null)
                        {
                            <img src="/images/logos/@(profileHardware.Key).svg" @* alt="@profileHardware.Name" *@
                                 style="height:15px;width:auto;opacity:.92;" onerror="this.style.display='none';" />
                        }
                        <span>@(string.IsNullOrWhiteSpace(profile?.InputDevice) ? "-" : profile!.InputDevice)</span>
                    </div>
                </div>
                <div class="surface-glass p-2">
                    <div class="text-mute small">Plattform</div>
                    <div class="fw-semibold">@(string.IsNullOrWhiteSpace(profile?.PreferredPlatform) ? "-" : profile!.PreferredPlatform)</div>
                </div>
                <div class="surface-glass p-2">
                    <div class="text-mute small">Nationalität / Flagge</div>
                    <div class="fw-semibold">@(string.IsNullOrWhiteSpace(profile?.Nationality) ? "-" : profile!.Nationality)</div>
                </div>
                <div class="surface-glass p-2">
                    <div class="text-mute small">Bio</div>
                    <div class="fw-semibold">@(string.IsNullOrWhiteSpace(profile?.Bio) ? "-" : profile!.Bio)</div>
                </div>
            </div>
        </div>

        @if (canEditEaName)
        {
            <div class="profile-card mt-4">
                <div class="profile-card__head"><i class="bi bi-image" style="color:var(--sig-cyan);"></i> Fahrer-Foto</div>
                <div class="profile-card__body d-flex flex-column gap-3">
                    <div class="text-mute small">Lade ein eigenes Foto für deine Fahrer-Karte hoch (optional). Max. 10&nbsp;MB – jpg, png, webp, gif oder avif.</div>
                    <form asp-action="UploadProfilePhoto" method="post" enctype="multipart/form-data" class="d-flex flex-column gap-2">
                        @Html.AntiForgeryToken()
                        <input class="form-control" type="file" name="photo" accept="image/png,image/jpeg,image/webp,image/gif,image/avif" required />
                        <button class="f1-btn f1-btn--ghost" type="submit">Foto hochladen</button>
                    </form>
                    @if (!string.IsNullOrWhiteSpace(profile?.PhotoUrl))
                    {
                        <form asp-action="RemoveProfilePhoto" method="post" onsubmit="return confirm('Profilbild wirklich entfernen?');">
                            @Html.AntiForgeryToken()
                            <button class="f1-btn f1-btn--ghost" type="submit" style="border-color:***REMOVED***ef4444;color:***REMOVED***ef4444;">Foto entfernen</button>
                        </form>
                    }
                </div>
            </div>

            <div class="profile-card mt-4" style="border-color:var(--text-amber,***REMOVED***f59e0b);">
                <div class="profile-card__head"><i class="bi bi-pencil-square" style="color:var(--text-amber,***REMOVED***f59e0b);"></i> Ingame-Namen ändern</div>
                <div class="profile-card__body d-flex flex-column gap-3">
                    <div class="text-mute small">Hier kannst du deinen Ingame-Namen (@preferredPlatform) selbst anpassen.</div>
                    <div class="surface-glass p-3" style="border-left:3px solid var(--text-amber,***REMOVED***f59e0b);font-size:.88rem;">
                        <strong>Wichtiger Hinweis:</strong> Bitte trage hier immer zu <strong>100% deinen echten und korrekten Ingame-Namen</strong> ein. Falsche Angaben führen zu falschen Zuordnungen im System.
                    </div>
                    <form asp-action="UpdateEaName" method="post" class="d-flex flex-column gap-2">
                        @Html.AntiForgeryToken()
                        <label class="form-label mb-0" for="eaName">Ingame-Name (@preferredPlatform)</label>
                        <input class="form-control" id="eaName" name="eaName" maxlength="128" value="@currentIngameTag" placeholder="Dein exakter Ingame-Name" required />
                        <div class="form-check mt-1">
                            <input class="form-check-input" type="checkbox" id="confirmEaNameAccuracy" name="confirmEaNameAccuracy" value="true" required />
                            <label class="form-check-label small" for="confirmEaNameAccuracy">
                                Ich bestätige, dass dieser Ingame-Name mein echter, vollständiger und aktueller Name ist.
                            </label>
                        </div>
                        <button class="f1-btn f1-btn--ghost" type="submit" style="border-color:var(--text-amber,***REMOVED***f59e0b);color:var(--text-amber,***REMOVED***f59e0b);">Ingame-Namen speichern</button>
                    </form>
                </div>
            </div>

            <div class="profile-card mt-4">
                <div class="profile-card__head"><i class="bi bi-person-lines-fill" style="color:var(--sig-cyan);"></i> Profil erweitern</div>
                <div class="profile-card__body">
                    <div class="text-mute small mb-3">Mehr Community-Infos für Teamseiten, Reservebörse und Profilansicht.</div>
                    <form asp-action="UpdateProfileMeta" method="post" class="row g-2">
                        @Html.AntiForgeryToken()
                        <div class="col-12">
                            <label class="form-label mb-0">Lieblingsstrecke</label>
                            <select class="form-select" name="favoriteTrack">
                                <option value="">– keine Angabe –</option>
                                @foreach (var track in F1RaceCatalog.Tracks)
                                {
                                    var trackFlag = RaceFlagHelper.ResolveCountry(track.Country) ?? "";
                                    var isSelected = string.Equals(selectedTrackKey, track.Key, StringComparison.OrdinalIgnoreCase);
                                    <option value="@track.Key" selected="@isSelected">@trackFlag @track.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label mb-0">Lieblingsteam</label>
                            <select class="form-select" name="favoriteTeam">
                                <option value="">– keine Angabe –</option>
                                @foreach (var t in F1TeamsHelper.Teams)
                                {
                                    var isTeamSel = string.Equals(selectedTeamCssKey, t.CssKey, StringComparison.OrdinalIgnoreCase);
                                    <option value="@t.CssKey" selected="@isTeamSel">@t.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label mb-0">Lenkrad / Pad</label>
                            <select class="form-select" name="inputDevice">
                                <option value="">– keine Angabe –</option>
                                @if (!string.IsNullOrEmpty(currentInputDevice) && !hwOptions.Any(o => string.Equals(o, currentInputDevice, StringComparison.OrdinalIgnoreCase)))
                                {
                                    <option value="@currentInputDevice" selected>@currentInputDevice</option>
                                }
                                @foreach (var o in hwOptions)
                                {
                                    var hwSel = string.Equals(o, currentInputDevice, StringComparison.OrdinalIgnoreCase);
                                    <option value="@o" selected="@hwSel">@o</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label mb-0">Plattform</label>
                            <input class="form-control" name="preferredPlatform" maxlength="64" value="@profile?.PreferredPlatform" placeholder="z. B. Steam, EA, Xbox …" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label mb-0">Nationalität / Flagge</label>
                            <select class="form-select" name="nationality">
                                <option value="">– keine Angabe –</option>
                                @if (!string.IsNullOrWhiteSpace(profile?.Nationality) && !RaceFlagHelper.Countries.Any(c => string.Equals(c, profile.Nationality, StringComparison.OrdinalIgnoreCase)))
                                {
                                    <option value="@profile.Nationality" selected>@profile.Nationality</option>
                                }
                                @foreach (var c in RaceFlagHelper.Countries)
                                {
                                    var isSel = string.Equals(c, profile?.Nationality, StringComparison.OrdinalIgnoreCase);
                                    <option value="@c" selected="@isSel">@RaceFlagHelper.ResolveCountry(c) @c</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label mb-0">Alter</label>
                            <input class="form-control" type="number" name="age" min="14" max="99" value="@(profile?.Age)" placeholder="z.B. 24" />
                        </div>
                        <div class="col-12">
                            <label class="form-label mb-0">Kurze Bio</label>
                            <textarea class="form-control" name="bio" rows="3" maxlength="512" placeholder="Kurz etwas über dich, deinen Fahrstil oder deine Ziele...">@profile?.Bio</textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label mb-0">Farbe der Fahrernummer</label>
                            <div class="d-flex align-items-center gap-2">
                                <input class="form-control form-control-color" type="color" name="driverNumberColor" value="@currentNumberColor" title="Farbe der Fahrernummer auf der Karte" />
                                <span class="text-mute small">Default: Team-Farbe</span>
                            </div>
                        </div>
                        <div class="col-12 d-grid">
                            <button class="f1-btn f1-btn--ghost" type="submit">Profil-Infos speichern</button>
                        </div>
                    </form>
                </div>
            </div>
        }

        @if (totalRaces > 0)
        {
            <div class="profile-card mt-4">
                <div class="profile-card__head"><i class="bi bi-shield-check" style="color:var(--sig-cyan);"></i> Konstanz</div>
                <div class="profile-card__body">
                    <div class="small text-mute mb-1">Reliability</div>
                    <div class="progress mb-2" style="height:10px;">
                        <div class="progress-bar js-reliability-bar" role="progressbar" style="width:0;transition:width .9s cubic-bezier(.22,.61,.36,1);" data-target-width="@reliability" aria-valuenow="@reliability" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <div class="text-mono small">@finishedRaces Finishes · @dnfRaces DNF/DNS · @reliability%</div>
                </div>
            </div>
        }

    </div>

    <div class="col-lg-8">

        @if (totalRaces > 0)
        {
            <div class="profile-card mb-4">
                <div class="profile-card__head">
                    <i class="bi bi-activity" style="color:var(--sig-cyan);"></i> Formkurve (letzte @recentRaces.Count Rennen)
                    <span class="ms-auto text-mute" style="font-weight:400;font-size:.78rem;">Neueste zuerst</span>
                </div>
                <div class="profile-card__body">
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var rr in recentRaces)
                        {
                            var cls = rr.Position == 1 ? "bg-warning text-dark" : rr.Position == 2 ? "bg-light text-dark" : rr.Position == 3 ? "bg-secondary" : rr.Position is >= 4 and <= 10 ? "bg-info text-dark" : "bg-danger";
                            var label = rr.Position > 0 ? $"P{rr.Position}" : "DNF";
                            var pulseCls = rr.Position == 1 ? " js-form-chip--p1" : "";
                            <span class="badge @cls js-form-chip@pulseCls" title="@rr.Track · @rr.Date.ToString("dd.MM.yyyy")">@label</span>
                        }
                    </div>
                </div>
            </div>
        }

        <div class="profile-card mb-4">
            <div class="profile-card__head"><i class="bi bi-trophy" style="color:var(--text-amber,***REMOVED***f59e0b);"></i> Achievements</div>
            <div class="profile-card__body">
                @if (unlocked.Any())
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var a in unlocked)
                        {
                            <span class="badge bg-secondary p-2" title="@a.Description"><i class="bi @a.Icon me-1"></i>@a.Title</span>
                        }
                    </div>
                }
                else
                {
                    <div class="text-mute">Noch keine Achievements freigeschaltet.</div>
                }
            </div>
        </div>

        <div class="profile-card mb-4">
            <div class="profile-card__head">
                <i class="bi bi-chat-left-text" style="color:var(--sig-cyan);"></i> Community Wall
                <span class="ms-auto text-mute" style="font-weight:400;font-size:.78rem;">Kurze Kommentare &amp; Rivalry-Talk</span>
            </div>
            <div class="profile-card__body">
                @if (User.Identity?.IsAuthenticated == true && profile is not null)
                {
                    <form asp-action="AddWallMessage" method="post" class="d-flex flex-column gap-2 mb-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="profileDiscordId" value="@profile.DiscordId" />
                        <textarea class="form-control" name="message" rows="3" maxlength="600" placeholder="Schreib eine kurze öffentliche Nachricht an diesen Fahrer..." required></textarea>
                        <div class="d-flex justify-content-end">
                            <button class="f1-btn f1-btn--ghost"type="submit" style="font-size:.85rem;padding:.4rem 1rem;">Nachricht posten</button>
                        </div>
                    </form>
                }

                @if (wallMessages.Any())
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var entry in wallMessages)
                        {
                            <div class="surface-glass p-3" style="border-radius:var(--r-2);">
                                <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-1">
                                    <strong>@entry.AuthorName</strong>
                                    <span class="text-mute small">@entry.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                                </div>
                                <div style="white-space:pre-wrap;">@entry.Message</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-mute">Noch keine Wall-Nachrichten vorhanden.</div>
                }
            </div>
        </div>

        <div class="profile-card">
            <div class="profile-card__head"><i class="bi bi-flag" style="color:var(--sig-cyan);"></i> Renn-Historie</div>
            <div class="profile-card__body p-0">
                @if (Model.Races.Any())
                {
                    <div class="f1-results-card" style="box-shadow:none;border:none;border-radius:0;">
                        <div class="f1-results-card__telemetry" aria-hidden="true"></div>
                        <div class="table-responsive">
                            <table class="f1-results-table profile-race-table">
                                <thead>
                                    <tr>
                                        <th>Datum</th>
                                        <th>Strecke</th>
                                        <th class="is-center">Pos.</th>
                                        <th class="is-center">FL</th>
                                        <th>Reserve für</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in Model.Races)
                                    {
                                        var hasLink = r.RaceId > 0 && !string.IsNullOrWhiteSpace(r.LeagueId);
                                        var url = hasLink ? Url.Action("RaceDetail", "Races", new { leagueId = r.LeagueId, raceId = r.RaceId }) : null;
                                        <tr class="@(hasLink ? "race-row" : null)"
                                            data-href="@(hasLink ? url : null)"
                                            role="@(hasLink ? "button" : null)"
                                            style="@(hasLink ? "cursor:pointer" : null)"
                                            title="@(hasLink ? "Renndetails öffnen" : null)">
                                            <td class="text-mono" style="font-size:.8rem;color:var(--ink-3);">
                                                @if (hasLink)
                                                {
                                                    <a class="text-decoration-none" style="color:var(--sig-cyan);" href="@url">@r.Date.ToString("dd.MM.yyyy")</a>
                                                }
                                                else
                                                {
                                                    @r.Date.ToString("dd.MM.yyyy")
                                                }
                                            </td>
                                            <td>@r.Track</td>
                                            <td class="is-center">
@if (r.Position > 0)
{
    <span class="driver-tile__pos @(r.Position == 1 ? "is-1" : r.Position == 2 ? "is-2" : r.Position == 3 ? "is-3" : "")">@($"P{r.Position}")</span>
}
else
{
    <span class="status-pill" style="background:rgba(239,68,68,.15);color:***REMOVED***ef4444;">@(r.Position == 0 ? "DNF" : "DNS")</span>
}
</td>
                                            <td class="text-tech is-center" style="color:var(--sig-purple,***REMOVED***a855f7);">@(r.FastestLap ? "★" : "")</td>
                                            <td style="font-size:.82rem;color:var(--ink-2);">@(r.WasReserve ? r.ReserveForDriver : "")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-mute p-4">Noch keine Rennen gefahren.</div>
                }
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const driverName = @Json.Serialize(Model.Driver ?? "fahrerkarte");

            const loadLib = () => new Promise((resolve, reject) => {
                if (window.htmlToImage) { resolve(window.htmlToImage); return; }
                const s = document.createElement('script');
                s.src = 'https://cdn.jsdelivr.net/npm/html-to-image@1.11.11/dist/html-to-image.js';
                s.onload = () => resolve(window.htmlToImage);
                s.onerror = () => reject(new Error('Bild-Bibliothek konnte nicht geladen werden.'));
                document.head.appendChild(s);
            });

            // 1×1 transparentes PNG — Ersatz für Bilder, die nicht geladen werden konnten
            // (z. B. fehlende Flaggen-SVGs). html-to-image bricht bei 404 sonst mit
            // „Resource not found" den kompletten Render ab, statt auf den Code-Fallback zu fallen.
            const PLACEHOLDER_PNG = 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+M8AAAMBAQDJ/pLvAAAAAElFTkSuQmCC';

            const blobToDataURL = (blob) => new Promise((resolve, reject) => {
                const r = new FileReader();
                r.onload = () => resolve(r.result);
                r.onerror = () => reject(new Error('Bild konnte nicht gelesen werden.'));
                r.readAsDataURL(blob);
            });

            // Alle <img> der Karte vorab holen und als Data-URL inline setzen. Bilder, die
            // nicht existieren (404) oder nicht geladen werden können, bekommen einen
            // transparenten Platzhalter + visibility:hidden — so geraten sie nicht in den
            // html-to-image-Fetch, der 404s hart werden lässt. Gibt die gemerkten Zustände
            // zurück, damit sie nach dem Render wiederhergestellt werden können.
            const inlineImages = async (root) => {
                const touched = [];
                const imgs = Array.from(root.querySelectorAll('img'));
                await Promise.all(imgs.map(async (img) => {
                    const src = img.getAttribute('src') || '';
                    if (!src || src.startsWith('data:')) return;
                    touched.push({ img, src });
                    try {
                        const res = await fetch(src, { credentials: 'same-origin' });
                        if (!res.ok) throw new Error(res.status);
                        const dataUrl = await blobToDataURL(await res.blob());
                        img.setAttribute('src', dataUrl);
                    } catch {
                        img.setAttribute('src', PLACEHOLDER_PNG);
                        img.style.visibility = 'hidden';
                    }
                }));
                return touched;
            };

            const restoreImages = (touched) => {
                touched.forEach(({ img, src }) => {
                    img.setAttribute('src', src);
                    img.style.visibility = '';
                });
            };

            const captureCard = async (btn) => {
                const card = document.querySelector('.erc-card');
                if (!card) { alert('Karte nicht gefunden.'); return null; }
                const origHtml = btn.innerHTML;
                btn.disabled = true;
                btn.textContent = 'Wird gerendert…';
                let touched = [];
                try {
                    touched = await inlineImages(card);
                    const lib = await loadLib();
                    const dataUrl = await lib.toPng(card, { pixelRatio: 2, cacheBust: false, imagePlaceholder: PLACEHOLDER_PNG });
                    return dataUrl;
                } catch (err) {
                    alert('Fehler beim Rendern: ' + err.message);
                    return null;
                } finally {
                    restoreImages(touched);
                    btn.disabled = false;
                    btn.innerHTML = origHtml;
                }
            };

            document.getElementById('btn-card-download')?.addEventListener('click', async function () {
                const dataUrl = await captureCard(this);
                if (!dataUrl) return;
                const a = document.createElement('a');
                a.download = `erc-${driverName.toLowerCase().replace(/\s+/g, '-')}.png`;
                a.href = dataUrl;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
            });

            document.getElementById('btn-card-copy')?.addEventListener('click', async function () {
                const dataUrl = await captureCard(this);
                if (!dataUrl) return;
                try {
                    const res = await fetch(dataUrl);
                    const blob = await res.blob();
                    await navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })]);
                    const origHtml = this.innerHTML;
                    this.textContent = 'Kopiert!';
                    setTimeout(() => { this.innerHTML = origHtml; }, 1800);
                } catch {
                    alert('Clipboard-Zugriff nicht möglich. Bitte "Karte speichern" verwenden.');
                }
            });
        })();
    </script>
    <script>
        document.querySelectorAll('.profile-race-table tr.race-row').forEach(function (row) {
            row.addEventListener('click', function (ev) {
                if (ev.target.closest('a')) return;
                var href = row.getAttribute('data-href');
                if (href) window.location.href = href;
            });
        });

        (function () {
            const formChips = Array.from(document.querySelectorAll('.js-form-chip'));
            formChips.forEach((chip, i) => {
                chip.style.opacity = '0';
                chip.style.transform = 'translateY(6px) scale(.98)';
                chip.style.transition = 'opacity .28s ease, transform .35s cubic-bezier(.22,.61,.36,1), box-shadow .35s ease';
                setTimeout(() => {
                    chip.style.opacity = '1';
                    chip.style.transform = 'translateY(0) scale(1)';
                }, 80 + (i * 55));
            });

            const p1Chips = Array.from(document.querySelectorAll('.js-form-chip--p1'));
            if (p1Chips.length > 0) {
                setTimeout(() => {
                    p1Chips.forEach((chip, i) => {
                        setTimeout(() => {
                            chip.animate([
                                { transform: 'translateY(0) scale(1)', boxShadow: '0 0 0 rgba(255, 193, 7, 0)' },
                                { transform: 'translateY(-1px) scale(1.04)', boxShadow: '0 0 14px rgba(255, 193, 7, .55)' },
                                { transform: 'translateY(0) scale(1)', boxShadow: '0 0 0 rgba(255, 193, 7, 0)' }
                            ], {
                                duration: 1350,
                                easing: 'cubic-bezier(.22,.61,.36,1)',
                                iterations: 2,
                                delay: i * 120
                            });
                        }, i * 70);
                    });
                }, 520);
            }

            const bar = document.querySelector('.js-reliability-bar');
            if (!bar) return;
            const target = parseInt(bar.getAttribute('data-target-width') || '0', 10);

            const animate = () => {
                requestAnimationFrame(() => {
                    bar.style.width = Math.max(0, Math.min(100, target)) + '%';
                });
            };

            if ('IntersectionObserver' in window) {
                const io = new IntersectionObserver((entries, obs) => {
                    entries.forEach(e => {
                        if (e.isIntersecting) {
                            animate();
                            obs.disconnect();
                        }
                    });
                }, { threshold: .35 });
                io.observe(bar);
            } else {
                animate();
            }
        })();
    </script>
}
