@model Erdi_ERC.Models.Troll.TrollGateViewModel
@*
    Kategorie „Mathe & Köpfchen" – Pflicht-Gags (serverseitig via Solve validiert).
    Neuer Gag dieser Kategorie = hier ein weiterer case + Registry-Eintrag in TrollService.
    Das „Erdi schüttelt den Kopf"-/Gnaden-Feedback rendert zentral Gate.cshtml.
*@
@switch (Model.Gag.Key)
{
    case "math":
        <div class="troll-gag troll-gag--math">
            <div class="troll-eyebrow">Erdi · Mathe-Kontrolle</div>
            <h2 class="troll-title">Erdi hat sich gedacht,<br>du löst erst mal eine Mathe-Aufgabe.</h2>
            <p class="troll-lead">Kleine Kopfrechen-Schikane. Erdi wartet.</p>

            <div class="troll-math__problem">@Model.Prompt =<span class="troll-math__q">?</span></div>

            <form asp-controller="Troll" asp-action="Solve" method="post" class="troll-form" autocomplete="off">
                <input type="number" name="answer" class="troll-input" inputmode="numeric"
                       placeholder="Dein Ergebnis" required autofocus aria-label="Ergebnis der Aufgabe" />
                <button type="submit" class="f1-btn f1-btn--primary">Antwort abschicken</button>
            </form>
        </div>
        break;

    case "best-driver":
        <div class="troll-gag troll-gag--quiz">
            <div class="troll-eyebrow">Erdi · Allgemeinbildung</div>
            <h2 class="troll-title">Erdi fragt:<br>Wer ist der <em>beste</em> Fahrer?</h2>
            <p class="troll-lead">Überleg gut. Es gibt nur eine richtige Antwort.</p>

            <form asp-controller="Troll" asp-action="Solve" method="post" class="troll-choices">
                @foreach (var name in new[] { "Max Verstappen", "Erdi", "Du", "Lewis Hamilton" })
                {
                    <button type="submit" name="answer" value="@name" class="troll-choice">@name</button>
                }
            </form>
        </div>
        break;

    case "f1-trivia":
    {
        // Optionen aus der statischen Bank anhand des gespeicherten Fragetexts (Model.Prompt) rekonstruieren.
        var question = Erdi_ERC.Models.Troll.TrollTrivia.ByQuestion(Model.Prompt);
        var options = question?.Options ?? new[] { "Italien", "Erdi", "25", "4" };
        <div class="troll-gag troll-gag--quiz">
            <div class="troll-eyebrow">Erdi · F1-Wissen</div>
            <h2 class="troll-title">Erdi macht den Wissens-Check.</h2>
            <p class="troll-lead">@(question?.Question ?? "Beantworte Erdis Frage.")</p>

            <form asp-controller="Troll" asp-action="Solve" method="post" class="troll-choices">
                @foreach (var opt in options)
                {
                    <button type="submit" name="answer" value="@opt" class="troll-choice">@opt</button>
                }
            </form>
        </div>
        break;
    }

    case "sequence":
        <div class="troll-gag troll-gag--math">
            <div class="troll-eyebrow">Erdi · Zahlengefühl</div>
            <h2 class="troll-title">Erdi prüft, ob du zählen kannst.</h2>
            <p class="troll-lead">Setze die Zahlenfolge fort. Welche Zahl kommt als Nächstes?</p>

            <div class="troll-math__problem">@Model.Prompt,<span class="troll-math__q">?</span></div>

            <form asp-controller="Troll" asp-action="Solve" method="post" class="troll-form" autocomplete="off">
                <input type="number" name="answer" class="troll-input" inputmode="numeric"
                       placeholder="Nächste Zahl" required autofocus aria-label="Nächste Zahl der Folge" />
                <button type="submit" class="f1-btn f1-btn--primary">Antwort abschicken</button>
            </form>
        </div>
        break;

    case "oath-type":
        <div class="troll-gag">
            <div class="troll-eyebrow">Erdi · Treueschwur</div>
            <h2 class="troll-title">Tippe den Schwur. <em>Exakt.</em></h2>
            <p class="troll-lead">Wort für Wort abschreiben. Erdi liest mit.</p>

            <p class="troll-oath">„@Model.Prompt"</p>

            <form asp-controller="Troll" asp-action="Solve" method="post" class="troll-form" autocomplete="off">
                <input type="text" name="answer" class="troll-input troll-input--wide"
                       placeholder="Hier exakt abtippen" required autofocus aria-label="Schwur abtippen" />
                <button type="submit" class="f1-btn f1-btn--primary">Schwören</button>
            </form>
        </div>
        break;
}
