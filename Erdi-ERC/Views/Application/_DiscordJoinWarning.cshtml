@model Erdi_ERC.ViewModels.DiscordJoinWarningViewModel
@{
    var missing = new List<string>();
    if (!Model.JoinedCommunity) missing.Add("Community");
    if (!Model.JoinedLeague) missing.Add("Liga");
}
<div class="f1-panel app-discord-warn">
    <div class="app-discord-warn__icon"><i class="bi bi-discord"></i></div>
    <div class="app-discord-warn__body">
        <strong>Hinweis: Discord-Beitritt</strong>
        <p>
            Laut deinem Login bist du noch nicht im @(string.Join(" und ", missing))-Discord.
            <strong>Du musst nichts weiter tun:</strong> sobald du die Bewerbung absendest,
            holt dich unser Bot automatisch in die fehlenden Server.
        </p>
        <p>
            Klappt das nicht, kannst du auch direkt beitreten:
        </p>
        <ul class="app-discord-warn__links">
            @if (!Model.JoinedCommunity && !string.IsNullOrWhiteSpace(Model.CommunityInviteUrl))
            {
                <li><a class="btn btn-sm btn-outline-primary" href="@Model.CommunityInviteUrl" target="_blank" rel="noopener">
                    <i class="bi bi-discord"></i> Community-Discord beitreten
                </a></li>
            }
            @if (!Model.JoinedLeague && !string.IsNullOrWhiteSpace(Model.LeagueInviteUrl))
            {
                <li><a class="btn btn-sm btn-outline-primary" href="@Model.LeagueInviteUrl" target="_blank" rel="noopener">
                    <i class="bi bi-discord"></i> Liga-Discord beitreten
                </a></li>
            }
        </ul>
        <small>Der automatische Beitritt funktioniert nur mit deiner aktuellen Discord-Anmeldung. Wir kontaktieren dich zusätzlich per Discord-Nachricht.</small>
    </div>
</div>
