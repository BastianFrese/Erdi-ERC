@model <OWNER_HANDLE>_ERC.Controllers.MyApplicationsViewModel
@using <OWNER_HANDLE>_ERC.Models
@{
    ViewData["Title"] = "Meine Bewerbungen";

    string StatusChip(int s) => ((ApplicationStatus)s) switch
    {
        ApplicationStatus.Pending   => "f1-chip f1-chip--amber",
        ApplicationStatus.Accepted  => "f1-chip f1-chip--green",
        ApplicationStatus.Rejected  => "f1-chip f1-chip--red",
        _                          => "f1-chip"
    };

    string StatusLabel(int s) => ((ApplicationStatus)s) switch
    {
        ApplicationStatus.Pending   => "In Prüfung",
        ApplicationStatus.Accepted  => "Angenommen",
        ApplicationStatus.Rejected  => "Abgelehnt",
        _                          => s.ToString()
    };

    var message = TempData["MyApplicationMessage"] as string;
    var hasAnything = Model.Applications.Count > 0 || Model.WaitlistEntries.Count > 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/applications.css" asp-append-version="true" />
}

<div class="app-page">
    <div class="app-hero">
        <div class="app-hero__icon"><i class="bi bi-list-ul"></i></div>
        <div class="app-hero__title">
            <h1>Meine Bewerbungen</h1>
            <p>Alle Bewerbungen und Wartelisten-Plätze, die du über Discord eingereicht hast.</p>
        </div>
        <div class="app-hero__action">
            <a class="btn btn-primary" asp-controller="Application" asp-action="Apply">
                <i class="bi bi-plus-lg"></i> Neue Bewerbung
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="app-flash" role="status">
            <i class="bi bi-info-circle-fill"></i> @message
        </div>
    }

    @if (!hasAnything)
    {
        <div class="f1-panel app-empty">
            <i class="bi bi-inbox"></i>
            <p>Du hast noch keine Bewerbung eingereicht.</p>
            <a class="btn btn-primary mt-3" asp-controller="Application" asp-action="Apply">
                <i class="bi bi-send"></i> Jetzt bewerben
            </a>
        </div>
    }
    else
    {
        <div class="app-card-stack">
            @foreach (var app in Model.Applications)
            {
                var isPending = app.Status == (int)ApplicationStatus.Pending;
                <div class="f1-panel app-card">
                    <div class="app-card__head">
                        <span class="app-card__league">@(app.TargetLeague?.Name ?? app.TargetLeagueId)</span>
                        <span class="@StatusChip(app.Status)">@StatusLabel(app.Status)</span>
                    </div>
                    <div class="app-card__meta">
                        <span><i class="bi bi-person-badge"></i> @app.Role</span>
                        <span><i class="bi bi-controller"></i> @app.GamerTag · @app.Platform</span>
                        <span><i class="bi bi-calendar-plus"></i> Eingereicht @app.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                        @if (app.DecidedAt is not null)
                        {
                            <span><i class="bi bi-calendar-check"></i> Entschieden @app.DecidedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(app.ReviewNote))
                    {
                        <div class="app-review-note">
                            <span class="app-review-note__label"><i class="bi bi-chat-left-text"></i> Notiz vom Team</span>
                            <blockquote>@app.ReviewNote</blockquote>
                        </div>
                    }
                    @if (isPending)
                    {
                        <div class="app-card__actions">
                            <form asp-controller="Application" asp-action="Withdraw" method="post"
                                  onsubmit="return confirm('Bewerbung wirklich zurückziehen? Das kann nicht rückgängig gemacht werden.');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@app.Id" />
                                <button type="submit" class="btn btn-ghost btn-sm app-btn-danger">
                                    <i class="bi bi-arrow-counterclockwise"></i> Bewerbung zurückziehen
                                </button>
                            </form>
                        </div>
                    }
                </div>
            }
        </div>

        @if (Model.WaitlistEntries.Count > 0)
        {
            <h2 class="app-section-title"><i class="bi bi-hourglass-split"></i> Warteliste</h2>
            <div class="app-card-stack">
                @foreach (var entry in Model.WaitlistEntries)
                {
                    <div class="f1-panel app-card app-card--waitlist">
                        <div class="app-waitlist-pos" aria-hidden="true">@entry.Position</div>
                        <div class="app-card__body">
                            <div class="app-card__head">
                                <span class="app-card__league">@(entry.League?.Name ?? entry.LeagueId)</span>
                                <span class="f1-chip f1-chip--amber">Position @entry.Position</span>
                            </div>
                            <div class="app-card__meta">
                                <span><i class="bi bi-controller"></i> @entry.GamerTag · @entry.Platform</span>
                                <span><i class="bi bi-calendar-plus"></i> Eingetragen @entry.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                            </div>
                            <p class="app-card__hint">Du rückst automatisch nach, sobald ein Stammfahrer-Platz frei wird und das Team dich promotet.</p>
                            <div class="app-card__actions">
                                <form asp-controller="Application" asp-action="LeaveWaitlist" method="post"
                                      onsubmit="return confirm('Warteliste wirklich verlassen? Dein Platz geht verloren.');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@entry.Id" />
                                    <button type="submit" class="btn btn-ghost btn-sm app-btn-danger">
                                        <i class="bi bi-box-arrow-right"></i> Warteliste verlassen
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>
