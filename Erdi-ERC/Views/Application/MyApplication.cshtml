@model System.Collections.Generic.List<<OWNER_HANDLE>_ERC.Models.Application>
@using <OWNER_HANDLE>_ERC.Models
@{
    ViewData["Title"] = "Meine Bewerbungen";

    string StatusBadge(int s) => ((ApplicationStatus)s) switch
    {
        ApplicationStatus.Pending   => "f1-chip f1-chip--amber",
        ApplicationStatus.Accepted  => "f1-chip f1-chip--green",
        ApplicationStatus.Rejected  => "f1-chip f1-chip--red",
        _                          => "f1-chip"
    };

    string StatusLabel(int s) => ((ApplicationStatus)s) switch
    {
        ApplicationStatus.Pending   => "In Prüfung",
        ApplicationStatus.Accepted  => "Angenommen",
        ApplicationStatus.Rejected  => "Abgelehnt",
        _                          => s.ToString()
    };
}

<div class="myapply-page">
    <div class="myapply-hero f1-panel">
        <div class="myapply-hero__icon"><i class="bi bi-list-ul"></i></div>
        <div class="myapply-hero__title">
            <h1 class="m-0">Meine Bewerbungen</h1>
            <p class="m-0 text-mute">Alle Bewerbungen, die du über Discord eingereicht hast.</p>
        </div>
        <div class="myapply-hero__action">
            <a class="btn btn-primary" asp-controller="Application" asp-action="Apply">
                <i class="bi bi-plus-lg"></i> Neue Bewerbung
            </a>
        </div>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="f1-panel myapply-empty">
            <i class="bi bi-inbox"></i>
            <p>Du hast noch keine Bewerbung eingereicht.</p>
            <a class="btn btn-primary mt-3" asp-controller="Application" asp-action="Apply">
                <i class="bi bi-send"></i> Jetzt bewerben
            </a>
        </div>
    }
    else
    {
        <div class="myapply-list f1-panel">
            <table class="myapply-table">
                <thead>
                    <tr>
                        <th>Liga</th>
                        <th>Rolle</th>
                        <th>Gamer-Tag</th>
                        <th>Plattform</th>
                        <th>Eingereicht</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var app in Model.OrderByDescending(a => a.CreatedAt))
                    {
                        <tr>
                            <td>
                                <strong>@(app.TargetLeague?.Name ?? app.TargetLeagueId)</strong>
                            </td>
                            <td>@app.Role</td>
                            <td>@app.GamerTag</td>
                            <td>@app.Platform</td>
                            <td>@app.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                <span class="@StatusBadge(app.Status)">@StatusLabel(app.Status)</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>