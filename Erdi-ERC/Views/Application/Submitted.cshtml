@{
    ViewData["Title"] = "Bewerbung eingereicht";
    var outcome = TempData["SubmitResultType"] as string;
    var waitlistPos = TempData["WaitlistPosition"] as string;
    var discordWarn = (TempData["DiscordWarn"] as string) == "true";
    var discordWarnDetail = TempData["DiscordWarnDetail"] as string;

    string iconClass, iconStyle, iconName, title, body;
    switch (outcome)
    {
        case "Waitlisted":
            iconClass = "app-submit-card__icon--wait";
            iconStyle = "color:***REMOVED***ffb800;";
            iconName = "bi-hourglass-split";
            title = "Auf der Warteliste";
            body = $"Die Liga ist aktuell voll. Du bist auf der Warteliste auf Position <strong>***REMOVED***{waitlistPos}</strong>. Wir melden uns, sobald ein Platz frei wird.";
            break;
        case "AlreadyPending":
            iconClass = "app-submit-card__icon--info";
            iconStyle = "color:***REMOVED***5b8cff;";
            iconName = "bi-info-circle-fill";
            title = "Bereits eingereicht";
            body = "Du hast bereits eine offene Bewerbung für diese Liga. Schau in deiner Übersicht nach dem aktuellen Status.";
            break;
        case "AlreadyWaitlisted":
            iconClass = "app-submit-card__icon--info";
            iconStyle = "color:***REMOVED***5b8cff;";
            iconName = "bi-info-circle-fill";
            title = "Bereits auf der Warteliste";
            body = "Du stehst für diese Liga bereits auf der Warteliste. Wir melden uns, sobald ein Platz frei wird.";
            break;
        default:
            iconClass = "app-submit-card__icon--send";
            iconStyle = "color:***REMOVED***22d3ee;";
            iconName = "bi-send-check-fill";
            title = "Bewerbung eingereicht";
            body = "Vielen Dank! Wir prüfen deine Bewerbung und melden uns per Discord.";
            break;
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/applications.css" asp-append-version="true" />
}

<div class="app-page">
    <div class="f1-panel app-submit-card">
        <div class="app-submit-card__icon @iconClass">
            <i class="bi @iconName" style="@iconStyle"></i>
        </div>
        <h1 class="app-submit-card__title">@title</h1>
        <div class="app-submit-card__body">
            <p>@Html.Raw(body)</p>
        </div>

        @if (discordWarn)
        {
            <div class="app-submit-card__warn">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span>@(discordWarnDetail ?? "Discord-Beitritts-Warnung")</span>
            </div>
        }

        <div class="app-submit-card__actions">
            <a class="btn btn-primary" asp-controller="Application" asp-action="MyApplication">
                <i class="bi bi-list-ul"></i> Meine Bewerbungen
            </a>
            <a class="btn btn-ghost" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house"></i> Zur Startseite
            </a>
        </div>
    </div>
</div>
