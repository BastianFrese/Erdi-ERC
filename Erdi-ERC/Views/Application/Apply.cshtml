@model <OWNER_HANDLE>_ERC.Controllers.ApplyInput
@using <OWNER_HANDLE>_ERC.Models
@using <OWNER_HANDLE>_ERC.Services
@inject Microsoft.Extensions.Options.IOptions<<OWNER_HANDLE>_ERC.Options.DiscordGuildOptions> DiscordGuildOptions
@{
    ViewData["Title"] = "Bewerbung";
    var leagues = ViewBag.Leagues as IReadOnlyList<League> ?? new List<League>();
    var platforms = ViewBag.AllowedPlatforms as IReadOnlyList<string> ?? new[] { "PC", "PS5", "Xbox" };
    var capacity = ViewBag.LeagueCapacity as IReadOnlyList<LeagueCapacityInfo> ?? new List<LeagueCapacityInfo>();
    var needsWarning = (bool)(ViewBag.NeedsGuildWarning ?? false);
    var communityClaim = User.HasClaim("erdi:on-community-guild", "true");
    var leagueClaim = User.HasClaim("erdi:on-league-guild", "true");
    var communityInvite = DiscordGuildOptions.Value.CommunityInviteUrl;
    var leagueInvite = DiscordGuildOptions.Value.LeagueInviteUrl;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/applications.css" asp-append-version="true" />
}

<div class="app-page">
    <div class="app-hero">
        <div class="app-hero__icon"><i class="bi bi-envelope-paper-fill"></i></div>
        <div class="app-hero__title">
            <h1>Bewerbung</h1>
            <p>
                Bewirb dich als <strong>Stammfahrer</strong>, <strong>Ersatzfahrer</strong> oder <strong>Probefahrer</strong>.
                Wir schauen uns jede Bewerbung persönlich an.
            </p>
            @if (ViewBag.TargetSeason is string targetSeason && !string.IsNullOrWhiteSpace(targetSeason))
            {
                <p class="app-hero__season">
                    <i class="bi bi-calendar-event"></i>
                    Du bewirbst dich für <strong>Season @targetSeason</strong>
                    @if (ViewBag.IsNextSeason == true)
                    {
                        <span class="f1-chip f1-chip--info">Vorschau</span>
                    }
                </p>
            }
        </div>
    </div>

    @if (needsWarning)
    {
        @await Html.PartialAsync("_DiscordJoinWarning", new <OWNER_HANDLE>_ERC.ViewModels.DiscordJoinWarningViewModel
        {
            JoinedCommunity = communityClaim,
            JoinedLeague = leagueClaim,
            CommunityInviteUrl = communityInvite,
            LeagueInviteUrl = leagueInvite
        })
    }

    @if (leagues.Count == 0)
    {
        <div class="f1-panel app-empty">
            <i class="bi bi-info-circle"></i>
            <p>Aktuell ist keine Liga für Bewerbungen geöffnet. Schau später wieder vorbei.</p>
        </div>
    }
    else
    {
        <form asp-controller="Application" asp-action="Apply" method="post" class="f1-panel app-form">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="app-form__validation" asp-validation-summary="ModelOnly" role="alert"></div>
            }

            <div class="app-form__grid">
                @* Row 1: Discord-Name (readonly, full width) *@
                <div class="app-form__field app-form__grid--full">
                    <label class="app-form__label" for="DiscordName">Discord-Name</label>
                    <input id="DiscordName" name="DiscordName" class="app-form__input" type="text"
                           value="@Model.DiscordName" readonly />
                    <span class="app-form__hint">Wird automatisch aus deinem Discord-Login übernommen.</span>
                </div>

                @* Row 2: GamerTag + Platform *@
                <div class="app-form__field">
                    <label class="app-form__label" for="GamerTag">EA-Gamer-Tag <span class="required">*</span></label>
                    <input id="GamerTag" name="GamerTag" class="app-form__input" type="text"
                           value="@Model.GamerTag" required maxlength="64" autocomplete="off"
                           placeholder="Dein EA-ID-Nickname" />
                    <span class="app-form__hint">Dein EA-ID-Nickname, wie er im Spiel angezeigt wird.</span>
                </div>

                <div class="app-form__field">
                    <label class="app-form__label" for="Platform">Plattform <span class="required">*</span></label>
                    <select id="Platform" name="Platform" class="app-form__select" required>
                        <option value="" disabled selected="@(string.IsNullOrEmpty(Model.Platform))">Bitte wählen</option>
                        @foreach (var p in platforms)
                        {
                            <option value="@p" selected="@(string.Equals(Model.Platform, p, StringComparison.OrdinalIgnoreCase))">@p</option>
                        }
                    </select>
                </div>

                @* Row 3: Liga-Karten (full width) *@
                <div class="app-form__field app-form__grid--full">
                    <span class="app-form__label">Liga <span class="required">*</span></span>
                    <div class="app-league-grid" role="radiogroup" aria-label="Liga wählen">
                        @foreach (var league in leagues)
                        {
                            var cap = capacity.FirstOrDefault(c => c.LeagueId == league.Id);
                            var isFull = cap?.IsFull == true;
                            var isChecked = string.Equals(Model.TargetLeagueId, league.Id, StringComparison.OrdinalIgnoreCase);
                            <label class="app-league-card @(isFull ? "app-league-card--full" : "")">
                                <input type="radio" name="TargetLeagueId" value="@league.Id" required checked="@isChecked" />
                                <span class="app-league-card__body">
                                    <span class="app-league-card__head">
                                        <span class="app-league-card__name">@league.Name</span>
                                        @if (cap?.Capacity is int capTotal)
                                        {
                                            <span class="app-league-card__seats">@cap.OccupiedSeats/@capTotal belegt</span>
                                        }
                                    </span>
                                    <span class="app-league-card__season">
                                        @if (!string.IsNullOrWhiteSpace(league.NextSeason) && league.ApplicationsOpenForNextSeason)
                                        {
                                            <span class="f1-chip f1-chip--info">Season @league.NextSeason</span>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(league.CurrentSeason))
                                        {
                                            <span class="f1-chip f1-chip--ghost">Season @league.CurrentSeason</span>
                                        }
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(league.Description))
                                    {
                                        <span class="app-league-card__desc">@league.Description</span>
                                    }
                                    <span class="app-league-card__status">
                                        @if (cap?.Capacity is null)
                                        {
                                            <span class="app-league-card__badge app-league-card__badge--open"><i class="bi bi-door-open"></i> Offen</span>
                                        }
                                        else if (isFull)
                                        {
                                            <span class="app-league-card__badge app-league-card__badge--wait"><i class="bi bi-hourglass-split"></i> Voll — Warteliste (Pos. ~@(cap!.WaitlistLength + 1))</span>
                                        }
                                        else
                                        {
                                            <span class="app-league-card__badge app-league-card__badge--free"><i class="bi bi-check2"></i> @cap!.FreeSeats @(cap.FreeSeats == 1 ? "Platz" : "Plätze") frei</span>
                                        }
                                    </span>
                                </span>
                            </label>
                        }
                    </div>
                    <span class="app-form__hint">Volle Ligen: Stammfahrer-Bewerbungen landen automatisch auf der Warteliste. Ersatz-/Probefahrer sind davon nicht betroffen.</span>
                </div>

                @* Row 4: Rolle *@
                <div class="app-form__field app-form__grid--full">
                    <label class="app-form__label" for="Role">Rolle <span class="required">*</span></label>
                    <select id="Role" name="Role" class="app-form__select" required>
                        <option value="Stammfahrer"   selected="@(string.Equals(Model.Role, "Stammfahrer",   StringComparison.OrdinalIgnoreCase))">Stammfahrer</option>
                        <option value="Ersatzfahrer"  selected="@(string.Equals(Model.Role, "Ersatzfahrer",  StringComparison.OrdinalIgnoreCase))">Ersatzfahrer</option>
                        <option value="Probefahrer"   selected="@(string.Equals(Model.Role, "Probefahrer",   StringComparison.OrdinalIgnoreCase))">Probefahrer</option>
                    </select>
                    <span class="app-form__hint"><strong>Stammfahrer</strong> fahren jedes Rennen mit festem Platz · <strong>Ersatzfahrer</strong> springen ein, wenn jemand ausfällt · <strong>Probefahrer</strong> schnuppern unverbindlich rein.</span>
                </div>

                @* Row 5: Motivation (full width) *@
                <div class="app-form__field app-form__grid--full">
                    <label class="app-form__label" for="Motivation">Motivation <span style="color:var(--ink-4);font-weight:400;">(optional)</span></label>
                    <textarea id="Motivation" name="Motivation" class="app-form__textarea" rows="4"
                              maxlength="1000" placeholder="Erzähl uns kurz, warum du mitfahren willst…">@Model.Motivation</textarea>
                    <span class="app-form__hint app-form__counter"><span id="motivationCount">0</span>/1000 Zeichen</span>
                </div>
            </div>

            <div class="app-form__actions">
                <a class="btn btn-ghost" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-arrow-left"></i> Abbrechen
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-send-fill"></i> Bewerbung absenden
                </button>
            </div>
        </form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var ta = document.getElementById('Motivation');
            var count = document.getElementById('motivationCount');
            if (!ta || !count) return;
            var update = function () { count.textContent = ta.value.length; };
            ta.addEventListener('input', update);
            update();
        })();
    </script>
}
