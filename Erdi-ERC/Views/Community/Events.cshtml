@model List<Erdi_ERC.Models.RealLifeEvent>
@using Erdi_ERC.Helpers
@{
    ViewData["Title"] = "Real-Life Events";
    Layout = "_Layout";

    var upcoming      = Model.Where(e => e.IsUpcoming).OrderByDescending(e => e.Date).ToList();
    var past          = Model.Where(e => !e.IsUpcoming).OrderByDescending(e => e.Date).ToList();
    var nextUpcoming  = upcoming.OrderBy(e => e.Date).FirstOrDefault();
    var timelineEvents = Model.OrderByDescending(e => e.Date).ToList();

    // Der Host der Anfrage wird als Twitch-parent gebraucht (VideoEmbedHelper).
    var requestHost = Context.Request.Host.Host;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/home-index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/events.css" asp-append-version="true" />
}

<div class="f1-home-backdrop" aria-hidden="true"></div>

<partial name="_F1PageHero" model="@(new F1PageHeroVm {
    Eyebrow   = "Erdi's Racing Community · Real Life",
    Title     = "Real-Life",
    Highlight = "Events",
    Lead      = "Kart-Events, LAN-Treffen und alles, was die ERC-Community offline zusammenbringt. Hier findest du unsere bisherigen Events &ndash; und alles, was als Nächstes ansteht.",

})" />

@if (nextUpcoming != null)
{
    <div class="f1-next-event reveal mb-4">
        <span class="f1-next-event__badge status-pill is-live">Upcoming</span>
        <div class="f1-next-event__info">
            <div class="f1-next-event__eyebrow">Nächstes Event</div>
            <div class="f1-next-event__title">@nextUpcoming.Title</div>
            <div class="f1-next-event__meta">
                <i class="f1-icon" data-lucide="calendar"></i>
                @nextUpcoming.Date.ToString("dd.MM.yyyy HH:mm")
                @if (!string.IsNullOrWhiteSpace(nextUpcoming.Location))
                {
                    <span>·</span>
                    <i class="f1-icon" data-lucide="map-pin"></i>
                    @nextUpcoming.Location
                }
            </div>
        </div>
        <div class="f1-next-event__countdown">
            <div class="f1-next-event__countdown-label">Countdown</div>
            <span class="f1-next-event__countdown-value"
                  id="nextEventCountdown"
                  data-target="@nextUpcoming.Date.ToString("O")">…</span>
        </div>
    </div>
}

@if (Model.Count == 0)
{
    <section class="f1-section reveal">
        <div class="empty-state">
            <span class="icon-chip is-cyan"><i class="bi bi-calendar-x"></i></span>
            <div class="empty-state__title">Noch keine Events eingetragen</div>
            <p class="empty-state__lead">Sobald das nächste Real-Life-Event ansteht, findest du es hier.</p>
        </div>
    </section>
}
else
{
    <section class="f1-section">
        <partial name="_F1Section" model="@(new F1SectionVm {
            Chip    = "Timeline",
            Title   = "Event Timeline",
            SubText = "Neueste Events oben"
        })" />

        <div class="event-timeline f1-stagger">
            @foreach (var ev in timelineEvents)
            {
                var video = VideoEmbedHelper.Resolve(ev.YouTubeUrl, requestHost);
                var previewImage = !string.IsNullOrWhiteSpace(ev.ImageFileName)
                    ? $"/uploads/events/{ev.ImageFileName}"
                    : (ev.Images.FirstOrDefault() is { } galleryImage ? $"/uploads/events/{galleryImage.FileName}" : null);
                var hasPreviewImage = !string.IsNullOrWhiteSpace(previewImage);

                // Galerie des Events: Cover zuerst, dann die Uploads — dieselbe Reihenfolge
                // wie auf der Detailseite. Index 0 ist dadurch immer genau das Bild, das in
                // der Timeline als Vorschau hängt (Cover bzw. erstes Galerie-Bild).
                var galleryImages = new List<string>();
                if (!string.IsNullOrWhiteSpace(ev.ImageFileName)) galleryImages.Add(ev.ImageFileName);
                galleryImages.AddRange(ev.Images.Select(i => i.FileName));
                var galleryJson = galleryImages.Count == 0
                    ? "[]"
                    : "[" + string.Join(",", galleryImages.Select(f => "\"/uploads/events/" + f + "\"")) + "]";

                <article class="event-timeline__item"
                         data-event-gallery
                         data-images="@galleryJson">
                    <div class="event-timeline__rail">
                        <div class="event-timeline__date">
                            <span class="event-timeline__date-day">@ev.Date.ToString("dd.MM.")</span>
                            <span class="event-timeline__date-year">@ev.Date.ToString("yyyy")</span>
                        </div>
                        <span class="event-timeline__dot"></span>
                    </div>

                    <div class="event-timeline__card">
                        <div class="event-timeline__layout @(hasPreviewImage ? "has-media" : "no-media")">
                            @if (hasPreviewImage)
                            {
                                <div class="event-timeline__cover">
                                    @* Echtes <button> statt role="button": damit lässt sich das Bild
                                       auch per Tastatur vergrößern (Enter/Space), ohne Extra-JS. *@
                                    <button type="button"
                                            class="event-timeline__cover-btn"
                                            data-gallery-index="0"
                                            aria-label="@(ev.Title) vergrößern">
                                        @{
                                            var previewPic = new PictureVm {
                                                Src = @previewImage,
                                                Alt = @ev.Title,
                                                Loading = "lazy",
                                                Decoding = "async",
                                                Sizes = "(max-width: 768px) 100vw, 320px"
                                            };
                                        }
                                        <partial name="_Picture" model="previewPic" />
                                    </button>
                                </div>
                            }

                            <div class="event-timeline__content">
                                <div class="event-timeline__head">
                                    <div>
                                        <h3 class="event-timeline__title">@ev.Title</h3>
                                        <div class="text-mute small">
                                            <i class="bi bi-calendar3"></i> @ev.Date.ToString("dd.MM.yyyy HH:mm")
                                            @if (!string.IsNullOrWhiteSpace(ev.Location))
                                            {
                                                <span> · <i class="bi bi-geo-alt-fill"></i> @ev.Location</span>
                                            }
                                        </div>
                                    </div>
                                    @if (ev.IsUpcoming)
                                    {
                                        <span class="status-pill is-live">Upcoming</span>
                                    }
                                    else
                                    {
                                        <span class="status-pill">Recap</span>
                                    }
                                </div>

                                <p class="text-mute mb-3">@ev.Description</p>

                                @if (video is { } embed)
                                {
                                    <div class="ratio ratio-16x9 event-timeline__media mb-3" style="max-width:400px;">
                                        <iframe src="@embed.Url" title="@VideoEmbedHelper.DisplayName(embed.Platform)-Video zu @ev.Title" allowfullscreen loading="lazy"></iframe>
                                    </div>
                                }
                                else if (VideoEmbedHelper.SafeLinkOrNull(ev.YouTubeUrl) is { } videoLink
                                         && VideoEmbedHelper.DetectPlatform(videoLink) is { } platform)
                                {
                                    @* Bekannter Anbieter, aber nicht einbettbar (z. B. eine Kanal-URL):
                                       dieselbe Ausgabe wie auf der Detailseite — der Link darf nicht
                                       verschwinden, nur weil kein Player daraus wird. *@
                                    <a class="f1-btn f1-btn--ghost mb-3" href="@videoLink" target="_blank" rel="noopener">
                                        Video auf @VideoEmbedHelper.DisplayName(platform) ansehen
                                        <i class="f1-icon" data-lucide="external-link" style="width:14px;height:14px;"></i>
                                    </a>
                                }

                                <a class="f1-btn f1-btn--ghost" asp-controller="Community" asp-action="EventDetail" asp-route-id="@ev.Id">
                                    Mehr anzeigen
                                    <i class="f1-icon" data-lucide="arrow-right" style="width:14px;height:14px;"></i>
                                </a>
                            </div>
                        </div>
                    </div>

                    @if (galleryImages.Count > 0)
                    {
                        @* Overlay liegt als Geschwister der Card (nicht darin): .event-timeline__card
                           hat backdrop-filter + overflow:hidden, das wäre ein Containing-Block für
                           position:fixed. Die Lightbox portiert das Overlay beim Öffnen ohnehin an
                           <body> (event-lightbox.js). *@
                        <div class="event-lightbox" data-lightbox hidden aria-modal="true" role="dialog"
                             aria-label="Galerie zu @(ev.Title)">
                            <button type="button" class="event-lightbox__close" data-lightbox-close aria-label="Schließen">×</button>
                            @if (galleryImages.Count > 1)
                            {
                                <button type="button" class="event-lightbox__nav event-lightbox__nav--prev" data-lightbox-prev aria-label="Vorheriges Bild">‹</button>
                                <button type="button" class="event-lightbox__nav event-lightbox__nav--next" data-lightbox-next aria-label="Nächstes Bild">›</button>
                            }
                            <img class="event-lightbox__img" data-lightbox-img alt="" />
                        </div>
                    }
                </article>
            }
        </div>
    </section>
}

@section Scripts {
    @* Lightbox für die Timeline-Cover (Markup oben: data-event-gallery / data-lightbox). *@
    <script src="~/js/event-lightbox.min.js" asp-append-version="true"></script>
    <script>
        (() => {
            const el = document.getElementById('nextEventCountdown');
            if (!el) return;
            const target = new Date(el.dataset.target || '');
            if (Number.isNaN(target.getTime())) return;
            const tick = () => {
                const diff = target.getTime() - Date.now();
                if (diff <= 0) { el.textContent = 'läuft / vorbei'; return; }
                const s = Math.floor(diff / 1000);
                const d = Math.floor(s / 86400);
                const h = Math.floor((s % 86400) / 3600);
                const m = Math.floor((s % 3600) / 60);
                const sec = s % 60;
                el.textContent = `${d}T ${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:${String(sec).padStart(2,'0')}`;
            };
            tick();
            setInterval(tick, 1000);
        })();
    </script>
}
