@{
    ViewData["Title"] = "Liga-Saisons";
    ViewData["Kicker"] = "Bewerbungen";
    ViewData["HeroTitle"] = "Saison-Verwaltung";

    var league = ViewBag.League as Erdi_ERC.Models.League;
    var seasons = ViewBag.Seasons as System.Collections.Generic.List<string>
                  ?? new System.Collections.Generic.List<string>();
    var perSeason = ViewBag.PerSeason as System.Collections.Generic.Dictionary<string, System.Collections.Generic.IReadOnlyList<Erdi_ERC.Models.Application>>
                    ?? new System.Collections.Generic.Dictionary<string, System.Collections.Generic.IReadOnlyList<Erdi_ERC.Models.Application>>();
}

@if (league is null)
{
    <p>Liga nicht gefunden.</p>
    return;
}

<div class="adm-dashboard">
    <h2>@league.Name <span class="text-muted small">(@league.Id)</span></h2>
    <p class="text-muted small">
        Aktuelle Saison: @(string.IsNullOrWhiteSpace(league.CurrentSeason) ? "—" : league.CurrentSeason) ·
        Nächste Saison: @(string.IsNullOrWhiteSpace(league.NextSeason) ? "—" : league.NextSeason) ·
        Vorausbewerbungen: @(league.ApplicationsOpenForNextSeason ? "offen" : "geschlossen")
    </p>

    @if (!seasons.Any())
    {
        <div class="alert alert-info">Keine Saison für diese Liga gesetzt. Bitte in der Liga-Verwaltung CurrentSeason/NextSeason setzen.</div>
    }
    else
    {
        @foreach (var season in seasons)
        {
            var apps = perSeason.TryGetValue(season, out var list) ? list : new System.Collections.Generic.List<Erdi_ERC.Models.Application>();
            var pending = apps.Count(a => a.Status == (int)Erdi_ERC.Models.ApplicationStatus.Pending);
            var accepted = apps.Count(a => a.Status == (int)Erdi_ERC.Models.ApplicationStatus.Accepted);
            var rejected = apps.Count(a => a.Status == (int)Erdi_ERC.Models.ApplicationStatus.Rejected);
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Saison @season</strong>
                    <span class="text-muted small">@apps.Count Bewerbungen · @pending offen · @accepted angenommen · @rejected abgelehnt</span>
                </div>
                <div class="card-body">
                    <form method="post" action="/AdminApplications/CloseSeason" class="row g-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="leagueId" value="@league.Id" />
                        <input type="hidden" name="fromSeason" value="@season" />
                        <div class="col-md-3">
                            <label class="form-label">Ziel-Saison</label>
                            <input class="form-control form-control-sm" name="toSeason" value="@league.NextSeason" maxlength="16" placeholder="z.B. 2027" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Modus</label>
                            <select class="form-select form-select-sm" name="mode">
                                <option value="Rollover">Rollover (Bewerbungen verschieben)</option>
                                <option value="RejectAll">Alle offen ablehnen</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-warning btn-sm w-100" onclick="return confirm('Saison @season wirklich schließen?');">Saison schließen</button>
                        </div>
                    </form>

                    @if (apps.Any())
                    {
                        <details class="mt-3">
                            <summary>Bewerbungen anzeigen (@apps.Count)</summary>
                            <table class="table table-sm mt-2">
                                <thead>
                                    <tr>
                                        <th>Spieler</th>
                                        <th>GamerTag</th>
                                        <th>Rolle</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var a in apps.OrderBy(x => x.DiscordName))
                                    {
                                        var statusLabel = ((Erdi_ERC.Models.ApplicationStatus)a.Status) switch
                                        {
                                            Erdi_ERC.Models.ApplicationStatus.Pending => "In Prüfung",
                                            Erdi_ERC.Models.ApplicationStatus.Accepted => "Angenommen",
                                            Erdi_ERC.Models.ApplicationStatus.Rejected => "Abgelehnt",
                                            _ => a.Status.ToString()
                                        };
                                        <tr>
                                            <td>@a.DiscordName</td>
                                            <td>@a.Platform:@a.GamerTag</td>
                                            <td>@a.Role</td>
                                            <td>@statusLabel</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </details>
                    }
                </div>
            </div>
        }
    }

    <div class="mt-3">
        <a class="btn btn-ghost btn-sm" href="/AdminApplications/Seasons">Zur Saison-Übersicht aller Ligen</a>
        <a class="btn btn-ghost btn-sm" href="/AdminLeague/EditLeague/@league.Id">Zur Liga-Verwaltung</a>
    </div>
</div>