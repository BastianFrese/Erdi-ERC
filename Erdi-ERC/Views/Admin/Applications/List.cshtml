@model <OWNER_HANDLE>_ERC.Controllers.ApplicationListViewModel
@using <OWNER_HANDLE>_ERC.Models

@{
    ViewData["Title"] = "Bewerbungen - Liste";
    ViewData["Kicker"] = "Admin · Bewerbungen";
    ViewData["HeroTitle"] = "Bewerbungen";
    ViewData["HeroSubtitle"] = "Alle Bewerbungen mit Filterung";

    // Route-Values der aktiven Filter (für Pagination-Links).
    object RouteFor(int page) => new
    {
        status = Model.Filter.Status?.ToString(),
        leagueId = Model.Filter.LeagueId,
        search = Model.Filter.Search,
        sort = Model.Filter.Sort,
        flagged = Model.Filter.FlaggedOnly ? "true" : null,
        duplicates = Model.Filter.DuplicatesOnly ? "true" : null,
        withoutLeague = Model.Filter.WithoutLeagueOnly ? "true" : null,
        page
    };
}

@section Styles {
    <style>
        .filter-bar {
            background: var(--surface-1);
            border: 1px solid var(--stroke-1);
            border-radius: var(--r-2);
            padding: 1.25rem 1.5rem;
            margin-bottom: 2rem;
        }
        .filter-bar form { display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; }
        .filter-group { display: flex; align-items: center; gap: 0.5rem; }
        .filter-group label { font-size: 0.82rem; color: var(--ink-2); }
        .filter-select {
            padding: 0.5rem 0.75rem;
            border: 1px solid var(--stroke-1);
            border-radius: var(--r-1);
            background: var(--surface-0);
            color: var(--ink);
            font-size: 0.875rem;
        }
        .filter-chip { display: inline-flex; align-items: center; gap: .35rem; font-size: .82rem; color: var(--ink-2); cursor: pointer; }
        .app-table { width: 100%; border-collapse: collapse; }
        .app-table thead { background: var(--surface-2); }
        .app-table th {
            padding: 1rem;
            text-align: left;
            font-weight: 600;
            border-bottom: 1px solid var(--stroke-1);
            font-size: 0.875rem;
        }
        .app-table td {
            padding: 1rem;
            border-bottom: 1px solid var(--stroke-1);
        }
        .app-table tbody tr:hover { background: var(--surface-1); }
        .status-badge {
            display: inline-block;
            padding: 0.25rem 0.75rem;
            border-radius: 999px;
            font-size: 0.75rem;
            font-weight: 600;
        }
        .status--pending { background: rgba(255, 193, 7, 0.1); color: ***REMOVED***ffc107; }
        .status--accepted { background: rgba(76, 175, 80, 0.1); color: ***REMOVED***4caf50; }
        .status--rejected { background: rgba(244, 67, 54, 0.1); color: ***REMOVED***f44336; }
        .pagination { display: flex; gap: 0.5rem; margin-top: 2rem; justify-content: center; }
        .pagination a, .pagination span {
            padding: 0.5rem 0.75rem;
            border: 1px solid var(--stroke-1);
            border-radius: var(--r-1);
            background: var(--surface-1);
            color: var(--ink);
            text-decoration: none;
        }
        .pagination a:hover { background: var(--surface-2); }
        .pagination .active { background: var(--sig-cyan); color: ***REMOVED***04121a; }
    </style>
}

<div class="container-fluid py-5">
    @{
        var _listSuccess = TempData["Success"] as string;
        var _listErr = TempData["Error"] as string;
    }
    @if (!string.IsNullOrEmpty(_listSuccess))
    {
        <div class="alert alert-success mb-3">@_listSuccess</div>
    }
    @if (!string.IsNullOrEmpty(_listErr) && _listErr.IndexOf("Konflikt", System.StringComparison.OrdinalIgnoreCase) >= 0)
    {
        <div class="alert alert-warning mb-3">
            <strong>Konflikt erkannt:</strong> Die Bewerbung wurde zwischenzeitlich von jemand anderem geändert.
            <div style="margin-top:.5rem;">
                <button type="button" class="btn btn-sm btn-secondary" onclick="window.location.reload();">Seite neu laden</button>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(_listErr))
    {
        <div class="alert alert-danger mb-3">@_listErr</div>
    }

    <div class="row mb-4">
        <div class="col">
            <h1>Bewerbungen</h1>
            <p class="text-mute">
                @Model.Statistics.TotalApplications gesamt | @Model.Statistics.OpenApplications offen |
                @Model.Statistics.AcceptedApplications angenommen | @Model.Statistics.RejectedApplications abgelehnt
                — Treffer: @Model.Result.TotalCount
            </p>
        </div>
        <div class="col-auto">
            <a href="@Url.Action("Dashboard", "AdminApplications")" class="btn-admin btn-admin--secondary" style="padding: 0.5rem 1rem; font-size: 0.875rem;">
                <i class="bi bi-arrow-left"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="filter-bar">
        <form method="get" action="@Url.Action("List", "AdminApplications")">
            <div class="filter-group">
                <label>Status:</label>
                <select name="status" class="filter-select" onchange="this.form.submit()">
                    <option value="">Alle</option>
                    <option value="Open" selected="@(Model.Filter.Status == ApplicationStatus.Open)">Offen</option>
                    <option value="Accepted" selected="@(Model.Filter.Status == ApplicationStatus.Accepted)">Angenommen</option>
                    <option value="Rejected" selected="@(Model.Filter.Status == ApplicationStatus.Rejected)">Abgelehnt</option>
                </select>
            </div>
            <div class="filter-group">
                <label>Liga:</label>
                <select name="leagueId" class="filter-select" onchange="this.form.submit()">
                    <option value="">Alle</option>
                    @foreach (var league in Model.Leagues)
                    {
                        <option value="@league.Id" selected="@(Model.Filter.LeagueId == league.Id)">@league.Name</option>
                    }
                </select>
            </div>
            <div class="filter-group">
                <label>Sortierung:</label>
                <select name="sort" class="filter-select" onchange="this.form.submit()">
                    <option value="">Standard (Liga)</option>
                    <option value="newest" selected="@(Model.Filter.Sort == "newest")">Neueste zuerst</option>
                    <option value="oldest" selected="@(Model.Filter.Sort == "oldest")">Älteste zuerst</option>
                </select>
            </div>
            <label class="filter-chip" title="Nur zur Überprüfung markierte">
                <input type="checkbox" name="flagged" value="true" @(Model.Filter.FlaggedOnly ? "checked" : "") onchange="this.form.submit()" />
                <i class="bi bi-flag"></i> Markiert
            </label>
            <label class="filter-chip" title="Bewerber mit mehreren Bewerbungen">
                <input type="checkbox" name="duplicates" value="true" @(Model.Filter.DuplicatesOnly ? "checked" : "") onchange="this.form.submit()" />
                <i class="bi bi-people"></i> Duplikate
            </label>
            <label class="filter-chip" title="Bewerbungen ohne Liga-Zuordnung">
                <input type="checkbox" name="withoutLeague" value="true" @(Model.Filter.WithoutLeagueOnly ? "checked" : "") onchange="this.form.submit()" />
                <i class="bi bi-question-circle"></i> Ohne Liga
            </label>
            <div class="filter-group" style="margin-left:auto;">
                <input type="text" name="search" class="filter-select" value="@Model.Filter.Search" placeholder="Discord- oder Ingame-Name" />
                <button type="submit" class="btn-admin btn-admin--secondary" style="padding: 0.5rem 0.75rem; font-size: 0.875rem;">
                    <i class="bi bi-search"></i>
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.Filter.Search) || Model.Filter.Status.HasValue || Model.Filter.LeagueId != null
                     || Model.Filter.FlaggedOnly || Model.Filter.DuplicatesOnly || Model.Filter.WithoutLeagueOnly)
                {
                    <a href="@Url.Action("List", "AdminApplications")" class="btn-admin btn-admin--secondary" style="padding: 0.5rem 0.75rem; font-size: 0.875rem;" title="Filter zurücksetzen">
                        <i class="bi bi-x"></i>
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Applications Table -->
    @if (Model.Result.Items.Count > 0)
    {
        <div style="overflow-x: auto;">
            <table class="app-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Liga</th>
                        <th>Rolle</th>
                        <th>Ingame-Name</th>
                        <th>Status</th>
                        <th>Eingereicht</th>
                        <th style="text-align: right;">Aktionen</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var app in Model.Result.Items)
                    {
                        var statusClass = app.IsAccepted ? "status--accepted" : app.IsRejected ? "status--rejected" : "status--pending";
                        var statusText = app.IsAccepted ? "Angenommen" : app.IsRejected ? "Abgelehnt" : "Offen";

                        <tr>
                            <td><strong>@app.DiscordName</strong></td>
                            <td>
                                @app.Division
                                @if (app.AssignedLeagueId is null && app.AppliedLeagueId is null)
                                {
                                    <span class="status-badge" style="background:rgba(255,193,7,.1);color:***REMOVED***ffc107;" title="Keine Liga-Zuordnung">?</span>
                                }
                            </td>
                            <td>@(app.AssignedRole ?? app.Role)</td>
                            <td>@app.GamingName <span class="text-mute small">(@app.Platform)</span></td>
                            <td>
                                <span class="status-badge @statusClass">@statusText</span>
                                @if (app.IsFlagged && !app.IsAccepted && !app.IsRejected)
                                {
                                    <span class="status-badge" style="background:rgba(0,188,212,.12);color:***REMOVED***00bcd4;" title="Zur Überprüfung markiert"><i class="bi bi-flag-fill"></i></span>
                                }
                                @if (app.IsOnTrial)
                                {
                                    <span class="status-badge" style="background:rgba(255,184,0,.12);color:***REMOVED***ffb800;" title="Auf Probe">P</span>
                                }
                            </td>
                            <td>@app.SubmittedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td style="text-align: right;">
                                <a href="@Url.Action("Detail", "AdminApplications", new { id = app.Id })" class="btn-admin btn-admin--secondary" style="padding: 0.5rem 0.75rem; font-size: 0.875rem;">
                                    <i class="bi bi-eye"></i> Detail
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (Model.Result.TotalPages > 1)
        {
            <div class="pagination">
                @if (Model.Result.Page > 1)
                {
                    <a href="@Url.Action("List", "AdminApplications", RouteFor(Model.Result.Page - 1))">
                        <i class="bi bi-chevron-left"></i> Zurück
                    </a>
                }
                <span class="active">Seite @Model.Result.Page / @Model.Result.TotalPages</span>
                @if (Model.Result.Page < Model.Result.TotalPages)
                {
                    <a href="@Url.Action("List", "AdminApplications", RouteFor(Model.Result.Page + 1))">
                        Weiter <i class="bi bi-chevron-right"></i>
                    </a>
                }
            </div>
        }
    }
    else
    {
        <div style="background: var(--surface-1); border: 1px solid var(--stroke-1); border-radius: var(--r-2); padding: 2rem; text-align: center; color: var(--ink-secondary);">
            <i class="bi bi-inbox" style="font-size: 2rem; opacity: 0.5;"></i>
            <p style="margin-top: 1rem;">Keine Bewerbungen gefunden</p>
        </div>
    }
</div>
