@{
    ViewData["Title"] = "Bewerbungen";
    ViewData["Kicker"] = "Bewerbungen";
    ViewData["HeroTitle"] = "Bewerbungs-Übersicht";

    var items   = ViewBag.Items as System.Collections.Generic.List<Erdi_ERC.Models.Application>
                  ?? new System.Collections.Generic.List<Erdi_ERC.Models.Application>();
    var leagues = ViewBag.Leagues as System.Collections.Generic.List<Erdi_ERC.Models.League>
                  ?? new System.Collections.Generic.List<Erdi_ERC.Models.League>();
    string? statusFilter = ViewBag.StatusFilter as string;
    string? leagueFilter = ViewBag.LeagueFilter as string;
    string? seasonFilter = ViewBag.SeasonFilter as string;
    int pageNo = (int)(ViewBag.Page ?? 1);
    bool hasMore = (bool)(ViewBag.HasMore ?? false);

    var statusQs = string.IsNullOrEmpty(statusFilter) ? "" : $"&status={Uri.EscapeDataString(statusFilter)}";
    var leagueQs = string.IsNullOrEmpty(leagueFilter) ? "" : $"&leagueId={Uri.EscapeDataString(leagueFilter)}";
    var seasonQs = string.IsNullOrEmpty(seasonFilter) ? "" : $"&season={Uri.EscapeDataString(seasonFilter)}";
    string CurrentLeagueName(string? id) => string.IsNullOrEmpty(id)
        ? "—"
        : leagues.FirstOrDefault(l => string.Equals(l.Id, id, StringComparison.OrdinalIgnoreCase))?.Name ?? id;

    string StatusBadge(int s) => ((Erdi_ERC.Models.ApplicationStatus)s) switch
    {
        Erdi_ERC.Models.ApplicationStatus.Pending   => "f1-chip f1-chip--amber",
        Erdi_ERC.Models.ApplicationStatus.Accepted  => "f1-chip f1-chip--green",
        Erdi_ERC.Models.ApplicationStatus.Rejected  => "f1-chip f1-chip--red",
        _                                          => "f1-chip"
    };

    string StatusLabel(int s) => ((Erdi_ERC.Models.ApplicationStatus)s) switch
    {
        Erdi_ERC.Models.ApplicationStatus.Pending   => "In Prüfung",
        Erdi_ERC.Models.ApplicationStatus.Accepted  => "Angenommen",
        Erdi_ERC.Models.ApplicationStatus.Rejected  => "Abgelehnt",
        _                                          => s.ToString()
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin-applications.css" asp-append-version="true" />
}

<div class="adm-dashboard">

    @* Filter-Leiste *@
    <form method="get" class="adm-filter-bar">
        <div class="adm-filter-bar__field">
            <label for="status">Status</label>
            <select id="status" name="status" class="adm-form-select">
                <option value="" selected="@(string.IsNullOrEmpty(statusFilter))">Alle</option>
                <option value="Pending"   selected="@(statusFilter == "Pending")">In Prüfung</option>
                <option value="Accepted"  selected="@(statusFilter == "Accepted")">Angenommen</option>
                <option value="Rejected"  selected="@(statusFilter == "Rejected")">Abgelehnt</option>
            </select>
        </div>
        <div class="adm-filter-bar__field">
            <label for="leagueId">Liga</label>
            <select id="leagueId" name="leagueId" class="adm-form-select">
                <option value="" selected="@(string.IsNullOrEmpty(leagueFilter))">Alle</option>
                @foreach (var l in leagues)
                {
                    <option value="@l.Id" selected="@(string.Equals(leagueFilter, l.Id, StringComparison.OrdinalIgnoreCase))">@l.Name</option>
                }
            </select>
        </div>
        <div class="adm-filter-bar__field">
            <label for="season">Season</label>
            <input id="season" name="season" type="text" class="adm-form-input"
                   placeholder="z.B. 2026" value="@seasonFilter" maxlength="16" />
        </div>
        <button type="submit" class="btn btn-primary btn-sm">
            <i class="bi bi-funnel-fill"></i> Filtern
        </button>
        <a class="btn btn-ghost btn-sm" asp-action="Waitlist" asp-route-leagueId="@leagueFilter">
            <i class="bi bi-hourglass-split"></i> Warteliste
        </a>
        <a class="btn btn-ghost btn-sm" asp-action="Seasons">
            <i class="bi bi-calendar-event"></i> Saison-Übersicht
        </a>
    </form>

    @* Tabelle *@
    <div class="adm-panel">
        <div class="adm-panel__head">
            <span class="adm-panel__head-title">
                <i class="bi bi-envelope-paper-fill me-2" style="color:#22d3ee;"></i>
                <span>Bewerbungen (@items.Count)</span>
            </span>
        </div>
        <div class="adm-panel__body adm-panel__body--flush">
            @if (items.Count == 0)
            {
                <div class="adm-empty">
                    <i class="bi bi-inbox"></i>
                    <p>Keine Bewerbungen für diesen Filter.</p>
                </div>
            }
            else
            {
                <table class="adm-table">
                    <thead>
                        <tr>
                            <th>Liga</th>
                            <th>Season</th>
                            <th>Discord</th>
                            <th>Rolle</th>
                            <th>Gamer-Tag</th>
                            <th>Plattform</th>
                            <th>Eingereicht</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in items)
                        {
                            <tr>
                                <td>@CurrentLeagueName(a.TargetLeagueId)</td>
                                <td><span class="f1-chip f1-chip--ghost">@a.Season</span></td>
                                <td>
                                    <div class="adm-table__primary">@a.DiscordName</div>
                                    <div class="adm-table__secondary">@a.DiscordId</div>
                                </td>
                                <td>@a.Role</td>
                                <td>@a.GamerTag</td>
                                <td>@a.Platform</td>
                                <td>@a.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                <td><span class="@StatusBadge(a.Status)">@StatusLabel(a.Status)</span></td>
                                <td>
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Detail" asp-route-id="@a.Id">
                                        <i class="bi bi-eye"></i> Detail
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    @* Pagination *@
    @if (pageNo > 1 || hasMore)
    {
        <nav class="adm-pagination">
            @if (pageNo > 1)
            {
                <a class="btn btn-ghost btn-sm"
                   href="@($"/AdminApplications/List?page={pageNo - 1}{statusQs}{leagueQs}{seasonQs}")">
                    <i class="bi bi-chevron-left"></i> Zurück
                </a>
            }
            <span class="adm-pagination__page">Seite @pageNo</span>
            @if (hasMore)
            {
                <a class="btn btn-ghost btn-sm"
                   href="@($"/AdminApplications/List?page={pageNo + 1}{statusQs}{leagueQs}{seasonQs}")">
                    Weiter <i class="bi bi-chevron-right"></i>
                </a>
            }
        </nav>
    }
</div>