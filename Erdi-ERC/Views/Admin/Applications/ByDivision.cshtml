@model <OWNER_HANDLE>_ERC.Controllers.ApplicationListViewModel

@{
    ViewData["Title"] = $"Bewerbungen - {Model.CurrentDivision}";
    ViewData["Kicker"] = "Admin · Bewerbungen";
    ViewData["HeroTitle"] = Model.CurrentDivision;
    ViewData["HeroSubtitle"] = "Bewerbungen für diese Division";
}

@section Styles {
    <style>
        .division-header {
            background: var(--surface-1);
            border: 1px solid var(--stroke-1);
            border-radius: var(--r-2);
            padding: 2rem;
            margin-bottom: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .division-info h2 { margin: 0; font-size: 1.5rem; }
        .division-stats { display: flex; gap: 2rem; margin-top: 1rem; }
        .stat { display: flex; flex-direction: column; }
        .stat-value { font-size: 1.5rem; font-weight: 700; color: var(--sig-cyan); }
        .stat-label { font-size: 0.875rem; color: var(--ink-secondary); }

        .app-card {
            background: var(--surface-1);
            border: 1px solid var(--stroke-1);
            border-radius: var(--r-2);
            padding: 1.5rem;
            margin-bottom: 1rem;
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 1rem;
            align-items: center;
        }
        .app-card-info h3 { margin: 0; color: var(--ink); }
        .app-card-meta {
            display: flex;
            gap: 1rem;
            margin-top: 0.5rem;
            font-size: 0.875rem;
            color: var(--ink-secondary);
        }
        .badge {
            display: inline-block;
            padding: 0.25rem 0.75rem;
            border-radius: 999px;
            font-size: 0.75rem;
            font-weight: 600;
        }
        .badge--stammfahrer { background: rgba(0, 188, 212, 0.1); color: ***REMOVED***00bcd4; }
        .badge--ersatzfahrer { background: rgba(156, 39, 176, 0.1); color: ***REMOVED***9c27b0; }

        .card-actions {
            display: flex;
            gap: 0.5rem;
        }
        .btn-sm {
            padding: 0.5rem 0.75rem;
            border: none;
            border-radius: var(--r-1);
            cursor: pointer;
            font-size: 0.875rem;
            font-weight: 600;
            transition: all 0.2s;
        }
        .btn-sm--secondary { background: var(--surface-2); color: var(--ink); }
        .btn-sm--secondary:hover { background: var(--surface-3); }

        .empty-state {
            text-align: center;
            padding: 3rem 1rem;
            color: var(--ink-secondary);
        }
        .empty-state-icon { font-size: 3rem; opacity: 0.3; margin-bottom: 1rem; }

        .role-filter {
            display: flex;
            gap: 0.75rem;
            margin-bottom: 2rem;
        }
        .filter-btn {
            padding: 0.5rem 1rem;
            border: 1px solid var(--stroke-1);
            background: var(--surface-1);
            border-radius: var(--r-2);
            cursor: pointer;
            font-weight: 600;
            transition: all 0.2s;
        }
        .filter-btn:hover, .filter-btn.active {
            background: var(--sig-cyan);
            color: white;
            border-color: var(--sig-cyan);
        }
    </style>
}

<div class="container-fluid py-5">
    <div class="division-header">
        <div class="division-info">
            <h2>@Model.CurrentDivision</h2>
            <div class="division-stats">
                <div class="stat">
                    @(((IReadOnlyDictionary<string?, int>)Model.Statistics.ApplicationsByDivision).GetValueOrDefault(Model.CurrentDivision, 0))
                    <span class="stat-label">Gesamt</span>
                </div>
                <div class="stat">
                    <span class="stat-value">@Model.Applications.Count(x => !x.IsAccepted)</span>
                    <span class="stat-label">Offen</span>
                </div>
                <div class="stat">
                    <span class="stat-value">@Model.Applications.Count(x => x.IsAccepted)</span>
                    <span class="stat-label">Akzeptiert</span>
                </div>
            </div>
        </div>
        <div>
            <a href="@Url.Action("Dashboard", "AdminApplications")" class="btn-sm btn-sm--secondary">
                <i class="bi bi-arrow-left"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- Applications by Role -->
    @{
        var stammfahrer = Model.Applications.Where(x => x.Role == "Stammfahrer").ToList();
        var ersatzfahrer = Model.Applications.Where(x => x.Role == "Ersatzfahrer").ToList();
    }

    <!-- Stammfahrer -->
    @if (stammfahrer.Count > 0)
    {
        <h3 style="margin-top: 2rem; margin-bottom: 1rem;">
            <span class="badge badge--stammfahrer">Stammfahrer</span> (@stammfahrer.Count)
        </h3>
        @foreach (var app in stammfahrer.OrderBy(x => x.IsAccepted).ThenByDescending(x => x.SubmittedAt))
        {
            <div class="app-card">
                <div class="app-card-info">
                    <h3>@app.DiscordName</h3>
                    <div class="app-card-meta">
                        <span style="padding: 0.25rem 0.75rem; border-radius: 999px; font-size: 0.75rem; font-weight: 600; background: @(app.IsAccepted ? "rgba(76, 175, 80, 0.1)" : "rgba(255, 193, 7, 0.1)"); color: @(app.IsAccepted ? "***REMOVED***4caf50" : "***REMOVED***ffc107");">
                            @(app.IsAccepted ? "✓ Akzeptiert" : "Offen")
                        </span>
                        <span>@app.GamingName <span class="text-mute small">(@app.Platform)</span></span>
                        <span>@app.AiLevel</span>
                    </div>
                </div>
                <div class="card-actions">
                    <a href="@Url.Action("Detail", "AdminApplications", new { id = app.Id })" class="btn-sm btn-sm--secondary">
                        <i class="bi bi-eye"></i> Ansehen
                    </a>
                </div>
            </div>
        }
    }

    <!-- Ersatzfahrer -->
    @if (ersatzfahrer.Count > 0)
    {
        <h3 style="margin-top: 2rem; margin-bottom: 1rem;">
            <span class="badge badge--ersatzfahrer">Ersatzfahrer</span> (@ersatzfahrer.Count)
        </h3>
        @foreach (var app in ersatzfahrer.OrderBy(x => x.IsAccepted).ThenByDescending(x => x.SubmittedAt))
        {
            <div class="app-card">
                <div class="app-card-info">
                    <h3>@app.DiscordName</h3>
                    <div class="app-card-meta">
                        <span style="padding: 0.25rem 0.75rem; border-radius: 999px; font-size: 0.75rem; font-weight: 600; background: @(app.IsAccepted ? "rgba(76, 175, 80, 0.1)" : "rgba(255, 193, 7, 0.1)"); color: @(app.IsAccepted ? "***REMOVED***4caf50" : "***REMOVED***ffc107");">
                            @(app.IsAccepted ? "✓ Akzeptiert" : "Offen")
                        </span>
                        <span>@app.GamingName <span class="text-mute small">(@app.Platform)</span></span>
                        <span>@app.AiLevel</span>
                    </div>
                </div>
                <div class="card-actions">
                    <a href="@Url.Action("Detail", "AdminApplications", new { id = app.Id })" class="btn-sm btn-sm--secondary">
                        <i class="bi bi-eye"></i> Ansehen
                    </a>
                </div>
            </div>
        }
    }

    @if (Model.Applications.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state-icon">
                <i class="bi bi-inbox"></i>
            </div>
            <h3>Keine Bewerbungen</h3>
            <p>Für diese Division gibt es noch keine Bewerbungen</p>
        </div>
    }
</div>
