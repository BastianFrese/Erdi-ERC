@model <OWNER_HANDLE>_ERC.Controllers.ApplicationMetricsViewModel

@{
    ViewData["Title"] = "Bewerbungs-Metriken";
    ViewData["Kicker"] = "Admin · Bewerbungen";
    ViewData["HeroTitle"] = "Statistiken";
    ViewData["HeroSubtitle"] = "Detaillierte Metriken zum Bewerbungsprozess";
}

@section Styles {
    <style>
        .metrics-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem; margin-bottom: 2rem; }
        .metric-card {
            background: var(--surface-1);
            border: 1px solid var(--stroke-1);
            border-radius: var(--r-2);
            padding: 1.5rem;
            box-shadow: var(--sh-2);
        }
        .metric-label { font-size: 0.875rem; color: var(--ink-secondary); font-weight: 600; text-transform: uppercase; }
        .metric-value { font-size: 2rem; font-weight: 700; color: var(--sig-cyan); margin-top: 0.75rem; }
        .metric-subtitle { font-size: 0.75rem; color: var(--ink-tertiary); margin-top: 0.5rem; }
        .metric-trend { display: inline-block; padding: 0.25rem 0.5rem; border-radius: 999px; font-size: 0.75rem; margin-top: 0.5rem; }
        .trend-up { background: rgba(76, 175, 80, 0.1); color: ***REMOVED***4caf50; }
        .trend-down { background: rgba(244, 67, 54, 0.1); color: ***REMOVED***f44336; }

        .section { margin-top: 2rem; }
        .section-title { font-size: 1.25rem; font-weight: 700; margin-bottom: 1rem; color: var(--ink); }
        .section-subtitle { font-size: 0.875rem; color: var(--ink-secondary); margin-bottom: 1.5rem; }

        .stats-box {
            background: var(--surface-1);
            border: 1px solid var(--stroke-1);
            border-radius: var(--r-2);
            padding: 1.5rem;
            margin-bottom: 1rem;
        }
        .stat-row { display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 0; border-bottom: 1px solid var(--stroke-1); }
        .stat-row:last-child { border-bottom: none; }
        .stat-label { color: var(--ink-secondary); }
        .stat-value { font-weight: 600; color: var(--ink); }

        .progress-bar {
            width: 100%;
            height: 8px;
            background: var(--stroke-1);
            border-radius: 999px;
            overflow: hidden;
            margin-top: 0.5rem;
        }
        .progress-fill { height: 100%; background: var(--sig-cyan); border-radius: 999px; }

        .comparison-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 1rem; }
        .comparison-item {
            background: var(--surface-0);
            padding: 1rem;
            border-radius: var(--r-1);
            text-align: center;
        }
        .comparison-value { font-size: 1.5rem; font-weight: 700; color: var(--sig-cyan); }
        .comparison-label { font-size: 0.875rem; color: var(--ink-secondary); margin-top: 0.5rem; }

        .export-bar { display: flex; gap: 0.75rem; margin-top: 2rem; }
        .btn-export {
            padding: 0.75rem 1.25rem;
            border: 1px solid var(--stroke-1);
            background: var(--surface-1);
            border-radius: var(--r-2);
            cursor: pointer;
            font-weight: 600;
            transition: all 0.2s;
        }
        .btn-export:hover { background: var(--surface-2); }
    </style>
}

<div class="container-fluid py-5">
    <div class="row mb-4">
        <div class="col">
            <h1>Bewerbungs-Metriken</h1>
            <p class="text-mute">Detaillierte Statistiken zum Bewerbungsprozess</p>
        </div>
    </div>

    <!-- KPI Metrics -->
    <div class="metrics-grid">
        <div class="metric-card">
            <div class="metric-label">Gesamte Bewerbungen</div>
            <div class="metric-value">@Model.Statistics.TotalApplications</div>
            <div class="metric-subtitle">Alle Bewerbungen</div>
        </div>

        <div class="metric-card">
            <div class="metric-label">Annahmequote</div>
            <div class="metric-value">@(Math.Round(Model.Metrics.AcceptanceRate * 100))%</div>
            <div class="metric-subtitle">Von @Model.Statistics.TotalApplications Bewerbungen</div>
        </div>

        <div class="metric-card">
            <div class="metric-label">Ø Bearbeitungszeit</div>
            <div class="metric-value">@(Math.Round(Model.Metrics.AverageProcessingTimeHours, 1))h</div>
            <div class="metric-subtitle">Durchschnitt bis Akzeptanz</div>
        </div>

        <div class="metric-card">
            <div class="metric-label">Diese Woche</div>
            <div class="metric-value">@Model.Metrics.ApplicationsThisWeek</div>
            <div class="metric-subtitle">Neue Bewerbungen</div>
        </div>
    </div>

    <!-- Overview -->
    <div class="section">
        <h3 class="section-title">Übersicht</h3>
        <div class="stats-box">
            <div class="stat-row">
                <span class="stat-label">Offene Bewerbungen</span>
                <span class="stat-value">@Model.Statistics.OpenApplications</span>
            </div>
            <div class="stat-row">
                <span class="stat-label">Akzeptierte Bewerbungen</span>
                <span class="stat-value">@Model.Statistics.AcceptedApplications</span>
            </div>
            <div class="stat-row">
                <span class="stat-label">Abgelehnte Bewerbungen</span>
                <span class="stat-value">@(Model.Statistics.TotalApplications - Model.Statistics.AcceptedApplications - Model.Statistics.OpenApplications)</span>
            </div>
            <div class="stat-row">
                <span class="stat-label">Annahmequote</span>
                <span class="stat-value">@(Math.Round(Model.Metrics.AcceptanceRate * 100))%</span>
            </div>
        </div>
    </div>

    <!-- Division Breakdown -->
    @if (Model.Statistics.ApplicationsByDivision.Count > 0)
    {
        <div class="section">
            <h3 class="section-title">Nach Division</h3>
            <div class="stats-box">
                @foreach (var kvp in Model.Statistics.ApplicationsByDivision.OrderByDescending(x => x.Value))
                {
                    var total = Model.Statistics.TotalApplications;
                    var percentage = total > 0 ? (kvp.Value * 100.0 / total) : 0;

                    <div class="stat-row">
                        <span class="stat-label">@kvp.Key</span>
                        <span class="stat-value">@kvp.Value (@(Math.Round(percentage))%)</span>
                    </div>
                    <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
                        <div class="progress-bar" style="flex: 1;">
                            <div class="progress-fill" style="width: @(percentage)%"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Role Distribution -->
    @if (Model.Statistics.ApplicationsByRole.Count > 0)
    {
        <div class="section">
            <h3 class="section-title">Nach Rolle</h3>
            <div class="comparison-grid">
                @foreach (var kvp in Model.Statistics.ApplicationsByRole.OrderByDescending(x => x.Value))
                {
                    <div class="comparison-item">
                        <div class="comparison-value">@kvp.Value</div>
                        <div class="comparison-label">@kvp.Key</div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Time-based Metrics -->
    <div class="section">
        <h3 class="section-title">Zeitbasierte Metriken</h3>
        <div class="stats-box">
            <div class="stat-row">
                <span class="stat-label">Bewerbungen diese Woche</span>
                <span class="stat-value">@Model.Metrics.ApplicationsThisWeek</span>
            </div>
            <div class="stat-row">
                <span class="stat-label">Bewerbungen diesen Monat</span>
                <span class="stat-value">@Model.Metrics.ApplicationsThisMonth</span>
            </div>
            <div class="stat-row">
                <span class="stat-label">Ø Verarbeitungszeit</span>
                <span class="stat-value">@(Math.Round(Model.Metrics.AverageProcessingTimeHours, 1)) Stunden</span>
            </div>
            @if (Model.Statistics.LastApplicationTime.HasValue)
            {
                <div class="stat-row">
                    <span class="stat-label">Letzte Bewerbung</span>
                    <span class="stat-value">@Model.Statistics.LastApplicationTime.Value.ToString("dd.MM.yyyy HH:mm")</span>
                </div>
            }
        </div>
    </div>

    <!-- Export -->
    <div class="export-bar">
        <a href="@Url.Action("Export", "AdminApplications")" class="btn-export">
            <i class="bi bi-download"></i> CSV Export
        </a>
        <a href="@Url.Action("Dashboard", "AdminApplications")" class="btn-export">
            <i class="bi bi-arrow-left"></i> Zum Dashboard
        </a>
    </div>
</div>
