@model <OWNER_HANDLE>_ERC.Controllers.ApplicationDashboardViewModel

@{
    ViewData["Title"] = "Bewerbungs-Dashboard";
    ViewData["Kicker"] = "Admin · Bewerbungen";
    ViewData["HeroTitle"] = "Bewerbungen";
    ViewData["HeroSubtitle"] = "Dashboard & Übersicht";

    string DivBadgeColor(string? division) => division switch
    {
        "Main Division 1"               => "var(--sig-cyan)",
        "Second Crossplay Division 2"   => "***REMOVED***ff9800",
        "Rookie Crossplay Division 3"   => "***REMOVED***4caf50",
        "Community Crossplay Event"     => "***REMOVED***9c27b0",
        _                               => "var(--sig-cyan)"
    };
}

<div class="adm-dashboard">

    @{
        var _err = TempData["Error"] as string;
        if (!string.IsNullOrEmpty(_err) && _err.IndexOf("Konflikt", System.StringComparison.OrdinalIgnoreCase) >= 0)
        {
            <div class="adm-alert adm-alert--warning">
                <strong>Konflikt erkannt:</strong> Eine Aktion wurde von einem anderen Admin durchgeführt.
                <div style="margin-top:.5rem; display:flex; gap:.5rem;">
                    <button type="button" class="btn btn-sm btn-primary"
                            onclick="if(confirm('Seite neu laden?')) { window.location.href='@Url.Action("Dashboard","AdminApplications")'; }">
                        Neu laden
                    </button>
                    <button type="button" class="btn btn-sm btn-secondary" onclick="window.location.reload();">Reload</button>
                </div>
            </div>
        }
        else if (!string.IsNullOrEmpty(_err))
        {
            <div class="adm-alert adm-alert--danger"><i class="bi bi-x-circle-fill me-2"></i>@_err</div>
        }
    }
    @if (TempData["Success"] is string _ok)
    {
        <div class="adm-alert adm-alert--success"><i class="bi bi-check-circle-fill me-2"></i>@_ok</div>
    }

    @* KPI Row *@
    <section class="adm-kpi-grid">
        <a class="adm-kpi-card text-decoration-none" asp-controller="AdminApplications" asp-action="Open" style="--kpi-color:***REMOVED***e10600;">
            <div class="adm-kpi-card__icon"><i class="bi bi-inbox-fill"></i></div>
            <div class="adm-kpi-card__body">
                <div class="adm-kpi-card__value">@Model.Statistics.OpenApplications</div>
                <div class="adm-kpi-card__label">Offene Bewerbungen</div>
            </div>
            <i class="bi bi-arrow-right adm-kpi-card__arrow"></i>
        </a>
        <a class="adm-kpi-card text-decoration-none" asp-controller="AdminApplications" asp-action="Accepted" style="--kpi-color:***REMOVED***39ff14;">
            <div class="adm-kpi-card__icon"><i class="bi bi-check2-circle"></i></div>
            <div class="adm-kpi-card__body">
                <div class="adm-kpi-card__value">@Model.Statistics.AcceptedApplications</div>
                <div class="adm-kpi-card__label">Akzeptiert</div>
            </div>
            <i class="bi bi-arrow-right adm-kpi-card__arrow"></i>
        </a>
        <a class="adm-kpi-card text-decoration-none" asp-controller="AdminApplications" asp-action="List" style="--kpi-color:***REMOVED***5b8cff;">
            <div class="adm-kpi-card__icon"><i class="bi bi-people-fill"></i></div>
            <div class="adm-kpi-card__body">
                <div class="adm-kpi-card__value">@Model.Statistics.TotalApplications</div>
                <div class="adm-kpi-card__label">Gesamt</div>
            </div>
            <i class="bi bi-arrow-right adm-kpi-card__arrow"></i>
        </a>
        <div class="adm-kpi-card" style="--kpi-color:***REMOVED***ffb800;">
            <div class="adm-kpi-card__icon"><i class="bi bi-bar-chart-fill"></i></div>
            <div class="adm-kpi-card__body">
                <div class="adm-kpi-card__value">@(Math.Round(Model.Metrics.AcceptanceRate * 100))%</div>
                <div class="adm-kpi-card__label">Annahmequote</div>
            </div>
        </div>
    </section>

    @* Quick Actions *@
    <div class="adm-panel" style="margin-bottom:1.5rem;">
        <div class="adm-panel__head">
            <span class="adm-panel__head-title">
                <i class="bi bi-lightning-charge-fill me-2" style="color:var(--sig-amber);"></i>Schnellzugriff
            </span>
        </div>
        <div class="adm-panel__body">
            <div style="display:flex; gap:.6rem; flex-wrap:wrap;">
                <a class="btn btn-sm btn-primary" asp-controller="AdminApplications" asp-action="Open">
                    <i class="bi bi-inbox me-1"></i>Offene ansehen
                </a>
                <a class="btn btn-sm btn-primary" asp-controller="AdminApplications" asp-action="List">
                    <i class="bi bi-list-ul me-1"></i>Alle anzeigen
                </a>
                <a class="btn btn-sm btn-outline-secondary" asp-controller="AdminApplications" asp-action="Metrics">
                    <i class="bi bi-graph-up me-1"></i>Statistiken
                </a>
                <a class="btn btn-sm btn-outline-secondary" asp-controller="AdminApplications" asp-action="Export">
                    <i class="bi bi-download me-1"></i>CSV Export
                </a>
            </div>
        </div>
    </div>

    <div class="adm-content-grid">

        @* Bewerbungen nach Division *@
        @if (Model.Statistics.ApplicationsByDivision.Count > 0)
        {
            <div class="adm-panel">
                <div class="adm-panel__head">
                    <span class="adm-panel__head-title">
                        <i class="bi bi-diagram-3-fill me-2" style="color:var(--sig-cyan);"></i>Nach Division
                    </span>
                </div>
                <div class="adm-panel__body">
                    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(130px,1fr)); gap:.75rem;">
                        @foreach (var kvp in Model.Statistics.ApplicationsByDivision.OrderByDescending(x => x.Value))
                        {
                            <a href="@Url.Action("ByDivision", "AdminApplications", new { division = kvp.Key })"
                               style="background:var(--surface-2); padding:1rem; border-radius:var(--r-2); text-align:center; text-decoration:none; display:block; border:1px solid var(--stroke-1);">
                                <div style="font-size:1.75rem; font-weight:700; color:@DivBadgeColor(kvp.Key);">@kvp.Value</div>
                                <div style="font-size:.75rem; color:var(--ink-2); margin-top:.35rem; font-weight:600;">@kvp.Key</div>
                            </a>
                        }
                    </div>
                </div>
            </div>
        }

        @* Neueste Bewerbungen *@
        @if (Model.RecentApplications.Count > 0)
        {
            <div class="adm-panel">
                <div class="adm-panel__head">
                    <span class="adm-panel__head-title">
                        <i class="bi bi-clock-history me-2" style="color:var(--sig-cyan);"></i>Neueste Bewerbungen
                    </span>
                    <span style="display:inline-flex; gap:.4rem;">
                        <a href="@Url.Action("Dashboard", new { sort = "newest" })"
                           style="font-size:.72rem; padding:.2rem .6rem; border-radius:999px; text-decoration:none; @(Model.CurrentSort != "oldest" ? "background:var(--sig-cyan);color:***REMOVED***04121a;font-weight:600;" : "background:rgba(255,255,255,.06);color:var(--ink-2);")">
                            <i class="bi bi-sort-down"></i> Neueste
                        </a>
                        <a href="@Url.Action("Dashboard", new { sort = "oldest" })"
                           style="font-size:.72rem; padding:.2rem .6rem; border-radius:999px; text-decoration:none; @(Model.CurrentSort == "oldest" ? "background:var(--sig-cyan);color:***REMOVED***04121a;font-weight:600;" : "background:rgba(255,255,255,.06);color:var(--ink-2);")">
                            <i class="bi bi-sort-up"></i> Älteste
                        </a>
                    </span>
                    <a class="adm-panel__head-action" asp-controller="AdminApplications" asp-action="Open">
                        Alle offenen <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
                <div class="adm-log-list">
                    @foreach (var app in Model.RecentApplications)
                    {
                        <div class="adm-log-item">
                            <div class="adm-log-item__body">
                                <span class="adm-log-item__id">@app.DiscordName</span>
                                <span class="adm-log-item__detail" style="color:@DivBadgeColor(app.Division);">@app.Division</span>
                            </div>
                            <div style="display:flex; align-items:center; gap:.75rem; flex-shrink:0;">
                                <span class="adm-log-item__time">
                                    vor @((DateTime.UtcNow - app.SubmittedAt).TotalHours.ToString("0")) Std.
                                </span>
                                <a class="btn btn-xs btn-outline-secondary"
                                   asp-controller="AdminApplications" asp-action="Detail" asp-route-id="@app.Id">
                                    Ansehen
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

    </div>
</div>
