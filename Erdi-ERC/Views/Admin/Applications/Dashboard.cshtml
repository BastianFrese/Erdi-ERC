@model <OWNER_HANDLE>_ERC.Controllers.ApplicationDashboardViewModel

@{
    ViewData["Title"] = "Bewerbungs-Dashboard";
    ViewData["Kicker"] = "Admin · Bewerbungen";
    ViewData["HeroTitle"] = "Bewerbungen";
    ViewData["HeroSubtitle"] = "Dashboard & Übersicht";
}

@section Styles {
    <style>
        .kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
        .kpi-card { 
            background: var(--surface-1); 
            border: 1px solid var(--stroke-1); 
            border-radius: var(--r-2); 
            padding: 1.5rem; 
            text-align: center;
            box-shadow: var(--sh-2);
        }
        .kpi-value { font-size: 2.5rem; font-weight: 700; color: var(--sig-cyan); }
        .kpi-label { font-size: 0.875rem; color: var(--ink-secondary); margin-top: 0.5rem; }
        .kpi-subtitle { font-size: 0.75rem; color: var(--ink-tertiary); margin-top: 0.25rem; }

        .action-buttons { display: flex; gap: 0.75rem; margin-bottom: 2rem; flex-wrap: wrap; }
        .btn-admin { 
            padding: 0.75rem 1.25rem; 
            border-radius: var(--r-2); 
            border: none; 
            cursor: pointer;
            font-weight: 600;
            transition: all 0.2s;
        }
        .btn-admin--primary { background: var(--sig-cyan); color: white; }
        .btn-admin--primary:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(0, 188, 212, 0.3); }
        .btn-admin--secondary { background: var(--surface-2); color: var(--ink); border: 1px solid var(--stroke-1); }
        .btn-admin--secondary:hover { background: var(--surface-3); }

        .recent-apps { margin-top: 2rem; }
        .app-list-item {
            background: var(--surface-1);
            border-left: 4px solid var(--sig-cyan);
            padding: 1rem;
            border-radius: var(--r-1);
            margin-bottom: 0.75rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .app-info { flex: 1; }
        .app-name { font-weight: 600; color: var(--ink); }
        .app-meta { font-size: 0.875rem; color: var(--ink-secondary); margin-top: 0.25rem; }
        .app-badge { 
            display: inline-block; 
            padding: 0.25rem 0.75rem; 
            border-radius: 999px; 
            font-size: 0.75rem;
            font-weight: 600;
        }
        .badge--main { background: rgba(0, 188, 212, 0.1); color: var(--sig-cyan); }
        .badge--second { background: rgba(255, 152, 0, 0.1); color: ***REMOVED***ff9800; }
        .badge--rookie { background: rgba(76, 175, 80, 0.1); color: ***REMOVED***4caf50; }
        .badge--community { background: rgba(156, 39, 176, 0.1); color: ***REMOVED***9c27b0; }
    </style>
}

<div class="container-fluid py-5">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mb-3">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mb-3">@TempData["Error"]</div>
    }
    @{
        var _err = TempData["Error"] as string;
        if (!string.IsNullOrEmpty(_err) && _err.IndexOf("Konflikt", System.StringComparison.OrdinalIgnoreCase) >= 0)
        {
            <div class="alert alert-warning mb-3">
                <strong>Konflikt erkannt:</strong> Eine Aktion wurde von einem anderen Admin durchgeführt und die Daten haben sich geändert.
                <div style="margin-top:.5rem; display:flex; gap:.5rem;">
                    <button type="button" class="btn btn-sm btn-primary" onclick="if(confirm('Seite neu laden und lokale Ansicht aktualisieren?')) { window.location.href='@Url.Action("Dashboard","AdminApplications")'; }">Neu laden und Ansicht aktualisieren</button>
                    <button type="button" class="btn btn-sm btn-secondary" onclick="window.location.reload();">Seite neu laden</button>
                </div>
            </div>
        }
    }
    <div class="row mb-4">
        <div class="col">
            <h1>Bewerbungs-Dashboard</h1>
            <p class="text-mute">Übersicht über alle Bewerbungen und schnelle Aktionen</p>
        </div>
    </div>

    <!-- KPI Grid -->
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-value">@Model.Statistics.OpenApplications</div>
            <div class="kpi-label">Offene Bewerbungen</div>
            <div class="kpi-subtitle">Warten auf Bearbeitung</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-value">@Model.Statistics.AcceptedApplications</div>
            <div class="kpi-label">Akzeptiert</div>
            <div class="kpi-subtitle">In der letzten Woche</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-value">@Model.Statistics.TotalApplications</div>
            <div class="kpi-label">Gesamt</div>
            <div class="kpi-subtitle">Alle Bewerbungen</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-value">@(Math.Round(Model.Metrics.AcceptanceRate * 100))%</div>
            <div class="kpi-label">Annahmequote</div>
            <div class="kpi-subtitle">Erfolgsquote</div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="action-buttons">
        <a href="@Url.Action("Open", "AdminApplications")" class="btn-admin btn-admin--primary">
            <i class="bi bi-inbox"></i> Offene ansehen
        </a>
        <a href="@Url.Action("List", "AdminApplications")" class="btn-admin btn-admin--primary">
            <i class="bi bi-list-ul"></i> Alle anzeigen
        </a>
        <a href="@Url.Action("Metrics", "AdminApplications")" class="btn-admin btn-admin--secondary">
            <i class="bi bi-graph-up"></i> Statistiken
        </a>
        <a href="@Url.Action("Export", "AdminApplications")" class="btn-admin btn-admin--secondary">
            <i class="bi bi-download"></i> CSV Export
        </a>
    </div>

    <!-- Division Overview -->
    @if (Model.Statistics.ApplicationsByDivision.Count > 0)
    {
        <div style="margin-top: 2rem;">
            <h3>Bewerbungen nach Division</h3>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem;">
                @foreach (var kvp in Model.Statistics.ApplicationsByDivision.OrderByDescending(x => x.Value))
                {
                    var badgeClass = kvp.Key switch
                    {
                        "Main Division 1" => "badge--main",
                        "Second Crossplay Division 2" => "badge--second",
                        "Rookie Crossplay Division 3" => "badge--rookie",
                        "Community Crossplay Event" => "badge--community",
                        _ => "badge--main"
                    };

                    <div style="background: var(--surface-1); padding: 1rem; border-radius: var(--r-2); text-align: center;">
                        <div style="font-size: 1.75rem; font-weight: 700; color: var(--sig-cyan);">@kvp.Value</div>
                        <div style="font-size: 0.875rem; color: var(--ink-secondary); margin-top: 0.5rem;">
                            <a href="@Url.Action("ByDivision", "AdminApplications", new { division = kvp.Key })" style="color: inherit; text-decoration: none; font-weight: 600;">
                                @kvp.Key
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Recent Applications -->
    @if (Model.RecentApplications.Count > 0)
    {
        <div class="recent-apps">
            <h3>Neueste Bewerbungen</h3>
            @foreach (var app in Model.RecentApplications)
            {
                var badgeClass = app.Division switch
                {
                    "Main Division 1" => "badge--main",
                    "Second Crossplay Division 2" => "badge--second",
                    "Rookie Crossplay Division 3" => "badge--rookie",
                    "Community Crossplay Event" => "badge--community",
                    _ => "badge--main"
                };

                <div class="app-list-item">
                    <div class="app-info">
                        <div class="app-name">@app.DiscordName</div>
                        <div class="app-meta">
                            <span class="app-badge @badgeClass">@app.Division</span>
                            <span style="margin-left: 0.5rem;">@app.Role</span>
                            <span style="margin-left: 0.5rem; color: var(--ink-tertiary);">vor @((DateTime.UtcNow - app.SubmittedAt).TotalHours.ToString("0")) Std.</span>
                        </div>
                    </div>
                    <div>
                        <a href="@Url.Action("Detail", "AdminApplications", new { id = app.Id })" class="btn-admin btn-admin--secondary" style="font-size: 0.875rem;">
                            Ansehen
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>
