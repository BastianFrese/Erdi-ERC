@model <OWNER_HANDLE>_ERC.Services.ApplicationFormWithHistory

@{
    ViewData["Title"] = $"Bewerbung von {Model.Application.DiscordName}";
    ViewData["Kicker"] = "Admin · Bewerbungen";
    ViewData["HeroTitle"] = "Bewerbungs-Detail";
    ViewData["HeroSubtitle"] = $"Vollständige Übersicht mit Audit-Trail";
}

@section Styles {
    <style>
        .detail-header {
            background: var(--surface-1);
            border: 1px solid var(--stroke-1);
            border-radius: var(--r-2);
            padding: 2rem;
            margin-bottom: 2rem;
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 2rem;
        }
        .applicant-info { display: flex; gap: 1.5rem; align-items: flex-start; }
        .applicant-avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: var(--sig-cyan);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            color: white;
        }
        .applicant-meta h2 { margin: 0; color: var(--ink); }
        .applicant-meta p { margin: 0.5rem 0; color: var(--ink-secondary); font-size: 0.875rem; }
        .status-large {
            padding: 0.5rem 1rem;
            border-radius: var(--r-2);
            font-weight: 600;
            display: inline-block;
        }
        .status-large--accepted { background: rgba(76, 175, 80, 0.1); color: ***REMOVED***4caf50; }
        .status-large--pending  { background: rgba(255, 193, 7, 0.1); color: ***REMOVED***ffc107; }
        .status-large--review   { background: rgba(0, 188, 212, 0.1); color: ***REMOVED***00bcd4; }
        .status-large--rejected { background: rgba(244, 67, 54, 0.1); color: ***REMOVED***f44336; }
        .status-large--expired  { background: rgba(158, 158, 158, 0.12); color: ***REMOVED***9e9e9e; }

        .info-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-top: 1.5rem; }
        .info-item { background: var(--surface-0); padding: 1rem; border-radius: var(--r-1); }
        .info-label { font-size: 0.75rem; font-weight: 600; color: var(--ink-tertiary); text-transform: uppercase; }
        .info-value { font-size: 1rem; font-weight: 600; color: var(--ink); margin-top: 0.5rem; }

        .action-panel {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }
        .btn-action {
            padding: 0.75rem 1rem;
            border-radius: var(--r-1);
            border: none;
            cursor: pointer;
            font-weight: 600;
            text-align: center;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            transition: all 0.2s;
        }
        .btn-action--success { background: rgba(76, 175, 80, 0.9); color: white; }
        .btn-action--success:hover { background: rgba(76, 175, 80, 1); transform: translateY(-2px); box-shadow: 0 4px 12px rgba(76, 175, 80, 0.3); }
        .btn-action--danger { background: rgba(244, 67, 54, 0.9); color: white; }
        .btn-action--danger:hover { background: rgba(244, 67, 54, 1); }
        .btn-action--secondary { background: var(--surface-2); color: var(--ink); border: 1px solid var(--stroke-1); }
        .btn-action--secondary:hover { background: var(--surface-3); }

        .section { margin-top: 2rem; }
        .section-title { font-size: 1.25rem; font-weight: 700; margin-bottom: 1rem; color: var(--ink); }
        .section-subtitle { font-size: 0.875rem; color: var(--ink-secondary); margin-bottom: 1rem; }

        .timeline { position: relative; padding-left: 2rem; }
        .timeline-item {
            position: relative;
            margin-bottom: 1rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--stroke-1);
        }
        .timeline-item:last-child { border-bottom: none; }
        .timeline-dot {
            position: absolute;
            left: -2.5rem;
            top: 0;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: var(--sig-cyan);
            border: 2px solid var(--surface-0);
        }
        .timeline-time { font-size: 0.75rem; color: var(--ink-tertiary); }
        .timeline-action { font-weight: 600; color: var(--ink); }
        .timeline-details { font-size: 0.875rem; color: var(--ink-secondary); margin-top: 0.25rem; }

        .app-modal-backdrop {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            z-index: 999;
            align-items: center;
            justify-content: center;
        }
        .app-modal-backdrop.active { display: flex; }
        .app-modal { background: var(--surface-0); border-radius: var(--r-2); padding: 2rem; max-width: 500px; width: 90%; }
        .app-modal-close {
            float: right;
            font-size: 1.5rem;
            cursor: pointer;
            color: var(--ink-secondary);
        }
        .app-modal-title { font-size: 1.25rem; font-weight: 700; margin: 1rem 0; clear: both; }
        .app-modal-input {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid var(--stroke-1);
            border-radius: var(--r-1);
            margin-bottom: 1rem;
            font-size: 0.875rem;
        }
    </style>
}

<div class="container-fluid py-5">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mb-3">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mb-3">@TempData["Error"]</div>
    }
    @{
        var _err = TempData["Error"] as string;
        if (!string.IsNullOrEmpty(_err) && _err.IndexOf("Konflikt", System.StringComparison.OrdinalIgnoreCase) >= 0)
        {
            <div class="alert alert-warning mb-3">
                <strong>Konflikt erkannt:</strong> Die Bewerbung wurde zwischenzeitlich von jemand anderem geändert.
                <div style="margin-top:.5rem; display:flex; gap:.5rem;">
                    <button type="button" class="btn btn-sm btn-primary" onclick="if(confirm('Seite neu laden und lokale Aktion verwerfen?')) { window.location.href='@Url.Action("Detail","AdminApplications", new { id = Model.Application.Id })'; }">Neu laden und Änderungen verwerfen</button>
                    <button type="button" class="btn btn-sm btn-secondary" onclick="window.location.reload();">Seite neu laden</button>
                </div>
            </div>
        }
    }
    <!-- Header mit Status -->
    <div class="detail-header">
        <div>
            <div class="applicant-info">
                <div class="applicant-avatar">
                    @(string.IsNullOrEmpty(Model.Application.DiscordName) ? '?' : Model.Application.DiscordName[0])
                </div>
                <div class="applicant-meta">
                    <h2>@Model.Application.DiscordName</h2>
                    <p>
                        <strong>EA-Name:</strong> @Model.Application.GamingName
                        <span class="text-mute small ms-2">(@Model.Application.Platform)</span>
                    </p>
                    <p>
                        <strong>Alter:</strong> @Model.Application.Age Jahre
                    </p>
                    <div style="margin-top: 0.75rem;">
                        @{
                            var (badgeClass, badgeText) = Model.Status switch
                            {
                                <OWNER_HANDLE>_ERC.Services.ApplicationStatus.Expired => ("status-large--expired", "⏰ Abgelaufen"),
                                _ => Model.Application.ReviewStatus switch
                                {
                                    <OWNER_HANDLE>_ERC.Models.ApplicationReviewStatus.Accepted => ("status-large--accepted", "✓ Akzeptiert"),
                                    <OWNER_HANDLE>_ERC.Models.ApplicationReviewStatus.Rejected => ("status-large--rejected", "✗ Abgelehnt"),
                                    <OWNER_HANDLE>_ERC.Models.ApplicationReviewStatus.InReview => ("status-large--review",   "🔍 In Review"),
                                    _ => Model.Application.IsAccepted
                                        ? ("status-large--accepted", "✓ Akzeptiert")
                                        : ("status-large--pending",  "⏳ Offen")
                                }
                            };
                        }
                        <span class="status-large @badgeClass">@badgeText</span>
                    </div>
                </div>
            </div>

            <div class="info-grid">
                <div class="info-item">
                    <div class="info-label">Division</div>
                    <div class="info-value">@Model.Application.Division</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Rolle</div>
                    <div class="info-value">@Model.Application.Role</div>
                </div>
                <div class="info-item">
                    <div class="info-label">AI Level</div>
                    <div class="info-value">@Model.Application.AiLevel</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Eingereicht</div>
                    <div class="info-value">@Model.Application.SubmittedAt.ToString("dd.MM.yyyy")</div>
                </div>
            </div>
        </div>

        <!-- Action Panel -->
        <div class="action-panel">
            @if (!Model.Application.IsAccepted)
            {
                <button class="btn-action btn-action--success" onclick="showModal('acceptModal')">
                    <i class="bi bi-check-circle"></i> Akzeptieren
                </button>
                <button class="btn-action btn-action--danger" onclick="showModal('rejectModal')">
                    <i class="bi bi-x-circle"></i> Ablehnen
                </button>
                <button class="btn-action btn-action--secondary" onclick="showModal('flagModal')">
                    <i class="bi bi-flag"></i> Zur Überprüfung
                </button>
            }
            else
            {
                <button class="btn-action btn-action--danger" onclick="showModal('unacceptModal')">
                    <i class="bi bi-arrow-counterclockwise"></i> Akzeptanz rückgängig
                </button>
            }
            <button class="btn-action btn-action--secondary" onclick="showModal('reviewStatusModal')"
                    title="Review-Status (Open/InReview/Accepted/Rejected) setzen">
                <i class="bi bi-diagram-3"></i> Review-Status
                @if (Model.Application.ReviewStatus != <OWNER_HANDLE>_ERC.Models.ApplicationReviewStatus.Open)
                {
                    <span class="badge bg-secondary ms-1" style="font-size:.65rem;">@Model.Application.ReviewStatus</span>
                }
            </button>
            <button class="btn-action btn-action--secondary" onclick="showModal('assignRoleModal')"
                    title="Finale Fahrer-Rolle nach Annahme zuweisen">
                <i class="bi bi-person-check"></i> Rolle zuweisen
                @if (!string.IsNullOrEmpty(Model.Application.AssignedRole))
                {
                    <span class="badge bg-primary ms-1" style="font-size:.65rem;">@Model.Application.AssignedRole</span>
                }
            </button>
            <a href="@Url.Action("Dashboard", "AdminApplications")" class="btn-action btn-action--secondary">
                <i class="bi bi-arrow-left"></i> Zurück
            </a>
        </div>
    </div>

    <!-- Audit Trail -->
    <div class="section">
        <h3 class="section-title">Bearbeitungs-Historie</h3>
        <p class="section-subtitle">Alle Aktionen zu dieser Bewerbung:</p>

        @if (Model.AuditHistory.Count > 0)
        {
            <div class="timeline">
                @foreach (var entry in Model.AuditHistory)
                {
                    <div class="timeline-item">
                        <div class="timeline-dot"></div>
                        <div class="timeline-time">@entry.CreatedAt.ToString("dd.MM.yyyy HH:mm")</div>
                        <div class="timeline-action">@entry.Action</div>
                        <div class="timeline-details">
                            Von: @entry.Actor
                            @if (!string.IsNullOrEmpty(entry.Details))
                            {
                                <div>Grund: @entry.Details</div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p style="color: var(--ink-secondary); font-style: italic;">Noch keine Aktionen</p>
        }
    </div>

    <!-- Discord Info -->
    @if (!string.IsNullOrEmpty(Model.Application.DiscordId))
    {
        <div class="section">
            <h3 class="section-title">Discord-Informationen</h3>
            <div class="info-grid">
                <div class="info-item">
                    <div class="info-label">Discord ID</div>
                    <div class="info-value" style="font-family: monospace; font-size: 0.875rem;">@Model.Application.DiscordId</div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modals -->
<div id="acceptModal" class="app-modal-backdrop">
    <div class="app-modal">
        <span class="app-modal-close" onclick="closeModal('acceptModal')">&times;</span>
        <h3 class="app-modal-title">Bewerbung akzeptieren</h3>
        <form method="post" action="@Url.Action("Accept", "AdminApplications", new { id = Model.Application.Id })">
            @Html.AntiForgeryToken()
            <p>Sind Sie sicher, dass Sie diese Bewerbung akzeptieren möchten?</p>
            <button type="submit" class="btn-action btn-action--success" style="width: 100%;">
                <i class="bi bi-check-circle"></i> Ja, akzeptieren
            </button>
            <button type="button" class="btn-action btn-action--secondary" style="width: 100%;" onclick="closeModal('acceptModal')">
                Abbrechen
            </button>
        </form>
    </div>
</div>

<div id="rejectModal" class="app-modal-backdrop">
    <div class="app-modal">
        <span class="app-modal-close" onclick="closeModal('rejectModal')">&times;</span>
        <h3 class="app-modal-title">Bewerbung ablehnen</h3>
        <form method="post" action="@Url.Action("Reject", "AdminApplications", new { id = Model.Application.Id })">
            @Html.AntiForgeryToken()
            <label style="display: block; margin-bottom: 0.5rem;">Grund für Ablehnung:</label>
            <textarea name="reason" class="app-modal-input" rows="3" required placeholder="z.B. Keine freien Plätze in dieser Division"></textarea>
            <button type="submit" class="btn-action btn-action--danger" style="width: 100%;">
                <i class="bi bi-x-circle"></i> Ablehnen
            </button>
            <button type="button" class="btn-action btn-action--secondary" style="width: 100%;" onclick="closeModal('rejectModal')">
                Abbrechen
            </button>
        </form>
    </div>
</div>

<div id="unacceptModal" class="app-modal-backdrop">
    <div class="app-modal">
        <span class="app-modal-close" onclick="closeModal('unacceptModal')">&times;</span>
        <h3 class="app-modal-title">Akzeptanz rückgängig machen</h3>
        <form method="post" action="@Url.Action("Unaccept", "AdminApplications", new { id = Model.Application.Id })">
            @Html.AntiForgeryToken()
            <label style="display: block; margin-bottom: 0.5rem;">Grund:</label>
            <textarea name="reason" class="app-modal-input" rows="3" required placeholder="z.B. Benutzer hat sich gegen Teilnahme entschieden"></textarea>
            <button type="submit" class="btn-action btn-action--danger" style="width: 100%;">
                <i class="bi bi-arrow-counterclockwise"></i> Rückgängig
            </button>
            <button type="button" class="btn-action btn-action--secondary" style="width: 100%;" onclick="closeModal('unacceptModal')">
                Abbrechen
            </button>
        </form>
    </div>
</div>

<div id="flagModal" class="app-modal-backdrop">
    <div class="app-modal">
        <span class="app-modal-close" onclick="closeModal('flagModal')">&times;</span>
        <h3 class="app-modal-title">Zur Überprüfung kennzeichnen</h3>
        <form method="post" action="@Url.Action("Flag", "AdminApplications", new { id = Model.Application.Id })">
            @Html.AntiForgeryToken()
            <label style="display: block; margin-bottom: 0.5rem;">Grund für Kennzeichnung:</label>
            <textarea name="reason" class="app-modal-input" rows="3" required placeholder="z.B. Verdächtige Aktivität, benötigt weitere Überprüfung"></textarea>
            <button type="submit" class="btn-action btn-action--secondary" style="width: 100%;">
                <i class="bi bi-flag"></i> Kennzeichnen
            </button>
            <button type="button" class="btn-action btn-action--secondary" style="width: 100%;" onclick="closeModal('flagModal')">
                Abbrechen
            </button>
        </form>
    </div>
</div>

@* ── Review-Status Modal ────────────────────────────────────────────── *@
<div id="reviewStatusModal" class="app-modal-backdrop">
    <div class="app-modal">
        <span class="app-modal-close" onclick="closeModal('reviewStatusModal')">&times;</span>
        <h3 class="app-modal-title">Review-Status setzen</h3>
        <form method="post" action="@Url.Action("SetReviewStatus", "AdminApplications", new { id = Model.Application.Id })">
            @Html.AntiForgeryToken()
            <div style="margin-bottom:1rem;">
                <label style="display:block;margin-bottom:.5rem;font-size:.8rem;color:var(--ink-3);">Status</label>
                <select name="status" class="app-modal-input" required>
                    @foreach (var s in Enum.GetValues<<OWNER_HANDLE>_ERC.Models.ApplicationReviewStatus>())
                    {
                        if (Model.Application.ReviewStatus == s)
                        {
                            <option value="@((int)s)" selected>@s</option>
                        }
                        else
                        {
                            <option value="@((int)s)">@s</option>
                        }
                    }
                </select>
            </div>
            <div style="margin-bottom:1rem;">
                <label style="display:block;margin-bottom:.5rem;font-size:.8rem;color:var(--ink-3);">Notiz (optional)</label>
                <textarea name="note" class="app-modal-input" rows="2" placeholder="Interne Notiz...">@Model.Application.ReviewNote</textarea>
            </div>
            <button type="submit" class="btn-action btn-action--primary" style="width:100%;">
                <i class="bi bi-check2-circle"></i> Status speichern
            </button>
            <button type="button" class="btn-action btn-action--secondary" style="width:100%;margin-top:.5rem;" onclick="closeModal('reviewStatusModal')">Abbrechen</button>
        </form>
    </div>
</div>

@* ── Rollen-Zuweisung Modal ─────────────────────────────────────────── *@
<div id="assignRoleModal" class="app-modal-backdrop">
    <div class="app-modal">
        <span class="app-modal-close" onclick="closeModal('assignRoleModal')">&times;</span>
        <h3 class="app-modal-title">Fahrer-Rolle zuweisen</h3>
        @if (Model.Application.ReviewStatus != <OWNER_HANDLE>_ERC.Models.ApplicationReviewStatus.Accepted)
        {
            <p style="color:var(--sig-amber);font-size:.85rem;"><i class="bi bi-exclamation-triangle me-1"></i>Bewerbung muss zuerst angenommen werden.</p>
        }
        else
        {
            <form method="post" action="@Url.Action("AssignRole", "AdminApplications", new { id = Model.Application.Id })">
                @Html.AntiForgeryToken()
                <div style="margin-bottom:1rem;">
                    <label style="display:block;margin-bottom:.5rem;font-size:.8rem;color:var(--ink-3);">Rolle</label>
                    <select name="assignedRole" class="app-modal-input" required>
                        <option value="">– Rolle wählen –</option>
                        @foreach (var role in new[]{ "Stammfahrer", "Ersatzfahrer", "Academy" })
                        {
                            if (Model.Application.AssignedRole == role)
                            {
                                <option value="@role" selected>@role</option>
                            }
                            else
                            {
                                <option value="@role">@role</option>
                            }
                        }
                    </select>
                </div>
                <button type="submit" class="btn-action btn-action--primary" style="width:100%;">
                    <i class="bi bi-person-check"></i> Rolle zuweisen
                </button>
                <button type="button" class="btn-action btn-action--secondary" style="width:100%;margin-top:.5rem;" onclick="closeModal('assignRoleModal')">Abbrechen</button>
            </form>
        }
    </div>
</div>
<script>
    function showModal(modalId) {
        document.getElementById(modalId).classList.add('active');
    }
    function closeModal(modalId) {
        document.getElementById(modalId).classList.remove('active');
    }
    // Close modal when clicking outside
    document.querySelectorAll('.app-modal-backdrop').forEach(backdrop => {
        backdrop.addEventListener('click', function(e) {
            if (e.target === this) {
                this.classList.remove('active');
            }
        });
    });
</script>
