@{
    ViewData["Title"] = "Bewerbung";
    ViewData["Kicker"] = "Bewerbungen";
    ViewData["HeroTitle"] = "Bewerbung – Detail";

    var app = ViewBag.App as <OWNER_HANDLE>_ERC.Models.Application;
    var deciderName = ViewBag.DeciderName as string;

    string StatusBadge(int s) => ((<OWNER_HANDLE>_ERC.Models.ApplicationStatus)s) switch
    {
        <OWNER_HANDLE>_ERC.Models.ApplicationStatus.Pending   => "f1-chip f1-chip--amber",
        <OWNER_HANDLE>_ERC.Models.ApplicationStatus.Accepted  => "f1-chip f1-chip--green",
        <OWNER_HANDLE>_ERC.Models.ApplicationStatus.Rejected  => "f1-chip f1-chip--red",
        _                                          => "f1-chip"
    };
    string StatusLabel(int s) => ((<OWNER_HANDLE>_ERC.Models.ApplicationStatus)s) switch
    {
        <OWNER_HANDLE>_ERC.Models.ApplicationStatus.Pending   => "In Prüfung",
        <OWNER_HANDLE>_ERC.Models.ApplicationStatus.Accepted  => "Angenommen",
        <OWNER_HANDLE>_ERC.Models.ApplicationStatus.Rejected  => "Abgelehnt",
        _                                          => s.ToString()
    };
}

<div class="adm-dashboard">

    <div class="adm-back-bar">
        <a class="btn btn-ghost btn-sm" asp-action="List">
            <i class="bi bi-arrow-left"></i> Zurück zur Liste
        </a>
    </div>

    @if (app == null)
    {
        <div class="adm-empty"><i class="bi bi-question-circle"></i><p>Bewerbung nicht gefunden.</p></div>
    }
    else
    {
        @* Stammdaten *@
        <div class="adm-panel">
            <div class="adm-panel__head">
                <span class="adm-panel__head-title">
                    <i class="bi bi-person-vcard-fill me-2" style="color:***REMOVED***22d3ee;"></i>
                    <span>@app.DiscordName</span>
                    <span class="@StatusBadge(app.Status) ms-2">@StatusLabel(app.Status)</span>
                </span>
            </div>
            <div class="adm-panel__body">
                <dl class="adm-dl">
                    <dt>Discord-ID</dt>            <dd><code>@app.DiscordId</code></dd>
                    <dt>Liga</dt>                  <dd>@(app.TargetLeague?.Name ?? app.TargetLeagueId)</dd>
                    <dt>Rolle</dt>                 <dd>@app.Role</dd>
                    <dt>Gamer-Tag</dt>             <dd>@app.GamerTag</dd>
                    <dt>Plattform</dt>             <dd>@app.Platform</dd>
                    <dt>Eingereicht</dt>           <dd>@app.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>
                    @if (app.DecidedAt is not null)
                    {
                        <dt>Entschieden</dt>      <dd>@app.DecidedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>
                        <dt>Von</dt>              <dd>@(deciderName ?? "–")</dd>
                    }
                    @if (app.DiscordJoinWarning)
                    {
                        <dt>Discord-Warnung</dt>  <dd><i class="bi bi-exclamation-triangle-fill text-warning"></i> @(app.DiscordJoinWarningDetail ?? "Bewerber ist nicht im Community- oder Liga-Discord")</dd>
                    }
                </dl>

                @if (!string.IsNullOrWhiteSpace(app.Motivation))
                {
                    <div class="adm-motivation">
                        <h3><i class="bi bi-chat-quote me-1"></i> Motivation</h3>
                        <blockquote>@app.Motivation</blockquote>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(app.ReviewNote))
                {
                    <div class="adm-review-note">
                        <h3><i class="bi bi-sticky me-1"></i> Admin-Notiz</h3>
                        <blockquote>@app.ReviewNote</blockquote>
                    </div>
                }
            </div>
        </div>

        @* Aktionen *@
        @if (app.Status == (int)<OWNER_HANDLE>_ERC.Models.ApplicationStatus.Pending)
        {
            <div class="adm-panel">
                <div class="adm-panel__head">
                    <span class="adm-panel__head-title">
                        <i class="bi bi-check2-square me-2" style="color:***REMOVED***22d3ee;"></i>
                        <span>Entscheiden</span>
                    </span>
                </div>
                <div class="adm-panel__body">
                    <div class="adm-action-grid">
                        <form asp-action="Accept" method="post" class="adm-action-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@app.Id" />
                            <label class="adm-form-label">Notiz (optional)</label>
                            <textarea name="note" class="adm-form-textarea" rows="2"
                                      placeholder="Wird beim Accept gespeichert und ist für den Bewerber sichtbar."></textarea>
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-circle-fill"></i> Annehmen
                            </button>
                        </form>

                        <form asp-action="Reject" method="post" class="adm-action-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@app.Id" />
                            <label class="adm-form-label">Grund (optional)</label>
                            <textarea name="note" class="adm-form-textarea" rows="2"
                                      placeholder="Wird beim Reject gespeichert."></textarea>
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-x-circle-fill"></i> Ablehnen
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="adm-alert">
                <i class="bi bi-info-circle-fill"></i>
                Diese Bewerbung wurde bereits @(app.Status == (int)<OWNER_HANDLE>_ERC.Models.ApplicationStatus.Accepted ? "angenommen" : "abgelehnt") –
                eine erneute Entscheidung ist nicht möglich.
            </div>
        }
    }
</div>