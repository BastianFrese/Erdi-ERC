@using <OWNER_HANDLE>_ERC.Services
@model ReSortResult

@{
    ViewData["Title"] = "Liga-Neuzuordnung";
    ViewData["Kicker"] = "Admin · Bewerbungen";
    ViewData["HeroTitle"] = "Bewerbungen";
    ViewData["HeroSubtitle"] = "Liga-Neuzuordnung";
}

<div class="adm-dashboard">

    @if (TempData["Error"] is string _err)
    {
        <div class="adm-alert adm-alert--danger"><i class="bi bi-x-circle-fill me-2"></i>@_err</div>
    }
    @if (TempData["Success"] is string _ok)
    {
        <div class="adm-alert adm-alert--success"><i class="bi bi-check-circle-fill me-2"></i>@_ok</div>
    }

    <section class="adm-kpi-grid" style="--kpi-cols:3;">
        <div class="adm-kpi-card" style="--kpi-color:***REMOVED***e10600;">
            <div class="adm-kpi-card__icon"><i class="bi bi-arrow-repeat"></i></div>
            <div class="adm-kpi-card__body">
                <div class="adm-kpi-card__value">@Model.ToUpdate.Count</div>
                <div class="adm-kpi-card__label">Werden aktualisiert</div>
            </div>
        </div>
        <div class="adm-kpi-card" style="--kpi-color:***REMOVED***4caf50;">
            <div class="adm-kpi-card__icon"><i class="bi bi-check-circle"></i></div>
            <div class="adm-kpi-card__body">
                <div class="adm-kpi-card__value">@Model.Unchanged.Count</div>
                <div class="adm-kpi-card__label">Bereits korrekt</div>
            </div>
        </div>
        <div class="adm-kpi-card" style="--kpi-color:***REMOVED***ff9800;">
            <div class="adm-kpi-card__icon"><i class="bi bi-question-circle"></i></div>
            <div class="adm-kpi-card__body">
                <div class="adm-kpi-card__value">@Model.Unmatched.Count</div>
                <div class="adm-kpi-card__label">Kein Treffer</div>
            </div>
        </div>
    </section>

    @if (Model.ToUpdate.Count > 0)
    {
        <section class="adm-section mt-4">
            <h2 class="adm-section__title">Werden zugeordnet (@Model.ToUpdate.Count)</h2>
            <p class="text-muted small">Diese Bewerbungen erhalten eine neue <code>AppliedLeagueId</code> — kein Annehmen, nur Zuordnung.</p>
            <div class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead>
                        <tr>
                            <th>***REMOVED***</th>
                            <th>Discord</th>
                            <th>Division</th>
                            <th>Alt</th>
                            <th>Neu</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model.ToUpdate)
                        {
                            <tr>
                                <td class="text-muted">@e.App.Id</td>
                                <td>@e.App.DiscordName</td>
                                <td><span class="badge" style="background:var(--sig-cyan);color:***REMOVED***000;">@e.App.Division</span></td>
                                <td><code class="text-danger">@(e.PreviousLeagueId ?? "—")</code></td>
                                <td><code class="text-success">@e.League?.Id</code></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (Model.Unmatched.Count > 0)
    {
        <section class="adm-section mt-4">
            <h2 class="adm-section__title">Kein Treffer (@Model.Unmatched.Count)</h2>
            <p class="text-muted small">Diese Bewerbungen haben eine Division, die keiner aktiven Liga entspricht. Sie werden nicht verändert.</p>
            <div class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead>
                        <tr>
                            <th>***REMOVED***</th>
                            <th>Discord</th>
                            <th>Division</th>
                            <th>Grund</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model.Unmatched)
                        {
                            <tr>
                                <td class="text-muted">@e.App.Id</td>
                                <td>@e.App.DiscordName</td>
                                <td><span class="badge bg-secondary">@(e.App.Division ?? "—")</span></td>
                                <td class="text-muted small">@e.Reason</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (Model.ToUpdate.Count == 0 && Model.Unmatched.Count == 0)
    {
        <div class="adm-alert adm-alert--success mt-4">
            <i class="bi bi-check-circle-fill me-2"></i>
            Alle @Model.Unchanged.Count offenen Bewerbungen sind bereits korrekt zugeordnet. Nichts zu tun.
        </div>
    }

    <div class="d-flex gap-3 mt-4">
        @if (Model.ToUpdate.Count > 0)
        {
            <form method="post" asp-controller="AdminApplications" asp-action="ReSortLeaguesExecute"
                  onsubmit="return confirm('@Model.ToUpdate.Count Bewerbung(en) jetzt zuordnen?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-lightning-fill me-1"></i> Jetzt @Model.ToUpdate.Count zuordnen
                </button>
            </form>
        }
        <a asp-controller="AdminApplications" asp-action="Dashboard" class="btn btn-outline-secondary">Zurück</a>
    </div>

</div>
