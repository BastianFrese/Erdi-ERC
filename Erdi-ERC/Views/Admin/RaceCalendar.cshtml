@using Erdi_ERC.Models
@{
    ViewData["Title"] = "Race Calendar";
    ViewData["Kicker"] = "Community";
    ViewData["HeroTitle"] = "Race Calendar";

    var settings = (RaceCalendarSettings?)ViewBag.Settings ?? new RaceCalendarSettings();
    var leagues  = (ViewBag.Leagues  as List<League>)        ?? new List<League>();
    var weekends = (ViewBag.Weekends as List<RaceWeekend>)   ?? new List<RaceWeekend>();

    var today    = DateTime.Today;
    var bgUrl    = string.IsNullOrWhiteSpace(settings.BackgroundImageFileName)
                    ? null
                    : "/uploads/calendar/" + settings.BackgroundImageFileName;

    var allLegs     = weekends.SelectMany(w => w.Legs).ToList();
    var upcomingLegs = allLegs.Count(l => l.Date >= today);
    var pastLegs     = allLegs.Count - upcomingLegs;

    int[] distancePresets = new[] { 25, 35, 50, 100 };
    int nextOrder = (weekends.Count == 0 ? 1 : weekends.Max(w => w.Order) + 1);
}

@section Styles {
<style>
    .rc-bg-preview {
        width: 100%; aspect-ratio: 16/9; border-radius: var(--r-3); overflow: hidden;
        border: 1px solid var(--stroke-1); background: var(--surface-2);
        display: flex; align-items: center; justify-content: center; color: var(--ink-3); font-size: .85rem;
        background-size: cover; background-position: center;
    }
    .rc-bg-preview--empty { background: repeating-linear-gradient(45deg, var(--surface-2), var(--surface-2) 8px, var(--surface-1) 8px, var(--surface-1) 16px); }

    .rc-settings-grid { display: grid; grid-template-columns: 320px 1fr; gap: 1.25rem; align-items: start; }
    .rc-settings-submit { margin-top: 1rem; display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
    @@media (max-width: 800px) { .rc-settings-grid { grid-template-columns: 1fr; } }

    .rc-weekend-card { margin-top: 1rem; border: 1px solid var(--stroke-1); border-radius: var(--r-3); background: var(--surface-1); overflow: hidden; }
    .rc-weekend-card__head { padding: .6rem .9rem; border-bottom: 1px solid var(--stroke-1); display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; background: linear-gradient(180deg, rgba(255,255,255,.025), transparent); }
    .rc-weekend-card__title { font: 700 .82rem/1 var(--ff-tech); letter-spacing: .08em; text-transform: uppercase; color: var(--ink); }
    .rc-weekend-card__pill { font: 700 .62rem/1 var(--ff-tech); letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3); border: 1px solid var(--stroke-1); padding: .25rem .5rem; border-radius: 999px; background: var(--surface-2); }
    .rc-weekend-card__body { padding: .85rem; }

    .rc-weekend-row { display: grid; grid-template-columns: 80px 1fr 110px; gap: .55rem; align-items: center; }
    .rc-weekend-row input[type=text], .rc-weekend-row input[type=number], .rc-weekend-row select { background: var(--surface-2); border: 1px solid var(--stroke-1); color: var(--ink); padding: .35rem .55rem; border-radius: var(--r-2); font-size: .82rem; width: 100%; }
    .rc-weekend-row__label { font: 700 .58rem/1 var(--ff-tech); letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3); margin-bottom: .25rem; }

    .rc-legs { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: .6rem; margin-top: .85rem; }
    .rc-leg { display: flex; flex-direction: column; gap: .25rem; padding: .55rem .7rem; border: 1px solid var(--stroke-1); border-radius: var(--r-2); background: var(--surface-2); }
    .rc-leg__head { display: flex; justify-content: space-between; gap: .5rem; align-items: center; }
    .rc-leg__league { font: 700 .72rem/1 var(--ff-tech); color: var(--ink); letter-spacing: .06em; text-transform: uppercase; }
    .rc-leg__hint  { font-size: .68rem; color: var(--ink-3); }
    .rc-leg input[type=datetime-local] { background: var(--surface-1); border: 1px solid var(--stroke-1); color: var(--ink); padding: .3rem .45rem; border-radius: var(--r-2); font-size: .8rem; }

    .rc-weekend-actions { display: flex; gap: .4rem; justify-content: flex-end; margin-top: .85rem; }
    .rc-add-weekend { margin-top: 1.25rem; padding: .85rem; border: 1px dashed var(--stroke-2); border-radius: var(--r-3); background: rgba(91,140,255,.04); }
    @@media (max-width: 700px) {
        .rc-weekend-row { grid-template-columns: 1fr 1fr; }
        .rc-weekend-row > div:nth-child(1) { grid-column: 1 / -1; }
    }
</style>
}

<div class="adm-dashboard">

    @if (TempData["AdminMessage"] is string msg && !string.IsNullOrWhiteSpace(msg))
    {
        <div class="alert alert-info py-2 px-3 mb-3" role="status">@msg</div>
    }

    @* KPI *@
    <section class="adm-kpi-grid" style="grid-template-columns:repeat(4,1fr);">
        <div class="adm-kpi-card" style="--kpi-color:#5b8cff;">
            <div class="adm-kpi-card__icon"><i class="bi bi-calendar3"></i></div>
            <div class="adm-kpi-card__body">
                <div class="adm-kpi-card__value">@weekends.Count</div>
                <div class="adm-kpi-card__label">Wochenenden</div>
            </div>
        </div>
        <div class="adm-kpi-card" style="--kpi-color:#39ff14;">
            <div class="adm-kpi-card__icon"><i class="bi bi-calendar-check-fill"></i></div>
            <div class="adm-kpi-card__body">
                <div class="adm-kpi-card__value">@upcomingLegs</div>
                <div class="adm-kpi-card__label">Anstehende Termine</div>
            </div>
        </div>
        <div class="adm-kpi-card" style="--kpi-color:#888;">
            <div class="adm-kpi-card__icon"><i class="bi bi-calendar-x"></i></div>
            <div class="adm-kpi-card__body">
                <div class="adm-kpi-card__value">@pastLegs</div>
                <div class="adm-kpi-card__label">Vergangen</div>
            </div>
        </div>
        <div class="adm-kpi-card" style="--kpi-color:#c78cff;">
            <div class="adm-kpi-card__icon"><i class="bi bi-trophy-fill"></i></div>
            <div class="adm-kpi-card__body">
                <div class="adm-kpi-card__value">@leagues.Count</div>
                <div class="adm-kpi-card__label">Aktive Ligen</div>
            </div>
        </div>
    </section>

    @* Settings *@
    <div class="adm-panel">
        <div class="adm-panel__head">
            <span class="adm-panel__head-title">
                <i class="bi bi-image-fill me-2" style="color:#5b8cff;"></i>Render-Settings (Hintergrund &amp; Saison-Titel)
            </span>
            <a class="btn btn-sm btn-outline-secondary" asp-controller="Races" asp-action="RaceCalendar" target="_blank">
                <i class="bi bi-eye me-1"></i>Vorschau öffnen
            </a>
        </div>
        <div class="adm-panel__body">
            <form asp-action="SaveSettings" method="post" enctype="multipart/form-data" id="rcSettingsForm">
                @Html.AntiForgeryToken()

                <div class="rc-settings-grid">
                    <div>
                        <label class="adm-form-label">Hintergrundbild</label>
                        <div class="rc-bg-preview @(bgUrl is null ? "rc-bg-preview--empty" : "")"
                             style="@(bgUrl is null ? "" : $"background-image:url('{bgUrl}')")">
                            @if (bgUrl is null) { <span>Kein Hintergrund hochgeladen</span> }
                        </div>
                        <input class="form-control form-control-sm mt-2" name="backgroundImage" type="file" accept="image/*" />
                        @if (bgUrl is not null)
                        {
                            <div class="adm-check-label mt-2">
                                <input class="adm-checkbox" type="checkbox" name="removeBackground" value="true" id="rmBgChk" />
                                <label class="adm-check-text" for="rmBgChk" style="color:#ff6b6b;">Hintergrundbild entfernen</label>
                            </div>
                        }
                        <div class="small text-muted mt-1">jpg, png, gif, webp, avif · max. 10 MB</div>
                    </div>

                    <div>
                        <div class="mb-3">
                            <label class="adm-form-label">Saison-Titel</label>
                            <input class="form-control form-control-sm" name="seasonTitle" maxlength="120"
                                   value="@settings.SeasonTitle" placeholder="z.B. ERC Season 2026" />
                        </div>
                        <div class="mb-3">
                            <label class="adm-form-label">Saison-Untertitel</label>
                            <input class="form-control form-control-sm" name="seasonSubtitle" maxlength="240"
                                   value="@settings.SeasonSubtitle" placeholder="Kurzer Untertitel oder Slogan" />
                        </div>
                    </div>
                </div>

                <div class="rc-settings-submit">
                    <button class="btn btn-sm btn-primary" type="submit">
                        <i class="bi bi-check-lg me-1"></i>Einstellungen speichern
                    </button>
                    <span class="small text-muted ms-2">
                        Letztes Update: @settings.UpdatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    </span>
                </div>
            </form>
        </div>
    </div>

    @* Race Weekends *@
    <div class="adm-panel">
        <div class="adm-panel__head">
            <span class="adm-panel__head-title">
                <i class="bi bi-calendar2-event-fill me-2" style="color:var(--accent);"></i>Renn-Wochenenden
            </span>
            <span class="adm-badge">@weekends.Count</span>
        </div>
        <div class="adm-panel__body">

            @if (leagues.Count == 0)
            {
                <div class="adm-empty"><i class="bi bi-calendar-x adm-empty__icon"></i><span>Keine aktiven Ligen vorhanden — Wochenenden brauchen mindestens eine Liga.</span></div>
            }
            else
            {
                @foreach (var w in weekends)
                {
                    <div class="rc-weekend-card">
                        <div class="rc-weekend-card__head">
                            <span class="rc-weekend-card__title">#@w.Order · @w.Track</span>
                            <span class="rc-weekend-card__pill">@w.DistancePercent% Race</span>
                            <span class="rc-weekend-card__pill">@w.Legs.Count Liga-Termin(e)</span>
                        </div>
                        <div class="rc-weekend-card__body">
                            <form asp-action="SaveWeekend" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@w.Id" />

                                <div class="rc-weekend-row">
                                    <div>
                                        <div class="rc-weekend-row__label">Reihenfolge</div>
                                        <input type="number" name="order" min="0" value="@w.Order" required />
                                    </div>
                                    <div>
                                        <div class="rc-weekend-row__label">Strecke</div>
                                        <input type="text" name="track" required maxlength="128" value="@w.Track" placeholder="z.B. Australien" />
                                    </div>
                                    <div>
                                        <div class="rc-weekend-row__label">Distanz</div>
                                        <select name="distancePercent">
                                            @foreach (var p in distancePresets)
                                            {
                                                if (p == w.DistancePercent)
                                                {
                                                    <option value="@p" selected>@p% Race</option>
                                                }
                                                else
                                                {
                                                    <option value="@p">@p% Race</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="rc-legs">
                                    @foreach (var league in leagues)
                                    {
                                        var existing = w.Legs.FirstOrDefault(l => l.LeagueId == league.Id);
                                        <div class="rc-leg">
                                            <div class="rc-leg__head">
                                                <span class="rc-leg__league">@league.Name</span>
                                                @if (existing is null)
                                                {
                                                    <span class="rc-leg__hint">leer = kein Termin</span>
                                                }
                                            </div>
                                            <input type="hidden" name="legLeagueIds" value="@league.Id" />
                                            <input type="datetime-local" name="legDates"
                                                   value="@(existing?.Date.ToString("yyyy-MM-ddTHH:mm") ?? "")" />
                                        </div>
                                    }
                                </div>

                                <div class="rc-weekend-actions">
                                    <button class="btn btn-sm btn-outline-success" type="submit">
                                        <i class="bi bi-check-lg me-1"></i>Speichern
                                    </button>
                                </div>
                            </form>

                            <form asp-action="DeleteWeekend" method="post" class="mt-2"
                                  onsubmit="return confirm('Wochenende @w.Track wirklich löschen? Alle Liga-Termine dieses Wochenendes gehen verloren.');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@w.Id" />
                                <button class="btn btn-xs btn-outline-danger" type="submit">
                                    <i class="bi bi-trash3 me-1"></i>Wochenende löschen
                                </button>
                            </form>
                        </div>
                    </div>
                }

                @* Neues Wochenende *@
                <div class="rc-add-weekend">
                    <h6 class="mb-3" style="font: 700 .82rem/1 var(--ff-tech); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-2);">
                        <i class="bi bi-plus-circle me-1"></i>Neues Renn-Wochenende
                    </h6>
                    <form asp-action="SaveWeekend" method="post">
                        @Html.AntiForgeryToken()

                        <div class="rc-weekend-row">
                            <div>
                                <div class="rc-weekend-row__label">Reihenfolge</div>
                                <input type="number" name="order" min="0" value="@nextOrder" required />
                            </div>
                            <div>
                                <div class="rc-weekend-row__label">Strecke</div>
                                <input type="text" name="track" required maxlength="128" placeholder="z.B. Australien" />
                            </div>
                            <div>
                                <div class="rc-weekend-row__label">Distanz</div>
                                <select name="distancePercent">
                                    @foreach (var p in distancePresets)
                                    {
                                        if (p == 100)
                                        {
                                            <option value="@p" selected>@p% Race</option>
                                        }
                                        else
                                        {
                                            <option value="@p">@p% Race</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="rc-legs">
                            @foreach (var league in leagues)
                            {
                                <div class="rc-leg">
                                    <div class="rc-leg__head">
                                        <span class="rc-leg__league">@league.Name</span>
                                        <span class="rc-leg__hint">leer = kein Termin</span>
                                    </div>
                                    <input type="hidden" name="legLeagueIds" value="@league.Id" />
                                    <input type="datetime-local" name="legDates" />
                                </div>
                            }
                        </div>

                        <div class="rc-weekend-actions">
                            <button class="btn btn-sm btn-primary" type="submit">
                                <i class="bi bi-plus-lg me-1"></i>Wochenende anlegen
                            </button>
                        </div>
                    </form>
                </div>
            }
        </div>
    </div>

</div>
