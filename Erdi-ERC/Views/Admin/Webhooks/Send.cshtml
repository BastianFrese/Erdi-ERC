    announce:{
        content:'\u0040everyone', useEmbed:true,
        embedAuthorName:"Erdi's Racing Community", embedAuthorIconUrl:'',
        embedTitle:'📢 Wichtige Ankündigung', embedUrl:'https://erdi-erc.de',
        embedDescription:'Text der Ankündigung…',
        embedColor:'#57f287', embedFooter:"Erdi's Racing Community",
        embedThumbnail:'', embedImage:'', fields:[]}
};

window.applyTemplate=function(key){
    var t=TPLS[key]; if(!t) return;
    var m={inContent:t.content||'',inAuthorName:t.embedAuthorName||'',inAuthorIcon:t.embedAuthorIconUrl||'',
           inEmbedTitle:t.embedTitle||'',inEmbedUrl:t.embedUrl||'',inEmbedDesc:t.embedDescription||'',
           inThumbnail:t.embedThumbnail||'',inImage:t.embedImage||'',inFooter:t.embedFooter||''};
    Object.keys(m).forEach(function(k){ var el=g(k); if(el) el.value=m[k]; });
    setColor(t.embedColor||'#5865f2');
    g('useEmbedChk').checked=t.useEmbed;
    g('embedSection').classList.toggle('is-active',t.useEmbed);
    fields=(t.fields||[]).map(function(f){ return Object.assign({},f); });
    renderFields();
    // Switch to message tab
    qa('.dce-tab').forEach(function(b){ b.classList.remove('is-active'); });
    qa('.dce-tab-pane').forEach(function(p){ p.classList.remove('is-active'); });
    document.querySelector('[data-tab="message"]').classList.add('is-active');
    g('tab-message').classList.add('is-active');
    updateBadges(); updatePreview();
};

window.clearAll=function(){
    ['inContent','inUsername','inAvatarUrl','inAuthorName','inAuthorIcon',
     'inEmbedTitle','inEmbedUrl','inEmbedDesc','inThumbnail','inImage','inFooter'
    ].forEach(function(id){ var el=g(id); if(el) el.value=''; });
    g('useEmbedChk').checked=false;
    g('embedSection').classList.remove('is-active');
    fields=[]; renderFields(); setColor('#e10600'); updatePreview();
};

// ── Live Preview ──────────────────────────────────────────────────────
function tv(el,show){ el.style.display=show?'':'none'; }

function updatePreview(){
    var uname   = (g('inUsername').value||'').trim()||'ERC Bot';
    var avatar  = (g('inAvatarUrl').value||'').trim();
    var content = g('inContent').value;

    g('pvUsername').textContent = uname;
    var av=g('pvAvatar');
    if(avatar){ av.innerHTML='<img src="'+escH(avatar)+'" alt="" onerror="this.parentNode.textContent=\'🤖\'" />'; }
    else { av.textContent='🤖'; }

    var hasContent=!!content.trim();
    tv(g('pvContent'),hasContent);
    g('pvContent').innerHTML = hasContent ? md(content) : '';

    var showEmbed=g('useEmbedChk').checked;
    tv(g('pvEmbed'),showEmbed);

    if(showEmbed){
        var color=g('inEmbedColor').value||'#5865f2';
        g('pvEmbed').style.borderLeftColor=color;

        var aName=g('inAuthorName').value.trim();
        var aIcon=g('inAuthorIcon').value.trim();
        tv(g('pvAuthor'),!!aName);
        g('pvAuthorName').textContent=aName;
        if(aIcon){ g('pvAuthorIcon').src=aIcon; tv(g('pvAuthorIcon'),true); }
        else { tv(g('pvAuthorIcon'),false); }

        var thumb=g('inThumbnail').value.trim();
        tv(g('pvThumbnailWrap'),!!thumb);
        if(thumb) g('pvThumbnail').src=thumb;

        var title=g('inEmbedTitle').value.trim();
        var tUrl=g('inEmbedUrl').value.trim();
        tv(g('pvTitle'),!!title);
        if(title){
            g('pvTitle').innerHTML=tUrl
                ?'<a href="'+escH(tUrl)+'" target="_blank">'+escH(title)+'</a>'
                :escH(title);
        }

        var desc=g('inEmbedDesc').value;
        tv(g('pvDesc'),!!desc.trim());
        g('pvDesc').innerHTML=desc.trim()?md(desc):'';

        // Fields
        var pf=g('pvFields'); pf.innerHTML='';
        var af=fields.filter(function(f){ return f.name||f.value; });
        if(af.length){
            var inlines=af.filter(function(f){ return f.inline; }).length;
            var cols=inlines>0?Math.min(3,inlines):1;
            pf.style.gridTemplateColumns='repeat('+cols+',1fr)';
            af.forEach(function(f){
                var fd=document.createElement('div');
                fd.className='dce-embed__field';
                if(!f.inline) fd.style.gridColumn='1/-1';
                fd.innerHTML='<div class="dce-embed__field-name">'+md(f.name)+'</div>'+
                             '<div class="dce-embed__field-value">'+md(f.value)+'</div>';
                pf.appendChild(fd);
            });
        }

        var img=g('inImage').value.trim();
        tv(g('pvImageWrap'),!!img);
        if(img) g('pvImage').src=img;

        var footer=g('inFooter').value.trim();
        tv(g('pvFooter'),!!footer);
        if(footer){
            var dt=new Date().toLocaleDateString('de-DE',{day:'2-digit',month:'short',year:'numeric'});
            g('pvFooter').innerHTML='<span>'+escH(footer)+'</span>'+
                '<span class="dce-embed__footer-dot"></span><span>'+escH(dt)+'</span>';
        }
    }

    tv(g('pvEmpty'),!hasContent&&!showEmbed);
    updateBadges();
    if(g('modeJson').style.display!=='none') refreshJson();
}

function buildPayload(){
    var p={};
    var c=g('inContent').value, u=(g('inUsername').value||'').trim(), av=(g('inAvatarUrl').value||'').trim();
    if(c.trim()) p.content=c;
    if(u) p.username=u;
    if(av) p.avatar_url=av;
    if(g('useEmbedChk').checked){
        var e={};
        var t=g('inEmbedTitle').value.trim(), tu=g('inEmbedUrl').value.trim(),
            d=g('inEmbedDesc').value.trim(), col=g('inEmbedColor').value,
            th=g('inThumbnail').value.trim(), im=g('inImage').value.trim(),
            ft=g('inFooter').value.trim(), an=g('inAuthorName').value.trim(),
            ai=g('inAuthorIcon').value.trim();
        if(t)   e.title=t;
        if(tu)  e.url=tu;
        if(d)   e.description=d;
        if(col&&/^#[0-9a-fA-F]{6}$/.test(col)) e.color=parseInt(col.slice(1),16);
        if(th)  e.thumbnail={url:th};
        if(im)  e.image={url:im};
        if(ft)  e.footer={text:ft};
        if(an)  e.author=ai?{name:an,icon_url:ai}:{name:an};
        var af=fields.filter(function(f){ return f.name||f.value; });
        if(af.length) e.fields=af.map(function(f){ return {name:f.name,value:f.value,inline:f.inline}; });
        e.timestamp=new Date().toISOString();
        p.embeds=[e];
    }
    return p;
}

function refreshJson(){
    g('jsonBlock').textContent=JSON.stringify(buildPayload(),null,2);
}

// Wire inputs
['inUsername','inAvatarUrl','inAuthorName','inAuthorIcon',
 'inEmbedTitle','inEmbedUrl','inEmbedDesc','inThumbnail','inImage','inFooter'
].forEach(function(id){
    var el=g(id); if(el) el.addEventListener('input',updatePreview);
});

// Submit
g('dceFrm').addEventListener('submit',function(){
    serF();
    g('sendBtn').disabled=true;
    g('sendBtn').innerHTML='<i class="bi bi-hourglass-split"></i> Wird gesendet&#x2026;';
});

// ── Draft restore (nach Fehler-POST) ─────────────────────────────────
function restoreDraft(){
    var d = window.__webhookDraft;
    if(!d) return;
    var map = {
        content:'inContent', username:'inUsername', avatarUrl:'inAvatarUrl',
        embedTitle:'inEmbedTitle', embedDescription:'inEmbedDesc', embedUrl:'inEmbedUrl',
        embedThumbnail:'inThumbnail', embedImage:'inImage', embedFooter:'inFooter',
        embedAuthorName:'inAuthorName', embedAuthorIconUrl:'inAuthorIcon'
    };
    Object.keys(map).forEach(function(k){
        var v = d[k]; if(v == null) return;
        var el = g(map[k]); if(el) el.value = v;
    });
    if(d.useEmbed === 'true'){
        g('useEmbedChk').checked = true;
        g('embedSection').classList.add('is-active');
    }
    if(d.embedColor && /^#[0-9a-fA-F]{6}$/.test(d.embedColor)){
        setColor(d.embedColor);
    }
    if(d.fieldsJson){
        try{
            var parsed = JSON.parse(d.fieldsJson);
            if(Array.isArray(parsed)){
                fields = parsed.map(function(f){ return {name:f.name||'',value:f.value||'',inline:!!f.inline}; });
                renderFields();
            }
        } catch(e){ /* malformed draft - ignore */ }
    }
}
restoreDraft();

updatePreview();
})();
</script>
}
