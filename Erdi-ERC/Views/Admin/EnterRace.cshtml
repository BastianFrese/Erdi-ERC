@model Erdi_ERC.Models.League
@using System.Text.Json

@{
    ViewData["Title"] = $"Rennen eintragen - {Model.Name}";
    ViewData["Kicker"] = "Rennen";
    ViewData["HeroTitle"] = Model.Name;
    ViewData["HeroSubtitle"] = "Erfasse ein neues Renn-Ergebnis inklusive Zeiten, Reserve-Zuordnungen und DNF-Markierungen in einem Durchgang.";
    int[] pointsMap = { 25, 21, 18, 16, 14, 12, 10, 8, 7, 6, 5, 4, 3, 2, 1, 0, 0, 0, 0, 0, 0, 0 };
    var drivers = Model.Standings.Select(s => s.Driver).OrderBy(d => d).ToList();
    var reserveToMain = Model.Standings
        .Where(s => s.IsReserveDriver
                    && !string.IsNullOrWhiteSpace(s.Driver)
                    && !string.IsNullOrWhiteSpace(s.ReserveForDriver))
        .GroupBy(s => s.Driver.Trim(), StringComparer.OrdinalIgnoreCase)
        .ToDictionary(g => g.Key, g => g.First().ReserveForDriver!.Trim(), StringComparer.OrdinalIgnoreCase);
    var reserveDrivers = Model.Standings
        .Where(s => s.IsReserveDriver && !string.IsNullOrWhiteSpace(s.Driver))
        .Select(s => s.Driver.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList();
    var mainDrivers = Model.Standings
        .Where(s => !s.IsReserveDriver && !string.IsNullOrWhiteSpace(s.Driver))
        .Select(s => s.Driver.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList();

    // ── Bearbeiten-Modus: ein bestehendes Rennen vorbefüllen ──────────────────
    var existing = ViewBag.ExistingRace as Erdi_ERC.Models.RaceResult;
    var isEdit = existing != null;
    var formAction = isEdit ? "UpdateEnteredRace" : "SaveEnteredRace";

    string FormatMs(int ms)
    {
        var ts = TimeSpan.FromMilliseconds(ms);
        // Gesamtzeit-Anzeige: ab 1 Stunde H:MM:SS.mmm, sonst M:SS.mmm.
        return ts.TotalHours >= 1
            ? $"{(int)ts.TotalHours}:{ts.Minutes:00}:{ts.Seconds:00}.{ts.Milliseconds:000}"
            : $"{(int)ts.TotalMinutes}:{ts.Seconds:00}.{ts.Milliseconds:000}";
    }

    var posToDriver = new Dictionary<int, string>();
    var posToTime = new Dictionary<int, string>();
    var posToQuali = new Dictionary<int, int>();
    var dnfPrefill = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    var prefillReserveToMain = reserveToMain;
    var fastestLapPrefill = existing?.FastestLap ?? string.Empty;

    if (existing != null)
    {
        foreach (var f in existing.Finishes)
        {
            if (f.Position > 0)
            {
                posToDriver[f.Position] = f.Driver;
                if (f.RaceTimeMs.HasValue) posToTime[f.Position] = FormatMs(f.RaceTimeMs.Value);
                if (f.QualifyingPosition.HasValue) posToQuali[f.Position] = f.QualifyingPosition.Value;
            }
            else if (f.Position == 0)
            {
                dnfPrefill.Add(f.Driver);
            }
        }

        prefillReserveToMain = existing.ReserveAssignments
            .Where(a => !string.IsNullOrWhiteSpace(a.ReserveDriver) && !string.IsNullOrWhiteSpace(a.MainDriver))
            .GroupBy(a => a.ReserveDriver.Trim(), StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.First().MainDriver.Trim(), StringComparer.OrdinalIgnoreCase);
    }

    // Gastfahrer (in den Ergebnissen, aber nicht in der Liga-Fahrerliste) zusätzlich anbieten.
    var guestDrivers = existing == null
        ? new List<string>()
        : existing.Finishes.Select(f => f.Driver?.Trim() ?? string.Empty)
            .Where(d => !string.IsNullOrWhiteSpace(d) && !drivers.Contains(d, StringComparer.OrdinalIgnoreCase))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

    // Mapping bestehender Gastfahrer → MainDriver aus den GuestAssignments (nur Edit-Modus).
    var existingGuestMain = existing == null
        ? new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        : existing.GuestAssignments
            .Where(g => !string.IsNullOrWhiteSpace(g.GuestDriver)
                        && !string.IsNullOrWhiteSpace(g.MainDriver)
                        && g.MainDriver != Erdi_ERC.Services.StatsService.GuestSentinelNoMain)
            .GroupBy(g => g.GuestDriver.Trim(), StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.First().MainDriver.Trim(), StringComparer.OrdinalIgnoreCase);

    var allDrivers = drivers.Concat(guestDrivers).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(d => d).ToList();

    if (isEdit)
    {
        ViewData["Title"] = $"Rennen bearbeiten - {Model.Name}";
        ViewData["HeroSubtitle"] = "Korrigiere ein bestehendes Renn-Ergebnis vollständig — Positionen, Zeiten, DNF und Reserve. Punkte werden danach automatisch neu berechnet.";
    }
}

<div class="adm-dashboard">

    <section class="adm-kpi-grid" style="grid-template-columns:repeat(3,1fr);">
        <div class="adm-kpi-card" style="--kpi-color:#5b8cff;">
            <div class="adm-kpi-card__icon"><i class="bi bi-people-fill"></i></div>
            <div class="adm-kpi-card__body">
                <div class="adm-kpi-card__value">@drivers.Count</div>
                <div class="adm-kpi-card__label">Fahrer in dieser Liga</div>
            </div>
        </div>
        <div class="adm-kpi-card" style="--kpi-color:#ff8a4c;">
            <div class="adm-kpi-card__icon"><i class="bi bi-arrow-repeat"></i></div>
            <div class="adm-kpi-card__body">
                <div class="adm-kpi-card__value">@reserveDrivers.Count</div>
                <div class="adm-kpi-card__label">Reservefahrer</div>
            </div>
        </div>
        <div class="adm-kpi-card" style="--kpi-color:#4caf6d;">
            <div class="adm-kpi-card__icon"><i class="bi bi-flag-fill"></i></div>
            <div class="adm-kpi-card__body">
                <div class="adm-kpi-card__value">22</div>
                <div class="adm-kpi-card__label">Positions-Slots</div>
            </div>
        </div>
    </section>

    @if (TempData["RaceError"] is string raceError)
    {
        <div class="adm-alert" style="border-color:rgba(255,107,107,.3);background:rgba(255,107,107,.08);color:#ffc0c0;">
            <i class="bi bi-exclamation-triangle-fill"></i> @raceError
        </div>
    }

    <div class="adm-panel">
        <div class="adm-panel__head">
            <span class="adm-panel__head-title">
                <i class="bi bi-flag-fill me-2" style="color:var(--sig-amber,#e8a93d);"></i>@(isEdit ? "Renn-Ergebnis bearbeiten" : "Neues Renn-Ergebnis") · @Model.Name
            </span>
        </div>
        <div class="adm-panel__body">
            <form asp-action="@formAction" method="post" id="enterRaceForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="leagueId" value="@Model.Id" />
                @if (isEdit)
                {
                    <input type="hidden" name="rowId" value="@existing!.RowId" />
                }
                <input type="hidden" name="fastestLapDriver" value="@fastestLapPrefill" />

                <div class="row g-3 mb-4">
                    <div class="col-sm-6">
                        <label class="form-label">Datum & Uhrzeit</label>
                        <input class="form-control" type="datetime-local" name="date" required value="@(isEdit ? existing!.Date.ToString("yyyy-MM-ddTHH:mm") : DateTime.Now.ToString("yyyy-MM-ddTHH:mm"))" />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label">Strecke</label>
                        <input class="form-control" type="text" name="track" required placeholder="z. B. Australien" value="@(isEdit ? existing!.Track : "")" />
                    </div>
                </div>

                <div class="border rounded p-3 mb-4">
                    <label class="form-label small mb-1"><i class="bi bi-person-plus me-1"></i>Gastfahrer aus einer anderen Liga aufnehmen</label>
                    <div class="d-flex gap-2 align-items-center flex-wrap">
                        <input class="form-control form-control-sm" id="guestDriverInput" placeholder="Name eingeben…" autocomplete="off" aria-autocomplete="list" aria-controls="guest-suggestions-panel" style="min-width:240px" />
                        <button class="btn btn-sm btn-outline-info" type="button" id="addGuestBtn"><i class="bi bi-plus-lg me-1"></i>Aufnehmen</button>
                        <span class="text-muted small">Erscheint in allen Positions- und DNF-Listen. <strong>Pflicht:</strong> Jedem Gast muss unten ein Liga-Hauptfahrer zugeordnet werden, damit Punkte und Team korrekt zugewiesen werden.</span>
                    </div>
                    <div id="guest-suggestions-panel" class="d-flex flex-wrap gap-1 mt-2" role="listbox" aria-label="Vorschläge"></div>
                    <div id="guest-error-banner" class="alert alert-warning py-2 px-3 mt-2 mb-0 small d-none" role="alert"></div>

                    <div id="guestAssignmentsContainer" class="mt-3 @(guestDrivers.Count > 0 ? "" : "d-none")">
                        <h6 class="mb-2 small text-uppercase text-info">Gast-Zuordnung (Pflicht)</h6>
                        <div id="guestAssignmentRows">
                            @{
                                var guestIndex = 0;
                            }
                            @foreach (var guest in guestDrivers)
                            {
                                var prefillMain = existingGuestMain.TryGetValue(guest, out var m) ? m : "";
                                var gi = guestIndex++;
                                <div class="row g-2 align-items-center mb-2" data-guest-row data-guest-name="@guest">
                                    <div class="col-md-5">
                                        <span class="badge bg-info me-1">Gast</span> <strong>@guest</strong>
                                    </div>
                                    <div class="col-md-7">
                                        <select class="form-select form-select-sm guest-main-select" name="guestAssignments[@gi].MainDriver" required>
                                            <option value="">-- Liga-Hauptfahrer wählen (Pflicht) --</option>
                                            <option value="__sentinel__">(kein Hauptfahrer — Gast zählt nicht für Overall)</option>
                                            @foreach (var mainDriver in mainDrivers)
                                            {
                                                <option value="@mainDriver" selected="@(string.Equals(mainDriver, prefillMain, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@mainDriver</option>
                                            }
                                        </select>
                                        <input type="hidden" name="guestAssignments[@gi].GuestName" value="@guest" />
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                @if (reserveDrivers.Count > 0)
                {
                    <div class="border rounded p-3 mb-4 bg-dark-subtle">
                        <h5 class="mb-2">Reserve-Zuordnung für dieses Rennen (optional)</h5>
                        <p class="text-muted small mb-3">Hier kannst du bei Bedarf die Zuordnung nur für dieses Rennen überschreiben. Wenn leer, gilt die Standard-Zuordnung aus der Fahrerverwaltung.</p>
                        <div class="row g-2">
                            @foreach (var reserveDriver in reserveDrivers)
                            {
                                <input type="hidden" name="reserveDrivers" value="@reserveDriver" />
                                <div class="col-md-6">
                                    <label class="form-label small">@reserveDriver fährt für</label>
                                    <select class="form-select form-select-sm reserve-main-select" name="reserveMainDrivers" data-reserve-driver="@reserveDriver">
                                        <option value="">-- keine Zuordnung für dieses Rennen --</option>
                                        @foreach (var mainDriver in mainDrivers)
                                        {
                                            <option value="@mainDriver" selected="@(prefillReserveToMain.TryGetValue(reserveDriver, out var mapped) && string.Equals(mapped, mainDriver, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@mainDriver</option>
                                        }
                                    </select>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="border rounded p-3 mb-4" style="border-color:rgba(91,140,255,.35)!important;">
                    <h5 class="mb-2"><i class="bi bi-clipboard-data me-1"></i>CSV aus dem Spiel-Export einfügen</h5>
                    <p class="text-muted small mb-2">
                        Füge den kompletten Ergebnis-Textblock aus dem Spiel-Export hier ein und klicke auf
                        <strong>„CSV übernehmen"</strong>. Positionen, Fahrer (wo der Name bekannt ist) und die
                        <strong>Gesamt-Rennzeit</strong> werden automatisch befüllt — die Gesamtzeit wird aus
                        Siegerzeit + Abstand zum Vordermann berechnet. Überrundete Fahrer behalten den Export-Text
                        (z.&nbsp;B. „+1 Runde"). <span class="text-warning">Ersetzt die aktuelle Positions-/Zeit-Füllung.</span>
                    </p>
                    <textarea id="raceCsvInput" class="form-control font-monospace" rows="4" spellcheck="false"
                              placeholder='"Pos.","Fahrer","Team","Grid","Stopps","Beste","Zeit","Pkt.","Fahrertyp"&#10;"1","Spieler:in","Mercedes-AMG F1 Team","1","1","1:20,126","45:31,798","25","Spieler:in"&#10;…'></textarea>
                    <div class="d-flex align-items-center gap-2 mt-2 flex-wrap">
                        <button type="button" class="btn btn-outline-info btn-sm" id="raceCsvApplyBtn"><i class="bi bi-magic me-1"></i>CSV übernehmen</button>
                        <span id="raceCsvStatus" class="small text-muted"></span>
                    </div>
                </div>
                <style>
                    select.needs-driver { box-shadow: 0 0 0 2px rgba(232,169,61,.55); }
                    .race-position-block { transition: background-color .15s ease, border-color .15s ease; }
                    .race-position-block.race-dragging { opacity: .45; }
                    .race-position-block.race-drop-target { box-shadow: 0 0 0 2px rgba(91,140,255,.55); }
                    .race-sort-handle { cursor: grab; touch-action: none; }
                    .race-sort-handle:active { cursor: grabbing; }
                </style>

                <hr />
                <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                    <h5 class="mb-0">Startaufstellung / Zieleinlauf</h5>
                    <button type="button" class="btn btn-outline-primary btn-sm" id="sortByTimeBtn"
                            title="Ordnet alle Zeilen nach Gesamtzeit aufsteigend (Strafen sind bereits im Gesamtzeit-Feld eingerechnet) — Schnellste auf Position 1. Zeilen ohne parsebare Zeit wandern ans Ende und behalten ihre relative Reihenfolge.">
                        <i class="bi bi-sort-numeric-down me-1"></i>Nach Zeit sortieren
                    </button>
                </div>
                <p class="text-muted small">Wähle den Fahrer für die jeweilige Position. Optional trägst du die <strong>Gesamt-Rennzeit</strong> des Fahrers ein (gesamt gefahrene Zeit, keine Rundenzeit) — z. B. <code>1:24:35.100</code> (h:mm:ss) oder <code>24:35.100</code> (m:ss). Eine Strafe (positive <strong>und</strong> negative Zahl) wird <strong>sofort</strong> auf die Gesamt-Rennzeit angerechnet und direkt in das <strong>Gesamtzeit</strong>-Feld übernommen — die <em>Endposition</em> basiert damit immer auf der angezeigten, korrigierten Zeit. Fahrer-Zeilen kannst du am Griff <i class="bi bi-grip-vertical"></i> per Drag &amp; Drop verschieben.</p>

                <div class="row g-4 align-items-start">
                    <div class="col-lg-8">
                        <div class="row g-3">
                            @for(int i = 0; i < 22; i++)
                            {
                                <div class="col-12 mb-3 race-position-block" data-pos="@(i+1)">
                                    <label class="form-label fw-bold"><span class="race-pos-text">Position @(i+1) (@pointsMap[i] Pkt.)</span></label>
                                    <div class="row g-2 align-items-center">
                                        <div class="col-auto">
                                            <button type="button" class="btn btn-sm btn-outline-secondary race-sort-handle" draggable="true" title="Zeile per Drag &amp; Drop verschieben — Endposition = Gesamtzeit + Strafsekunden" aria-label="Fahrer-Zeile verschieben"><i class="bi bi-grip-vertical"></i></button>
                                        </div>
                                        <div class="col-md-3">
                                            <select class="form-select race-position-select" name="positions">
                                                <option value="">-- Leer --</option>
                                                @{ var selectedDriverForPos = posToDriver.TryGetValue(i + 1, out var pd) ? pd : null; }
                                                @foreach(var driver in allDrivers)
                                                {
                                                    <option value="@driver" selected="@(string.Equals(driver, selectedDriverForPos, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@driver</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-2">
                                            <input class="form-control" name="qualiPositions" type="number" min="0" max="30" step="1" placeholder="Quali" title="Startposition aus dem Qualifying (Pole = 1)" value="@(posToQuali.TryGetValue(i + 1, out var qp) ? qp.ToString() : "")" />
                                        </div>
                                        <div class="col-md-3">
                                            <input class="form-control race-time-input" name="raceTimes" placeholder="Gesamtzeit (z. B. 1:24:35.100)" title="Gesamt gefahrene Rennzeit des Fahrers. Formate: h:mm:ss oder m:ss" value="@(posToTime.TryGetValue(i + 1, out var pt) ? pt : "")" />
                                        </div>
                                        <div class="col-md-2">
                                            <input class="form-control race-penalty-input" name="penaltySeconds" type="number" step="1" placeholder="Strafe (± Sek.)" title="Strafzeit in Sekunden. Positive Werte addieren zur Gesamtzeit, negative Werte (Minus-Strafe) ziehen Zeit ab." />
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="border rounded p-3 mb-3">
                            <h5 class="mb-2">⚠️ Strafen-System</h5>
                            <p class="text-muted small mb-0">
                                Strafe in <strong>Sekunden</strong> ins Straf-Feld tippen: <strong>positive Zahl</strong> addiert Zeit, eine <strong>negative Zahl</strong> (Minus-Strafe) zieht Zeit ab. Die Strafe wird <strong>sofort</strong> auf die Gesamt-Rennzeit angerechnet und genau dort in das <strong>Gesamtzeit</strong>-Feld geschrieben — das Straf-Feld leert sich danach. Die Gesamtzeit kann dabei nie unter 1&nbsp;ms sinken.
                            </p>
                        </div>
                        <div class="border rounded p-3">
                            <h5 class="mb-2">DNF</h5>
                            <p class="text-muted small mb-3">Markiere Fahrer, die ausgefallen sind.</p>
                            <div class="row g-2" id="dnfList">
                                @foreach (var driver in allDrivers)
                                {
                                    <div class="col-12">
                                        <div class="form-check">
                                            <input class="form-check-input dnf-driver-check" type="checkbox" name="dnfDrivers" value="@driver" id="dnf-@driver.GetHashCode()" checked="@(dnfPrefill.Contains(driver) ? "checked" : null)" />
                                            <label class="form-check-label" for="dnf-@driver.GetHashCode()">@driver</label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <hr />

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="bi bi-floppy-fill me-1"></i> @(isEdit ? "Änderungen speichern & Punkte neu berechnen" : "Ergebnis speichern & Punkte berechnen")
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        (() => {
            const form = document.getElementById('enterRaceForm');
            const selects = Array.from(document.querySelectorAll('.race-position-select'));
            const dnfChecks = Array.from(document.querySelectorAll('.dnf-driver-check'));
            const reserveMainSelects = Array.from(document.querySelectorAll('.reserve-main-select'));
            const defaultReserveToMain = @Html.Raw(JsonSerializer.Serialize(prefillReserveToMain));

            if (!form || selects.length === 0) return;

            // Liga-Hauptfahrer als JSON für Gast-Zuordnung-Aufbau.
            const mainDriversList = @Html.Raw(JsonSerializer.Serialize(mainDrivers));

            // ── Gastfahrer aufnehmen: Name in alle Positions-Dropdowns + DNF-Liste einfügen ──
            const guestInput = document.getElementById('guestDriverInput');
            const addGuestBtn = document.getElementById('addGuestBtn');
            const dnfList = document.getElementById('dnfList');
            const guestSuggestionsPanel = document.getElementById('guest-suggestions-panel');
            const guestErrorBanner = document.getElementById('guest-error-banner');
            const guestAssignmentsContainer = document.getElementById('guestAssignmentsContainer');
            const guestAssignmentRows = document.getElementById('guestAssignmentRows');

            // Letzte vom Server gelieferte Suggestions (Trefferliste für die aktuelle Eingabe).
            // Strikte Validierung: addGuestDriver akzeptiert nur Namen aus dieser Liste,
            // damit Tippfehler und halluzinierte Namen geblockt werden.
            let currentSuggestions = [];

            const showGuestError = (msg) => {
                if (!guestErrorBanner) return;
                guestErrorBanner.textContent = msg;
                guestErrorBanner.classList.remove('d-none');
            };
            const clearGuestError = () => {
                if (!guestErrorBanner) return;
                guestErrorBanner.textContent = '';
                guestErrorBanner.classList.add('d-none');
            };

            const renderSuggestions = (items) => {
                if (!guestSuggestionsPanel) return;
                guestSuggestionsPanel.innerHTML = '';
                for (const m of items) {
                    const tag = (m.gamerTag || '').trim();
                    if (!tag) continue;
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'btn btn-sm btn-outline-info';
                    btn.setAttribute('role', 'option');
                    btn.dataset.gamerTag = tag;
                    const dist = typeof m.distance === 'number' ? ` (D=${m.distance})` : '';
                    btn.textContent = tag + dist;
                    btn.title = m.exact ? 'Exakter Treffer — Enter / Klick übernimmt' : 'Vorschlag — Enter / Klick übernimmt';
                    btn.addEventListener('mouseenter', () => setActiveSuggestion(btn));
                    btn.addEventListener('click', () => addGuestDriver(tag, true));
                    guestSuggestionsPanel.appendChild(btn);
                }
            };

            // Highlighted Suggestion (für Tastatur-Navigation ↓↑ + Enter-Übernahme).
            const setActiveSuggestion = (btn) => {
                if (!guestSuggestionsPanel) return;
                for (const sib of guestSuggestionsPanel.querySelectorAll('[role="option"]')) {
                    sib.classList.remove('active', 'btn-info');
                    sib.classList.add('btn-outline-info');
                }
                if (btn) {
                    btn.classList.add('active', 'btn-info');
                    btn.classList.remove('btn-outline-info');
                }
            };

            const getActiveSuggestion = () => guestSuggestionsPanel
                ? guestSuggestionsPanel.querySelector('[role="option"].active')
                : null;

            const moveActiveSuggestion = (delta) => {
                if (!guestSuggestionsPanel) return;
                const all = Array.from(guestSuggestionsPanel.querySelectorAll('[role="option"]'));
                if (all.length === 0) return;
                const cur = all.indexOf(getActiveSuggestion());
                let next = cur + delta;
                if (next < 0) next = all.length - 1;
                if (next >= all.length) next = 0;
                setActiveSuggestion(all[next]);
                all[next].focus();
            };

            const knownDrivers = () => new Set(
                Array.from(selects[0].options).map(o => (o.value || '').toLowerCase()).filter(Boolean)
            );

            // rawName: vom User eingegebener Text; fromServer = true, wenn der Aufrufer aus
            // einer vom Server gelieferten Suggestion stammt (kanonischer Name).
            const addGuestDriver = (rawName, fromServer = false) => {
                const name = (rawName || '').trim();
                if (!name) return;
                if (knownDrivers().has(name.toLowerCase())) {
                    if (guestInput) guestInput.value = '';
                    clearGuestError();
                    return;
                }

                // Strikte Validierung: ohne explizite Bestätigung durch eine Server-Suggestion
                // wird der Name abgelehnt. Verhindert Tippfehler + halluzinierte Namen.
                if (!fromServer) {
                    const match = currentSuggestions.find(s =>
                        (s.gamerTag || '').trim().toLowerCase() === name.toLowerCase());
                    if (!match) {
                        showGuestError(`„${name}" ist kein registrierter Fahrer. Bitte einen Vorschlag aus der Liste anklicken — oder den Fahrer zuerst in der Fahrerverwaltung registrieren.`);
                        return;
                    }
                    // Kanonischer Name vom Server übernehmen.
                    addGuestDriver(match.gamerTag.trim(), true);
                    return;
                }

                clearGuestError();
                for (const select of selects) {
                    const opt = document.createElement('option');
                    opt.value = name;
                    opt.textContent = name;
                    select.appendChild(opt);
                }
                if (dnfList) {
                    const col = document.createElement('div');
                    col.className = 'col-12';
                    const id = 'dnf-guest-' + name.replace(/[^a-z0-9]/gi, '');
                    col.innerHTML = `<div class="form-check">
                        <input class="form-check-input dnf-driver-check" type="checkbox" name="dnfDrivers" value="${name}" id="${id}" />
                        <label class="form-check-label" for="${id}">${name} <span class="text-info">(Gast)</span></label></div>`;
                    dnfList.appendChild(col);
                    const newCheck = col.querySelector('.dnf-driver-check');
                    if (newCheck) {
                        newCheck.addEventListener('change', syncDisabledOptions);
                        dnfChecks.push(newCheck);
                    }
                }

                // Pflicht-Zuordnung: neue Zeile im Gast-Zuordnungs-Panel.
                if (guestAssignmentRows && guestAssignmentsContainer) {
                    guestAssignmentsContainer.classList.remove('d-none');
                    const safeId = 'gmr-' + name.replace(/[^a-z0-9]/gi, '');
                    // Strukturiertes Form-Pärchen (GuestName + MainDriver) statt zwei loser Arrays,
                    // damit Model-Binding in AdminLeagueController.GuestAssignmentInput funktioniert.
                    const gi = guestAssignmentRows.querySelectorAll('[data-guest-row]').length;
                    const row = document.createElement('div');
                    row.className = 'row g-2 align-items-center mb-2';
                    row.setAttribute('data-guest-row', '');
                    row.setAttribute('data-guest-name', name);
                    const mainOptions = (mainDriversList || [])
                        .map(m => `<option value="${m.replace(/"/g, '&quot;')}">${m}</option>`)
                        .join('');
                    row.innerHTML = `<div class="col-md-5">
                            <span class="badge bg-info me-1">Gast</span> <strong>${name.replace(/</g, '&lt;')}</strong>
                        </div>
                        <div class="col-md-5">
                            <select class="form-select form-select-sm guest-main-select" name="guestAssignments[${gi}].MainDriver" required>
                                <option value="">-- Liga-Hauptfahrer wählen --</option>
                                <option value="__sentinel__">(kein Hauptfahrer — Gast zählt nicht für Overall)</option>
                                ${mainOptions}
                            </select>
                            <input type="hidden" name="guestAssignments[${gi}].GuestName" value="${name.replace(/"/g, '&quot;')}" />
                        </div>
                        <div class="col-md-2">
                            <button type="button" class="btn btn-sm btn-outline-danger btn-remove-guest">Entfernen</button>
                        </div>`;
                    guestAssignmentRows.appendChild(row);
                    row.querySelector('.btn-remove-guest')?.addEventListener('click', () => {
                        row.remove();
                        // Nach Entfernen Indizes aller nachfolgenden Zeilen neu schreiben,
                        // damit das ASP.NET-Model-Binding die Pärchen konsistent zuordnet.
                        renumberGuestAssignments();
                        if (!guestAssignmentRows.querySelector('[data-guest-row]')) {
                            guestAssignmentsContainer.classList.add('d-none');
                        }
                        removeGuestDriver(name);
                    });
                }

                if (guestInput) guestInput.value = '';
                if (guestSuggestionsPanel) guestSuggestionsPanel.innerHTML = '';
                currentSuggestions = [];
                syncDisabledOptions();
            };

            const removeGuestDriver = (name) => {
                const lowered = name.toLowerCase();
                for (const select of selects) {
                    for (let i = select.options.length - 1; i >= 0; i--) {
                        if ((select.options[i].value || '').toLowerCase() === lowered) {
                            select.remove(i);
                            break;
                        }
                    }
                }
                if (dnfList) {
                    for (const check of Array.from(dnfChecks)) {
                        if ((check.value || '').toLowerCase() === lowered) {
                            check.closest('.col-12')?.remove();
                            const idx = dnfChecks.indexOf(check);
                            if (idx >= 0) dnfChecks.splice(idx, 1);
                            break;
                        }
                    }
                }
            };

            // Indizes der Gast-Zuordnungs-Pärchen nach jedem Hinzufügen/Entfernen neu schreiben,
            // damit ASP.NET-Model-Binding die Paare konsistent GuestName<->MainDriver zuordnet.
            const renumberGuestAssignments = () => {
                if (!guestAssignmentRows) return;
                const rows = Array.from(guestAssignmentRows.querySelectorAll('[data-guest-row]'));
                rows.forEach((r, idx) => {
                    const sel = r.querySelector('select.guest-main-select');
                    const hid = r.querySelector('input[type="hidden"]');
                    if (sel) sel.setAttribute('name', `guestAssignments[${idx}].MainDriver`);
                    if (hid) hid.setAttribute('name', `guestAssignments[${idx}].GuestName`);
                });
            };

            if (addGuestBtn) addGuestBtn.addEventListener('click', () => addGuestDriver(guestInput && guestInput.value));
            if (guestInput) guestInput.addEventListener('keydown', (e) => {
                // Tastatur-Navigation im Suggestion-Panel.
                if (e.key === 'ArrowDown') { e.preventDefault(); moveActiveSuggestion(+1); return; }
                if (e.key === 'ArrowUp')   { e.preventDefault(); moveActiveSuggestion(-1); return; }
                if (e.key === 'Escape')    {
                    e.preventDefault();
                    if (guestSuggestionsPanel) guestSuggestionsPanel.innerHTML = '';
                    currentSuggestions = [];
                    clearGuestError();
                    return;
                }
                if (e.key === 'Enter') {
                    e.preventDefault();
                    const active = getActiveSuggestion();
                    if (active && active.dataset.gamerTag) {
                        // Ausgewählte Suggestion übernehmen.
                        addGuestDriver(active.dataset.gamerTag, true);
                        return;
                    }
                    // Ohne aktive Suggestion: klassisch über resolveAsync-Gate.
                    addGuestDriver(guestInput.value);
                }
            });

            // Profil-Autocomplete für die Gast-Eingabe (gleiche Quelle wie in der Fahrerverwaltung).
            // Strikte Validierung: nur aus diesen Vorschlägen kann ein Gast übernommen werden.
            if (guestInput && guestSuggestionsPanel) {
                let guestTimer = null;
                guestInput.addEventListener('input', () => {
                    const q = (guestInput.value || '').trim();
                    clearTimeout(guestTimer);
                    if (q.length < 2) {
                        guestSuggestionsPanel.innerHTML = '';
                        currentSuggestions = [];
                        clearGuestError();
                        return;
                    }
                    guestTimer = setTimeout(async () => {
                        try {
                            const resp = await fetch(`/AdminLeague/DriverSuggestions?q=${encodeURIComponent(q)}`, { credentials: 'same-origin' });
                            if (!resp.ok) return;
                            const items = await resp.json();
                            currentSuggestions = Array.isArray(items) ? items : [];
                            const seen = new Set();
                            const dedup = [];
                            for (const m of currentSuggestions) {
                                const tag = (m.gamerTag || '').trim();
                                const key = tag.toLowerCase();
                                if (!tag || seen.has(key)) continue;
                                seen.add(key);
                                dedup.push(m);
                            }
                            currentSuggestions = dedup;
                            renderSuggestions(dedup);
                            // Erste Suggestion vorauswählen, damit Enter direkt übernimmt.
                            const first = guestSuggestionsPanel && guestSuggestionsPanel.querySelector('[role="option"]');
                            if (first) setActiveSuggestion(first);
                            clearGuestError();
                            if (dedup.length === 0) {
                                showGuestError('Kein registrierter Fahrer gefunden. Bitte zuerst in der Fahrerverwaltung registrieren.');
                            }
                        } catch { /* still */ }
                    }, 200);
                });
            }

            const getEffectiveReserveToMain = () => {
                const map = new Map(Object.entries(defaultReserveToMain || {}));
                for (const select of reserveMainSelects) {
                    const reserve = (select.getAttribute('data-reserve-driver') || '').trim();
                    if (!reserve) continue;

                    const main = (select.value || '').trim();
                    if (!main) {
                        map.delete(reserve);
                    } else {
                        map.set(reserve, main);
                    }
                }
                return map;
            };

            const getSelectedCounts = () => {
                const counts = new Map();
                for (const select of selects) {
                    const value = (select.value || '').trim();
                    if (!value) continue;
                    counts.set(value, (counts.get(value) || 0) + 1);
                }
                return counts;
            };

            const getDfnSelected = () => {
                const dnf = new Set();
                for (const check of dnfChecks) {
                    if (check.checked) dnf.add(check.value);
                }
                return dnf;
            };

            const hasReserveMainConflict = () => {
                const selected = new Set();
                for (const select of selects) {
                    const value = (select.value || '').trim();
                    if (value) selected.add(value);
                }
                for (const check of dnfChecks) {
                    if (check.checked) selected.add(check.value);
                }

                const mapping = getEffectiveReserveToMain();
                for (const [reserve, main] of mapping.entries()) {
                    if (selected.has(reserve) && selected.has(main)) {
                        return { reserve, main };
                    }
                }

                return null;
            };

            const buildReserveConflictBlockedSet = () => {
                const selected = new Set();
                for (const select of selects) {
                    const value = (select.value || '').trim();
                    if (value) selected.add(value);
                }
                for (const check of dnfChecks) {
                    if (check.checked) selected.add(check.value);
                }

                const blocked = new Set();
                const mapping = getEffectiveReserveToMain();
                for (const [reserve, main] of mapping.entries()) {
                    if (selected.has(reserve)) blocked.add(main);
                    if (selected.has(main)) blocked.add(reserve);
                }
                return blocked;
            };

            const syncDisabledOptions = () => {
                const dnfSelected = getDfnSelected();

                for (const select of selects) {
                    const currentValue = (select.value || '').trim();
                    if (currentValue && dnfSelected.has(currentValue)) {
                        select.value = '';
                    }
                }

                const counts = getSelectedCounts();
                const reserveBlocked = buildReserveConflictBlockedSet();

                for (const select of selects) {
                    const currentValue = (select.value || '').trim();
                    for (const option of select.options) {
                        if (!option.value) {
                            option.disabled = false;
                            option.hidden = false;
                            continue;
                        }

                        const isBlocked = counts.has(option.value) || dnfSelected.has(option.value) || reserveBlocked.has(option.value);
                        const shouldHide = option.value !== currentValue && isBlocked;

                        option.disabled = shouldHide;
                        option.hidden = shouldHide;
                    }
                }

                for (const check of dnfChecks) {
                    check.disabled = counts.has(check.value) || reserveBlocked.has(check.value);
                    if (check.disabled) check.checked = false;
                }
            };

            const hasDuplicateSelection = () => {
                const counts = getSelectedCounts();
                for (const count of counts.values()) {
                    if (count > 1) return true;
                }
                return false;
            };

            for (const select of selects) {
                select.addEventListener('change', syncDisabledOptions);
            }

            for (const check of dnfChecks) {
                check.addEventListener('change', syncDisabledOptions);
            }

            for (const select of reserveMainSelects) {
                select.addEventListener('change', syncDisabledOptions);
            }

            form.addEventListener('submit', (event) => {
                if (hasDuplicateSelection()) {
                    event.preventDefault();
                    alert('Jeder Fahrer darf nur einmal in den Positionen ausgewählt werden.');
                    syncDisabledOptions();
                    return;
                }

                const conflict = hasReserveMainConflict();
                if (conflict) {
                    event.preventDefault();
                    alert(`Reservefahrer '${conflict.reserve}' und Hauptfahrer '${conflict.main}' dürfen nicht gleichzeitig im selben Rennen eingetragen sein.`);
                    syncDisabledOptions();
                }

                // Pflicht: jeder Gastfahrer braucht einen Liga-Hauptfahrer.
                const guestSelects = Array.from(document.querySelectorAll('select.guest-main-select'));
                for (const sel of guestSelects) {
                    if (!sel.value || !sel.value.trim()) {
                        event.preventDefault();
                        sel.focus();
                        alert('Jeder Gastfahrer braucht einen Liga-Hauptfahrer (Pflicht-Zuordnung).');
                        return;
                    }
                }
            });

            // ── CSV-Rennimport: Spiel-Export einfügen → Positionen/Zeiten auto-füllen ──
            const raceCsvInput = document.getElementById('raceCsvInput');
            const raceCsvApplyBtn = document.getElementById('raceCsvApplyBtn');
            const raceCsvStatus = document.getElementById('raceCsvStatus');
            const timeInputs = Array.from(document.querySelectorAll('input[name="raceTimes"]'));

            const formatRaceMs = (ms) => {
                const totalSec = Math.floor(ms / 1000);
                const milli = ms - totalSec * 1000;
                const h = Math.floor(totalSec / 3600);
                const m = Math.floor((totalSec % 3600) / 60);
                const s = totalSec % 60;
                const pad = (n, w = 2) => String(n).padStart(w, '0');
                return h >= 1
                    ? `${h}:${pad(m)}:${pad(s)}.${pad(milli, 3)}`
                    : `${m}:${pad(s)}.${pad(milli, 3)}`;
            };

            const setRaceCsvStatus = (msg, kind) => {
                if (!raceCsvStatus) return;
                raceCsvStatus.textContent = msg;
                raceCsvStatus.className = 'small ' + (kind === 'err' ? 'text-danger fw-bold' : kind === 'warn' ? 'text-warning' : 'text-muted');
            };

            const clearNeedsDriverMarks = () => {
                for (const select of selects) {
                    select.classList.remove('needs-driver');
                    select.removeAttribute('title');
                }
            };

            const applyRaceCsv = async () => {
                if (!raceCsvInput || !raceCsvApplyBtn) return;
                const text = raceCsvInput.value.trim();
                if (!text) { setRaceCsvStatus('Bitte zuerst den Export-Text einfügen.', 'warn'); return; }

                const token = form ? form.querySelector('input[name="__RequestVerificationToken"]')?.value : null;
                if (!token) { setRaceCsvStatus('Sicherheits-Token fehlt — bitte Seite neu laden.', 'err'); return; }

                raceCsvApplyBtn.disabled = true;
                setRaceCsvStatus('Wird geparst …');
                try {
                    const resp = await fetch('/AdminLeague/ParseRaceCsv', {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({ csv: text })
                    });
                    if (!resp.ok) { setRaceCsvStatus(`Server-Fehler (HTTP ${resp.status}).`, 'err'); return; }

                    const data = await resp.json().catch(() => null);
                    if (!data) { setRaceCsvStatus('Ungültige Server-Antwort.', 'err'); return; }
                    if (data.error) { setRaceCsvStatus(data.error, 'err'); return; }
                    if (!Array.isArray(data.entries) || data.entries.length === 0) {
                        setRaceCsvStatus('Keine Positions-Zeilen in der Eingabe gefunden.', 'warn');
                        return;
                    }

                    // „Übernehmen"-Semantik: bestehende Füllung vorher vollständig leeren.
                    clearNeedsDriverMarks();
                    for (const select of selects) select.value = '';
                    for (const input of timeInputs) input.value = '';

                    let filled = 0, needsDriver = 0, dnfCount = 0, lappedCount = 0;
                    for (const entry of data.entries) {
                        const idx = entry.position - 1;
                        if (!Number.isInteger(idx) || idx < 0 || idx >= selects.length) continue;
                        const select = selects[idx];
                        const timeInput = timeInputs[idx];

                        if (entry.isDnf) {
                            // DNF behält die bestehende Semantik: Positions-Slot leer, Checkbox an.
                            dnfCount++;
                            const check = dnfChecks.find(c =>
                                (c.value || '').toLowerCase() === String(entry.driver || '').toLowerCase());
                            if (check) check.checked = true;
                            continue;
                        }

                        // Fahrer nur zuordnen, wenn der Name im Dropdown existiert (case-insensitive).
                        // "Spieler:in"/unbekannte Namen → leer + gelbe Markierung + Team-Tooltip.
                        const known = Array.from(select.options).find(o =>
                            (o.value || '').toLowerCase() === String(entry.driver || '').toLowerCase());
                        if (known && entry.driver) {
                            select.value = known.value;
                            filled++;
                        } else {
                            needsDriver++;
                            select.classList.add('needs-driver');
                            if (entry.team) select.title = `CSV-Team: ${entry.team}`;
                        }

                        if (entry.lappedText) {
                            if (timeInput) timeInput.value = entry.lappedText;
                            lappedCount++;
                        } else if (entry.totalTimeMs != null && timeInput) {
                            timeInput.value = formatRaceMs(entry.totalTimeMs);
                        }
                    }

                    syncDisabledOptions();
                    syncRowBaseTimes();

                    const parts = [
                        `${data.entries.length} Zeilen übernommen`,
                        `${filled} Fahrer zugeordnet`,
                        needsDriver > 0 ? `${needsDriver} manuell nachzutragen (gelb markiert)` : null,
                        lappedCount > 0 ? `${lappedCount} überrundet` : null,
                        dnfCount > 0 ? `${dnfCount} DNF erkannt` : null
                    ].filter(Boolean);
                    setRaceCsvStatus(parts.join(' · '), needsDriver > 0 ? 'warn' : '');
                } catch {
                    setRaceCsvStatus('Verbindungsfehler — bitte erneut versuchen.', 'err');
                } finally {
                    raceCsvApplyBtn.disabled = false;
                }
            };

            if (raceCsvApplyBtn) raceCsvApplyBtn.addEventListener('click', applyRaceCsv);

            // ── Drag & Drop + Sortierung: komplette Fahrer-Zeile verschieben ──
            // Position im DOM = Position im Formular-Array = finale Endposition (Server
            // übernimmt den Index direkt). Sortier-Basis ist die EFFEKTIVE Zeit =
            // Gesamtzeit + Strafsekunden.
            const racePointsMap = @Html.Raw(JsonSerializer.Serialize(pointsMap));
            const rowEls = () => Array.from(document.querySelectorAll('.race-position-block'));

            // Position-Label + data-pos an die aktuelle DOM-Reihenfolge angleichen.
            const renumberRaceRows = () => {
                rowEls().forEach((row, i) => {
                    row.dataset.pos = String(i + 1);
                    const text = row.querySelector('.race-pos-text');
                    if (text) text.textContent = `Position ${i + 1} (${racePointsMap[i] ?? 0} Pkt.)`;
                });
            };

            // selects/timeInputs sind const-Snapshots: nach jedem Umordnen in-place neu
            // befüllen, damit CSV-Import & Validierung die aktuelle DOM-Reihenfolge sehen.
            const refreshRaceFieldArrays = () => {
                selects.length = 0;
                selects.push(...document.querySelectorAll('.race-position-select'));
                timeInputs.length = 0;
                timeInputs.push(...document.querySelectorAll('input[name="raceTimes"]'));
            };

            // Vorzeichenbehaftet: negativ = Minus-Strafe (Zeit-Abzug), leer/nichtnumerisch = 0.
            const parsePenaltySecs = (raw) => {
                const v = parseInt(String(raw ?? '').trim(), 10);
                return Number.isFinite(v) ? v : 0;
            };

            // Spiegel von RaceTimeParser.ParseMs (Single Source of Truth, server):
            // [H:]MM:SS(.mmm), MM:SS(.mmm) oder nackte Sekunden (12.423, 2700).
            // Absichtlich keine Ziffern-Bounds — der Server akzeptiert z. B. "24:60"
            // und "1:2:3" auch, sonst würden server-valid Zeiten beim Sortieren still
            // ans Ende rutschen. Komma = Dezimaltrenner wird auf "." normalisiert.
            const parseTimeToMs = (raw) => {
                let s = String(raw ?? '').trim().replace(/,/g, '.');
                if (!s) return null;
                // Strikte Zahlenprüfung statt parseFloat: "+1 Runde" (CSV-Lapped-Text)
                // und andere Nicht-Zahlen werden wie beim Server (double.TryParse) zu
                // null — parseFloat hätte "+1 Runde" still als 1000 ms gelesen.
                const numRe = /^\d+(?:\.\d+)?$/;
                if (s.includes(':')) {
                    const parts = s.split(':');
                    if (parts.length === 3 && numRe.test(parts[0]) && numRe.test(parts[1]) && numRe.test(parts[2]))
                        return Math.floor((parseInt(parts[0], 10) * 3600 + parseInt(parts[1], 10) * 60 + parseFloat(parts[2])) * 1000);
                    if (parts.length === 2 && numRe.test(parts[0]) && numRe.test(parts[1]))
                        return Math.floor((parseInt(parts[0], 10) * 60 + parseFloat(parts[1])) * 1000);
                    return null;
                }
                if (!numRe.test(s)) return null;
                return Math.floor(parseFloat(s) * 1000);
            };

            const getRowEffectiveMs = (row) => {
                const timeMs = parseTimeToMs(row.querySelector('input[name="raceTimes"]')?.value);
                if (timeMs == null) return null;
                // Effektive Zeit kann durch eine zu hohe Minus-Strafe nicht negativ werden → mind. 1 ms
                // (gleiche Klemme wie serverseitig in ApplyRaceEntriesAsync).
                return Math.max(1, timeMs + parsePenaltySecs(row.querySelector('input[name="penaltySeconds"]')?.value) * 1000);
            };

            // Basis-Gesamtzeit je Zeitfeld merken (data-base-ms), damit eine eingetragene
            // Strafe immer von der ORIGINAL eingegebenen Gesamtzeit rechnet — nie von einem
            // bereits korrigierten Wert (kein kumulatives Aufaddieren über mehrere Strafen).
            const syncRowBaseTimes = () => {
                for (const input of timeInputs) {
                    const ms = parseTimeToMs(input.value);
                    input.dataset.baseMs = ms == null ? '' : String(ms);
                }
            };

            let dragSourceRow = null;
            const dropCleanup = (clearSource = true) => {
                for (const r of rowEls()) r.classList.remove('race-dragging', 'race-drop-target');
                if (clearSource) dragSourceRow = null;
            };

            const wireRowDragHandlers = (row) => {
                const handle = row.querySelector('.race-sort-handle');
                if (handle && !handle.dataset.raceDragBound) {
                    handle.dataset.raceDragBound = '1';
                    handle.addEventListener('dragstart', (e) => {
                        dragSourceRow = row;
                        e.stopPropagation();
                        e.dataTransfer.effectAllowed = 'move';
                        e.dataTransfer.setData('text/plain', String(row.dataset.pos));
                        // Drag erst nach dem Frame sichtbar dämpfen, damit das Drag-Image
                        // die Zeile nicht gedimmt abfotografiert. Guard gegen rAF-Ghost:
                        // war der Drag schon beendet (dropCleanup → dragSourceRow = null),
                        // wird die Klasse nicht mehr gesetzt und bleibt nicht hängen.
                        requestAnimationFrame(() => { if (dragSourceRow === row) row.classList.add('race-dragging'); });
                    });
                    handle.addEventListener('dragend', () => dropCleanup());
                }
                if (row.dataset.raceRowBound) return;
                row.dataset.raceRowBound = '1';
                row.addEventListener('dragover', (e) => {
                    if (dragSourceRow && dragSourceRow !== row) {
                        e.preventDefault();
                        e.dataTransfer.dropEffect = 'move';
                        row.classList.add('race-drop-target');
                    }
                });
                row.addEventListener('dragleave', (e) => {
                    if (!row.contains(e.relatedTarget)) row.classList.remove('race-drop-target');
                });
                row.addEventListener('drop', (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    if (!dragSourceRow || dragSourceRow === row) { dropCleanup(); return; }
                    const rect = row.getBoundingClientRect();
                    const insertBefore = (e.clientY - rect.top) < rect.height / 2;
                    dropCleanup(false);
                    dragSourceRow.parentNode.removeChild(dragSourceRow);
                    row.parentNode.insertBefore(dragSourceRow, insertBefore ? row : row.nextSibling);
                    renumberRaceRows();
                    refreshRaceFieldArrays();
                    syncDisabledOptions();
                });
            };

            // Sortierung: aufsteigend nach Gesamtzeit (Strafen sind per Absorb-Verhalten
            // bereits ins Gesamtzeit-Feld eingerechnet, das Straf-Feld ist leer). Zeilen
            // ohne parsebare Zeit (leer, „+1 Runde“) wandern ans Ende, relative Reihenfolge
            // bleibt. getRowEffectiveMs wendet eine evtl. noch gefüllte Strafe trotzdem an.
            const sortRowsByEffectiveTime = () => {
                const rows = rowEls();
                if (rows.length === 0) return;
                const withTime = [];
                const withoutTime = [];
                rows.forEach((row, i) => {
                    const eff = getRowEffectiveMs(row);
                    (eff == null ? withoutTime : withTime).push({ row, eff, i });
                });
                withTime.sort((a, b) => (a.eff - b.eff) || (a.i - b.i));
                const ordered = withTime.map(x => x.row).concat(withoutTime.map(x => x.row));
                const parent = rows[0].parentNode;
                for (const r of ordered) parent.appendChild(r);
                renumberRaceRows();
                refreshRaceFieldArrays();
                syncDisabledOptions();
            };

            const sortByTimeBtn = document.getElementById('sortByTimeBtn');
            if (sortByTimeBtn) sortByTimeBtn.addEventListener('click', sortRowsByEffectiveTime);

            for (const row of rowEls()) wireRowDragHandlers(row);

            // Straf-Eingabe = Rechner: Eine eingetragene Strafe (± Sekunden) wird SOFORT
            // auf die Basis-Gesamtzeit addiert bzw. subtrahiert und das Ergebnis direkt in
            // das Gesamtzeit-Feld geschrieben. Das Straf-Feld leert sich danach wieder.
            // So landet die "neu berechnete Zeit" genau dort, wo der Fahrer sie nachher
            // eintragen würde — und der Server (der die Strafen OHNE Doppel-Addierung
            // verarbeitet, weil das Feld leer bleibt) erhält die korrigierte Endzeit.
            for (const row of rowEls()) {
                const timeInput = row.querySelector('input[name="raceTimes"]');
                const penaltyInput = row.querySelector('input[name="penaltySeconds"]');
                if (!timeInput || !penaltyInput) continue;
                timeInput.addEventListener('input', () => {
                    const ms = parseTimeToMs(timeInput.value);
                    timeInput.dataset.baseMs = ms == null ? '' : String(ms);
                });
                penaltyInput.addEventListener('input', () => {
                    const base = Number(timeInput.dataset.baseMs);
                    const penalty = parsePenaltySecs(penaltyInput.value);
                    // Nur anwenden, wenn eine echte Basis-Zeit existiert ("+1 Runde" etc.
                    // wird bewusst NICHT mit Strafe verrechnet) und tatsächlich eine Strafe
                    // eingegeben wurde. Gesamtzeit nie negativ → Klemme auf 1 ms wie server.
                    if (Number.isFinite(base) && base > 0 && penalty !== 0) {
                        timeInput.value = formatRaceMs(Math.max(1, base + penalty * 1000));
                    }
                    penaltyInput.value = '';
                });
            }

            renumberRaceRows();
            syncRowBaseTimes();

            syncDisabledOptions();
        })();
    </script>
}



