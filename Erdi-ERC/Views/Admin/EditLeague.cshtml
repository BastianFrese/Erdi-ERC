@model Erdi_ERC.Models.League
@using Erdi_ERC.Helpers
@{
    ViewData["Title"] = $"Liga: {Model.Name}";
    ViewData["Kicker"] = "Liga";
    ViewData["HeroTitle"] = Model.Name;
    ViewData["HeroSubtitle"] = "Verwalte Details, Fahrerliste, Rennen und kommende Events dieser Liga in einem zentralen Bereich.";
    var recentRaceUndos = (ViewBag.RecentRaceUndos as List<Erdi_ERC.Models.RaceUndoEntry>) ?? new List<Erdi_ERC.Models.RaceUndoEntry>();
    var mainDriverOptions = Model.Standings
        .Where(x => !x.IsReserveDriver && !string.IsNullOrWhiteSpace(x.Driver))
        .Select(x => x.Driver.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList();
}


<div class="league-page">
    <div class="league-page-hero">
        <div>
            <partial name="_AdminHeroCard" />
            <div class="league-page-pills mt-3">
                <span class="league-page-pill"><i class="bi bi-trophy-fill me-1"></i>@Model.Standings.Count Fahrer</span>
                <span class="league-page-pill"><i class="bi bi-flag-fill me-1"></i>@Model.Races.Count Rennen</span>
                <span class="league-page-pill">@(Model.IsArchived ? "Archiviert" : "Aktiv")</span>
            </div>
        </div>
        <div class="league-page-side">
            <div class="league-page-hero-card league-page-action-panel">
                <div class="league-page-action-panel__title">Aktionen</div>
                <div class="league-page-action-panel__stack">
                    <a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="Index">← Zurück zum Dashboard</a>
                    <a class="btn btn-success" asp-controller="AdminApplications" asp-action="ManualRegister" asp-route-leagueId="@Model.Id">
                        <i class="bi bi-person-plus me-1"></i>Fahrer manuell registrieren
                    </a>
                    <form asp-controller="AdminLeague" asp-action="ValidateReserveData" method="post" class="d-inline" onsubmit="return confirm('Reservefahrer-Daten dieser Liga prüfen?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="leagueId" value="@Model.Id" />
                        <button class="btn btn-outline-info w-100" type="submit">Reserve-Daten prüfen</button>
                    </form>
                    <form asp-action="RebuildLeagueStats" method="post" class="d-inline" onsubmit="return confirm('Stats für diese Liga neu berechnen?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button class="btn btn-outline-warning w-100" type="submit">Stats dieser Liga neu berechnen</button>
                    </form>
                    <a class="btn btn-primary" asp-controller="AdminLeague" asp-action="EnterRace" asp-route-leagueId="@Model.Id">Renn-Ergebnis eintragen</a>
                </div>
            </div>
        </div>
    </div>


    @if (recentRaceUndos.Count > 0)
    {
        <div class="card mb-4 shadow-sm league-page-surface">
            <div class="card-header d-flex justify-content-between align-items-center gap-2">
                <strong>Letzte Löschungen rückgängig</strong>
                <button class="btn btn-sm btn-outline-secondary" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#recentRaceUndosCollapse"
                        aria-expanded="false"
                        aria-controls="recentRaceUndosCollapse">
                    Ein-/Ausklappen
                </button>
            </div>
            <div id="recentRaceUndosCollapse" class="collapse">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Zeit (UTC)</th>
                                    <th>Gelöschtes Rennen</th>
                                    <th>Benutzer</th>
                                    <th class="text-end">Aktion</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var undo in recentRaceUndos)
                                {
                                    <tr>
                                        @* CreatedAt der Undo-Einträge ist UTC (DateTime.UtcNow). *@
                                        <td>@undo.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>#@undo.OriginalRaceId</td>
                                        <td>@undo.Actor</td>
                                        <td class="text-end">
                                            <form asp-controller="AdminLeague" asp-action="UndoDeleteRace" method="post" class="d-inline" onsubmit="return confirm('Gelöschtes Rennen wiederherstellen?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="undoId" value="@undo.Id" />
                                                <button class="btn btn-sm btn-outline-success" type="submit">Wiederherstellen</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="card mb-4 shadow-sm league-page-surface">
        <div class="card-header"><strong>Liga-Details</strong></div>
        <div class="card-body">
            <form asp-controller="AdminLeagueManagement" asp-action="UpdateLeague" method="post" class="row g-2" id="updateLeagueForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="col-md-3">
                    <label class="form-label">Name</label>
                    <input class="form-control" name="name" value="@Model.Name" required />
                </div>
                <div class="col-md-1">
                    <label class="form-label">Reihenfolge</label>
                    <input class="form-control" type="number" name="sortOrder" value="@Model.SortOrder" min="0" max="9999" title="Niedrigere Zahl erscheint zuerst" />
                </div>
                <div class="col-md-8">
                    <label class="form-label">Beschreibung</label>
                    <textarea class="form-control" name="description" rows="2">@Model.Description</textarea>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Kapazität <span class="text-muted small">(Stammplätze)</span></label>
                    <input class="form-control" type="number" name="capacity" value="@(Model.Capacity)" min="0" max="999" placeholder="∞" title="Soll-Anzahl Stammfahrer. Leer/0 = unbegrenzt." />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Streichresultate <span class="text-muted small">(Drop)</span></label>
                    <input class="form-control" type="number" name="dropWorstResults" value="@(Model.DropWorstResults)" min="0" max="99" placeholder="0" title="Anzahl der schwächsten Rennergebnisse, die je Fahrer nicht zählen. Leer/0 = alle zählen." />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Aktuelle Saison <span class="text-muted small">(Tabelle)</span></label>
                    <input class="form-control" type="text" name="currentSeason" value="@Model.CurrentSeason" maxlength="32" placeholder="z.B. 2026" title="Ist sie gesetzt, zählt die Tabelle nur Rennen dieser Saison. Leer = alle Rennen." />
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="countsTowardOverall" value="true" id="leagueCountsOverall" @(Model.CountsTowardOverall ? "checked" : "") />
                        <label class="form-check-label" for="leagueCountsOverall">In Constructors-Gesamtwertung <span class="text-muted small">(Punkte aller Ligen zusammenzählen)</span></label>
                    </div>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="acceptsApplications" value="true" id="leagueAcceptsApplications" @(Model.AcceptsApplications ? "checked" : "") />
                        <label class="form-check-label" for="leagueAcceptsApplications">Bewerbungen offen <span class="text-muted small">(Liga erscheint im Bewerbungsformular)</span></label>
                    </div>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-primary w-100" type="submit">Speichern</button>
                </div>
            </form>

            <hr />

            @if (!Model.IsArchived)
            {
                <form asp-action="ArchiveLeague" method="post" class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="col-md-8">
                        <label class="form-label">Name in Ewiger Liste (Archivname)</label>
                        <input class="form-control" name="archivedName" placeholder="z. B. ERC MAIN S10" value="@Model.Name" />
                    </div>
                    <div class="col-md-4 d-grid">
                        <button class="btn btn-outline-warning" type="submit" onclick="return confirm('Liga als abgeschlossen markieren? Dabei wird auch der .xlsx Snapshot aktualisiert.');">Liga als abgeschlossen markieren</button>
                    </div>
                </form>
            }
            else
            {
                <div class="alert alert-warning d-flex justify-content-between align-items-center mb-0">
                    <div>
                        Diese Liga ist abgeschlossen und erscheint mit <strong>@(Model.ArchivedName ?? Model.Name)</strong> in der Ewigen Liste.
                        @if (Model.ArchivedAt.HasValue)
                        {
                            <span class="text-muted">(seit @Model.ArchivedAt.Value.ToString("dd.MM.yyyy"))</span>
                        }
                    </div>
                    <form asp-action="UnarchiveLeague" method="post" class="ms-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button class="btn btn-sm btn-outline-secondary" type="submit">Wieder aktiv setzen</button>
                    </form>
                </div>
            }

            <hr />

            <details class="mb-0">
                <summary class="fw-semibold text-success-emphasis" style="cursor:pointer;user-select:none;">
                    🆕 Neue Saison starten / Liga duplizieren
                </summary>
                <div class="mt-3">
                    <p class="small text-muted mb-2">
                        Erstellt eine <strong>neue Liga</strong> mit dem kompletten Fahrer-Roster dieser Liga
                        (Name, Nummer, Team, Reserve-Status). <strong>Punkte, Siege und Rennen werden zurückgesetzt</strong> —
                        ideal für den Start einer neuen Saison. Optional kannst du die aktuelle Liga dabei abschließen (Archiv + .xlsx-Snapshot).
                    </p>
                    <form asp-action="CloneLeague" method="post" class="row g-2 align-items-end"
                          onsubmit="return confirm('Neue Liga mit dem Roster dieser Liga erstellen?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="sourceId" value="@Model.Id" />
                        <div class="col-md-5">
                            <label class="form-label">Name der neuen Liga/Saison</label>
                            <input class="form-control" name="newName" placeholder="z. B. @Model.Name S+1" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Neue ID <span class="text-muted small">(optional)</span></label>
                            <input class="form-control" name="newId" placeholder="automatisch aus Name" maxlength="64" pattern="[^\s]*" title="Keine Leerzeichen" />
                        </div>
                        <div class="col-md-2 d-flex align-items-end pb-2">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="archiveSource" value="true" id="cloneArchiveSource" />
                                <label class="form-check-label small" for="cloneArchiveSource">Alte Liga archivieren</label>
                            </div>
                        </div>
                        <div class="col-md-2 d-grid">
                            <button class="btn btn-success" type="submit">Saison erstellen</button>
                        </div>
                    </form>
                </div>
            </details>

            <hr />

            <details class="mb-0">
                <summary class="fw-semibold text-warning-emphasis" style="cursor:pointer;user-select:none;">
                    ⚠️ Liga-ID umbenennen
                </summary>
                <div class="mt-3">
                    <p class="small text-muted mb-2">
                        Die ID ist der interne Schlüssel dieser Liga (<code>@Model.Id</code>). Eine Änderung aktualisiert automatisch
                        alle verknüpften Datensätze (Standings, Rennen, Bewerbungen, Strafen, Verlauf …).
                        Die Aktion läuft in einer Transaktion — entweder alles oder nichts.
                    </p>
                    <form asp-action="RenameLeagueId" method="post" class="row g-2 align-items-end"
                          onsubmit="return confirm('Liga-ID wirklich von \'@Model.Id\' umbenennen? Alle verknüpften Daten werden mitgezogen.');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="oldId" value="@Model.Id" />
                        <div class="col-md-4">
                            <label class="form-label">Aktuelle ID</label>
                            <input class="form-control" value="@Model.Id" disabled />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Neue ID <span class="text-muted small">(max. 64 Zeichen, keine Leerzeichen)</span></label>
                            <input class="form-control" name="newId" required maxlength="64" pattern="[^\s]+" title="Keine Leerzeichen erlaubt" />
                        </div>
                        <div class="col-md-4 d-grid">
                            <button class="btn btn-warning" type="submit">ID umbenennen</button>
                        </div>
                    </form>
                </div>
            </details>

            <hr />

            <div class="d-flex flex-column gap-2">
                <div class="small text-muted">Reset / Saison-Neustart: Entfernt alle Fahrer, Rennen, Events, Strafen und Undo-Einträge dieser Liga. Funktioniert auch bei abgeschlossener Liga.</div>
                <form asp-action="ClearLeagueData" method="post" class="d-inline"
                      onsubmit="return confirm('Diese Liga wirklich vollständig leeren? Alle aktuellen Liga-Daten werden entfernt. Bei abgeschlossener Liga wird vorher ein .xlsx Snapshot aktualisiert.');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button class="btn btn-outline-danger" type="submit">Liga vollständig leeren</button>
                </form>
            </div>
        </div>
    </div>

    @* === Formulare außerhalb der Tabellen, per form="..." referenziert === *@

    <div class="card mb-4 shadow-sm league-page-surface league-page-surface--standings">
        <div class="card-header d-flex justify-content-between align-items-center gap-2 flex-wrap">
            <strong>Bestenliste</strong>
            <div class="d-flex gap-2 flex-wrap">
                <button class="btn btn-sm btn-outline-secondary" type="button"
                        data-bs-toggle="collapse" data-bs-target="#bulkImportCollapse"
                        aria-expanded="false" aria-controls="bulkImportCollapse">
                    <i class="bi bi-list-ul me-1"></i>Fahrer per Liste importieren
                </button>
                <form asp-controller="AdminLeague" asp-action="ResortStandings" method="post" class="d-inline"
                      onsubmit="return confirm('Positionen nach aktuellen Punkten neu nummerieren? (Punkte selbst bleiben unverändert)');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="leagueId" value="@Model.Id" />
                    <button class="btn btn-sm btn-outline-info" type="submit" title="Reihenfolge rein nach Punkten/Siegen — ohne Renn-Neuberechnung">
                        <i class="bi bi-sort-numeric-down me-1"></i>Nach Punkten neu nummerieren
                    </button>
                </form>
            </div>
        </div>
        <div id="bulkImportCollapse" class="collapse">
            <div class="card-body border-bottom">
                <form asp-controller="AdminLeague" asp-action="BulkAddStandings" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="leagueId" value="@Model.Id" />
                    <label class="form-label mb-1">Mehrere Fahrer auf einmal hinzufügen</label>
                    <p class="small text-muted mb-2">
                        Ein Fahrer pro Zeile. Optional Nummer und Team mit Semikolon trennen:
                        <code>Name; Nr; Team</code> — z. B. <code>Max Müller; 33; Red Bull Racing</code>.
                        Bereits vorhandene Namen und vergebene Nummern werden übersprungen. Punkte starten bei 0.
                    </p>
                    <textarea class="form-control mb-2" name="bulk" rows="6" placeholder="Max Müller; 33; Red Bull Racing&#10;Lena Schmidt; 16; Ferrari&#10;Tom Becker"></textarea>
                    <button class="btn btn-sm btn-primary" type="submit"><i class="bi bi-plus-lg me-1"></i>Fahrer importieren</button>
                </form>
            </div>
        </div>
        <div class="card-body p-0">
            <form asp-controller="AdminLeague" asp-action="SaveAllStandings" method="post" id="standings-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="leagueId" value="@Model.Id" />
                <table class="table table-sm align-middle mb-0 league-page-standings-table">
                    <thead class="table-light">
                        <tr>
                            <th style="width:56px" title="Automatisch aus Punkten">#</th>
                            <th>Fahrer</th>
                            <th style="width:90px">Nr.</th>
                            <th>Team</th>
                            <th style="width:110px">Reserve?</th>
                            <th>Reservefahrer</th>
                            <th style="width:64px" class="text-center" title="Aus Rennen">Siege</th>
                            <th style="width:64px" class="text-center" title="Aus Rennen + Korrektur">Punkte</th>
                            <th style="width:104px" title="Manueller Bonus/Malus, bleibt bei Neuberechnung erhalten">Korrektur</th>
                            <th style="width:64px" class="text-center">Löschen</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.Standings)
                        {
                            var rfId = $"reserve-for-{s.RowId}";
                            <tr>
                                <td class="text-muted fw-semibold">@s.Position<input type="hidden" name="rowId" value="@s.RowId" /></td>
                                <td><input class="form-control form-control-sm js-driver-input" name="driver" value="@s.Driver" autocomplete="off" list="driver-suggestions" /></td>
                                <td><input class="form-control form-control-sm" type="number" min="0" max="999" name="driverNumber" value="@s.DriverNumber" /></td>
                                <td>
                                    <select class="form-select form-select-sm" name="team">
                                        <option value="">-- Team wählen --</option>
                                        @foreach (var t in F1TeamsHelper.Teams)
                                        {
                                            <option value="@t.Name" selected="@(t.Name == s.Team ? "selected" : null)">@t.Name</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <select class="form-select form-select-sm js-reserve-toggle" name="isReserveDriver" data-target="@rfId">
                                        <option value="false" selected="@(!s.IsReserveDriver ? "selected" : null)">Nein</option>
                                        <option value="true" selected="@(s.IsReserveDriver ? "selected" : null)">Ja</option>
                                    </select>
                                </td>
                                <td>
                                    <select class="form-select form-select-sm" id="@rfId" name="reserveForDriver" disabled="@(!s.IsReserveDriver ? "disabled" : null)">
                                        <option value="">-- Hauptfahrer wählen --</option>
                                        @foreach (var mainDriver in mainDriverOptions)
                                        {
                                            <option value="@mainDriver" selected="@(string.Equals(mainDriver, s.ReserveForDriver, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@mainDriver</option>
                                        }
                                    </select>
                                </td>
                                <td class="text-center fw-semibold">@s.Wins</td>
                                <td class="text-center fw-semibold">@PointsFormatHelper.Format(s.Points)</td>
                                <td><input class="form-control form-control-sm" type="number" step="0.01" name="pointsAdjustment" value="@PointsFormatHelper.FormatForInput(s.PointsAdjustment)" title="+/- Punkte" /></td>
                                <td class="text-center"><input class="form-check-input" type="checkbox" name="deleteRowIds" value="@s.RowId" title="Zum Löschen markieren" /></td>
                            </tr>
                        }
                        @* Leerzeile zum Anlegen — Name eintragen genügt, der Rest ist optional *@
                        <tr class="league-page-add-row">
                            <td class="text-muted small">neu<input type="hidden" name="rowId" value="0" /></td>
                            <td><input class="form-control form-control-sm js-driver-input" name="driver" placeholder="Fahrer hinzufügen…" autocomplete="off" list="driver-suggestions" /></td>
                            <td><input class="form-control form-control-sm" type="number" min="0" max="999" name="driverNumber" placeholder="Nr." /></td>
                            <td>
                                <select class="form-select form-select-sm" name="team">
                                    <option value="">-- Team wählen --</option>
                                    @foreach (var t in F1TeamsHelper.Teams)
                                    {
                                        <option value="@t.Name">@t.Name</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <select class="form-select form-select-sm js-reserve-toggle" name="isReserveDriver" data-target="reserve-for-new">
                                    <option value="false" selected="selected">Nein</option>
                                    <option value="true">Ja</option>
                                </select>
                            </td>
                            <td>
                                <select class="form-select form-select-sm" id="reserve-for-new" name="reserveForDriver" disabled>
                                    <option value="">-- Hauptfahrer wählen --</option>
                                    @foreach (var mainDriver in mainDriverOptions)
                                    {
                                        <option value="@mainDriver">@mainDriver</option>
                                    }
                                </select>
                            </td>
                            <td class="text-center text-muted">–</td>
                            <td class="text-center text-muted">–</td>
                            <td><input class="form-control form-control-sm" type="number" step="0.01" name="pointsAdjustment" value="0" /></td>
                            <td class="text-center text-muted">–</td>
                        </tr>
                    </tbody>
                </table>
                <div class="p-3 d-flex justify-content-between align-items-center gap-2 flex-wrap border-top">
                    <span class="text-muted small"><i class="bi bi-info-circle me-1"></i>Position, Siege und Punkte werden automatisch aus den Rennen (+ Korrektur) berechnet. Zum Entfernen das Häkchen in „Löschen" setzen. Einen Fahrer umzubenennen wirkt systemweit (Fahrerkarte, Ergebnisse, alle Ligen).</span>
                    <button class="btn btn-primary" type="submit"
                            onclick="return confirm('Alle Änderungen an der Fahrerliste speichern? Markierte Zeilen werden gelöscht.');">
                        <i class="bi bi-floppy-fill me-1"></i>Alle Änderungen speichern
                    </button>
                </div>
            </form>
        </div>
    </div>

    @section Scripts {
        <datalist id="driver-suggestions"></datalist>
        <script>
            (() => {
                const toggles = Array.from(document.querySelectorAll('.js-reserve-toggle'));

                const sync = (toggle) => {
                    const targetId = toggle.getAttribute('data-target');
                    if (!targetId) return;
                    const target = document.getElementById(targetId);
                    if (!target) return;

                    const isReserve = (toggle.value || '').toLowerCase() === 'true';
                    target.disabled = !isReserve;
                    if (!isReserve) {
                        target.value = '';
                    }
                };

                for (const toggle of toggles) {
                    toggle.addEventListener('change', () => sync(toggle));
                    sync(toggle);
                }

                const datalist = document.getElementById('driver-suggestions');
                let timer = null;
                let lastQuery = '';
                const cache = new Map();

                async function loadSuggestions(q, input) {
                    if (!datalist || q.length < 2 || q === lastQuery) return;
                    lastQuery = q;
                    let items;
                    if (cache.has(q)) {
                        items = cache.get(q);
                    } else {
                        try {
                            const resp = await fetch(`/AdminLeague/DriverSuggestions?q=${encodeURIComponent(q)}`, { credentials: 'same-origin' });
                            if (!resp.ok) return;
                            items = await resp.json();
                            cache.set(q, items);
                        } catch { return; }
                    }
                    datalist.innerHTML = '';
                    const seen = new Set();
                    for (const m of items) {
                        const key = (m.gamerTag || '').toLowerCase();
                        if (!key || seen.has(key)) continue;
                        seen.add(key);
                        const opt = document.createElement('option');
                        opt.value = m.gamerTag;
                        opt.label = `${m.platform} • ${m.discordName}`;
                        datalist.appendChild(opt);
                    }
                    input.classList.toggle('is-valid', items.some(m => m.exact && m.gamerTag.toLowerCase() === q.toLowerCase()));
                }

                document.addEventListener('input', (ev) => {
                    const t = ev.target;
                    if (!(t instanceof HTMLInputElement) || !t.classList.contains('js-driver-input')) return;
                    const val = (t.value || '').trim();
                    clearTimeout(timer);
                    timer = setTimeout(() => loadSuggestions(val, t), 200);
                });
            })();
        </script>
    }

    @* Races *@
    @foreach (var r in Model.Races)
    {
        <form asp-controller="AdminLeague" asp-action="SaveRace" method="post" id="save-race-@r.RowId">
            @Html.AntiForgeryToken()
            <input type="hidden" name="rowId" value="@r.RowId" />
            <input type="hidden" name="leagueId" value="@Model.Id" />
        </form>
        <form asp-controller="AdminLeague" asp-action="DeleteRace" method="post" id="del-race-@r.RowId">
            @Html.AntiForgeryToken()
            <input type="hidden" name="rowId" value="@r.RowId" />
        </form>
    }

    <div class="card mb-4 shadow-sm league-page-surface">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Rennen</strong>
            <a class="btn btn-sm btn-primary" asp-controller="AdminLeague" asp-action="EnterRace" asp-route-leagueId="@Model.Id">Renn-Ergebnis eintragen</a>
        </div>
        <div class="card-body p-0">
            <table class="table table-sm align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:220px">Datum / Start</th>
                        <th>Strecke</th>
                        <th>Sieger</th>
                        <th>Schnellste Runde</th>
                        <th style="width:120px">Punkte</th>
                        <th>Reserve-Einsätze</th>
                        <th style="width:140px"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Races)
                    {
                        var f = $"save-race-{r.RowId}";
                        var d = $"del-race-{r.RowId}";
                        var reserveAssignments = r.ReserveAssignments
                            .Where(x => !string.IsNullOrWhiteSpace(x.ReserveDriver) && !string.IsNullOrWhiteSpace(x.MainDriver))
                            .OrderBy(x => x.ReserveDriver)
                            .ToList();
                        <tr>
                            <td><input class="form-control form-control-sm" type="datetime-local" name="date" value="@r.Date.ToString("yyyy-MM-ddTHH:mm")" form="@f" required /></td>
                            <td><input class="form-control form-control-sm" name="track" value="@r.Track" form="@f" required /></td>
                            <td><input class="form-control form-control-sm" name="winner" value="@r.Winner" form="@f" /></td>
                            <td><input class="form-control form-control-sm" name="fastestLap" value="@r.FastestLap" form="@f" /></td>
                            <td>
                                <select class="form-select form-select-sm @(r.PointsPercent < RacePointsFactor.Full ? "border-warning" : "")"
                                        name="pointsPercent" form="@f"
                                        title="Punkte-Faktor bei Rennabbruch">
                                    @foreach (var percent in RacePointsFactor.AllowedPercents)
                                    {
                                        <option value="@percent" selected="@(percent == r.PointsPercent ? "selected" : null)">@percent %</option>
                                    }
                                </select>
                                @if (r.PointsPercent < RacePointsFactor.Full)
                                {
                                    <span class="badge text-bg-warning text-dark mt-1" title="Rennen abgebrochen — es werden nur @r.PointsPercent % der Punkte vergeben">@r.PointsPercent % Punkte</span>
                                }
                            </td>
                            <td>
                                @if (reserveAssignments.Count == 0)
                                {
                                    <span class="text-muted small">-</span>
                                }
                                else
                                {
                                    <div class="small d-flex flex-column gap-1">
                                        @foreach (var assignment in reserveAssignments)
                                        {
                                            <span class="badge text-bg-info text-start">@assignment.ReserveDriver → @assignment.MainDriver</span>
                                        }
                                    </div>
                                }
                                @if (r.GuestAssignments?.Any(g => !string.IsNullOrWhiteSpace(g.GuestDriver)
                                    && !string.IsNullOrWhiteSpace(g.MainDriver)
                                    && g.MainDriver != Erdi_ERC.Services.StatsService.GuestSentinelNoMain) ?? false)
                                {
                                    <div class="small d-flex flex-column gap-1 mt-1">
                                        @foreach (var ga in r.GuestAssignments.Where(g => !string.IsNullOrWhiteSpace(g.GuestDriver)
                                            && !string.IsNullOrWhiteSpace(g.MainDriver)
                                            && g.MainDriver != Erdi_ERC.Services.StatsService.GuestSentinelNoMain))
                                        {
                                            <span class="badge text-bg-warning text-start text-dark" title="Cross-League-Gast">@ga.GuestDriver → @ga.MainDriver</span>
                                        }
                                    </div>
                                }
                            </td>
                            <td>
                                <a class="btn btn-sm btn-outline-primary" asp-controller="AdminLeague" asp-action="EditRace" asp-route-rowId="@r.RowId" title="Positionen, Zeiten, DNF & Reserve vollständig bearbeiten">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <button class="btn btn-sm btn-success" type="submit" form="@f" title="Datum/Strecke/Sieger schnell speichern">✔</button>
                                <button class="btn btn-sm btn-outline-danger" type="submit" form="@d"
                                        onclick="return confirm('Rennen löschen? Du kannst es danach über „Letzte Löschungen rückgängig\" wiederherstellen.');">❌</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card mb-4 shadow-sm league-page-surface">
        <div class="card-header bg-light d-flex justify-content-between align-items-center gap-2">
            <strong>📅 Anstehende Events</strong>
            <a class="btn btn-sm btn-outline-primary" asp-controller="AdminRaceCalendar" asp-action="Index">
                Renn-Kalender verwalten <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="card-body">
            <p class="mb-0 text-muted small">
                Renntermine werden zentral im <strong>Renn-Kalender</strong> verwaltet — ein Strecken-Wochenende mit Distanz und einem Termin pro Liga.
            </p>
        </div>
    </div>
</div>


    </div>
</div>

