@{
    ViewData["Title"] = "FAQ";
    Layout = "_Layout";

    var items = new (string Icon, string Question, string Answer)[]
    {
        ("bi-clipboard-check-fill",
         "Wie melde ich mich in der Liga an?",
         "Um unserer Liga beizutreten, musst du nur oben auf den roten Anmelde-Button drücken und das Formular ausfüllen. Danach werten wir deine Daten aus und beurteilen, ob wir einen freien Platz für dich haben."),
        ("bi-discord",
         "Woher weiß ich, ob ich für einen Platz angenommen wurde?",
         "Sobald wir deine Anmeldung bearbeitet haben, wirst du von uns über Discord benachrichtigt. Sollten wir uns auch nach längerer Zeit nicht bei dir melden, schreib einen unserer Admins auf Discord an."),
        ("bi-controller",
         "Ist die ERC rein Formel-1-basiert?",
         "Auch wenn unser Name \"<OWNER_HANDLE>s Racing Community\" etwas anderes aussagt, sind wir trotzdem auch offen für anderes. Gaming ist unsere Leidenschaft - Spiele wie CS:GO, EA Sports FC oder auch Klassiker wie Monopoly haben bei uns einen Platz."),
        ("bi-heart-fill",
         "Wieso sollte ich bei der ERC mitmachen?",
         "Die ERC ist ein langjährig bestehendes Projekt, das mit Herz und Liebe von unseren Mitarbeitern und vor allem von <OWNER_HANDLE> selbst geführt wird. Nicht nur das High-Quality-Entertainment auf Twitch, sondern auch die Freundschaften, die bei uns geknüpft werden, sind ein wichtiger Bestandteil der ERC-DNA."),
        ("bi-flag-fill",
         "Was sind \"Real Life Events\"?",
         "Die ERC veranstaltet mehrmals im Jahr Events im echten Leben, an denen DU teilnehmen kannst. Diese werden meist groß im Discord sowie in <OWNER_HANDLE>s Streams auf Twitch angekündigt. Typische Events sind z. B. unsere Kart-Events oder LAN-Events."),
        ("bi-graph-up-arrow",
         "Kann ich meine Fähigkeiten beim Racing in der ERC ausbauen?",
         "In unseren Liga-Rennen kannst du Erfahrung und Rennkilometer sammeln. Auch das Zuschauen bei den anderen Ligen wird dir bestimmt helfen. Sollte dir das nicht genug sein, kannst du bei unseren Pros Fragen stellen oder eine Trainingssession im direkten Gespräch vereinbaren.")
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/home-index.css" asp-append-version="true" />
    <style>
        .doc-card { background:var(--surface-1);border:1px solid var(--stroke-1);border-radius:var(--r-3);overflow:hidden;box-shadow:var(--sh-2); }
        .doc-card__head { padding:.85rem 1rem;border-bottom:1px solid var(--stroke-1);display:flex;align-items:center;gap:.5rem;font:700 .88rem/1 var(--ff-body);color:var(--ink);background:linear-gradient(180deg,rgba(255,255,255,.025),transparent); }
        .doc-card__body { padding:1.25rem;line-height:1.75; }
    </style>
}

<div class="f1-home-backdrop" aria-hidden="true"></div>

<partial name="_F1PageHero" model="@(new F1PageHeroVm {
    Eyebrow   = "<OWNER_HANDLE>'s Racing Community · FAQ",
    Title     = "Häufig gestellte",
    Highlight = "Fragen",
    Lead      = "Alles, was du über die ERC wissen musst &ndash; auf einen Blick.",

})" />

<section class="f1-section reveal">
    <div class="row g-4">
        <div class="col-lg-9">
            <div class="accordion" id="faqAccordion">
                @for (int i = 0; i < items.Length; i++)
                {
                    var item = items[i];
                    var collapseId = $"faq-collapse-{i}";
                    var headingId  = $"faq-heading-{i}";
                    var isFirst    = i == 0;
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="@headingId">
                            <button class="accordion-button @(isFirst ? "" : "collapsed")"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="***REMOVED***@collapseId"
                                    aria-expanded="@(isFirst ? "true" : "false")"
                                    aria-controls="@collapseId">
                                <span class="icon-chip is-cyan me-3">
                                    <i class="bi @item.Icon"></i>
                                </span>
                                @item.Question
                            </button>
                        </h2>
                        <div id="@collapseId"
                             class="accordion-collapse collapse @(isFirst ? "show" : "")"
                             aria-labelledby="@headingId"
                             data-bs-parent="***REMOVED***faqAccordion">
                            <div class="accordion-body" style="line-height:1.7;">
                                @item.Answer
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-3">
            <div class="doc-card h-100">
                <div class="doc-card__head">
                    <i class="bi bi-chat-dots-fill" style="color:var(--sig-cyan);"></i> Noch Fragen?
                </div>
                <div class="doc-card__body d-flex flex-column gap-2">
                    <p class="text-mute small mb-2">Melde dich direkt bei uns auf Discord oder schau bei <OWNER_HANDLE>10 auf Twitch vorbei.</p>
                    <a class="f1-btn f1-btn--primary" asp-controller="Stats" asp-action="<OWNER_HANDLE>10">
                        <i class="bi bi-broadcast"></i> Zum Racing Hub
                    </a>
                    <a class="f1-btn f1-btn--ghost" href="https://twitch.tv/erdi10" target="_blank" rel="noopener">
                        <span class="live-dot"></span> Twitch
                    </a>
                    <a class="f1-btn f1-btn--ghost" asp-controller="Application" asp-action="Apply">
                        <i class="bi bi-clipboard-check"></i> Bewerbung
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
