@using <OWNER_HANDLE>_ERC.Models
@using <OWNER_HANDLE>_ERC.Models.UiComponents
@using System.Text.Json
@model List<LeaguePenalty>
@{
    ViewData["Title"] = "Stewarding";
    string TypeColor(string t) => t switch
    {
        "DSQ"         => "***REMOVED***ff6b6b",
        "Punkteabzug" => "***REMOVED***ff8a4c",
        "Zeitstrafe"  => "***REMOVED***ffb800",
        "Gridstrafe"  => "***REMOVED***5b8cff",
        "Verwarnung"  => "***REMOVED***c084fc",
        _             => "***REMOVED***888"
    };
    var totalDocs = Model.Count;
    var dsqCount  = Model.Count(p => p.PenaltyType == "DSQ");
    var ptsCount  = Model.Count(p => p.PenaltyType == "Punkteabzug");
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/home-index.css" asp-append-version="true" />
<style>
/* FIA doc-badge list item */
.stw-item {
    background: var(--surface-1); border: 1px solid var(--stroke-1);
    border-left: 4px solid var(--item-color, var(--stroke-1));
    display: flex; align-items: center; gap: 1rem;
    padding: .75rem 1rem; cursor: pointer; transition: background var(--t-fast);
}
.stw-item + .stw-item { border-top: none; }
.stw-item:first-child { border-radius: var(--r-3) var(--r-3) 0 0; }
.stw-item:last-child  { border-radius: 0 0 var(--r-3) var(--r-3); }
.stw-item:only-child  { border-radius: var(--r-3); }
.stw-item:hover { background: var(--surface-2); }
.stw-item__type {
    display: inline-flex; align-items: center; gap: .3rem;
    font-family: var(--ff-tech); font-size: .6rem; font-weight: 700;
    letter-spacing: .1em; text-transform: uppercase;
    padding: .1rem .5rem; border-radius: var(--r-pill);
    border: 1px solid var(--item-color); color: var(--item-color);
    background: color-mix(in srgb, var(--item-color) 12%, transparent);
    white-space: nowrap;
}
.stw-item__body { flex: 1; min-width: 0; }
.stw-item__driver { font: 700 .95rem/1.2 var(--ff-tech); color: var(--ink); margin: .25rem 0 .15rem; }
.stw-item__meta { display: flex; gap: .5rem; flex-wrap: wrap; font-size: .72rem; color: var(--ink-3); align-items: center; }
.stw-item__reason { font-size: .74rem; color: var(--ink-3); margin-top: .2rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 640px; }
.stw-item__docbadge { flex-shrink: 0; display: flex; flex-direction: column; align-items: center; gap: .2rem; }
.stw-item__docicon {
    width: 34px; height: 44px; background: ***REMOVED***fff; border: 1px solid ***REMOVED***ccc; border-radius: 2px;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 1px 2px 6px rgba(0,0,0,.25); position: relative;
}
.stw-item__docicon::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px;
    background: ***REMOVED***e10600; border-radius: 1px 1px 0 0;
}
.stw-item__docicon i { font-size: .8rem; color: ***REMOVED***111; margin-top: 3px; }
.stw-item__doclabel { font-family: var(--ff-tech); font-size: .5rem; letter-spacing: .06em; color: var(--ink-3); }

/* Filter chips */
.stw-filters { display: flex; gap: .5rem; flex-wrap: wrap; margin-bottom: 1rem; }
.stw-filter-btn {
    background: var(--surface-2); border: 1px solid var(--stroke-1); color: var(--ink-3);
    font-size: .65rem; padding: .25rem .85rem; border-radius: var(--r-pill); cursor: pointer;
    transition: all var(--t-fast); font-family: var(--ff-tech); letter-spacing: .08em; text-transform: uppercase;
}
.stw-filter-btn:hover { border-color: var(--stroke-2); color: var(--ink-2); }
.stw-filter-btn.active { background: var(--accent); border-color: var(--accent); color: ***REMOVED***fff; }

/* FIA Overlay */
.fia-overlay {
    position: fixed; inset: 0; z-index: 9999;
    display: flex; align-items: center; justify-content: center; padding: 1rem;
    opacity: 0; pointer-events: none; transition: opacity var(--t-base);
}
.fia-overlay.is-open { opacity: 1; pointer-events: all; }
.fia-overlay__backdrop { position: absolute; inset: 0; background: rgba(0,0,0,.78); backdrop-filter: blur(4px); }
.fia-overlay__scroll { position: relative; z-index: 1; max-height: 92vh; overflow-y: auto; width: 100%; max-width: 680px; border-radius: var(--r-3); overflow: hidden; box-shadow: var(--sh-3); }
.fia-overlay__close {
    position: absolute; top: .6rem; right: .6rem; z-index: 2;
    background: rgba(0,0,0,.55); border: 1px solid rgba(255,255,255,.15); color: ***REMOVED***fff;
    width: 30px; height: 30px; border-radius: 50%; font-size: .85rem; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background var(--t-fast);
}
.fia-overlay__close:hover { background: rgba(225,6,0,.7); }

/* FIA Document */
.fia-doc { background: ***REMOVED***f7f6f1; color: ***REMOVED***111; font-family: Arial, Helvetica, sans-serif; font-size: 13px; }
.fia-doc__lh { padding: .7rem 1.2rem .5rem; display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid ***REMOVED***c00; }
.fia-doc__brand { display: flex; align-items: center; gap: .5rem; }
.fia-doc__brand-mark { background: ***REMOVED***e10600; color: ***REMOVED***fff; font-size: 11px; font-weight: 900; letter-spacing: .1em; padding: .15rem .5rem; border-radius: 2px; text-transform: uppercase; }
.fia-doc__brand-text { font-size: 11px; font-weight: 700; color: ***REMOVED***111; text-transform: uppercase; letter-spacing: .08em; }
.fia-doc__num { font-size: 11px; font-weight: 700; color: ***REMOVED***e10600; }
.fia-doc__title { text-align: center; padding: .65rem 1.2rem .5rem; border-bottom: 1px solid ***REMOVED***ccc; }
.fia-doc__event { font-size: 15px; font-weight: 900; text-transform: uppercase; letter-spacing: .03em; font-variant: small-caps; }
.fia-doc__event-date { font-size: 11px; color: ***REMOVED***555; }
.fia-meta { display: grid; grid-template-columns: 1fr 1fr; border-bottom: 1px solid ***REMOVED***ccc; }
.fia-meta__col { padding: .5rem 1rem; display: flex; flex-direction: column; gap: .2rem; }
.fia-meta__col + .fia-meta__col { border-left: 1px solid ***REMOVED***ddd; }
.fia-meta__row { display: grid; grid-template-columns: 70px 1fr; font-size: 12px; }
.fia-meta__label { font-weight: 700; }
.fia-meta__value { color: ***REMOVED***111; }
.fia-meta__value--red { color: ***REMOVED***c00; font-weight: 600; }
.fia-doc__body { padding: .7rem 1.1rem .8rem; }
.fia-doc__intro { font-size: 12px; line-height: 1.6; color: ***REMOVED***333; margin-bottom: .6rem; padding-bottom: .5rem; border-bottom: 1px solid ***REMOVED***ddd; }
.fia-def { display: flex; flex-direction: column; }
.fia-def__row { display: grid; grid-template-columns: 100px 1fr; gap: .25rem .6rem; padding: .3rem 0; border-bottom: 1px solid ***REMOVED***e8e8e3; font-size: 12px; line-height: 1.5; }
.fia-def__row:last-child { border-bottom: none; }
.fia-def__key { font-weight: 700; color: ***REMOVED***111; }
.fia-def__val { color: ***REMOVED***222; }
.fia-def__decision { font-weight: 700; }
.fia-def__decision-pts { color: ***REMOVED***c00; font-weight: 700; }
.fia-def__reason p { margin: 0 0 .4rem; }
.fia-def__reason p:last-child { margin: 0; }
.fia-doc-footer { background: ***REMOVED***eeeee8; border-top: 1px solid ***REMOVED***ccc; padding: .45rem 1.1rem; font-size: 11px; color: ***REMOVED***666; display: flex; justify-content: space-between; flex-wrap: wrap; gap: .3rem; }
.fia-doc-footer__stewards { font-weight: 700; text-transform: uppercase; letter-spacing: .06em; }
</style>
}

<div class="f1-home-backdrop" aria-hidden="true"></div>

<partial name="_F1PageHero" model="@(new F1PageHeroVm {
    Eyebrow   = "ERC Stewarding",
    Title     = "Steward",
    Highlight = "Entscheidungen",
    Lead      = "Offizielle Entscheidungen des Steward-Kollegiums &mdash; transparent und nachvollziehbar wie in der Formel 1.",

    Chequer   = true
})" />

<div class="f1-stat-grid reveal mb-4">
    <partial name="_F1StatTile" model="@(new F1StatTileVm {
        IconLucide = "file-text",
        Label     = "Entscheidungen",
        Value     = totalDocs.ToString(),
        Sub       = "&***REMOVED***214;ffentliche Dokumente"
    })" />
    <partial name="_F1StatTile" model="@(new F1StatTileVm {
        IconLucide = "x-octagon",
        Label     = "DSQ",
        Value     = dsqCount.ToString(),
        Sub       = "Disqualifikationen"
    })" />
    <partial name="_F1StatTile" model="@(new F1StatTileVm {
        IconLucide = "minus-circle",
        Label     = "Punktabz&***REMOVED***252;ge",
        Value     = ptsCount.ToString(),
        Sub       = "Punktestrafen"
    })" />
</div>

<section class="f1-section reveal">
    <partial name="_F1Section" model="@(new F1SectionVm {
        Chip    = "Dokumente",
        Title   = "Steward-Entscheidungen",
        SubText = totalDocs > 0 ? $"{totalDocs} Eintr&***REMOVED***228;ge" : null
    })" />

    <div class="stw-filters" id="stwFilters">
        <button class="stw-filter-btn active" data-filter="all">Alle</button>
        <button class="stw-filter-btn" data-filter="DSQ">DSQ</button>
        <button class="stw-filter-btn" data-filter="Zeitstrafe">Zeitstrafe</button>
        <button class="stw-filter-btn" data-filter="Gridstrafe">Gridstrafe</button>
        <button class="stw-filter-btn" data-filter="Punkteabzug">Punkteabzug</button>
        <button class="stw-filter-btn" data-filter="Verwarnung">Verwarnung</button>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <span class="icon-chip is-cyan"><i class="bi bi-shield-check"></i></span>
            <div class="empty-state__title">Keine Entscheidungen</div>
            <p class="empty-state__lead">Derzeit sind keine Steward-Entscheidungen ver&***REMOVED***246;ffentlicht.</p>
        </div>
    }
    else
    {
        <div id="stwList">
            @foreach (var p in Model)
            {
                var col = TypeColor(p.PenaltyType);
                <div class="stw-item" style="--item-color:@col;" data-type="@p.PenaltyType" onclick="openDoc(@p.Id)">
                    <div class="stw-item__body">
                        <span class="stw-item__type">@p.PenaltyType</span>
                        <div class="stw-item__driver">@p.Driver</div>
                        <div class="stw-item__meta">
                            <code style="color:var(--sig-cyan);font-size:.7rem;">@p.LeagueId</code>
                            <span>@p.Date.ToString("dd.MM.yyyy")</span>
                            @if (!string.IsNullOrEmpty(p.RaceTrack))
                            {
                                <span><i class="bi bi-geo-alt me-1"></i>@p.RaceTrack</span>
                            }
                            @if (!string.IsNullOrEmpty(p.SecondDriver))
                            {
                                <span><i class="bi bi-person me-1"></i>@p.SecondDriver</span>
                            }
                            @if (p.Points > 0)
                            {
                                <span style="color:@col;font-weight:700;">@p.Points&thinsp;Pkt.</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(p.Incident))
                        {
                            <div class="stw-item__reason">@p.Incident</div>
                        }
                        else if (!string.IsNullOrEmpty(p.Reason))
                        {
                            <div class="stw-item__reason">@p.Reason</div>
                        }
                    </div>
                    <div class="stw-item__docbadge">
                        <div class="stw-item__docicon"><i class="bi bi-file-text-fill"></i></div>
                        <span class="stw-item__doclabel">DOK. @p.Id</span>
                    </div>
                </div>
            }
        </div>
    }
</section>

@* FIA Overlay *@
<div class="fia-overlay" id="fiaOverlay">
    <div class="fia-overlay__backdrop" onclick="closeDoc()"></div>
    <button class="fia-overlay__close" onclick="closeDoc()"><i class="bi bi-x-lg"></i></button>
    <div class="fia-overlay__scroll">
        <div class="fia-doc">
            <div class="fia-doc__lh">
                <div class="fia-doc__brand">
                    <span class="fia-doc__brand-mark">ERC</span>
                    <span class="fia-doc__brand-text"><OWNER_HANDLE>'s Racing Community</span>
                </div>
                <span class="fia-doc__num" id="fiaDocNum">Document --</span>
            </div>
            <div class="fia-doc__title">
                <div class="fia-doc__event" id="fiaEvent">--</div>
                <div class="fia-doc__event-date" id="fiaEventDate">--</div>
            </div>
            <div class="fia-meta">
                <div class="fia-meta__col">
                    <div class="fia-meta__row">
                        <span class="fia-meta__label">From</span>
                        <span class="fia-meta__value">The Stewards</span>
                    </div>
                    <div class="fia-meta__row">
                        <span class="fia-meta__label">To</span>
                        <span class="fia-meta__value fia-meta__value--red" id="fiaMetaTo">--</span>
                    </div>
                </div>
                <div class="fia-meta__col">
                    <div class="fia-meta__row">
                        <span class="fia-meta__label">Document</span>
                        <span class="fia-meta__value" id="fiaMetaDocNum">--</span>
                    </div>
                    <div class="fia-meta__row">
                        <span class="fia-meta__label">Date</span>
                        <span class="fia-meta__value" id="fiaMetaDate">--</span>
                    </div>
                    <div class="fia-meta__row">
                        <span class="fia-meta__label">Time</span>
                        <span class="fia-meta__value" id="fiaMetaTime">--</span>
                    </div>
                </div>
            </div>
            <div class="fia-doc__body">
                <p class="fia-doc__intro">The Stewards, having received a report from the Race Director, examined the available evidence and determine the following:</p>
                <div class="fia-def">
                    <div class="fia-def__row">
                        <span class="fia-def__key">No / Driver</span>
                        <span class="fia-def__val" id="fdDriver">--</span>
                    </div>
                    <div class="fia-def__row">
                        <span class="fia-def__key">Competitor</span>
                        <span class="fia-def__val" id="fdLeague">--</span>
                    </div>
                    <div class="fia-def__row">
                        <span class="fia-def__key">Time</span>
                        <span class="fia-def__val" id="fdDate">--</span>
                    </div>
                    <div class="fia-def__row">
                        <span class="fia-def__key">Session</span>
                        <span class="fia-def__val">Race</span>
                    </div>
                    <div class="fia-def__row" id="fdTrackRow">
                        <span class="fia-def__key">Track</span>
                        <span class="fia-def__val" id="fdTrack">--</span>
                    </div>
                    <div class="fia-def__row" id="fd2ndRow" style="display:none;">
                        <span class="fia-def__key">2nd Driver</span>
                        <span class="fia-def__val" id="fd2ndDriver">--</span>
                    </div>
                    <div class="fia-def__row" id="fdFactRow" style="display:none;">
                        <span class="fia-def__key">Fact</span>
                        <span class="fia-def__val" id="fdFact">--</span>
                    </div>
                    <div class="fia-def__row">
                        <span class="fia-def__key">Infringement</span>
                        <span class="fia-def__val" id="fdOffence">--</span>
                    </div>
                    <div class="fia-def__row">
                        <span class="fia-def__key">Decision</span>
                        <div class="fia-def__val">
                            <span class="fia-def__decision" id="fdDecision">--</span>
                            <span class="fia-def__decision-pts" id="fdDecisionPts" style="display:none;"></span>
                        </div>
                    </div>
                    <div class="fia-def__row">
                        <span class="fia-def__key">Reason</span>
                        <div class="fia-def__val fia-def__reason" id="fdReason">--</div>
                    </div>
                </div>
            </div>
            <div class="fia-doc-footer">
                <span class="fia-doc-footer__stewards">The Stewards &middot; <span id="fdCreatedBy">ERC Stewards</span></span>
                <span id="fdCreatedAt">--</span>
            </div>
        </div>
    </div>
</div>

@* JSON data island *@
<script id="penaltiesData" type="application/json">
    @Html.Raw(JsonSerializer.Serialize(Model.Select(p => new {
        id           = p.Id,
        driver       = p.Driver,
        leagueId     = p.LeagueId,
        date         = p.Date.ToString("dd.MM.yyyy"),
        penaltyType  = p.PenaltyType,
        points       = p.Points,
        raceTrack    = p.RaceTrack    ?? "",
        secondDriver = p.SecondDriver ?? "",
        incident     = p.Incident     ?? "",
        reason       = p.Reason       ?? "",
        createdBy    = p.CreatedBy    ?? "ERC Stewards",
        createdAt    = p.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm") + " Uhr"
    })))
</script>

@section Scripts {
<script>
(function () {
    const raw  = document.getElementById('penaltiesData');
    const data = raw ? JSON.parse(raw.textContent) : [];
    const byId = {};
    data.forEach(function(p) { byId[p.id] = p; });
    const overlay = document.getElementById('fiaOverlay');

    function setText(id, val) { var e = document.getElementById(id); if (e) e.textContent = val || '--'; }
    function show(id) { var e = document.getElementById(id); if (e) e.style.display = ''; }
    function hide(id) { var e = document.getElementById(id); if (e) e.style.display = 'none'; }

    window.openDoc = function (id) {
        var p = byId[id]; if (!p) return;
        var docNum   = String(p.id).padStart(2, '0');
        var gpLabel  = p.raceTrack ? p.raceTrack.toUpperCase() + ' GRAND PRIX' : (p.leagueId || 'ERC').toUpperCase();
        var timePart = p.createdAt ? p.createdAt.replace(' Uhr', '').split(' ').pop() : '--';

        setText('fiaDocNum',     'Document ' + docNum);
        setText('fiaEvent',      gpLabel);
        setText('fiaEventDate',  p.date);
        setText('fiaMetaTo',     p.driver + (p.secondDriver ? ' & ' + p.secondDriver : ''));
        setText('fiaMetaDocNum', docNum);
        setText('fiaMetaDate',   p.date);
        setText('fiaMetaTime',   timePart);
        setText('fdDriver',      p.driver);
        setText('fdLeague',      p.leagueId || '--');
        setText('fdDate',        p.date);

        if (p.raceTrack)    { setText('fdTrack',     p.raceTrack);    show('fdTrackRow'); } else { hide('fdTrackRow'); }
        if (p.secondDriver) { setText('fd2ndDriver', p.secondDriver); show('fd2ndRow');   } else { hide('fd2ndRow');   }
        if (p.incident)     { setText('fdFact',      p.incident);     show('fdFactRow');  } else { hide('fdFactRow');  }

        setText('fdOffence',  'Breach of ERC Sporting Regulations \u2014 ' + p.penaltyType + '.');
        setText('fdDecision', p.penaltyType + ' imposed.');

        var pts = document.getElementById('fdDecisionPts');
        if (p.points > 0) {
            pts.textContent  = ' (\u2212' + p.points + ' Championship points deducted.)';
            pts.style.display = 'inline';
        } else {
            pts.style.display = 'none';
        }

        var reasonEl = document.getElementById('fdReason');
        reasonEl.innerHTML = '';
        (p.reason || '--').split(/\n+/).filter(function(l) { return l.trim(); }).forEach(function(line) {
            var para = document.createElement('p');
            para.textContent = line;
            reasonEl.appendChild(para);
        });

        setText('fdCreatedBy', p.createdBy || 'ERC Stewards');
        setText('fdCreatedAt', p.createdAt || '--');
        overlay.classList.add('is-open');
        document.body.style.overflow = 'hidden';
    };

    window.closeDoc = function () {
        overlay.classList.remove('is-open');
        document.body.style.overflow = '';
    };

    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeDoc(); });

    document.querySelectorAll('.stw-filter-btn').forEach(function(btn) {
        btn.addEventListener('click', function () {
            document.querySelectorAll('.stw-filter-btn').forEach(function(b) { b.classList.remove('active'); });
            btn.classList.add('active');
            var f = btn.dataset.filter;
            document.querySelectorAll('.stw-item').forEach(function(item) {
                item.style.display = (f === 'all' || item.dataset.type === f) ? '' : 'none';
            });
        });
    });
})();
</script>
}
