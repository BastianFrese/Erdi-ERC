@using Erdi_ERC.Models
@using Erdi_ERC.Models.UiComponents
@model List<LeaguePenalty>
@{
    ViewData["Title"] = "Stewarding";
    string TypeColor(string t) => t switch
    {
        "DSQ"                    => "#ff6b6b",
        "Zeitstrafe + Strafpunkte"=> "#ff8a4c",
        "Zeitstrafe"             => "#e8a93d",
        "Gridstrafe"             => "#5b8cff",
        "Verwarnung"             => "#c084fc",
        _                        => "#888"
    };
    var totalDocs = Model.Count;
    var dsqCount  = Model.Count(p => p.PenaltyType == "DSQ");
    var comboCount= Model.Count(p => p.PenaltyType == "Zeitstrafe + Strafpunkte");
    var filterTypes = Model.Select(p => p.PenaltyType).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(t => t).ToList();

    // Liga-Filter: nur aktive (nicht-archivierte) Ligen anzeigen.
    // ViewBag.ActiveLeagues kommt aus HomeController.Stewarding().
    var activeLeagues  = ViewBag.ActiveLeagues as List<dynamic> ?? new();
    var leagueFilter   = (ViewBag.LeagueFilter as string) ?? "";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/home-index.css" asp-append-version="true" />
<style>
/* FIA doc-badge list item */
.stw-item {
    background: var(--surface-1); border: 1px solid var(--stroke-1);
    border-left: 4px solid var(--item-color, var(--stroke-1));
    display: flex; align-items: center; gap: 1rem;
    padding: .75rem 1rem; cursor: pointer; transition: background var(--t-fast);
}
.stw-item + .stw-item { border-top: none; }
.stw-item:first-child { border-radius: var(--r-3) var(--r-3) 0 0; }
.stw-item:last-child  { border-radius: 0 0 var(--r-3) var(--r-3); }
.stw-item:only-child  { border-radius: var(--r-3); }
.stw-item:hover { background: var(--surface-2); }
.stw-item__type {
    display: inline-flex; align-items: center; gap: .3rem;
    font-family: var(--ff-tech); font-size: .6rem; font-weight: 700;
    letter-spacing: .1em; text-transform: uppercase;
    padding: .1rem .5rem; border-radius: var(--r-pill);
    border: 1px solid var(--item-color); color: var(--item-color);
    background: color-mix(in srgb, var(--item-color) 12%, transparent);
    white-space: nowrap;
}
.stw-item__body { flex: 1; min-width: 0; }
.stw-item__driver { font: 700 .95rem/1.2 var(--ff-tech); color: var(--ink); margin: .25rem 0 .15rem; }
.stw-item__meta { display: flex; gap: .5rem; flex-wrap: wrap; font-size: .72rem; color: var(--ink-3); align-items: center; }
.stw-item__reason { font-size: .74rem; color: var(--ink-2); margin-top: .2rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 640px; }
.stw-item__docbadge { flex-shrink: 0; display: flex; flex-direction: column; align-items: center; gap: .2rem; }
.stw-item__docicon {
    width: 34px; height: 44px; background: #fff; border: 1px solid #ccc; border-radius: 2px;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 1px 2px 6px rgba(0,0,0,.25); position: relative;
}
.stw-item__docicon::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px;
    background: #e10600; border-radius: 1px 1px 0 0;
}
.stw-item__docicon i { font-size: .8rem; color: #111; margin-top: 3px; }
.stw-item__doclabel { font-family: var(--ff-tech); font-size: .5rem; letter-spacing: .06em; color: var(--ink-3); }

/* Filter chips */
.stw-filters { display: flex; gap: .5rem; flex-wrap: wrap; margin-bottom: 1rem; }
.stw-filter-btn {
    background: var(--surface-2); border: 1px solid var(--stroke-1); color: var(--ink-3);
    font-size: .65rem; padding: .25rem .85rem; border-radius: var(--r-pill); cursor: pointer;
    transition: all var(--t-fast); font-family: var(--ff-tech); letter-spacing: .08em; text-transform: uppercase;
}
.stw-filter-btn:hover { border-color: var(--stroke-2); color: var(--ink-2); }
.stw-filter-btn.active { background: var(--accent); border-color: var(--accent); color: #fff; }

/* Liga-Filter: Button-Liste (GET-Links) statt Dropdown. */
.stw-league-filter {
    display: flex; align-items: center; gap: .4rem; flex-wrap: wrap;
    margin: -.25rem 0 1rem;
    padding: .5rem .75rem;
    background: var(--surface-1);
    border: 1px solid var(--stroke-1);
    border-radius: var(--r-3);
}
.stw-league-filter__label {
    font-size: .65rem;
    font-family: var(--ff-tech);
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-right: .25rem;
}
.stw-league-filter__btn {
    display: inline-flex; align-items: center; gap: .3rem;
    font-size: .65rem;
    font-family: var(--ff-tech);
    letter-spacing: .08em;
    text-transform: uppercase;
    padding: .25rem .85rem;
    border-radius: var(--r-pill);
    border: 1px solid var(--stroke-1);
    background: var(--surface-2);
    color: var(--ink-3);
    text-decoration: none;
    transition: all var(--t-fast);
}
.stw-league-filter__btn:hover { border-color: var(--stroke-2); color: var(--ink-2); }
.stw-league-filter__btn.is-active {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
}
.stw-league-filter__btn.is-archived {
    border-style: dashed;
    opacity: .85;
}
.stw-league-filter__btn.is-archived .bi { color: var(--ink-3); }
.stw-league-filter__btn.is-archived.is-active .bi { color: #fff; }

/* Item als Link: kein Default-Underline, ganzer Bereich klickbar. */
.stw-item--link { text-decoration: none; color: inherit; display: flex; align-items: center; gap: 1rem; flex: 1; min-width: 0; }
.stw-item--link:hover .stw-item__type { box-shadow: 0 0 0 2px color-mix(in srgb, var(--item-color) 35%, transparent); }
</style>
}

<div class="f1-home-backdrop" aria-hidden="true"></div>

<partial name="_F1PageHero" model="@(new F1PageHeroVm {
    Eyebrow   = "ERC Stewarding",
    Title     = "Steward",
    Highlight = "Entscheidungen",
    Lead      = "Offizielle Entscheidungen des Steward-Kollegiums &mdash; transparent und nachvollziehbar wie in der Formel 1.",

    Chequer   = true
})" />

<div class="f1-stat-grid reveal mb-4">
    <partial name="_F1StatTile" model="@(new F1StatTileVm {
        IconLucide = "file-text",
        Label     = "Entscheidungen",
        Value     = totalDocs.ToString(),
        Sub       = "&#214;ffentliche Dokumente"
    })" />
    <partial name="_F1StatTile" model="@(new F1StatTileVm {
        IconLucide = "x-octagon",
        Label     = "DSQ",
        Value     = dsqCount.ToString(),
        Sub       = "Disqualifikationen"
    })" />
    <partial name="_F1StatTile" model="@(new F1StatTileVm {
        IconLucide = "timer",
        Label     = "Zeitstrafe +",
        Value     = comboCount.ToString(),
        Sub       = "Strafpunkte"
    })" />
</div>

<section class="f1-section reveal">
    <partial name="_F1Section" model="@(new F1SectionVm {
        Chip    = "Dokumente",
        Title   = "Steward-Entscheidungen",
        SubText = totalDocs > 0 ? $"{totalDocs} Eintr&#228;ge" : null
    })" />

    <div class="stw-filters" id="stwFilters">
        <button class="stw-filter-btn active" data-filter="all">Alle</button>
        @foreach (var t in filterTypes)
        {
            <button class="stw-filter-btn" data-filter="@t">@t</button>
        }
    </div>

    @* Liga-Filter: ein Button pro Liga, die mindestens einen oeffentlichen
       Bericht hat. Klick = GET-Request mit ?league=… an die Liste. "Alle"
       setzt den Filter zurueck. Aktive Ligen zuerst; archivierte Ligen mit
       Alt-Berichten bekommen einen eigenen Button mit "Archiviert"-Marker.
       URL ist Source of Truth (teilbar, Browser-Back funktioniert). *@
    <nav class="stw-league-filter" aria-label="Liga-Filter">
        <span class="stw-league-filter__label">Liga</span>
        <a class="stw-league-filter__btn @(string.IsNullOrEmpty(leagueFilter) ? "is-active" : null)"
           asp-controller="Home" asp-action="Stewarding"
           aria-current="@(string.IsNullOrEmpty(leagueFilter) ? "page" : null)">Alle</a>
        @foreach (var lg in activeLeagues)
        {
            var isActive = string.Equals(lg.Id, leagueFilter, StringComparison.OrdinalIgnoreCase);
            var isArchived = lg.IsArchived;
            <a class="stw-league-filter__btn @(isActive ? "is-active" : null) @(isArchived ? "is-archived" : null)"
               asp-controller="Home" asp-action="Stewarding" asp-route-league="@lg.Id"
               aria-current="@(isActive ? "page" : null)"
               title="@(isArchived ? "Archivierte Liga — " : "")@lg.Name (@lg.Id)">
                @lg.Name
                @if (isArchived)
                {
                    <i class="bi bi-archive-fill ms-1" aria-hidden="true"></i>
                }
            </a>
        }
    </nav>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <span class="icon-chip is-cyan"><i class="bi bi-shield-check"></i></span>
            <div class="empty-state__title">Keine Entscheidungen</div>
            <p class="empty-state__lead">Derzeit sind keine Steward-Entscheidungen ver&#246;ffentlicht.</p>
        </div>
    }
    else
    {
        <div id="stwList">
            @foreach (var p in Model)
            {
                var col = TypeColor(p.PenaltyType);
                <div class="stw-item" style="--item-color:@col;" data-type="@p.PenaltyType">
                    <a class="stw-item--link" asp-controller="Home" asp-action="StewardingDoc" asp-route-id="@p.Id" target="_blank" rel="noopener" aria-label="Steward-Dokument @p.Id in neuem Tab öffnen">
                        <div class="stw-item__body">
                            <span class="stw-item__type">@p.PenaltyType</span>
                            <div class="stw-item__driver">
                                @if (p.DriverNumber.HasValue)
                                {
                                    <span>@p.DriverNumber.Value – @p.Driver</span>
                                }
                                else
                                {
                                    <span>@p.Driver</span>
                                }
                            </div>
                            <div class="stw-item__meta">
                                <code style="color:var(--sig-cyan);font-size:.7rem;">@p.LeagueId</code>
                                <span>@p.Date.ToString("dd.MM.yyyy")</span>
                                @if (!string.IsNullOrEmpty(p.RaceTrack))
                                {
                                    <span><i class="bi bi-geo-alt me-1"></i>@p.RaceTrack</span>
                                }
                                @if (!string.IsNullOrEmpty(p.SecondDriver))
                                {
                                    <span><i class="bi bi-person me-1"></i>@p.SecondDriver</span>
                                }
                                @if (p.Points > 0)
                                {
                                    <span style="color:@col;font-weight:700;">@p.Points&thinsp;Pkt.</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(p.Incident))
                            {
                                <div class="stw-item__reason">@p.Incident</div>
                            }
                            else if (!string.IsNullOrEmpty(p.Reason))
                            {
                                <div class="stw-item__reason">@p.Reason</div>
                            }
                        </div>
                        <div class="stw-item__docbadge">
                            <div class="stw-item__docicon"><i class="bi bi-file-text-fill"></i></div>
                            <span class="stw-item__doclabel">DOK. @p.Id</span>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</section>

@* Berichte werden ueber /Stewarding/Doc/{id} in einem neuen Tab geoeffnet
   (siehe HomeController.StewardingDoc). Kein Modal mehr noetig. *@

@section Scripts {
<script>
// Decision-Type-Filter: blendet Items per data-type clientseitig aus.
// Liga-Filter laeuft ueber GET-Reload (URL = Source of Truth).
(function () {
    document.querySelectorAll('.stw-filter-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.querySelectorAll('.stw-filter-btn').forEach(function (b) { b.classList.remove('active'); });
            btn.classList.add('active');
            var f = btn.dataset.filter;
            document.querySelectorAll('.stw-item').forEach(function (item) {
                item.style.display = (f === 'all' || item.dataset.type === f) ? '' : 'none';
            });
        });
    });
})();
</script>
}
