@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/home-index.css" asp-append-version="true" />
}

<div class="f1-home-backdrop" aria-hidden="true"></div>

<partial name="_F1PageHero" model="@(new F1PageHeroVm {
    Eyebrow   = "<OWNER_HANDLE> · ERC · Authentication",
    Title     = "Willkommen in der",
    Highlight = "Boxengasse",
    Lead      = "Melde dich mit deinem <strong class=\"text-accent\">Discord-Konto</strong> an, um Zugriff auf das Dashboard, Setup-Pakete und deine Liga-Tools zu bekommen.",

})" />

<section class="f1-section reveal">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div style="background:var(--surface-1);border:1px solid var(--stroke-1);border-radius:var(--r-3);padding:2rem;text-align:center;box-shadow:var(--sh-2);">
                <div class="icon-chip icon-chip-xl is-accent mx-auto mb-3">
                    <i class="bi bi-discord"></i>
                </div>
                <h2 class="mb-2" style="font:700 1.25rem/1.2 var(--ff-heading);color:var(--ink);">Discord OAuth</h2>
                <p class="text-mute mb-4" style="font-size:.9rem;">
                    Wir benötigen nur deine Discord-ID und deinen Anzeigenamen.
                    Kein Spam. Keine DMs. Keine Tracker.
                </p>
                <a class="f1-btn f1-btn--primary w-100 mb-3" asp-controller="Account" asp-action="Login">
                    <i class="bi bi-discord me-2"></i> Mit Discord anmelden
                </a>
                <div class="text-mute text-tech" style="font-size:.78rem;">
                    <i class="bi bi-lock-fill"></i> Verschlüsselte Session · 14 Tage Sliding Expiration
                </div>
            </div>
        </div>
    </div>
</section>
