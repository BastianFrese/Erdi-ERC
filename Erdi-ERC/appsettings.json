{
  "AllowedHosts": "*",

  // ⚠️ KEINE Secrets in dieser Datei einchecken!
  // Lokal:      dotnet user-secrets set "ConnectionStrings:Default" "..."
  // Production: Environment Variables / appsettings.Production.json (NICHT im Repo)
  "ConnectionStrings": {
    "Default": ""
  },

  "Discord": {
    "ClientId": "",
    "ClientSecret": "",
    "SetupAccess": {
      "GuildId": "",
      "MinGuildTenureDays": 7
    },
    "Guilds": {
      "CommunityGuildId": "<DISCORD_GUILD_ID_REMOVED>",
      "LeagueGuildId": "<DISCORD_GUILD_ID_REMOVED>"
    },
    "Webhook": {
      "Url": "",
      "Username": "ERC Community Bot"
    }
    // Redirect URI in der Discord App (Tab OAuth2 → Redirects):
    //   Lokal (HTTPS):  https://localhost:7030/signin-discord
    //   Produktion:     https://<deine-domain>/signin-discord
    // Der Pfad /signin-discord wird vom AspNet.Security.OAuth.Discord-Handler erwartet.
  },

  "Application": {
    "TwitchChannel": "erdi10",
    "UserAgentName": "Erdi-ERC",
    "UserAgentVersion": "1.0",
    "F1GameYear": "F1 26",
    "F1GameYearShort": "26"
  },

  // Erdi-Troll-System: kleine Login-Pranks nach erfolgreichem Discord-Login.
  // Enabled=false → Login verhält sich exakt wie gehabt. Zum Testen TriggerChance auf 1.0 setzen.
  "Troll": {
    "Enabled": true,
    "TriggerChance": 1.0,
    "CooldownMinutes": 60,
    "ApplyToAdmins": true,
    "MercyAfterAttempts": 3,
    "MathMaxOperand": 9,
    // Optionale Gewichts-Overrides je Gag (0 = aus). Leer = Registry-Defaults.
    // Gezielt einen einzelnen Gag testen, z. B.: "Weights": { "math": 1, "dice": 0, "wheel": 0 }
    "Weights": {}
  },

  "Auth": {
    "Cookie": {
      "ExpireHours": 2,
      "RefreshDiscordMembershipMinutes": 15
    }
  },

  "RateLimiting": {
    "Global": { "PermitLimit": 200, "WindowSeconds": 60 },
    "Auth":   { "PermitLimit": 10,  "WindowSeconds": 60 },
    "Forms":  { "PermitLimit": 20,  "WindowSeconds": 60 }
  },

  "BackgroundMusic": {
    "Directory": "backgroundmusic",
    "AllowedExtensions": [ ".mp3", ".wav", ".ogg" ],
    "MaxUploadSizeMb": 50
  },

  "F1Scoring": {
    "PointMap": [ 25, 21, 18, 16, 14, 12, 10, 8, 7, 6, 5, 4, 3, 2, 1, 0, 0, 0, 0, 0, 0, 0 ]
  },

  "LeagueDivisions": {
    "Order": [
      "Main Division 1",
      "Second Crossplay Division 2",
      "Rookie Crossplay Division 3",
      "Community Crossplay Event"
    ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "File": {
      "Directory": "logs",
      "FileNamePrefix": "erdi-erc-",
      "RetainedFileCount": 14,
      "FileSizeLimitMb": 50
    }
  },

  // Optional: Bootstrap-Admins, die automatisch in die DB geseedet werden,
  // damit du dich beim ersten Login direkt selbst administrieren kannst.
  "BootstrapAdmins": [
    { "DiscordId": "<OWNER_DISCORD_ID_REMOVED>", "DisplayName": "ltwiener" },
    { "DiscordId": "<OWNER_DISCORD_ID_REMOVED>", "DisplayName": "Erdi" }
  ]
}

