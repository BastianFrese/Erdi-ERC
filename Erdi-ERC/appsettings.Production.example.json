{
  // TEMPLATE fuer appsettings.Production.json.
  // Diese Datei wird getrackt. Die echte appsettings.Production.json ist .gitignored
  // und enthaelt die Klartext-Secrets fuer das Live-System (Nginx-Proxied).
  //
  // Production-Setup (laut Docs/SETUP.md):
  //   1) Auf dem Production-Server: kopiere diese Datei nach appsettings.Production.json.
  //   2) Ersetze alle Platzhalter <..._REMOVED> durch echte Werte.
  //   3) Idealerweise per Environment Variables ueberschreiben
  //      (ConnectionStrings__Default, Discord__ClientId, Discord__ClientSecret, ...)
  //      statt in der Datei selbst zu speichern.
  //
  // ConnectionString-Aufbau: Server=<ip>;Port=3306;Database=REDACTED;
  //                          User=<user>;Password=<pw>;TreatTinyAsBoolean=true
  //
  // Discord-OAuth Redirect URI in der Discord App (Tab OAuth2 -> Redirects):
  //   https://<deine-domain>/signin-discord

  "AllowedHosts": "*",
  "BootstrapAdmins": [
    { "DiscordId": "<OWNER_DISCORD_ID_REMOVED>", "DisplayName": "ltwiener" },
    { "DiscordId": "<OWNER_DISCORD_ID_REMOVED>", "DisplayName": "Erdi" }
  ],
  "ConnectionStrings": {
    "Default": "Server=<PROD_HOST>;Port=3306;Database=REDACTED;User=<PROD_DB_USER>;Password=<PROD_DB_PASSWORD_REMOVED>;TreatTinyAsBoolean=true"
  },
  "Discord": {
    "ClientId": "<DISCORD_CLIENT_ID_REMOVED>",
    "ClientSecret": "<DISCORD_CLIENT_SECRET_REMOVED>",
    "SetupAccess": {
      "GuildId": "<DISCORD_GUILD_ID_REMOVED>"
    },
    "Guilds": {
      "CommunityGuildId": "<DISCORD_GUILD_ID_REMOVED>",
      "LeagueGuildId": "<DISCORD_GUILD_ID_REMOVED>"
    },
    "Webhook": {
      "Username": "ERC Community Bot"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}