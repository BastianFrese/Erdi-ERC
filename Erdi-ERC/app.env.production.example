# Wird vom FolderProfile.pubxml (T:\) als app.env ins Publish-Output kopiert.
# Server-Startbefehl:
#   set -a && source /var/www/app/app.env && set +a && dotnet /var/www/app/Erdi-ERC.dll
#
# `set -a` macht alle zugewiesenen Variablen automatisch zu Environment-Variablen,
# sodass ASP.NET Core sie lesen kann (überschreibt appsettings.Production.json-Werte).
#
# Lokal: kopiere diese Datei nach app.env.production, ersetze Platzhalter <..._REMOVED>.

ASPNETCORE_ENVIRONMENT=Production

ConnectionStrings__Default="Server=<PROD_HOST>;Port=3306;Database=REDACTED;User=<PROD_DB_USER>;Password=<PROD_DB_PASSWORD_REMOVED>;TreatTinyAsBoolean=true"

Discord__ClientId=<DISCORD_CLIENT_ID_REMOVED>
Discord__ClientSecret=<DISCORD_CLIENT_SECRET_REMOVED>
Discord__Webhook__Url=https://discord.com/api/webhooks/<DISCORD_WEBHOOK_TOKEN_REMOVED>