{
  // TEMPLATE fuer appsettings.Development.json.
  // Diese Datei wird getrackt. Die echte appsettings.Development.json ist .gitignored
  // und enthaelt die Klartext-Secrets fuer lokales Dev.
  //
  // Lokales Setup:
  //   1) Kopiere diese Datei nach appsettings.Development.json
  //      (cp appsettings.Development.example.json appsettings.Development.json)
  //   2) Ersetze alle Platzhalter <..._REMOVED> durch echte Werte.
  //   3) Optional: dotnet user-secrets set "ConnectionStrings:Default" "..."
  //      (user-secrets ueberschreibt appsettings-Werte zur Laufzeit).
  //
  // ConnectionString-Aufbau: Server=<ip>;Port=3306;Database=erditest;
  //                          User=<user>;Password=<pw>;TreatTinyAsBoolean=true
  //
  // Discord-OAuth Redirect URI in der Discord App (Tab OAuth2 -> Redirects):
  //   https://localhost:7030/signin-discord
  // Der Pfad /signin-discord wird vom AspNet.Security.OAuth.Discord-Handler erwartet.

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Server=<DEV_DB_HOST>;Port=3306;Database=erditest;User=<DEV_DB_USER>;Password=<DEV_DB_PASSWORD_REMOVED>;TreatTinyAsBoolean=true"
  },
  "Discord": {
    "ClientId": "<DISCORD_CLIENT_ID_REMOVED>",
    "ClientSecret": "<DISCORD_CLIENT_SECRET_REMOVED>",
    "SetupAccess": {
      "GuildId": "<DISCORD_GUILD_ID_REMOVED>"
    },
    "Webhook": {
      "Url": "https://discord.com/api/webhooks/<DISCORD_WEBHOOK_TOKEN_REMOVED>",
      "Username": "ERC Community Bot"
    }
  },
  "BootstrapAdmins": [
    { "DiscordId": "<OWNER_DISCORD_ID_REMOVED>", "DisplayName": "ltwiener" },
    { "DiscordId": "<OWNER_DISCORD_ID_REMOVED>", "DisplayName": "Erdi" }
  ]
}