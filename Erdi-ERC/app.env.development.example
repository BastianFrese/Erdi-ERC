# Wird vom FolderProfile2.pubxml (Y:\) als app.env ins Publish-Output kopiert.
# Server-Startbefehl (Dev-Staging):
#   set -a && source /var/www/dev/app.env && set +a && dotnet /var/www/dev/Erdi-ERC.dll
#
# Lokal: kopiere diese Datei nach app.env.development, ersetze Platzhalter <..._REMOVED>.

ASPNETCORE_ENVIRONMENT=Development

ConnectionStrings__Default="Server=<DEV_DB_HOST>;Port=3306;Database=erditest;User=<DEV_DB_USER>;Password=<DEV_DB_PASSWORD_REMOVED>;TreatTinyAsBoolean=true"

Discord__ClientId=<DISCORD_CLIENT_ID_REMOVED>
Discord__ClientSecret=<DISCORD_CLIENT_SECRET_REMOVED>
Discord__Webhook__Url=https://discord.com/api/webhooks/<DISCORD_WEBHOOK_TOKEN_REMOVED>