<?xml version="1.0" encoding="utf-8"?>
<!-- Publish direkt auf Netzlaufwerk T:\ = /var/www/app auf dem Server -->
<Project>
  <PropertyGroup>
    <PublishProvider>FileSystem</PublishProvider>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishUrl>T:\</PublishUrl>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <!-- DeleteExistingFiles=false: uploads/ und logs/ auf dem Server bleiben erhalten -->
    <DeleteExistingFiles>false</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <!-- Framework-dependent: dotnet ist auf dem Server installiert -->
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <Configuration>Release</Configuration>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
</Project>