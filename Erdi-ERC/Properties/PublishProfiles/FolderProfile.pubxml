<?xml version="1.0" encoding="utf-8"?>
<!-- Publish direkt auf Netzlaufwerk T:\ = /var/www/app auf dem Server (Production).
     FolderProfile.pubxml = Production-Deploy. FolderProfile2.pubxml = Dev-Staging auf Y:\.
     Beim Publish wird app.env.production.example als app.env ins Output kopiert,
     sodass `source app.env && dotnet Erdi-ERC.dll` garantiert ASPNETCORE_ENVIRONMENT=Production laedt. -->
<Project>
  <PropertyGroup>
    <PublishProvider>FileSystem</PublishProvider>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishUrl>T:\</PublishUrl>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <!-- DeleteExistingFiles=false: uploads/ und logs/ auf dem Server bleiben erhalten -->
    <DeleteExistingFiles>false</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <!-- Framework-dependent: dotnet ist auf dem Server installiert -->
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <Configuration>Release</Configuration>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
  <!-- app.env ins Output kopieren (AfterTargets=Publish laeuft NACH MSDeploy-FileSystem-Publish). -->
  <Target Name="CopyAppEnvProduction" AfterTargets="Publish">
    <Copy SourceFiles="app.env.production.example"
          DestinationFiles="$(PublishUrl)app.env"
          SkipUnchangedFiles="true"
          Condition="Exists('app.env.production.example')" />
  </Target>
</Project>