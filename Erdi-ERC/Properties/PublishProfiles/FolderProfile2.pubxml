<?xml version="1.0" encoding="utf-8"?>
<!-- Publish auf Y:\ = Dev-Staging (Environment=Development).
     FolderProfile.pubxml = Production auf T:\, FolderProfile2.pubxml = Dev-Staging auf Y:\.
     Beim Publish wird app.env.development.example als app.env ins Output kopiert,
     sodass `source app.env && dotnet Erdi-ERC.dll` garantiert ASPNETCORE_ENVIRONMENT=Development laedt. -->
<Project>
  <PropertyGroup>
    <DeleteExistingFiles>false</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <PublishProvider>FileSystem</PublishProvider>
    <PublishUrl>Y:\</PublishUrl>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <_TargetId>Folder</_TargetId>
    <!-- Framework-dependent + linux-x64: passt zum Production-Profil, damit Dev-Staging
         das gleiche Runtime-Target hat und keine "It works on dev"-Falsch-Annahmen entstehen. -->
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
  </PropertyGroup>
  <!-- app.env ins Output kopieren (AfterTargets=Publish laeuft NACH MSDeploy-FileSystem-Publish). -->
  <Target Name="CopyAppEnvDevelopment" AfterTargets="Publish">
    <Copy SourceFiles="app.env.development.example"
          DestinationFiles="$(PublishUrl)app.env"
          SkipUnchangedFiles="true"
          Condition="Exists('app.env.development.example')" />
  </Target>
</Project>