<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Erdi_ERC</RootNamespace>
    <UserSecretsId>d6786501-5297-4cb5-8fbc-dc9b63521d5b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.41.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.0" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <PackageReference Include="AspNet.Security.OAuth.Discord" Version="10.0.0" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
  </ItemGroup>

  <!-- Production-Konfiguration immer mit deployen (ueberschreibt appsettings.json zur Laufzeit) -->
  <ItemGroup>
    <Content Update="appsettings.Production.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <!-- Upload-Ordner: .gitkeep stellt sicher dass der Ordner beim Publish existiert -->
  <!-- Hochgeladene Bilder werden dadurch nicht geloescht (PreserveNewest) -->
  <ItemGroup>
    <None Include="wwwroot\uploads\events\.gitkeep">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="wwwroot\uploads\drivers\.gitkeep">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- Background Music: Songs ins Publish-Verzeichnis kopieren -->
  <ItemGroup>
    <Content Include="backgroundmusic\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Tests\**" />
    <Content Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
  </ItemGroup>

  <!-- JS-Bundle Inputs (Top-Level — Inputs-Attribut in <Target> braucht Items, die zur Target-Auswertungszeit existieren). -->
  <ItemGroup>
    <_JsBundleInputs Include="wwwroot/js/site.js" />
    <_JsBundleInputs Include="wwwroot/js/track-setups.js" />
    <_JsBundleInputs Include="wwwroot/js/home-index.js" />
    <_JsBundleInputs Include="wwwroot/js/troll.js" />
    <_JsBundleInputs Include="wwwroot/js/driver-card-fit.js" />
    <_JsBundleInputs Include="wwwroot/js/exclusive-consent.js" />
    <_JsBundleInputs Include="wwwroot/js/event-lightbox.js" />
  </ItemGroup>

  <!--
    CSS-Bundling: konkateniert alle Partials aus /wwwroot/css/site/ + site.track-setups.css + site.community.css
    zu /wwwroot/css/site.bundled.css. Ergebnis: 1 HTTP-Request statt 13 @import-Roundtrips (render-blocking).
    Inputs/Outputs sorgen für incrementell — läuft nur wenn Partials neuer sind als das Bundle.
  -->
  <Target Name="BundleSiteCss" BeforeTargets="BeforeBuild" Inputs="wwwroot/css/site/01-tokens.css;wwwroot/css/site/02-base.css;wwwroot/css/site/03-layout.css;wwwroot/css/site/04-components.css;wwwroot/css/site/05-f1-modules.css;wwwroot/css/site/06-pages-and-admin.css;wwwroot/css/site/07-utilities.css;wwwroot/css/site/08-animations.css;wwwroot/css/site/09-responsive.css;wwwroot/css/site/10-f1-quickwins.css;wwwroot/css/site/11-unique-addons.css;wwwroot/css/site/12-tokens-f1.css;wwwroot/css/site.track-setups.css;wwwroot/css/site.community.css" Outputs="wwwroot/css/site.bundled.css">
    <ItemGroup>
      <_CssBundle Include="wwwroot/css/site/01-tokens.css" />
      <_CssBundle Include="wwwroot/css/site/02-base.css" />
      <_CssBundle Include="wwwroot/css/site/03-layout.css" />
      <_CssBundle Include="wwwroot/css/site/04-components.css" />
      <_CssBundle Include="wwwroot/css/site/05-f1-modules.css" />
      <_CssBundle Include="wwwroot/css/site/06-pages-and-admin.css" />
      <_CssBundle Include="wwwroot/css/site/07-utilities.css" />
      <_CssBundle Include="wwwroot/css/site/08-animations.css" />
      <_CssBundle Include="wwwroot/css/site/09-responsive.css" />
      <_CssBundle Include="wwwroot/css/site/10-f1-quickwins.css" />
      <_CssBundle Include="wwwroot/css/site/11-unique-addons.css" />
      <_CssBundle Include="wwwroot/css/site/12-tokens-f1.css" />
      <_CssBundle Include="wwwroot/css/site.track-setups.css" />
      <_CssBundle Include="wwwroot/css/site.community.css" />
    </ItemGroup>
    <ReadLinesFromFile File="%(_CssBundle.Identity)">
      <Output TaskParameter="Lines" ItemName="_CssBundleLines" />
    </ReadLinesFromFile>
    <WriteLinesToFile File="wwwroot/css/site.bundled.css" Lines="@(_CssBundleLines)" Overwrite="true" />
    <Message Importance="high" Text="CSS-Bundle erzeugt: wwwroot/css/site.bundled.css" />
  </Target>

  <!--
    JS-Minify via esbuild (Block 5). Erzeugt für jede Source-Datei ein *.min.js + .map-Pärchen.
    esbuild ist 10-100x schneller als UglifyJS/Terser, sodass der Pre-Build-Hook auch auf CI
    nur Sekunden kostet. Inputs/Outputs ermöglichen inkrementelles Rebuild.
    Fallback: wenn npx/esbuild nicht verfügbar ist (ContinueOnError), wird das Target
    übersprungen — die App startet trotzdem, lädt dann nur die unminified Source.
  -->
  <Target Name="BundleSiteJs" BeforeTargets="BeforeBuild">
    <Exec Command="npx --yes esbuild &quot;%(_JsBundleInputs.Identity)&quot; --minify --sourcemap --target=es2020 --outfile=&quot;%(_JsBundleInputs.RootDir)%(_JsBundleInputs.Directory)%(_JsBundleInputs.Filename).min.js&quot;"
          ContinueOnError="true" />
    <Message Importance="high" Text="JS-Minify via esbuild: %(_JsBundleInputs.Identity) -> %(_JsBundleInputs.Filename).min.js" />
  </Target>

  <!--
    Pre-Build-Hook: Warnt, falls dotnet user-secrets leer sind ODER ASPNETCORE_ENVIRONMENT
    nicht gesetzt ist. Läuft nur lokal (nicht in CI, wo $env:CI gesetzt ist).
    Ziel: Developer merkt beim ersten VS-Start, dass SETUP.md-Schritte nötig sind,
    und wird vor dem Production-Default-Fall gewarnt, der Discord-OAuth "invalid_client"
    und DB-Migrationen auf die falsche DB auslöst.
    Siehe Erdi-ERC/SETUP.md für die einmalige Initialisierung.
  -->
  <Target Name="WarnIfUserSecretsEmpty" BeforeTargets="Build;Run" Condition="'$(CI)' != 'true' AND '$(DisableUserSecretsCheck)' != 'true'">
    <!-- WICHTIG: Wir benutzen KEIN 'ConsoleToMSBuild=true' und keine direkte
            'ConsoleOutput'-Capture, weil beides Secret-Werte in das Build-Log
            leaken wuerde. Stattdessen schreiben wir das Ergebnis in eine
            temporaere Datei, lesen sie per 'ReadLinesFromFile' in eine private
            MSBuild-Property und loeschen die Datei danach sofort. -->

    <!-- 1) User-Secrets-Liste: nur die Anzahl der Keys zaehlen, nicht die Werte lesen.
            Wir benutzen $([System.IO.Path]::GetTempPath()) statt %TEMP%, weil MSBuild
            in Exec-Commands KEINE Windows-Env-Vars expandiert (nur $(...)-Properties). -->
    <PropertyGroup>
      <_SecretsTmp>$([System.IO.Path]::GetTempPath())erdierc-secrets-$(MSBuildProjectGuid).txt</_SecretsTmp>
    </PropertyGroup>
    <Exec Command="dotnet user-secrets list --project &quot;$(MSBuildThisFileDirectory)Erdi-ERC.csproj&quot; &gt; &quot;$(_SecretsTmp)&quot; 2&gt;NUL"
          Condition="'$(OS)' != 'Unix'"
          ContinueOnError="true" />
    <Exec Command="dotnet user-secrets list --project &quot;$(MSBuildThisFileDirectory)Erdi-ERC.csproj&quot; &gt; &quot;$(_SecretsTmp)&quot; 2&gt;/dev/null"
          Condition="'$(OS)' == 'Unix'"
          ContinueOnError="true" />
    <ReadLinesFromFile File="$(_SecretsTmp)" Condition="Exists('$(_SecretsTmp)')">
      <Output TaskParameter="Lines" ItemName="_UserSecretsKeys" />
    </ReadLinesFromFile>
    <Delete Files="$(_SecretsTmp)" Condition="Exists('$(_SecretsTmp)')" />

    <Warning Text="SEC001: dotnet user-secrets sind leer (oder dotnet-CLI nicht gefunden). App-Start wird mit 'MySqlException: Unable to connect' fehlschlagen. Siehe Erdi-ERC/SETUP.md fuer die einmalige Initialisierung von ConnectionStrings:Default + Discord-Credentials."
             Condition="'@(_UserSecretsKeys)' == ''" />

    <!-- 2) ASPNETCORE_ENVIRONMENT pruefen.
            Liest nur die env-Var, NICHT den effektiven Wert (dotnet ueberschreibt das
            bei 'dotnet run' mit launch profile selbst, daher kein Hard Fail).
            Wir warnen, wenn die Var komplett leer ist. Das faengt den haeufigsten
            Fall ab: Aufruf ohne env und ohne launch profile. -->
    <PropertyGroup>
      <_EnvTmp>$([System.IO.Path]::GetTempPath())erdierc-env-$(MSBuildProjectGuid).txt</_EnvTmp>
    </PropertyGroup>
    <Exec Command="cmd /c &quot;echo ASPNETCORE_ENVIRONMENT=%ASPNETCORE_ENVIRONMENT%&quot; &gt; &quot;$(_EnvTmp)&quot; 2&gt;NUL"
          Condition="'$(OS)' != 'Unix'"
          ContinueOnError="true" />
    <Exec Command="sh -c &quot;echo ASPNETCORE_ENVIRONMENT=$ASPNETCORE_ENVIRONMENT&quot; &gt; &quot;$(_EnvTmp)&quot; 2&gt;/dev/null"
          Condition="'$(OS)' == 'Unix'"
          ContinueOnError="true" />
    <ReadLinesFromFile File="$(_EnvTmp)" Condition="Exists('$(_EnvTmp)')">
      <Output TaskParameter="Lines" PropertyName="_EnvProbe" />
    </ReadLinesFromFile>
    <Delete Files="$(_EnvTmp)" Condition="Exists('$(_EnvTmp)')" />

    <Warning Text="SEC002: ASPNETCORE_ENVIRONMENT ist nicht gesetzt. ASP.NET Core defaultet dann auf 'Production' -&gt; appsettings.Development.json wird NICHT geladen -&gt; Discord-OAuth 'invalid_client' und ggf. EF-Migrationen auf die falsche DB. Fix: 'dotnet run --project Erdi-ERC --launch-profile http' (oder env-Var explizit setzen)."
             Condition="'$(_EnvProbe)' == 'ASPNETCORE_ENVIRONMENT=' OR '$(_EnvProbe)' == ''" />
  </Target>

</Project>
